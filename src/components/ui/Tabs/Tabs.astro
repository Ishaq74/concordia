---
/**
 * Tabs — conteneur d'onglets (CSS-only, zéro JavaScript)
 *
 * Flex container avec flex-wrap. Les <Tab> enfants rendent des
 * radio + label + panel en siblings. Le CSS :checked + ~ gère
 * l'affichage du bon panneau sans aucun JS.
 *
 * @param {string}  variant  - Style (initial | retro | modern | futuristic)
 * @param {string}  label    - aria-label sur le conteneur
 * @param {string}  name     - Identifiant du groupe (à passer aussi à chaque <Tab>)
 * @param {string}  class    - Classes CSS additionnelles
 */

import './tabs.css';

interface Props {
  variant?: 'initial' | 'retro' | 'modern' | 'futuristic';
  label?: string;
  name?: string;
  class?: string;
}

const {
  variant = 'initial',
  label,
  class: className = '',
} = Astro.props;

const containerClasses = ['tabs-container', variant, className]
  .filter(Boolean)
  .join(' ');
---

<div class={containerClasses} aria-label={label || undefined}>
  <slot />
</div>

---
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import CardMeta from "@components/ui/Card/CardMeta.astro";
import Link from "@components/ui/Link.astro";
import Badge from "@components/ui/Badge.astro";

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  description?: string;
  ratingAvg?: number;
  ratingCount?: number;
  variant?: 'initial' | 'retro' | 'modern' | 'futuristic';
}

const {
  href,
  title,
  subtitle,
  description,
  ratingAvg,
  ratingCount,
  variant = 'initial'
} = Astro.props as Props;
---

<Link href={href} variant={variant}>
  <Card variant={variant} interactive>
    <CardHeader>
      <h3>{title}</h3>
      {subtitle && <Badge variant={variant} color="secondary">{subtitle}</Badge>}
    </CardHeader>
    <CardContent>
      {description && <p>{description}</p>}
    </CardContent>
    {(ratingAvg || ratingCount) && (
      // build items array without nulls so types align
      (() => {
        const metaItems: { icon?: string; text: string; label?: string }[] = [];
        if (ratingAvg) {
          metaItems.push({
            icon: "mdi:star",
            text: ratingAvg.toFixed(1),
            label: "Rating",
          });
        }
        if (ratingCount) {
          metaItems.push({
            text: `${ratingCount} reviews`,
            label: "Reviews",
          });
        }
        return <CardMeta items={metaItems} />;
      })()
    )}
  </Card>
</Link>
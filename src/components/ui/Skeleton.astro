---
interface Props {
  variant?: "initial" | "retro" | "modern" | "futuristic";
  width?: string;
  height?: string;
  circle?: boolean;
  rounded?: boolean;
  animated?: boolean;
  count?: number;
  className?: string;
}

const {
  variant = "initial",
  width,
  height,
  circle = false,
  rounded = false,
  animated = true,
  count = 1,
  className = "",
} = Astro.props;

const classes = [
  "skeleton",
  variant !== "initial" && variant,
  circle && "circle",
  rounded && "rounded",
  animated && "animated",
  className,
]
  .filter(Boolean)
  .join(" ");

const style = [
  width && `width: ${width}`,
  height && `height: ${height}`,
]
  .filter(Boolean)
  .join("; ");

const skeletons = Array.from({ length: count }, (_, i) => i);
---

{count === 1 ? (
  <div class={classes} style={style} aria-busy="true" aria-label="Chargement en cours"></div>
) : (
  <div class="skeleton-group">
    {skeletons.map(() => (
      <div class={classes} style={style} aria-busy="true" aria-label="Chargement en cours"></div>
    ))}
  </div>
)}

<style>
/* SKELETON */
.skeleton {
  display: block;
  background: var(--skeleton-bg);
  border-radius: var(--skeleton-border-radius);
  position: relative;
  overflow: hidden;
  opacity: 0.7;
}
.skeleton::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, var(--skeleton-shimmer-color), transparent);
  animation: skeleton-shimmer 1.5s infinite;
}
@keyframes skeleton-shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* ===========================================
   SKELETON - Initial Variant
   =========================================== */

.skeleton {
  --skeleton-bg: rgba(0, 0, 0, 0.1);
  --skeleton-highlight: rgba(255, 255, 255, 0.1);
  --skeleton-shine: rgba(255, 255, 255, 0.3);
  
  display: block;
  width: 100%;
  height: 1rem;
  background: linear-gradient(
    90deg,
    var(--skeleton-bg),
    var(--skeleton-highlight),
    var(--skeleton-bg)
  );
  background-size: 200% 100%;
  border: 1px solid rgba(0, 0, 0, 0.05);
  border-radius: var(--radius-sm);
  position: relative;
  overflow: hidden;
}

.skeleton-group {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.skeleton.circle {
  border-radius: 50%;
}

.skeleton.rounded {
  border-radius: var(--radius-lg);
}

/* Animation de pulsation */
.skeleton.animated {
  animation: skeleton-pulse 1.5s ease-in-out infinite, skeleton-gradient 2s ease-in-out infinite;
}

@keyframes skeleton-pulse {
  0%, 100% {
    opacity: 1;
  }
  50% {
    opacity: 0.7;
  }
}

@keyframes skeleton-gradient {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* Animation de shimmer */
.skeleton.animated::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    var(--skeleton-shine),
    transparent
  );
  animation: skeleton-shimmer 2s infinite;
}

@keyframes skeleton-shimmer {
  0% {
    left: -100%;
  }
  100% {
    left: 100%;
  }
}

/* ===========================================
   SKELETON - Retro Variant
   =========================================== */

.skeleton.retro {
  --skeleton-bg: var(--retro-card-bg, #ccc); /* fallback si pas de variable */
  
  border: var(--retro-border-width, 2px) solid var(--text-default, #000);
  border-radius: 0;
  box-shadow: var(--retro-shadow-offset, 4px) var(--retro-shadow-offset, 4px) 0 0 var(--retro-shadow-color, #000);

  background: repeating-linear-gradient(
    45deg,
    var(--skeleton-bg),
    var(--skeleton-bg) 10px,
    rgba(0,0,0,0.1) 10px,
    rgba(0,0,0,0.1) 20px
  );

  /* taille de l’élément pour visualiser */
  width: 200px;
  height: 50px;
}

.skeleton.retro::after { 
  display: none; 
}

.skeleton.retro.circle {
  border-radius: 0;
  clip-path: circle(50%);
}

.skeleton.retro.animated {
  animation: skeleton-retro-pulse 1.5s ease-in-out infinite;
}

@keyframes skeleton-retro-pulse {
  0%, 100% {
    opacity: 1;
    box-shadow: var(--retro-shadow-offset) var(--retro-shadow-offset) 0 0 var(--retro-shadow-color);
  }
  50% {
    opacity: 0.7;
    box-shadow: calc(var(--retro-shadow-offset) - 1px) calc(var(--retro-shadow-offset) - 1px) 0 0 var(--retro-shadow-color);
  }
}

.skeleton.retro.animated::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 255, 255, 0.2),
    transparent
  );
  animation: skeleton-shimmer 3s infinite;
}

/* ===========================================
   SKELETON MODERN
   =========================================== */
.skeleton.modern {
  --skeleton-bg: rgba(100, 100, 120, 0.15);
  --skeleton-highlight: rgba(150, 150, 180, 0.25);
  --skeleton-shine: rgba(255, 255, 255, 0.3);

  position: relative; /* important pour ::after et ::before */
  overflow: hidden;
  border-radius: var(--radius-lg);
  border: 1px solid rgba(100, 100, 120, 0.2);
  backdrop-filter: blur(10px);
  background: linear-gradient(
    135deg,
    var(--skeleton-bg),
    var(--skeleton-highlight),
    var(--skeleton-bg)
  );
  background-size: 200% 200%;
  box-shadow: var(--modern-shadow-sm), inset 0 1px 0 rgba(255, 255, 255, 0.1);
}

.skeleton.modern.circle {
  border-radius: 50%;
}

.skeleton.modern.animated {
  animation: 
    skeleton-modern-pulse 1.5s ease-in-out infinite,
    skeleton-modern-gradient 3s ease-in-out infinite;
}

.skeleton.modern.animated::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(
    90deg,
    transparent,
    var(--skeleton-shine),
    transparent
  );
  animation: skeleton-shimmer 2s infinite;
  pointer-events: none;
  z-index: 2;
}

@keyframes skeleton-modern-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.7; transform: scale(0.98); }
}

@keyframes skeleton-modern-gradient {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

@keyframes skeleton-shimmer {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

/* Optional glass highlight */
.skeleton.modern::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.1), transparent);
  pointer-events: none;
  z-index: 1;
}


/* SKELETON FUTURISTIC */
.skeleton.futuristic {
  --skeleton-primary: rgba(99, 102, 241, 0.25);
  --skeleton-secondary: rgba(139, 92, 246, 0.2);
  --skeleton-glow: rgba(99, 102, 241, 0.4);

  border-radius: var(--radius-md, 4px);
  border: 2px solid transparent;
  position: relative;
  overflow: hidden;
  background: linear-gradient(
    135deg,
    var(--skeleton-primary) 0%,
    var(--skeleton-secondary) 50%,
    var(--skeleton-primary) 100%
  );
  background-size: 200% 200%;
  box-shadow: 
    0 0 30px var(--skeleton-glow),
    0 0 60px rgba(99, 102, 241, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.15),
    inset 0 -1px 0 rgba(0, 0, 0, 0.2);
  backdrop-filter: blur(12px);
}

/* Animation futuristique style scanline / pulse */
.skeleton.futuristic::after {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 200%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(99,102,241,0.3), transparent);
  animation: skeleton-futuristic-shimmer 1.5s infinite;
}

@keyframes skeleton-futuristic-shimmer {
  0% {
    transform: translateX(-100%);
  }
  50% {
    transform: translateX(50%);
  }
  100% {
    transform: translateX(100%);
  }
}

/* Bordure néon animée */
.skeleton.futuristic {
  background-clip: padding-box;
  border: 2px solid;
  border-image: linear-gradient(
    90deg,
    rgba(99, 102, 241, 0.5),
    rgba(139, 92, 246, 0.5),
    rgba(236, 72, 153, 0.5),
    rgba(99, 102, 241, 0.5)
  ) 1;
}

.skeleton.futuristic.circle {
  border-radius: 50%;
  border-image: none;
  border-color: rgba(99, 102, 241, 0.5);
}

.skeleton.futuristic.rounded {
  border-radius: var(--radius-lg);
}

/* Grille cyber en arrière-plan */
.skeleton.futuristic::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: 
    repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(99, 102, 241, 0.05) 2px,
      rgba(99, 102, 241, 0.05) 4px
    ),
    repeating-linear-gradient(
      90deg,
      transparent,
      transparent 2px,
      rgba(99, 102, 241, 0.05) 2px,
      rgba(99, 102, 241, 0.05) 4px
    );
  opacity: 0.6;
  pointer-events: none;
  z-index: 1;
}

/* Effet holographique */
.skeleton.futuristic::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255, 255, 255, 0.1) 50%,
    transparent 70%
  );
  opacity: 0;
  z-index: 2;
}

.skeleton.futuristic.animated {
  animation: 
    skeleton-futuristic-glow 3s ease-in-out infinite,
    skeleton-futuristic-gradient 4s ease-in-out infinite;
}

@keyframes skeleton-futuristic-glow {
  0%, 100% {
    box-shadow: 
      0 0 30px var(--skeleton-glow),
      0 0 60px rgba(99, 102, 241, 0.2),
      inset 0 1px 0 rgba(255, 255, 255, 0.15),
      inset 0 -1px 0 rgba(0, 0, 0, 0.2);
  }
  50% {
    box-shadow: 
      0 0 40px rgba(99, 102, 241, 0.6),
      0 0 80px rgba(99, 102, 241, 0.3),
      inset 0 1px 0 rgba(255, 255, 255, 0.2),
      inset 0 -1px 0 rgba(0, 0, 0, 0.3);
  }
}

@keyframes skeleton-futuristic-gradient {
  0%, 100% {
    background-position: 0% 50%;
  }
  50% {
    background-position: 100% 50%;
  }
}

/* Scan line laser */
.skeleton.futuristic.animated::after {
  animation: skeleton-futuristic-scan 3s linear infinite;
}

@keyframes skeleton-futuristic-scan {
  0% {
    transform: translateX(-100%) skewX(-15deg);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateX(200%) skewX(-15deg);
    opacity: 0;
  }
}

</style>

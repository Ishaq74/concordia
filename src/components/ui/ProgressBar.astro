}

.progress-bar.futuristic.primary .progress-fill {
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-light, var(--color-primary)), var(--color-primary));
  box-shadow: 0 0 30px rgba(99, 102, 241, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

.progress-bar.futuristic.primary .progress-track::before {
  background: linear-gradient(90deg, transparent, rgba(99, 102, 241, 0.1), transparent);
}

.progress-bar.futuristic.secondary .progress-fill {
  background: linear-gradient(90deg, var(--color-secondary), var(--color-secondary-light, var(--color-secondary)), var(--color-secondary));
  box-shadow: 0 0 30px rgba(139, 92, 246, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

.progress-bar.futuristic.secondary .progress-track::before {
  background: linear-gradient(90deg, transparent, rgba(139, 92, 246, 0.1), transparent);
}

.progress-bar.futuristic.accent .progress-fill {
  background: linear-gradient(90deg, var(--color-accent), var(--color-accent-light, var(--color-accent)), var(--color-accent));
  box-shadow: 0 0 30px rgba(236, 72, 153, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.3);
}

.progress-bar.futuristic.accent .progress-track::before {
  background: linear-gradient(90deg, transparent, rgba(236, 72, 153, 0.1), transparent);
}

.progress-bar.futuristic .progress-label {
  font-family: var(--font-mono);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  text-shadow: 0 0 10px rgba(99, 102, 241, 0.5);
}

.progress-bar.futuristic .progress-label-inner {
  font-family: var(--font-mono);
  font-weight: 700;
  text-shadow: 0 0 5px rgba(0, 0, 0, 0.8);
}
</style>
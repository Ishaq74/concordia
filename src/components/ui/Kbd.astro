---
/**
 * Kbd - Composant pour afficher des touches de clavier
 * 
 * Affiche une représentation visuelle d'une touche de clavier ou d'un raccourci.
 * Supporte les 4 variants du design system et les couleurs.
 * 
 * @param {string} variant - Style variant (initial|retro|modern|futuristic)
 * @param {string} color - Couleur (default|primary|secondary|accent)
 * @param {string} size - Taille (sm|md|lg)
 * @param {string} className - Classes CSS additionnelles
 * 
 * @example
 * <Kbd>Ctrl</Kbd>
 * <Kbd color="primary">⌘ K</Kbd>
 * <Kbd variant="modern" size="lg">Enter</Kbd>
 */

interface Props {
  variant?: 'initial' | 'retro' | 'modern' | 'futuristic';
  color?: 'default' | 'primary' | 'secondary' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  className?: string;
}

const {
  variant = 'initial',
  color = 'default',
  size = 'md',
  className = '',
} = Astro.props;

const variantClass = variant !== 'initial' ? `kbd-${variant}` : '';
const colorClass = color !== 'default' ? color : '';
const sizeClass = size !== 'md' ? `kbd-${size}` : '';

const classes = [
  'kbd',
  variantClass,
  colorClass,
  sizeClass,
  className,
].filter(Boolean).join(' ');
---

<kbd class={classes}>
  <slot />
</kbd>

<style>
/* KBD - Keyboard Key */
.kbd {
  display: inline-block;
  padding: 0.125rem 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.875em;
  line-height: 1.5;
  color: var(--text-default);
  background: var(--bg-subtle);
  border: 1px solid var(--border-default);
  border-radius: 0.375rem;
  box-shadow: 0 2px 0 0 var(--border-default), 
              0 3px 0 0 color-mix(in srgb, var(--border-default) 50%, transparent);
  font-weight: 600;
  white-space: nowrap;
  vertical-align: middle;
  transition: all 0.1s ease;
}

.kbd:active {
  transform: translateY(2px);
  box-shadow: 0 1px 0 0 var(--border-default);
}

/* Sizes */
.kbd-sm {
  padding: 0.0625rem 0.375rem;
  font-size: 0.75em;
  border-radius: 0.25rem;
}

.kbd-lg {
  padding: 0.25rem 0.75rem;
  font-size: 1em;
  border-radius: 0.5rem;
}

/* Combinations de touches */
.kbd + .kbd {
  margin-left: 0.25rem;
}

/* Colors */
.kbd.primary {
  background: var(--button-primary-bg);
  color: var(--button-primary-color);
  border-color: var(--button-primary-bg);
  box-shadow: 0 2px 0 0 color-mix(in srgb, var(--button-primary-bg) 80%, #000),
              0 3px 0 0 color-mix(in srgb, var(--button-primary-bg) 40%, transparent);
}

.kbd.secondary {
  background: var(--button-secondary-bg);
  color: var(--button-secondary-color);
  border-color: var(--button-secondary-bg);
  box-shadow: 0 2px 0 0 color-mix(in srgb, var(--button-secondary-bg) 80%, #000),
              0 3px 0 0 color-mix(in srgb, var(--button-secondary-bg) 40%, transparent);
}

.kbd.accent {
  background: var(--button-accent-bg);
  color: var(--button-accent-color);
  border-color: var(--button-accent-bg);
  box-shadow: 0 2px 0 0 color-mix(in srgb, var(--button-accent-bg) 80%, #000),
              0 3px 0 0 color-mix(in srgb, var(--button-accent-bg) 40%, transparent);
}

/* KBD RETRO */
.kbd-retro {
  border-radius: 0;
  border: var(--retro-border-width) solid var(--text-default);
  background: var(--retro-button-bg);
  color: var(--retro-button-color);
  box-shadow: 3px 3px 0 0 var(--retro-shadow-color);
  font-family: var(--font-mono);
  font-weight: 700;
  letter-spacing: 0.05em;
}

.kbd-retro:active {
  transform: translate(3px, 3px);
  box-shadow: none;
}

.kbd-retro.primary {
  background: var(--button-primary-bg);
  color: var(--button-primary-color);
  border-color: var(--text-default);
  box-shadow: 3px 3px 0 0 color-mix(in srgb, var(--button-primary-bg) 60%, #000);
}

.kbd-retro.secondary {
  background: var(--button-secondary-bg);
  color: var(--button-secondary-color);
  border-color: var(--text-default);
  box-shadow: 3px 3px 0 0 color-mix(in srgb, var(--button-secondary-bg) 60%, #000);
}

.kbd-retro.accent {
  background: var(--button-accent-bg);
  color: var(--button-accent-color);
  border-color: var(--text-default);
  box-shadow: 3px 3px 0 0 color-mix(in srgb, var(--button-accent-bg) 60%, #000);
}

/* KBD MODERN */
.kbd-modern {
  border-radius: var(--modern-radius);
  border: 1px solid var(--modern-input-border-color);
  background: var(--modern-input-bg);
  color: var(--modern-input-text-color);
  box-shadow: 0 1px 2px 0 color-mix(in srgb, var(--border-default) 30%, transparent),
              0 2px 0 0 var(--modern-input-border-color);
  font-weight: 500;
}

.kbd-modern:active {
  transform: translateY(1px);
  box-shadow: 0 1px 1px 0 color-mix(in srgb, var(--border-default) 20%, transparent);
}

.kbd-modern.primary {
  background: var(--button-primary-bg);
  color: var(--button-primary-color);
  border-color: var(--button-primary-bg);
  box-shadow: 0 1px 2px 0 color-mix(in srgb, var(--button-primary-bg) 40%, transparent),
              0 2px 0 0 color-mix(in srgb, var(--button-primary-bg) 80%, #000);
}

.kbd-modern.secondary {
  background: var(--button-secondary-bg);
  color: var(--button-secondary-color);
  border-color: var(--button-secondary-bg);
  box-shadow: 0 1px 2px 0 color-mix(in srgb, var(--button-secondary-bg) 40%, transparent),
              0 2px 0 0 color-mix(in srgb, var(--button-secondary-bg) 80%, #000);
}

.kbd-modern.accent {
  background: var(--button-accent-bg);
  color: var(--button-accent-color);
  border-color: var(--button-accent-bg);
  box-shadow: 0 1px 2px 0 color-mix(in srgb, var(--button-accent-bg) 40%, transparent),
              0 2px 0 0 color-mix(in srgb, var(--button-accent-bg) 80%, #000);
}

/* KBD FUTURISTIC */
.kbd-futuristic {
  border-radius: 0;
  clip-path: polygon(4px 0, 100% 0, 100% calc(100% - 4px), calc(100% - 4px) 100%, 0 100%, 0 4px);
  border: 1px solid var(--color-primary);
  background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  color: var(--color-primary);
  box-shadow: 0 0 10px color-mix(in srgb, var(--color-primary) 30%, transparent),
              inset 0 0 10px color-mix(in srgb, var(--color-primary) 10%, transparent);
  font-family: var(--font-mono);
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-shadow: 0 0 5px var(--color-primary);
}

.kbd-futuristic:active {
  transform: scale(0.95);
  box-shadow: 0 0 5px color-mix(in srgb, var(--color-primary) 50%, transparent);
}

.kbd-futuristic.primary {
  border-color: var(--button-primary-bg);
  background: color-mix(in srgb, var(--button-primary-bg) 15%, transparent);
  color: var(--button-primary-bg);
  box-shadow: 0 0 10px color-mix(in srgb, var(--button-primary-bg) 40%, transparent),
              inset 0 0 10px color-mix(in srgb, var(--button-primary-bg) 15%, transparent);
  text-shadow: 0 0 5px var(--button-primary-bg);
}

.kbd-futuristic.secondary {
  border-color: var(--button-secondary-bg);
  background: color-mix(in srgb, var(--button-secondary-bg) 15%, transparent);
  color: var(--button-secondary-bg);
  box-shadow: 0 0 10px color-mix(in srgb, var(--button-secondary-bg) 40%, transparent),
              inset 0 0 10px color-mix(in srgb, var(--button-secondary-bg) 15%, transparent);
  text-shadow: 0 0 5px var(--button-secondary-bg);
}

.kbd-futuristic.accent {
  border-color: var(--button-accent-bg);
  background: color-mix(in srgb, var(--button-accent-bg) 15%, transparent);
  color: var(--button-accent-bg);
  box-shadow: 0 0 10px color-mix(in srgb, var(--button-accent-bg) 40%, transparent),
              inset 0 0 10px color-mix(in srgb, var(--button-accent-bg) 15%, transparent);
  text-shadow: 0 0 5px var(--button-accent-bg);
}
</style>
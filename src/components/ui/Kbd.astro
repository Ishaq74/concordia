---
/**
 * Kbd - Composant pour afficher des touches de clavier
 * 
 * Affiche une représentation visuelle d'une touche de clavier ou d'un raccourci.
 * Supporte les 4 variants du design system et les couleurs.
 * 
 * @param {string} variant - Style variant (initial|retro|modern|futuristic)
 * @param {string} color - Couleur (default|primary|secondary|accent)
 * @param {string} size - Taille (sm|md|lg)
 * @param {string} className - Classes CSS additionnelles
 * 
 * @example
 * <Kbd>Ctrl</Kbd>
 * <Kbd color="primary">⌘ K</Kbd>
 * <Kbd variant="modern" size="lg">Enter</Kbd>
 */

interface Props {
  variant?: 'initial' | 'retro' | 'modern' | 'futuristic';
  color?: 'default' | 'primary' | 'secondary' | 'accent';
  size?: 'sm' | 'md' | 'lg';
  className?: string;
}

const {
  variant = 'initial',
  color = 'default',
  size = 'md',
  className = '',
} = Astro.props;

const variantClass = variant !== 'initial' ? `kbd-${variant}` : '';
const colorClass = color !== 'default' ? color : '';
const sizeClass = size !== 'md' ? `kbd-${size}` : '';

const classes = [
  'kbd',
  variantClass,
  colorClass,
  sizeClass,
  className,
].filter(Boolean).join(' ');
---

<kbd class={classes}>
  <slot />
</kbd>

<style>
/* KBD - Keyboard Key */
.kbd {
  display: inline-block;
  padding: 0.125rem 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.875em;
  line-height: 1.5;
  color: var(--text-default);
  background: var(--bg-subtle);
  border: 1px solid var(--border-default);
  border-radius: 0.375rem;
  box-shadow: 0 2px 0 0 var(--border-default), 
              0 3px 0 0 color-mix(in srgb, var(--border-default) 50%, transparent);
  font-weight: 600;
  white-space: nowrap;
  vertical-align: middle;
  transition: all 0.1s ease;
}

.kbd:active {
  transform: translateY(2px);
  box-shadow: 0 1px 0 0 var(--border-default);
}

/* Sizes */
.kbd-sm {
  padding: 0.0625rem 0.375rem;
  font-size: 0.75em;
  border-radius: 0.25rem;
}

.kbd-lg {
  padding: 0.25rem 0.75rem;
  font-size: 1em;
  border-radius: 0.5rem;
}

/* Combinations de touches */
.kbd + .kbd {
  margin-left: 0.25rem;
}

/* Colors */
.kbd.primary {
  background: var(--button-primary-bg);
  color: var(--button-primary-color);
  border-color: var(--button-primary-bg);
  box-shadow: 0 2px 0 0 color-mix(in srgb, var(--button-primary-bg) 80%, #000),
              0 3px 0 0 color-mix(in srgb, var(--button-primary-bg) 40%, transparent);
}

.kbd.secondary {
  background: var(--button-secondary-bg);
  color: var(--button-secondary-color);
  border-color: var(--button-secondary-bg);
  box-shadow: 0 2px 0 0 color-mix(in srgb, var(--button-secondary-bg) 80%, #000),
              0 3px 0 0 color-mix(in srgb, var(--button-secondary-bg) 40%, transparent);
}

.kbd.accent {
  background: var(--button-accent-bg);
  color: var(--button-accent-color);
  border-color: var(--button-accent-bg);
  box-shadow: 0 2px 0 0 color-mix(in srgb, var(--button-accent-bg) 80%, #000),
              0 3px 0 0 color-mix(in srgb, var(--button-accent-bg) 40%, transparent);
}
</style>
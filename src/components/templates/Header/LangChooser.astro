---
import Dropdown from "@components/ui/Dropdown.astro";
import { getLocalizedUrl, getCanonicalPath, getSupportedLocales } from "@lib/i18n/route-helpers";

interface Props {
  variant?: "initial" | "retro" | "modern" | "futuristic";
  class?: string;
  lang?: string;
  isMenu?: boolean;
}

const {
  variant = "initial",
  class: className = "",
  isMenu = false,
} = Astro.props;

// Detect current locale from URL
const locales = getSupportedLocales();
const localePattern = new RegExp(`^\\/(${locales.join("|")})(\\/.*)$`);
const currentLocale = Astro.currentLocale || "fr";

// Extract the canonical path from the current URL for accurate lang switching
const match = Astro.url.pathname.match(localePattern);
const detectedLang = match?.[1] ?? "fr";
const restOfPath = match?.[2]?.replace(/^\//, "") ?? "";
const canonicalPath = getCanonicalPath(detectedLang, restOfPath) ?? restOfPath;

const languages = [
  {
    label: "Français",
    icon: "🇫🇷",
    href: getLocalizedUrl("fr", canonicalPath) || '#',
    value: "fr",
  },
  {
    label: "English",
    icon: "🇬🇧",
    href: getLocalizedUrl("en", canonicalPath) || '#',
    value: "en",
  },
  {
    label: "العربية",
    icon: "🇸🇦",
    href: getLocalizedUrl("ar", canonicalPath) || '#',
    value: "ar",
  },
  {
    label: "Español",
    icon: "🇪🇸",
    href: getLocalizedUrl("es", canonicalPath) || '#',
    value: "es",
  },
];

// Determine current language display
const currentLangDisplay =
  languages.find((lang) => lang.value === currentLocale) || languages[0];
---

<Dropdown
  items={languages}
  variant={variant}
  position="bottom-right"
  triggerLabel={currentLangDisplay.icon}
  ismenu={isMenu}
  class={className}
/>

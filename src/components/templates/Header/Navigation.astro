---
import Dropdown from "@components/ui/Dropdown.astro";
import { getLocalizedUrl } from "@lib/i18n/route-helpers";

interface Props {
  variant?: "initial" | "retro" | "modern" | "futuristic";
  isMenu?: boolean;
  class?: string;
}

const {
  variant = "initial",
  isMenu = false,
  class: className = "",
} = Astro.props;

// Astro.currentLocale can occasionally be undefined during some page renders
// so we fall back to French and log the value for debugging purposes.
const currentLocale = Astro.currentLocale || "fr";
const currentPath = Astro.url.pathname;

import { getTranslations } from "@i18n/translations";
const t = getTranslations(currentLocale);

const navClass = ["nav", variant !== "initial" && variant, className]
  .filter(Boolean)
  .join(" ");

// Navigation sections with locale-aware slugs resolved via slug-map
const discoverItems = [
  { label: t.nav.places, href: getLocalizedUrl(currentLocale, "places") || "#" },
  { label: t.nav.trails, href: getLocalizedUrl(currentLocale, "trails") || "#" },
  { label: t.nav.blog, href: getLocalizedUrl(currentLocale, "blog") || "#" },
  { label: t.nav.events, href: getLocalizedUrl(currentLocale, "events") || "#" },
];

const communityItems = [
  { label: t.nav.forum, href: getLocalizedUrl(currentLocale, "forum") || "#" },
  { label: t.nav.groups, href: getLocalizedUrl(currentLocale, "groups") || "#" },
  { label: t.nav.classifieds, href: getLocalizedUrl(currentLocale, "classifieds") || "#" },
  { label: t.nav.services, href: getLocalizedUrl(currentLocale, "services") || "#" },
];

const engageItems = [
  { label: t.nav.volunteer, href: getLocalizedUrl(currentLocale, "volunteer") || "#" },
  { label: t.nav.education, href: getLocalizedUrl(currentLocale, "education") || "#" },
  { label: t.nav.funding, href: getLocalizedUrl(currentLocale, "funding") || "#" },
  { label: t.nav.transparency, href: getLocalizedUrl(currentLocale, "transparency") || "#" },
];
---

<nav class={navClass}>
  <a
    href={getLocalizedUrl(currentLocale, "")}
    class:list={["nav-link", { active: currentPath === getLocalizedUrl(currentLocale, "") }]}>
    {t.nav.home}
  </a>

  <div class="nav-dropdown-wrapper">
    <Dropdown
      items={discoverItems}
      variant={variant}
      position="bottom-left"
      triggerLabel={t.nav.discover}
      ishover={true}
      ismenu={isMenu}
      class="nav-dropdown"
    />
  </div>

  <div class="nav-dropdown-wrapper">
    <Dropdown
      items={communityItems}
      variant={variant}
      position="bottom-left"
      triggerLabel={t.nav.community}
      ishover={true}
      ismenu={isMenu}
      class="nav-dropdown"
    />
  </div>

  <div class="nav-dropdown-wrapper">
    <Dropdown
      items={engageItems}
      variant={variant}
      position="bottom-left"
      triggerLabel={t.nav.engage}
      ishover={true}
      ismenu={isMenu}
      class="nav-dropdown"
    />
  </div>

  <a
    href={getLocalizedUrl(currentLocale, "docs")}
    class:list={["nav-link", { active: currentPath.startsWith(getLocalizedUrl(currentLocale, "docs")) }]}> 
    {t.nav.docs}
  </a>
</nav>

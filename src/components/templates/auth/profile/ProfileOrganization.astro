---
// src/components/templates/auth/profile/ProfileOrganization.astro
import Flex from "@components/Tools/Flex.astro";
import Card from "@components/ui/Card/Card.astro";
import Button from "@components/ui/Button.astro";
import Label from "@components/ui/Form/Label.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Checkbox from "@components/ui/Form/Checkbox.astro";
import Dialog from "@components/ui/Dialog/Dialog.astro";
import DialogTrigger from "@components/ui/Dialog/DialogTrigger.astro";
import DialogContent from "@components/ui/Dialog/DialogContent.astro";
import DialogFooter from "@components/ui/Dialog/DialogFooter.astro";
import DialogHeader from "@components/ui/Dialog/DialogHeader.astro";
import DialogTitle from "@components/ui/Dialog/DialogTitle.astro";
import { Icon } from "astro-icon/components";

interface Org {
  id: string;
  name?: string | null;
  slug?: string | null;
  role?: string | null;
}
interface Member {
  id: string;
  userId: string;
  role: string;
  organizationId?: string;
  email?: string | null;
  user?: { name?: string | null; email?: string | null } | null;
}

interface Props {
  organizations?: Org[];
  activeOrganizationId?: string | null;
  members?: Member[];
  canManageOrganization?: boolean;
  isOwner?: boolean;
  session?: any;
  translations?: Record<string, any>;
}

const {
  organizations = [],
  activeOrganizationId = null,
  members = [],
  canManageOrganization = false,
  isOwner = false,
  translations = {},
} = Astro.props as Props;

const hasOrganizations = organizations.length > 0;
---

<Card variant="modern" elevation="sm" aria-label={translations.auth?.organizationSection ?? "Section organisation"}>
  <div class="profile-org">
    <div class="profile-org__header">
      <div class="profile-org__header-text">
        <h2 class="profile-org__title">
          <Icon name="mdi:office-building-outline" />
          Gestion des organisations
        </h2>
        <p class="profile-org__description">
          Gérez vos organisations, invitez des membres et configurez les paramètres.
        </p>
      </div>
    </div>

    {!hasOrganizations ? (
      <div class="profile-org__empty">
        <Icon name="mdi:account-group-outline" />
        <p class="profile-org__empty-title">Aucune organisation</p>
        <p class="profile-org__empty-hint">
          Vous n'êtes membre d'aucune organisation pour le moment.
          Rejoignez ou créez une organisation pour collaborer avec d'autres citoyens.
        </p>
      </div>
    ) : (
      <div class="profile-org__content">
        {/* Organisation list */}
        <div class="profile-org__list">
          {organizations.map((org) => (
            <div class="profile-org__card">
              <div class="profile-org__card-avatar">
                {org.name?.charAt(0)?.toUpperCase() ?? "O"}
              </div>
              <div class="profile-org__card-info">
                <span class="profile-org__card-name">{org.name ?? org.slug ?? org.id}</span>
                {org.role && (
                  <span class="profile-org__card-role">{org.role}</span>
                )}
              </div>
              {org.id === activeOrganizationId && (
                <span class="profile-org__card-active">Active</span>
              )}
            </div>
          ))}
        </div>

        {/* Management section (only when active org) */}
        {activeOrganizationId && (
          <div class="profile-org__management">
            {/* Member list */}
            <div class="profile-org__members">
              <Flex justifyContent="space-between" alignItems="center">
                <h3 class="profile-org__section-title">
                  Membres ({members.length})
                </h3>
                {canManageOrganization && (
                  <Dialog id="dialog-invite-member">
                    <DialogTrigger for="dialog-invite-member">
                      <Button variant="modern" color="primary" icon={{ name: "mdi:account-plus-outline", side: "left" }}>
                        Inviter
                      </Button>
                    </DialogTrigger>
                    <DialogContent>
                      <DialogHeader>
                        <DialogTitle>Inviter un membre</DialogTitle>
                      </DialogHeader>
                      <form method="POST" class="profile-org__invite-form">
                        <input type="hidden" name="intent" value="invite-member" />
                        <Label htmlFor="invite-email">{translations.auth?.email ?? "Email"}</Label>
                        <Input id="invite-email" type="email" name="email" required placeholder="membre@exemple.com" />
                        <Label htmlFor="invite-role">{translations.auth?.admin ?? "Rôle"}</Label>
                        <Select id="invite-role" name="role">
                          <option value="member">Membre</option>
                          <option value="admin">Admin</option>
                          <option value="owner">Propriétaire</option>
                        </Select>
                        <Checkbox id="invite-resend" name="resend">
                          {translations.auth?.resendInvite ?? "Renvoyer si déjà invité"}
                        </Checkbox>
                        <DialogFooter>
                          <Button type="submit" variant="modern" color="primary">
                            Envoyer l'invitation
                          </Button>
                        </DialogFooter>
                      </form>
                    </DialogContent>
                  </Dialog>
                )}
              </Flex>

              {members.length === 0 ? (
                <p class="profile-org__no-members">Aucun membre à afficher.</p>
              ) : (
                <div class="profile-org__member-list">
                  {members.map((member) => (
                    <div class="profile-org__member">
                      <div class="profile-org__member-avatar">
                        {(member.user?.name ?? member.email ?? "?").charAt(0).toUpperCase()}
                      </div>
                      <div class="profile-org__member-info">
                        <span class="profile-org__member-name">
                          {member.user?.name ?? member.user?.email ?? member.email ?? member.userId}
                        </span>
                        <span class="profile-org__member-role">{member.role}</span>
                      </div>
                    </div>
                  ))}
                </div>
              )}
            </div>

            {/* Leave */}
            {!isOwner && (
              <div class="profile-org__leave">
                <form method="POST">
                  <input type="hidden" name="intent" value="leave-organization" />
                  <input type="hidden" name="organizationId" value={activeOrganizationId} />
                  <Button type="submit" variant="modern" color="error" icon={{ name: "mdi:logout", side: "left" }}>
                    Quitter l'organisation
                  </Button>
                </form>
              </div>
            )}
          </div>
        )}
      </div>
    )}
  </div>
</Card>

<style>
.profile-org {
  padding: 1.5rem;
}

.profile-org__header {
  margin-bottom: 1.5rem;
  padding-bottom: 1rem;
  border-bottom: 1px solid var(--border-color, #e2e8f0);
}

.profile-org__title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--heading-color, #1e293b);
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
}

.profile-org__title :global(svg) {
  width: 1.25rem;
  height: 1.25rem;
  color: var(--color-primary, #1978e5);
}

.profile-org__description {
  font-size: 0.875rem;
  color: var(--text-muted, #64748b);
  margin: 0.5rem 0 0;
}

/* Empty state */
.profile-org__empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 2rem 1rem;
  gap: 0.5rem;
}

.profile-org__empty :global(svg) {
  width: 2.5rem;
  height: 2.5rem;
  color: var(--text-muted, #94a3b8);
}

.profile-org__empty-title {
  font-size: 0.9375rem;
  font-weight: 600;
  color: var(--text-secondary, #475569);
  margin: 0;
}

.profile-org__empty-hint {
  font-size: 0.8125rem;
  color: var(--text-muted, #94a3b8);
  margin: 0;
  max-width: 28rem;
}

/* Organization cards */
.profile-org__list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.profile-org__card {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem 1rem;
  border-radius: var(--radius, 0.5rem);
  border: 1px solid var(--border-color, #e2e8f0);
  background: var(--card-bg, #fff);
}

.profile-org__card-avatar {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 0.5rem;
  background: var(--bg-subtle, #f1f5f9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.875rem;
  color: var(--color-primary, #1978e5);
  flex-shrink: 0;
}

.profile-org__card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.profile-org__card-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--heading-color, #1e293b);
}

.profile-org__card-role {
  font-size: 0.75rem;
  color: var(--text-muted, #94a3b8);
  text-transform: capitalize;
}

.profile-org__card-active {
  font-size: 0.6875rem;
  font-weight: 700;
  color: #16a34a;
  background: #f0fdf4;
  padding: 0.125rem 0.5rem;
  border-radius: 9999px;
  border: 1px solid #bbf7d0;
}

/* Members */
.profile-org__section-title {
  font-size: 1rem;
  font-weight: 700;
  color: var(--heading-color, #1e293b);
  margin: 0;
}

.profile-org__no-members {
  font-size: 0.875rem;
  color: var(--text-muted, #94a3b8);
  margin: 0.75rem 0 0;
}

.profile-org__member-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 1rem;
}

.profile-org__member {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 0.75rem;
  border-radius: var(--radius, 0.5rem);
  background: var(--bg-subtle, #f8fafc);
}

.profile-org__member-avatar {
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  background: var(--border-color, #e2e8f0);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.75rem;
  color: var(--color-primary, #1978e5);
  flex-shrink: 0;
}

.profile-org__member-info {
  display: flex;
  flex-direction: column;
}

.profile-org__member-name {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--heading-color, #1e293b);
}

.profile-org__member-role {
  font-size: 0.75rem;
  color: var(--text-muted, #94a3b8);
  text-transform: capitalize;
}

.profile-org__invite-form {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  margin-top: 0.75rem;
}

.profile-org__leave {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border-color, #e2e8f0);
}
</style>


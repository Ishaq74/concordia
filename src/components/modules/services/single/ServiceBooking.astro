---
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Button from "@components/ui/Button.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";

interface Props {
  serviceId: string;
  providerId: string;
  basePrice?: string | null;
  priceType?: string | null;
  currency?: string | null;
  durationMinutes?: number | null;
  lang: string;
}

const { serviceId, providerId, basePrice, /* priceType, */ currency = "EUR", durationMinutes, lang } = Astro.props;
const t = getTranslations(lang);
---

<Card class="booking-card">
  <CardContent>
    <h3 class="booking-title">
      <Icon name="mdi:calendar-check" width="22" height="22" />
      {t.servicesPage?.bookNow ?? "Réserver"}
    </h3>

    <div class="booking-summary">
      {basePrice && basePrice !== "0" && (
        <div class="booking-row">
          <span class="booking-label">{t.servicesPage?.priceFrom ?? "À partir de"}</span>
          <span class="booking-value">{basePrice} {currency}</span>
        </div>
      )}
      {durationMinutes && (
        <div class="booking-row">
          <span class="booking-label">{t.servicesPage?.duration ?? "Durée"}</span>
          <span class="booking-value">{durationMinutes} {t.servicesPage?.durationMinutes ?? "min"}</span>
        </div>
      )}
    </div>

    <form class="booking-form" data-service-id={serviceId} data-provider-id={providerId}>
      <label class="booking-field">
        <span>{t.servicesPage?.availability ?? "Disponibilité"}</span>
        <input type="date" name="bookingDate" required min={new Date().toISOString().split("T")[0]} />
      </label>
      <label class="booking-field">
        <span>{t.servicesPage?.dayMonday && "Heure"}</span>
        <input type="time" name="bookingTime" required />
      </label>
      <textarea
        name="customerMessage"
        rows="3"
        placeholder={t.servicesPage?.contactProvider ?? "Message au prestataire..."}
      ></textarea>
      <Button type="submit" color="accent" class="booking-submit">
        <Icon name="mdi:send" width="16" height="16" />
        {t.servicesPage?.bookNow ?? "Réserver"}
      </Button>
    </form>
  </CardContent>
</Card>

<style>
  .booking-card {
    position: sticky;
    top: var(--space-6);
  }

  .booking-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 700;
    margin: 0 0 var(--space-4);
  }

  .booking-summary {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border, #e2e8f0);
  }

  .booking-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2) 0;
  }

  .booking-label {
    color: var(--color-text-muted, #666);
    font-size: var(--text-sm);
  }

  .booking-value {
    font-weight: 600;
  }

  .booking-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .booking-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
  }

  .booking-field input {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-md, 6px);
    font-size: var(--text-sm);
  }

  .booking-form textarea {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border, #e2e8f0);
    border-radius: var(--radius-md, 6px);
    font-size: var(--text-sm);
    resize: vertical;
  }

  .booking-feedback {
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md, 6px);
    font-size: var(--text-sm);
    font-weight: 500;
    text-align: center;
    display: none;
  }
  .booking-feedback.success { display: block; background: #dcfce7; color: #166534; }
  .booking-feedback.error { display: block; background: #fef2f2; color: #991b1b; }
</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector<HTMLFormElement>(".booking-form");
    if (!form) return;

    const serviceId = form.dataset.serviceId;
    const submitBtn = form.querySelector<HTMLButtonElement>('[type="submit"]');

    // Create feedback element dynamically
    let feedback = form.querySelector<HTMLDivElement>(".booking-feedback");
    if (!feedback) {
      feedback = document.createElement("div");
      feedback.className = "booking-feedback";
      form.appendChild(feedback);
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!submitBtn) return;

      feedback!.className = "booking-feedback";
      feedback!.textContent = "";
      submitBtn.disabled = true;
      submitBtn.style.opacity = "0.6";

      const formData = new FormData(form);
      const bookingDate = formData.get("bookingDate") as string;
      const bookingTime = formData.get("bookingTime") as string;
      const customerMessage = formData.get("customerMessage") as string;

      if (!bookingDate || !bookingTime) {
        feedback!.className = "booking-feedback error";
        feedback!.textContent = "Veuillez remplir la date et l'heure.";
        submitBtn.disabled = false;
        submitBtn.style.opacity = "";
        return;
      }

      try {
        const res = await fetch("/api/services/bookings", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ serviceId, bookingDate, bookingTime, customerMessage }),
        });

        const data = await res.json();

        if (res.ok) {
          feedback!.className = "booking-feedback success";
          feedback!.textContent = "Réservation envoyée ! Vous recevrez une confirmation.";
          form.reset();

          // Try to show toast if available
          try {
            const { showToast } = await import("@lib/admin/toast");
            showToast?.("Réservation créée avec succès", "success");
          } catch {}
        } else if (res.status === 401) {
          // Not authenticated — redirect to login
          const lang = document.documentElement.lang || "fr";
          window.location.href = `/${lang}/auth/sign-in?redirect=${encodeURIComponent(window.location.pathname)}`;
          return;
        } else {
          feedback!.className = "booking-feedback error";
          feedback!.textContent = data.error || "Une erreur est survenue.";
        }
      } catch (err) {
        feedback!.className = "booking-feedback error";
        feedback!.textContent = "Erreur réseau. Veuillez réessayer.";
      } finally {
        submitBtn.disabled = false;
        submitBtn.style.opacity = "";
      }
    });
  });
</script>

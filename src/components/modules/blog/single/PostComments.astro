---
import { actions } from "astro:actions";
import { getDrizzle } from "@database/drizzle";
import { blogComments } from "@database/schemas";
import { eq, and, desc } from "drizzle-orm";

import Card from "@components/ui/Card/Card.astro";
import Button from "@components/ui/Button.astro";

import Tabs from '@components/ui/Tabs/Tabs.astro';
import Tab from '@components/ui/Tabs/Tab.astro';
import CommentItem from "./CommentItem.astro";

interface Props {
  postId: string;
  postType: "blog" | "place" | "event" | "hike" | "classified";
}

const { postId, postType } = Astro.props;
const user = Astro.locals.user;
const lang = Astro.currentLocale ?? "fr";

let allComments: any[] = [];
let rootComments: any[] = [];
let dbError = null;
try {
  const db = await getDrizzle();
  allComments = await db.query.blogComments.findMany({
    where: and(
      eq(blogComments.postId, postId),
      eq(blogComments.postType, postType),
    ),
    orderBy: [desc(blogComments.createdAt)],
  });
  rootComments = allComments.filter((c) => !c.parentId);
} catch (err) {
  dbError = (err instanceof Error && err.message) ? err.message : String(err);
  console.error('PostComments: DB read error', dbError);
}
---

<section id="comments-section" class="comments-section">

<Tabs name="comments-tabs" variant="retro" label="Commentaires et avis">
  <Tab name="comments-tabs" label={`Commentaires (${allComments.length})`} open>
    {rootComments.length === 0 ? (
      <div>Aucun commentaire pour le moment.</div>
    ) : (
      rootComments.map((comment) => (
        <CommentItem
          comment={comment}
          allComments={allComments}
          postId={postId}
          postType={postType}
          user={user}
          lang={lang}
        />
      ))
    )}
  </Tab>

  <Tab name="comments-tabs" label="Laisser un avis" icon="mdi:pencil">
    <Card>
      <form method="POST" action={actions.createComment}>
        <input type="hidden" name="postId" value={postId} />
        <input type="hidden" name="postType" value={postType} />

        {!user && (
          <div class="anon-info">
            <p>Vous pouvez laisser un avis sans vous connecter. Indiquez votre nom et votre email (optionnel).</p>
            <div>
              <label>Nom</label>
              <input type="text" name="authorName" placeholder="Votre nom" />
            </div>
            <div>
              <label>Email</label>
              <input type="email" name="authorEmail" placeholder="votre@email.com" />
            </div>
          </div>
        )}

        <fieldset class="rating-fieldset">
          <legend class="rating-legend">Note</legend>
          <div class="rating-selector">
            {[5, 4, 3, 2, 1].map((n) => (
              <>
                <input
                  type="radio"
                  id={`r-${n}`}
                  name="rating"
                  value={n}
                  required
                  class="rating-radio"
                />
                <label for={`r-${n}`} class="rating-star" title={`${n} étoile${n > 1 ? 's' : ''}`}>
                  <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                    <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                  </svg>
                </label>
              </>
            ))}
          </div>
        </fieldset>

        <div>
          <label>Message</label>
          <textarea name="content" required minlength="3" placeholder="Partagez votre avis..." />
        </div>

        <Button type="submit">Publier le commentaire</Button>
      </form>
    </Card>
  </Tab>
</Tabs>
</section>

<script is:inline>
  (function initCommentInteractions() {
    var section = document.getElementById("comments-section");
    if (!section) return;

    section.addEventListener("click", function (e) {
      var target = /** @type {HTMLElement} */ (e.target);
      var replyBtn = target.closest(".reply-btn");
      var cancelBtn = target.closest(".cancel-reply");

      if (replyBtn) {
        var id = replyBtn.getAttribute("data-reply-to");
        var slot = document.getElementById("reply-slot-" + id);
        if (slot) slot.classList.remove("is-hidden");
        replyBtn.classList.add("is-hidden");
      }

      if (cancelBtn) {
        var cid = cancelBtn.getAttribute("data-target");
        var cslot = document.getElementById("reply-slot-" + cid);
        if (cslot) cslot.classList.add("is-hidden");
        var btn = section.querySelector('[data-reply-to="' + cid + '"]');
        if (btn) btn.classList.remove("is-hidden");
      }
    });
  })();
</script>

<style>
  .comments-section {
    margin-top: var(--space-6);
  }

  /* ── Rating stars selector ── */
  .rating-fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }
  .rating-legend {
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: var(--space-2);
    color: var(--text-default);
  }
  .rating-selector {
    display: flex;
    flex-direction: row-reverse;
    justify-content: flex-end;
    gap: var(--space-1);
    align-items: center;
  }
  /* Hide native radio, keep accessible */
  .rating-radio {
    position: absolute;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    width: 1px;
    height: 1px;
    overflow: hidden;
    white-space: nowrap;
  }
  .rating-star {
    cursor: pointer;
    color: var(--border-default, #d1d5db);
    transition: color 150ms ease, transform 150ms ease;
    line-height: 1;
    display: inline-flex;
  }
  .rating-star:hover,
  .rating-star:hover ~ .rating-star {
    color: #facc15;
    transform: scale(1.15);
  }
  .rating-radio:checked ~ .rating-star {
    color: #facc15;
  }
  .rating-radio:focus-visible ~ .rating-star {
    /* just the first star after focus gets outline */
  }
  .rating-radio:focus-visible + .rating-star {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--border-radius-sm);
  }

</style>

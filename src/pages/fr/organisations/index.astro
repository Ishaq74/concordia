---
// src/pages/fr/organisations/index.astro
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import BannerPage from "@templates/BannerPage.astro";
import Grid from "@components/Tools/Grid.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import CardFooter from "@components/ui/Card/CardFooter.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Flex from "@components/Tools/Flex.astro";
import { Icon } from "astro-icon/components";

import { getDrizzle } from "@database/drizzle";
import { blogOrganizations } from "@database/schemas";
import { eq } from "drizzle-orm";

const LANG = "fr";
const db = await getDrizzle();

const organizations = await db
  .select()
  .from(blogOrganizations)
  .where(eq(blogOrganizations.isActive, true))
  .orderBy(blogOrganizations.name);

// Helper to extract localized text
const loc = (val: any, fallback = "") => {
  if (!val) return fallback;
  if (typeof val === "string") return val;
  return val[LANG] ?? val.fr ?? val.en ?? Object.values(val)[0] ?? fallback;
};
---

<BaseLayout title="Organisations" lang={LANG}>
  <BannerPage
    title="Organisations"
    subtitle="Découvrez les organisations qui font vivre Concordia"
    description="Médias locaux, associations, collectifs — les acteurs qui animent la communauté et produisent du contenu de qualité."
    type="flex"
    color="primary"
    breadcrumbs={[]}
  />

  <main class="org-listing">
    {organizations.length === 0 ? (
      <div class="org-empty">
        <Icon name="mdi:domain" />
        <p>Aucune organisation enregistrée pour le moment.</p>
      </div>
    ) : (
      <Grid
        tag="section"
        display="grid"
        gap="lg"
        padding="lg"
        gridTemplateColumns="repeat(auto-fill, minmax(360px, 1fr))"
        ariaLabel="Liste des organisations"
      >
        {organizations.map((org) => {
          const desc = loc(org.description);
          const slogan = loc(org.slogan);
          const address = org.address as any;
          const sameAs = (org.sameAs ?? []) as string[];
          const rating = org.aggregateRating as any;

          return (
            <Card class="org-card" variant="modern" elevation="sm" role="article">
              <CardHeader class="org-card__header">
                <div class="org-card__identity">
                  {org.logo ? (
                    <img src={org.logo} alt={org.name} class="org-card__logo" loading="lazy" />
                  ) : (
                    <div class="org-card__logo-placeholder">
                      {org.name.charAt(0).toUpperCase()}
                    </div>
                  )}
                  <div class="org-card__titles">
                    <h2 class="org-card__name">
                      <a href={`/${LANG}/organisations/${org.slug}`}>{org.name}</a>
                    </h2>
                    {slogan && <p class="org-card__slogan">{slogan}</p>}
                  </div>
                </div>

                <Flex gap="xs" class="org-card__badges">
                  {org.isFeatured && (
                    <Badge variant="modern" color="warning" icon={{ name: "mdi:star", side: "left" }}>
                      En vedette
                    </Badge>
                  )}
                  {org.nonprofitStatus && (
                    <Badge variant="modern" color="success" icon={{ name: "mdi:hand-heart", side: "left" }}>
                      {org.nonprofitStatus}
                    </Badge>
                  )}
                </Flex>
              </CardHeader>

              <CardContent class="org-card__body">
                {desc && <p class="org-card__desc">{desc.length > 180 ? desc.slice(0, 180) + "…" : desc}</p>}

                <div class="org-card__meta">
                  {address?.addressLocality && (
                    <span class="org-card__meta-item">
                      <Icon name="mdi:map-marker-outline" />
                      {address.addressLocality}{address.addressCountry ? `, ${address.addressCountry}` : ""}
                    </span>
                  )}
                  {org.numberOfEmployees && (
                    <span class="org-card__meta-item">
                      <Icon name="mdi:account-group-outline" />
                      {org.numberOfEmployees} membres
                    </span>
                  )}
                  {org.foundingDate && (
                    <span class="org-card__meta-item">
                      <Icon name="mdi:calendar-outline" />
                      Depuis {new Date(org.foundingDate).getFullYear()}
                    </span>
                  )}
                </div>

                {/* Knowledge tags */}
                {org.knowsAbout && (org.knowsAbout as string[]).length > 0 && (
                  <Flex gap="xs" class="org-card__tags">
                    {(org.knowsAbout as string[]).slice(0, 4).map((tag) => (
                      <Badge variant="modern" color="secondary">{tag}</Badge>
                    ))}
                    {(org.knowsAbout as string[]).length > 4 && (
                      <Badge variant="modern" color="secondary">+{(org.knowsAbout as string[]).length - 4}</Badge>
                    )}
                  </Flex>
                )}
              </CardContent>

              <CardFooter className="org-card__footer">
                <Flex alignItems="center" justifyContent="space-between" class="org-card__actions">
                  <Flex gap="xs" class="org-card__socials">
                    {sameAs.slice(0, 4).map((link) => {
                      const icon = link.includes("facebook") ? "mdi:facebook"
                        : link.includes("instagram") ? "mdi:instagram"
                        : link.includes("twitter") || link.includes("x.com") ? "mdi:twitter"
                        : link.includes("linkedin") ? "mdi:linkedin"
                        : link.includes("youtube") ? "mdi:youtube"
                        : link.includes("strava") ? "mdi:run"
                        : "mdi:link-variant";
                      return (
                        <a href={link} target="_blank" rel="noopener noreferrer" class="org-card__social-link" aria-label={`Lien social ${org.name}`}>
                          <Icon name={icon} />
                        </a>
                      );
                    })}
                  </Flex>

                  {rating && (
                    <span class="org-card__rating" title={`${rating.ratingCount} avis`}>
                      <Icon name="mdi:star" /> {Number(rating.ratingValue).toFixed(1)}
                    </span>
                  )}

                  <a href={`/${LANG}/organisations/${org.slug}`}>
                    <Button variant="modern" color="primary" icon={{ name: "mdi:arrow-right", side: "right" }}>
                      Découvrir
                    </Button>
                  </a>
                </Flex>
              </CardFooter>
            </Card>
          );
        })}
      </Grid>
    )}
  </main>
</BaseLayout>

<style>
.org-listing {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 1rem;
}

.org-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding: 4rem 2rem;
  text-align: center;
  color: var(--text-muted-foreground);
}
.org-empty :global(svg) {
  width: 3rem;
  height: 3rem;
  opacity: 0.4;
}

/* Card */
.org-card { transition: transform 200ms ease, box-shadow 200ms ease; }
.org-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }

.org-card__header { display: flex; flex-direction: column; gap: 0.75rem; }

.org-card__identity { display: flex; align-items: center; gap: 1rem; }

.org-card__logo {
  width: 56px; height: 56px;
  border-radius: var(--radius-md, 0.5rem);
  object-fit: contain;
  background: var(--bg-muted, #f8f9fa);
  padding: 0.25rem;
}
.org-card__logo-placeholder {
  width: 56px; height: 56px;
  border-radius: var(--radius-md, 0.5rem);
  background: linear-gradient(135deg, var(--color-primary, #1978e5), #6366f1);
  color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem; font-weight: 700;
}

.org-card__titles { flex: 1; min-width: 0; }
.org-card__name { margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.3; }
.org-card__name a { text-decoration: none; color: var(--text-foreground); }
.org-card__name a:hover { text-decoration: underline; }
.org-card__slogan { margin: 0.25rem 0 0; font-size: 0.8125rem; color: var(--text-muted-foreground); font-style: italic; }

.org-card__badges { flex-wrap: wrap; }

.org-card__body { display: flex; flex-direction: column; gap: 0.75rem; }

.org-card__desc {
  font-size: 0.9rem;
  color: var(--text-muted-foreground);
  line-height: 1.6;
  margin: 0;
}

.org-card__meta { display: flex; flex-wrap: wrap; gap: 1rem; }
.org-card__meta-item {
  display: flex; align-items: center; gap: 0.25rem;
  font-size: 0.8125rem; color: var(--text-muted-foreground);
}
.org-card__meta-item :global(svg) { width: 1rem; height: 1rem; }

.org-card__tags { flex-wrap: wrap; }

.org-card__footer { padding-top: 0.75rem; border-top: 1px solid var(--border-color, #e2e8f0); }

.org-card__socials { flex-wrap: wrap; }
.org-card__social-link {
  display: flex; align-items: center; justify-content: center;
  width: 2rem; height: 2rem;
  border-radius: var(--radius-sm, 0.25rem);
  color: var(--text-muted-foreground);
  transition: color 150ms, background 150ms;
}
.org-card__social-link:hover {
  color: var(--color-primary);
  background: var(--bg-muted, #f1f5f9);
}
.org-card__social-link :global(svg) { width: 1.25rem; height: 1.25rem; }

.org-card__rating {
  display: flex; align-items: center; gap: 0.25rem;
  font-size: 0.875rem; font-weight: 600;
  color: var(--color-warning, #f59e0b);
}
.org-card__rating :global(svg) { width: 1rem; height: 1rem; }

@media (max-width: 480px) {
  .org-card__identity { flex-direction: column; align-items: flex-start; }
  .org-card__actions { flex-direction: column; gap: 0.75rem; }
}
</style>

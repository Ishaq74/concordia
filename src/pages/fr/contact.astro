---
// src/pages/fr/contact.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import BannerPage from "@templates/BannerPage.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Button from "@components/ui/Button.astro";
import { Icon } from "astro-icon/components";

const LANG = "fr";

const contactMethods = [
  { icon: "mdi:email-outline", title: "Email", value: "contact@concordia.community", href: "mailto:contact@concordia.community" },
  { icon: "mdi:map-marker-outline", title: "Adresse", value: "Paris, France", href: null },
  { icon: "mdi:clock-outline", title: "Disponibilité", value: "Lun–Ven, 9h–18h", href: null },
];
---

<BaseLayout title="Contact — Concordia" lang={LANG}>
  <BannerPage
    title="Contact"
    subtitle="Une question, une suggestion, un partenariat ?"
    description="N'hésitez pas à nous écrire. Notre équipe vous répondra dans les meilleurs délais."
    type="minimal"
    color="neutral"
    breadcrumbs={[]}
  />

  <main class="contact-page">
    <div class="contact-grid">

      {/* ===== FORM ===== */}
      <Card variant="retro" elevation="md" class="contact-form-card">
        <CardContent>
          <h2 class="contact-form-title">
            <Icon name="mdi:send-outline" /> Envoyez-nous un message
          </h2>
          <form class="contact-form" action="#" method="POST">
            <div class="contact-form__row">
              <div class="contact-form__field">
                <label for="contact-name">Nom complet</label>
                <input type="text" id="contact-name" name="name" placeholder="Votre nom" required autocomplete="name" />
              </div>
              <div class="contact-form__field">
                <label for="contact-email">Email</label>
                <input type="email" id="contact-email" name="email" placeholder="votre@email.com" required autocomplete="email" />
              </div>
            </div>
            <div class="contact-form__field">
              <label for="contact-subject">Sujet</label>
              <select id="contact-subject" name="subject" required>
                <option value="">Choisissez un sujet</option>
                <option value="question">Question générale</option>
                <option value="bug">Signaler un bug</option>
                <option value="partnership">Partenariat</option>
                <option value="press">Presse</option>
                <option value="other">Autre</option>
              </select>
            </div>
            <div class="contact-form__field">
              <label for="contact-message">Message</label>
              <textarea id="contact-message" name="message" rows="6" placeholder="Décrivez votre demande…" required></textarea>
            </div>
            <Button type="submit" variant="retro" color="primary" icon={{ name: "mdi:send", side: "right" }}>
              Envoyer le message
            </Button>
          </form>
        </CardContent>
      </Card>

      {/* ===== SIDEBAR INFO ===== */}
      <aside class="contact-sidebar">
        {contactMethods.map((method) => (
          <Card variant="retro" elevation="sm">
            <CardContent>
              <div class="contact-method">
                <div class="contact-method__icon">
                  <Icon name={method.icon} />
                </div>
                <div>
                  <h3 class="contact-method__title">{method.title}</h3>
                  {method.href ? (
                    <a href={method.href} class="contact-method__value contact-method__link">
                      {method.value}
                    </a>
                  ) : (
                    <p class="contact-method__value">{method.value}</p>
                  )}
                </div>
              </div>
            </CardContent>
          </Card>
        ))}

        <Card variant="retro" elevation="sm" class="contact-faq-card">
          <CardContent>
            <h3 class="contact-sidebar-title">
              <Icon name="mdi:frequently-asked-questions" /> FAQ
            </h3>
            <p class="contact-sidebar-text">Consultez notre base de connaissances pour trouver rapidement des réponses à vos questions.</p>
            <a href={`/${LANG}/blog`}>
              <Button variant="retro" color="secondary" icon={{ name: "mdi:arrow-right", side: "right" }}>
                Voir le blog
              </Button>
            </a>
          </CardContent>
        </Card>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
/* ========================================
   CONTACT PAGE
   ======================================== */

.contact-page {
  max-width: 1280px; margin: 0 auto;
  padding: 2.5rem 1rem;
}

.contact-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
@media (min-width: 1024px) { .contact-grid { grid-template-columns: 2fr 1fr; } }

/* --- Form --- */
.contact-form-title {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1.25rem; font-weight: 700; margin: 0 0 1.5rem;
  color: var(--heading-color, var(--text-default));
}
.contact-form-title :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary); }

.contact-form { display: flex; flex-direction: column; gap: 1.25rem; }

.contact-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@media (max-width: 640px) { .contact-form__row { grid-template-columns: 1fr; } }

.contact-form__field { display: flex; flex-direction: column; gap: 0.375rem; }
.contact-form__field label {
  font-size: 0.875rem; font-weight: 600;
  color: var(--text-default);
}

.contact-form__field input,
.contact-form__field select,
.contact-form__field textarea {
  width: 100%; padding: 0.625rem 0.75rem;
  border: 2px solid var(--border-default);
  border-radius: var(--border-radius-sm, 0.375rem);
  font-size: 0.9375rem; font-family: inherit;
  background: var(--bg-default); color: var(--text-default);
  transition: border-color 180ms;
}

.contact-form__field input:focus,
.contact-form__field select:focus,
.contact-form__field textarea:focus {
  outline: none; border-color: var(--color-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
}

.contact-form__field textarea { resize: vertical; min-height: 120px; }

/* --- Sidebar --- */
.contact-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }

.contact-method { display: flex; align-items: flex-start; gap: 0.75rem; }
.contact-method__icon {
  width: 2.5rem; height: 2.5rem; border-radius: 50%;
  background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.contact-method__icon :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary); }
.contact-method__title { margin: 0; font-size: 0.875rem; font-weight: 700; color: var(--text-default); }
.contact-method__value { margin: 0.125rem 0 0; font-size: 0.875rem; color: var(--text-muted); }
.contact-method__link { text-decoration: none; color: var(--color-primary); }
.contact-method__link:hover { text-decoration: underline; }

.contact-sidebar-title {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1rem; font-weight: 700; margin: 0 0 0.5rem;
  color: var(--heading-color, var(--text-default));
}
.contact-sidebar-title :global(svg) { width: 1.125rem; height: 1.125rem; color: var(--color-primary); }
.contact-sidebar-text { margin: 0 0 0.75rem; font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }
</style>

---
import DocLayout from "@layouts/DocLayout.astro";
import { Code } from "astro:components";
import TabsComponent from "@components/ui/Tabs/Tabs.astro";
import TabComponent from "@components/ui/Tabs/Tab.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import TableOfContents from "@/components/templates/docs/TableOfContents.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
---

<DocLayout
  title="Tabs Component"
  description="Documentation du composant Tabs — zéro JavaScript, CSS-only, accessible, responsive, 4 variants"
  variant="initial"
>
  <h1 id="tabs-component">Tabs Component</h1>

  <p>
    Le composant <code class="inline-code">Tabs</code> crée des interfaces à onglets
    <strong>sans aucun JavaScript</strong> grâce à des <code class="inline-code">&lt;input type="radio"&gt;</code>
    masqués et au sélecteur CSS <code class="inline-code">:checked</code>.
    La navigation clavier fonctionne nativement (flèches dans un groupe radio).
  </p>

  <h2>Démo interactive</h2>

  <div class="demo-section">
    <TabsComponent name="demo-tabs" variant="modern" label="Démo Tabs">
      <TabComponent name="demo-tabs" label="Aperçu" icon="mdi:eye" open>
        <h3>Bienvenue dans la démo Tabs !</h3>
        <p>
          Ce composant organise votre contenu en onglets interactifs.
          Naviguez entre les sections pour découvrir toutes les capacités.
        </p>
        <ul>
          <li>Interface intuitive et élégante</li>
          <li>4 variants disponibles (Initial, Retro, Modern, Futuristic)</li>
          <li>Zéro JavaScript — CSS-only avec radio inputs</li>
          <li>Accessible (clavier natif, screen reader, focus visible)</li>
          <li>Responsive : stack vertical sur mobile, tabs sur desktop</li>
        </ul>
      </TabComponent>

      <TabComponent name="demo-tabs" label="Code" icon="mdi:code-tags">
        <h3>Exemple de code</h3>
        <p>L'API — simple et composable :</p>
        <Code
          lang="astro"
          code={`<Tabs name="mes-tabs" variant="modern" label="Navigation">
  <Tab name="mes-tabs" label="Accueil" icon="mdi:home" open>
    <h3>Contenu de l'accueil</h3>
  </Tab>
  <Tab name="mes-tabs" label="Paramètres" icon="mdi:cog">
    <h3>Contenu des paramètres</h3>
  </Tab>
</Tabs>`}
        />
      </TabComponent>

      <TabComponent name="demo-tabs" label="Fonctionnalités" icon="mdi:star">
        <h3>Fonctionnalités principales</h3>
        <ul>
          <li><strong>4 variants</strong> : Initial, Retro, Modern, Futuristic</li>
          <li><strong>Icônes</strong> : intégration astro-icon native</li>
          <li><strong>Zéro JS</strong> : radio inputs + CSS :checked</li>
          <li><strong>Responsive</strong> : stack mobile → tabs desktop</li>
          <li><strong>Accessible</strong> : clavier natif (flèches), focus visible</li>
        </ul>
      </TabComponent>

      <TabComponent name="demo-tabs" label="Documentation" icon="mdi:book-open">
        <h3>Sur cette page</h3>
        <ul>
          <li>Exemples de code prêts à l'emploi</li>
          <li>Démos interactives pour chaque variant</li>
          <li>Référence complète des props</li>
          <li>Meilleures pratiques</li>
        </ul>
        <p>Continuez de faire défiler pour explorer !</p>
      </TabComponent>
    </TabsComponent>
  </div>

  <TableOfContents
    items={[
      { label: "Installation", href: "#installation" },
      { label: "Utilisation basique", href: "#basic-usage" },
      { label: "Variants", href: "#variants" },
      { label: "Avec icônes", href: "#icons" },
      { label: "Props", href: "#props" },
      { label: "Accessibilité", href: "#accessibility" },
      { label: "Meilleures pratiques", href: "#best-practices" },
    ]}
    title="Table des matières"
  />

  <h2 id="installation">Installation</h2>

  <p>Les composants sont dans <code class="inline-code">src/components/ui/Tabs/</code></p>

  <Code
    lang="typescript"
    code={`import Tabs from '@components/ui/Tabs/Tabs.astro';
import Tab  from '@components/ui/Tabs/Tab.astro';
// TabPanel est déprécié — le contenu va directement dans <Tab>`}
  />

  <h2 id="basic-usage">Utilisation basique</h2>

  <p>
    Chaque <code class="inline-code">&lt;Tab&gt;</code> porte son libellé
    (prop <code class="inline-code">label</code>) et son contenu (slot).
    Le prop <code class="inline-code">name</code> doit être identique sur tous les
    <code class="inline-code">&lt;Tab&gt;</code> d'un même groupe.
    Le prop <code class="inline-code">open</code> marque l'onglet actif par défaut.
  </p>


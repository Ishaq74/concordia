      <TabComponent name="basic-tabs" label="Vue d'ensemble" open>
        <h3>Vue d'ensemble</h3>
        <p>Introduction générale à notre produit et ses capacités principales.</p>
        <ul>
          <li>Interface intuitive et moderne</li>
          <li>Performance optimisée</li>

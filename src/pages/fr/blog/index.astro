---
// src/pages/fr/blog/index.astro
import { getCollection } from "astro:content";
import { getDrizzle } from "@database/drizzle";
import { blogComments } from "@database/schemas";
import { sql, eq } from "drizzle-orm";
import BaseLayout from "@layouts/BaseLayout.astro";
import BannerPage from "@templates/BannerPage.astro";
import PostGrid from "@components/modules/blog/lists/PostGrid.astro";
import PostCard from "@components/modules/blog/cards/PostCard.astro";
import CategoryGrid from "@components/modules/blog/lists/CategoryGrid.astro";
import FeaturedGrid from "@components/modules/blog/lists/FeaturedGrid.astro";

const LANG = Astro.currentLocale || "fr";
const t = await import(`../../../i18n/${LANG}.json`);
const allPosts = await getCollection("blog");

// On récupère les vraies stats SQL depuis la nouvelle table générique
const db = await getDrizzle();
const liveStats = await db
  .select({
    postId: blogComments.postId,
    avgRating: sql<number>`avg(${blogComments.rating})`.mapWith(Number),
    count: sql<number>`count(${blogComments.id})`.mapWith(Number),
  })
  .from(blogComments)
  .where(eq(blogComments.postType, "blog"))
  .groupBy(blogComments.postId);

const statsMap = new Map(liveStats.map((s) => [s.postId, s]));

const posts = allPosts
  .filter((post) => post.data.lang === LANG)
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt || 0).getTime() -
      new Date(a.data.publishedAt || 0).getTime(),
  );

// --- Extraire les catégories uniques avec nombre d'articles ---
const catMap = new Map<string, { name: string; slug: string; count: number }>();
posts.forEach((post) => {
  (post.data.categories ?? []).forEach((cat: any) => {
    const existing = catMap.get(cat.slug);
    if (existing) {
      existing.count++;
    } else {
      catMap.set(cat.slug, { name: cat.name, slug: cat.slug, count: 1 });
    }
  });
});
const categories = Array.from(catMap.values()).sort((a, b) => b.count - a.count);

// --- Articles mis en avant ---
const featuredPosts = posts.filter((p) => p.data.isFeatured);
---

<BaseLayout title="Blog" lang={LANG}>
  <BannerPage
    title={t.blog?.title || 'Blog'}
    subtitle={t.blog?.description || 'Découvrez nos derniers articles sur la technologie, l’innovation et les tendances du secteur.'}
    type="blog"
    color="accent"
    breadcrumbs={[]}
  />
  <main class="container py-12">
    {/* Section Catégories */}
    {categories.length > 0 && (
      <CategoryGrid categories={categories} lang={LANG} />
    )}

    {/* Section Articles à la une */}
    <FeaturedGrid posts={featuredPosts} lang={LANG} statsMap={statsMap} variant="retro" limit={6} />

    {/* Tous les articles */}
    <h2 class="all-posts-heading">Tous les articles</h2>
    <PostGrid>
      {
        posts.map((post) => {
          const stats = statsMap.get(post.data.id);

          return (
            <PostCard
              post={post}
              lang={LANG}
              rating={stats?.avgRating}
              count={stats?.count}
              variant="retro"
            />
          );
        })
      }
    </PostGrid>
  </main>
</BaseLayout>

<style>
  .all-posts-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-foreground);
    margin: 0 0 var(--space-4, 1rem) 0;
  }
</style>

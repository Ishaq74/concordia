---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Pagination from "@components/ui/Pagination.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogComments, blogPosts } from "@database/schemas";
import { count, eq, desc, inArray } from "drizzle-orm";

import tData from "@i18n/fr.json";
const currentLocale = Astro.currentLocale || "fr";
const t = tData;

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1"));
const perPage = 25;
const statusFilter = url.searchParams.get("status")?.trim() ?? "";
const postTypeFilter = url.searchParams.get("type")?.trim() ?? "";

const db = await getDrizzle();

// Conditions
const conditions = [];
if (statusFilter) conditions.push(eq(blogComments.status, statusFilter));
if (postTypeFilter) conditions.push(eq(blogComments.postType, postTypeFilter));

const whereClause = conditions.length > 0
  ? conditions.reduce((a, b) => a && b ? a : a || b)
  : undefined;

// Comptage
const [totalResult] = whereClause
  ? await db.select({ value: count() }).from(blogComments).where(whereClause)
  : await db.select({ value: count() }).from(blogComments);
const totalComments = totalResult.value;
const totalPages = Math.max(1, Math.ceil(totalComments / perPage));

// Fetch
const comments = whereClause
  ? await db
      .select()
      .from(blogComments)
      .where(whereClause)
      .orderBy(desc(blogComments.createdAt))
      .limit(perPage)
      .offset((page - 1) * perPage)
  : await db
      .select()
      .from(blogComments)
      .orderBy(desc(blogComments.createdAt))
      .limit(perPage)
      .offset((page - 1) * perPage);

// Résoudre les posts associés
const postIds = [...new Set(comments.map((c) => c.postId).filter(Boolean))];
const postsMap = new Map<string, string>();
if (postIds.length > 0) {
  const posts = await db
    .select({ id: blogPosts.id, slug: blogPosts.slug })
    .from(blogPosts)
    .where(inArray(blogPosts.id, postIds));
  posts.forEach((p) => postsMap.set(p.id, p.slug));
}

// Comptage par statut
const [pendingCount] = await db.select({ value: count() }).from(blogComments).where(eq(blogComments.status, "pending"));
const [approvedCount] = await db.select({ value: count() }).from(blogComments).where(eq(blogComments.status, "approved"));
const [rejectedCount] = await db.select({ value: count() }).from(blogComments).where(eq(blogComments.status, "rejected"));

// Types distincts
const distinctTypes = await db.selectDistinct({ postType: blogComments.postType }).from(blogComments);
const typeOptions = distinctTypes.map((t) => t.postType).filter(Boolean).sort();

const statusBadgeColor = (s: string) => {
  if (s === "approved") return "success" as const;
  if (s === "rejected") return "error" as const;
  if (s === "pending") return "warning" as const;
  return "default" as const;
};

const statusLabel = (s: string) => {
  if (s === "approved") return "Approuvé";
  if (s === "rejected") return "Rejeté";
  if (s === "pending") return "En attente";
  return s;
};

const extractText = (content: unknown): string => {
  if (typeof content === "string") return content;
  if (content && typeof content === "object") {
    const obj = content as Record<string, string>;
    return obj[currentLocale] || Object.values(obj)[0] || "—";
  }
  return "—";
};

const adminBase = `/${currentLocale}/admin/blog/comments`;
---

<AdminLayout title="Commentaires" activeSection="blog-comments">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <h1>Commentaires</h1>
      <Badge color="primary" text={`${totalComments} total`} />
    </div>
    <p class="admin-page-subtitle">Vue d'ensemble et gestion de tous les commentaires.</p>
  </header>

  <!-- Compteurs rapides -->
  <div class="comments-summary">
    <a href={`${adminBase}?status=pending`} class:list={["summary-chip", { active: statusFilter === "pending" }]}>
      <Icon name="mdi:clock-outline" class="chip-icon" />
      <span>En attente</span>
      <Badge color="warning" text={String(pendingCount.value)} />
    </a>
    <a href={`${adminBase}?status=approved`} class:list={["summary-chip", { active: statusFilter === "approved" }]}>
      <Icon name="mdi:check-circle-outline" class="chip-icon" />
      <span>Approuvés</span>
      <Badge color="success" text={String(approvedCount.value)} />
    </a>
    <a href={`${adminBase}?status=rejected`} class:list={["summary-chip", { active: statusFilter === "rejected" }]}>
      <Icon name="mdi:close-circle-outline" class="chip-icon" />
      <span>Rejetés</span>
      <Badge color="error" text={String(rejectedCount.value)} />
    </a>
    {(statusFilter || postTypeFilter) && (
      <a href={adminBase} class="summary-chip-reset">Tout afficher</a>
    )}
  </div>

  <!-- Filtre par type -->
  {typeOptions.length > 1 && (
    <Card elevation="sm" className="admin-filters-card">
      <CardContent>
        <form method="get" action={adminBase} class="admin-filters-form">
          {statusFilter && <input type="hidden" name="status" value={statusFilter} />}
          <div class="admin-filter-field">
            <Label htmlFor="type">Type de contenu</Label>
            <Select id="type" name="type">
              <option value="">Tous</option>
              {typeOptions.map((tp) => (
                <option value={tp} selected={tp === postTypeFilter}>{tp}</option>
              ))}
            </Select>
          </div>
          <div class="admin-filter-actions">
            <Button type="submit" color="primary" icon={{ name: "mdi:filter-outline", side: "left" }}>
              Filtrer
            </Button>
          </div>
        </form>
      </CardContent>
    </Card>
  )}

  <!-- Table des commentaires -->
  <Card>
    <CardContent>
      {comments.length === 0 ? (
        <div class="empty-state">
          <Icon name="mdi:comment-text-multiple-outline" class="empty-state-icon" />
          <p>Aucun commentaire trouvé.</p>
        </div>
      ) : (
        <div class="table-responsive">
        <Table striped>
          <TableHeader>
            <TableRow>
              <TableHead>Auteur</TableHead>
              <TableHead>Contenu</TableHead>
              <TableHead>Article</TableHead>
              <TableHead>Type</TableHead>
              <TableHead>Statut</TableHead>
              <TableHead>Note</TableHead>
              <TableHead>Langue</TableHead>
              <TableHead>Date</TableHead>
              <TableHead>Actions</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {comments.map((comment) => (
              <TableRow>
                <TableCell>
                  <div class="comment-author">
                    <span class="comment-author-name">{comment.authorName}</span>
                    <span class="comment-author-email">{comment.authorEmail}</span>
                  </div>
                </TableCell>
                <TableCell>
                  <p class="comment-excerpt">
                    {extractText(comment.content).slice(0, 100)}{extractText(comment.content).length > 100 ? "…" : ""}
                  </p>
                </TableCell>
                <TableCell>
                  <code class="slug-code">{postsMap.get(comment.postId) ?? comment.postId}</code>
                </TableCell>
                <TableCell>
                  <Badge color="default" text={comment.postType} />
                </TableCell>
                <TableCell>
                  <Badge color={statusBadgeColor(comment.status)} text={statusLabel(comment.status)} />
                </TableCell>
                <TableCell>
                  {comment.rating !== null && comment.rating !== undefined && comment.rating > 0 ? (
                    <div class="rating-display">
                      <Icon name="mdi:star" class="rating-icon" />
                      <span>{comment.rating}/5</span>
                    </div>
                  ) : (
                    <span class="text-muted">—</span>
                  )}
                </TableCell>
                <TableCell>
                  <Badge color="default" text={comment.inLanguage} />
                </TableCell>
                <TableCell>
                  <time datetime={comment.createdAt.toISOString()}>
                    {comment.createdAt.toLocaleDateString(currentLocale, {
                      day: "2-digit",
                      month: "2-digit",
                      year: "2-digit",
                    })}
                  </time>
                </TableCell>
                <TableCell>
                  <div class="action-buttons">
                    {comment.status !== "approved" && (
                      <form method="post" action={`/${currentLocale}/api/admin/moderate`} class="inline-form">
                        <input type="hidden" name="entity" value="blogComments" />
                        <input type="hidden" name="entityId" value={comment.id} />
                        <input type="hidden" name="action" value="approve" />
                        <Button type="submit" color="primary" className="btn-sm"
                          icon={{ name: "mdi:check", side: "left" }}>
                          OK
                        </Button>
                      </form>
                    )}
                    {comment.status !== "rejected" && (
                      <form method="post" action={`/${currentLocale}/api/admin/moderate`} class="inline-form">
                        <input type="hidden" name="entity" value="blogComments" />
                        <input type="hidden" name="entityId" value={comment.id} />
                        <input type="hidden" name="action" value="reject" />
                        <Button type="submit" color="error" className="btn-sm"
                          icon={{ name: "mdi:close", side: "left" }}>
                          Non
                        </Button>
                      </form>
                    )}
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
        </div>
      )}
    </CardContent>
  </Card>

  {totalPages > 1 && (
    <div class="admin-pagination">
      <Pagination
        currentPage={page}
        totalPages={totalPages}
        baseUrl={`${adminBase}?${statusFilter ? `status=${encodeURIComponent(statusFilter)}&` : ""}${postTypeFilter ? `type=${encodeURIComponent(postTypeFilter)}&` : ""}page=`}
        showPrevNext
        color="primary"
      />
    </div>
  )}
</AdminLayout>

<style>
  .admin-page-header {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .admin-page-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
  }

  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem);
    font-weight: 800;
    color: var(--heading-color, #0f172a);
    margin: 0;
  }

  .admin-page-subtitle {
    color: var(--text-muted, #64748b);
    font-size: 0.9375rem;
    margin: var(--space-1, 0.25rem) 0 0;
  }

  .comments-summary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-4, 1rem);
    align-items: center;
  }

  .summary-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-md, 0.375rem);
    background: var(--bg-surface, white);
    text-decoration: none;
    color: var(--text-default, #1e293b);
    font-size: 0.875rem;
    font-weight: 500;
    transition: border-color 0.15s, background 0.15s;
  }

  .summary-chip:hover {
    border-color: var(--color-primary, #eab308);
    background: var(--bg-subtle, #f8fafc);
  }

  .summary-chip.active {
    border-color: var(--color-primary, #eab308);
    background: var(--bg-inset, #f1f5f9);
  }

  .chip-icon {
    width: 1rem;
    height: 1rem;
    opacity: 0.7;
  }

  .summary-chip-reset {
    font-size: 0.8125rem;
    color: var(--text-muted, #64748b);
    text-decoration: underline;
    margin-left: var(--space-2, 0.5rem);
  }

  .admin-filters-card {
    margin-bottom: var(--space-4, 1rem);
  }

  .admin-filters-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4, 1rem);
  }

  .admin-filter-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
    min-width: 180px;
    max-width: 280px;
    flex: 1;
  }

  .admin-filter-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }

  .comment-author {
    display: flex;
    flex-direction: column;
  }

  .comment-author-name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-default, #0f172a);
  }

  .comment-author-email {
    font-size: 0.75rem;
    color: var(--text-muted, #64748b);
  }

  .comment-excerpt {
    font-size: 0.8125rem;
    color: var(--text-default, #1e293b);
    line-height: 1.4;
    margin: 0;
    max-width: 220px;
  }

  .slug-code {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.75rem;
    background: var(--bg-inset, #f1f5f9);
    padding: 0.125rem 0.375rem;
    border-radius: var(--border-radius-sm, 0.25rem);
  }

  .rating-display {
    display: inline-flex;
    align-items: center;
    gap: 0.125rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-warning, #f97316);
  }

  .rating-icon {
    width: 0.875rem;
    height: 0.875rem;
    color: var(--color-warning, #f97316);
  }

  .text-muted {
    color: var(--text-muted, #64748b);
    font-size: 0.8125rem;
  }

  .action-buttons {
    display: flex;
    gap: var(--space-1, 0.25rem);
  }

  .inline-form {
    display: inline;
  }

  .btn-sm {
    font-size: 0.75rem !important;
    padding: 0.25rem 0.375rem !important;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-8, 2rem);
    color: var(--text-muted, #64748b);
  }

  .empty-state-icon {
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2, 0.5rem);
    opacity: 0.5;
  }

  .admin-pagination {
    margin-top: var(--space-4, 1rem);
    display: flex;
    justify-content: center;
  }

  .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  @media (max-width: 768px) {
    .comments-summary { flex-direction: column; }
    .admin-filters-form { flex-direction: column; }
    .admin-filter-field { min-width: 0; max-width: none; }
    .comment-excerpt { max-width: 160px; }
    .action-buttons { flex-direction: column; gap: var(--space-1, 0.25rem); }
  }

  @media (max-width: 480px) {
    .admin-page-header h1 { font-size: 1.5rem; }
    .summary-chip { width: 100%; justify-content: center; }
  }
</style>

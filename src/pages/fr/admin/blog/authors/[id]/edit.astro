---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Switch from "@components/ui/Form/Switch.astro";
import MarkdownEditor from "@components/admin/MarkdownEditor.astro";
import MediaPickerModal from "@components/admin/MediaPickerModal.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogAuthors, blogOrganizations, blogPostAuthors } from "@database/schemas";
import { eq, count } from "drizzle-orm";

const currentLocale = Astro.currentLocale || "fr";
const adminBase = `/${currentLocale}/admin/blog/authors`;

const { id } = Astro.params;
if (!id) return Astro.redirect(adminBase);

const db = await getDrizzle();
const [author] = await db.select().from(blogAuthors).where(eq(blogAuthors.id, id));
if (!author) return Astro.redirect(adminBase);

const [articleCount] = await db.select({ value: count() }).from(blogPostAuthors).where(eq(blogPostAuthors.authorId, id));
const allOrgs = await db.select({ id: blogOrganizations.id, name: blogOrganizations.name }).from(blogOrganizations).orderBy(blogOrganizations.name);

const extractLocalized = (value: unknown, locale: string = currentLocale): string => {
  if (typeof value === "string") return value;
  if (value && typeof value === "object") { const obj = value as Record<string, string>; return obj[locale] || Object.values(obj)[0] || ""; }
  return "";
};

const getLocalizedValue = (value: unknown, locale: string): string => {
  if (typeof value === "string") return locale === currentLocale ? value : "";
  if (value && typeof value === "object") return (value as Record<string, string>)[locale] || "";
  return "";
};

const supportedLocales = [
  { code: "fr", label: "Français", flag: "🇫🇷" },
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "ar", label: "العربية", flag: "🇸🇦" },
];

const hasContent = (value: unknown, locale: string): boolean => {
  if (!value) return false;
  if (typeof value === "string") return locale === currentLocale && !!value;
  if (typeof value === "object") return !!(value as Record<string, string>)[locale];
  return false;
};

const sameAsArray: string[] = Array.isArray(author.sameAs)
  ? author.sameAs
  : typeof author.sameAs === "string" ? [author.sameAs] : [];

const frontendUrl = `/${currentLocale}/blog/auteur/${author.slug}`;
---

<AdminLayout title={`Modifier — ${extractLocalized(author.displayName)}`} activeSection="blog-authors">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <a href={adminBase} class="back-link"><Icon name="mdi:arrow-left" /></a>
        <h1>Modifier l'auteur</h1>
        <Badge color="primary" text={author.slug} />
      </div>
      <div class="admin-page-actions">
        <Badge color="default" text={`${articleCount.value} article${articleCount.value > 1 ? "s" : ""}`} />
        <a href={frontendUrl} target="_blank" rel="noopener" class="btn-view-site" title="Voir sur le site">
          <Icon name="mdi:open-in-new" />
          <span>Voir sur le site</span>
        </a>
      </div>
    </div>
    <p class="admin-page-subtitle">Mettez à jour le profil, la visibilité et le contenu multilingue.</p>
  </header>

  <form id="author-form" class="author-form">
    <input type="hidden" id="author-id" value={author.id} />
    <div class="form-layout">
      <div class="form-main">

        <!-- Multilingual -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:translate" class="card-title-icon" />
              <span>Contenu multilingue</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="locale-tabs" role="tablist">
              {supportedLocales.map((loc, i) => (
                <button type="button" role="tab" class:list={["locale-tab", { active: i === 0 }]} data-locale={loc.code} aria-selected={i === 0 ? "true" : "false"}>
                  <span class="locale-flag">{loc.flag}</span>
                  {loc.label}
                  {hasContent(author.displayName, loc.code) && <span class="locale-dot" />}
                </button>
              ))}
            </div>

            {supportedLocales.map((loc, i) => (
              <div class:list={["locale-panel", { active: i === 0 }]} data-locale-panel={loc.code}>
                <div class="form-row">
                  <div class="form-field">
                    <Label htmlFor={`displayName-${loc.code}`}>Nom affiché *</Label>
                    <Input id={`displayName-${loc.code}`} name={`displayName-${loc.code}`} value={getLocalizedValue(author.displayName, loc.code)} placeholder={`Nom en ${loc.label}…`} />
                  </div>
                </div>
                <div class="form-row form-row--2">
                  <div class="form-field">
                    <Label htmlFor={`givenName-${loc.code}`}>Prénom</Label>
                    <Input id={`givenName-${loc.code}`} name={`givenName-${loc.code}`} value={getLocalizedValue(author.givenName, loc.code)} />
                  </div>
                  <div class="form-field">
                    <Label htmlFor={`familyName-${loc.code}`}>Nom de famille</Label>
                    <Input id={`familyName-${loc.code}`} name={`familyName-${loc.code}`} value={getLocalizedValue(author.familyName, loc.code)} />
                  </div>
                </div>
                <div class="form-field">
                  <Label htmlFor={`jobTitle-${loc.code}`}>Titre / Poste</Label>
                  <Input id={`jobTitle-${loc.code}`} name={`jobTitle-${loc.code}`} value={getLocalizedValue(author.jobTitle, loc.code)} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`bio-${loc.code}`}>Biographie</Label>
                  <MarkdownEditor id={`bio-${loc.code}`} name={`bio-${loc.code}`} rows={4} value={getLocalizedValue(author.bio, loc.code)} minimal />
                </div>

                <details class="seo-section">
                  <summary class="seo-toggle">
                    <Icon name="mdi:search-web" class="seo-icon" />
                    SEO — {loc.label}
                  </summary>
                  <div class="seo-fields">
                    <div class="form-field">
                      <Label htmlFor={`seo-title-${loc.code}`}>Titre SEO</Label>
                      <Input id={`seo-title-${loc.code}`} name={`seo-title-${loc.code}`} value={getLocalizedValue(author.seoTitle, loc.code)} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-desc-${loc.code}`}>Description SEO</Label>
                      <Textarea id={`seo-desc-${loc.code}`} name={`seo-desc-${loc.code}`} rows={2}>{getLocalizedValue(author.seoDescription, loc.code)}</Textarea>
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-keywords-${loc.code}`}>Mots-clés SEO</Label>
                      <Input id={`seo-keywords-${loc.code}`} name={`seo-keywords-${loc.code}`} value={getLocalizedValue(author.seoKeywords, loc.code)} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`canonical-${loc.code}`}>URL canonique</Label>
                      <Input id={`canonical-${loc.code}`} name={`canonical-${loc.code}`} type="url" value={getLocalizedValue(author.canonicalUrl, loc.code)} />
                    </div>
                  </div>
                </details>
              </div>
            ))}
          </CardContent>
        </Card>

        <!-- Contact & social -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:link-variant" class="card-title-icon" />
              <span>Contact & réseaux</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-row form-row--2">
              <div class="form-field">
                <Label htmlFor="email">Email</Label>
                <Input id="email" name="email" type="email" value={author.email ?? ""} />
              </div>
              <div class="form-field">
                <Label htmlFor="website">Site web</Label>
                <Input id="website" name="website" type="url" value={author.website ?? ""} />
              </div>
            </div>
            <div class="form-field">
              <Label htmlFor="sameAs">Profils sociaux (un par ligne)</Label>
              <Textarea id="sameAs" name="sameAs" rows={3}>{sameAsArray.join("\n")}</Textarea>
              <span class="field-hint">URLs de profils sociaux, une par ligne.</span>
            </div>
          </CardContent>
        </Card>

        <!-- Avatar -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:account-circle-outline" class="card-title-icon" />
              <span>Photo / Avatar</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="upload-zone" id="upload-zone">
              <div class="upload-actions-row">
                <button type="button" class="btn-pick-media" id="btn-pick-media">
                  <span class="pick-icon" aria-hidden="true"></span>
                  Bibliothèque
                </button>
                <span class="upload-separator">ou</span>
                <label class="btn-upload-file">
                  <Icon name="mdi:cloud-upload-outline" />
                  Uploader
                  <input type="file" id="image-input" accept="image/jpeg,image/png,image/webp,image/avif" class="upload-file-input" />
                </label>
              </div>
              <div class="upload-preview" id="upload-preview" style={author.avatarUrl ? "" : "display:none"}>
                <img id="preview-img" src={author.avatarUrl ?? ""} alt="Aperçu" />
                <button type="button" class="upload-remove" id="remove-image" title="Retirer l'image">
                  <Icon name="mdi:close-circle" />
                </button>
              </div>
            </div>
            <input type="hidden" id="avatar-id" name="avatarId" value={author.avatarId ?? ""} />
            <input type="hidden" id="avatar-url" name="avatarUrl" value={author.avatarUrl ?? ""} />
          </CardContent>
        </Card>

        <!-- Danger zone -->
        <Card elevation="sm" className="danger-card">
          <CardHeader>
            <div class="card-title-row card-title-danger">
              <Icon name="mdi:alert-outline" class="card-title-icon" />
              <span>Zone de danger</span>
            </div>
          </CardHeader>
          <CardContent>
            <p class="danger-text">La suppression est irréversible. Les associations articles-auteurs seront supprimées.</p>
            <Button type="button" color="error" id="btn-delete" icon={{ name: "mdi:delete-outline", side: "left" }}>
              Supprimer cet auteur
            </Button>
          </CardContent>
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="form-sidebar">
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:cog-outline" class="card-title-icon" />
              <span>Paramètres</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="slug">Slug *</Label>
              <div class="slug-row">
                <Input id="slug" name="slug" value={author.slug} />
                <button type="button" id="generate-slug" class="slug-btn" title="Générer depuis le nom FR">
                  <Icon name="mdi:auto-fix" />
                </button>
              </div>
              <span class="field-hint">URL : /blog/auteur/<strong id="slug-preview">{author.slug}</strong></span>
            </div>

            {allOrgs.length > 0 && (
              <div class="form-field">
                <Label htmlFor="worksFor">Organisation</Label>
                <select id="worksFor" name="worksForId" class="select-native">
                  <option value="">Aucune</option>
                  {allOrgs.map((org) => (
                    <option value={org.id} selected={org.id === author.worksForId}>{extractLocalized(org.name)}</option>
                  ))}
                </select>
              </div>
            )}

            <div class="switch-group">
              <div class="switch-item">
                <Switch id="is-featured" name="isFeatured" checked={author.isFeatured ?? false} />
                <Label htmlFor="is-featured">Featured</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-home" name="displayInHome" checked={author.displayInHome ?? false} />
                <Label htmlFor="display-home">Afficher en accueil</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-blog" name="displayInBlog" checked={author.displayInBlog !== false} />
                <Label htmlFor="display-blog">Afficher dans le blog</Label>
              </div>
            </div>
          </CardContent>
        </Card>

        <div class="action-bar">
          <a href={adminBase} class="action-cancel">Annuler</a>
          <Button type="button" color="primary" id="btn-save" icon={{ name: "mdi:content-save-outline", side: "left" }}>
            Enregistrer
          </Button>
        </div>

        <!-- Metadata -->
        <Card elevation="sm">
          <CardContent>
            <div class="meta-list">
              <div class="meta-item">
                <span class="meta-label">ID</span>
                <code class="meta-value">{author.id}</code>
              </div>
              <div class="meta-item">
                <span class="meta-label">Créé le</span>
                <span class="meta-value">{author.createdAt.toLocaleDateString(currentLocale, { day: "2-digit", month: "long", year: "numeric" })}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Modifié le</span>
                <span class="meta-value">{author.updatedAt.toLocaleDateString(currentLocale, { day: "2-digit", month: "long", year: "numeric" })}</span>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  </form>
  <MediaPickerModal />
</AdminLayout>

<script>
  import { initMarkdownEditors } from "@lib/admin/markdown-editor";
  import { openMediaPicker } from "@lib/admin/media-picker";
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    // Init markdown editors
    const editors = initMarkdownEditors();

    const authorId = (document.getElementById("author-id") as HTMLInputElement).value;

    // Locale tabs
    const tabs = document.querySelectorAll<HTMLElement>(".locale-tab");
    const panels = document.querySelectorAll<HTMLElement>(".locale-panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const locale = tab.dataset.locale!;
        tabs.forEach((t) => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
        panels.forEach((p) => p.classList.remove("active"));
        tab.classList.add("active"); tab.setAttribute("aria-selected", "true");
        document.querySelector(`[data-locale-panel="${locale}"]`)?.classList.add("active");
      });
    });

    // Slug
    const nameInput = document.getElementById("displayName-fr") as HTMLInputElement | null;
    const slugInput = document.getElementById("slug") as HTMLInputElement | null;
    const slugPreview = document.getElementById("slug-preview");
    const generateSlugBtn = document.getElementById("generate-slug");
    const slugify = (text: string): string => text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
    generateSlugBtn?.addEventListener("click", () => {
      if (nameInput && slugInput) { slugInput.value = slugify(nameInput.value); if (slugPreview) slugPreview.textContent = slugInput.value || "…"; }
    });
    slugInput?.addEventListener("input", () => { if (slugPreview) slugPreview.textContent = slugInput.value || "…"; });

    // Image upload
    const uploadZone = document.getElementById("upload-zone");
    const imageInput = document.getElementById("image-input") as HTMLInputElement;
    const uploadPreview = document.getElementById("upload-preview");
    const previewImg = document.getElementById("preview-img") as HTMLImageElement;
    const removeImageBtn = document.getElementById("remove-image");
    const avatarIdEl = document.getElementById("avatar-id") as HTMLInputElement;
    const avatarUrlEl = document.getElementById("avatar-url") as HTMLInputElement;

    function setAvatarPreview(id: string, url: string) {
      avatarIdEl.value = id; avatarUrlEl.value = url;
      previewImg.src = url; uploadPreview!.style.display = "block";
    }

    function clearAvatarPreview() {
      avatarIdEl.value = ""; avatarUrlEl.value = "";
      uploadPreview!.style.display = "none"; previewImg.src = "";
    }

    // Media library picker
    document.getElementById("btn-pick-media")?.addEventListener("click", async () => {
      const result = await openMediaPicker();
      if (result) setAvatarPreview(result.id, result.url);
    });

    // Upload via modal (with metadata form)
    imageInput?.addEventListener("change", async () => {
      const file = imageInput.files?.[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setAvatarPreview(result.id, result.url);
      }
      imageInput.value = "";
    });

    // Drag & drop → open modal with file
    uploadZone?.addEventListener("dragover", (e) => { e.preventDefault(); uploadZone.classList.add("dragover"); });
    uploadZone?.addEventListener("dragleave", () => uploadZone.classList.remove("dragover"));
    uploadZone?.addEventListener("drop", async (e) => {
      e.preventDefault(); uploadZone.classList.remove("dragover");
      const file = e.dataTransfer?.files[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setAvatarPreview(result.id, result.url);
      }
    });

    removeImageBtn?.addEventListener("click", (e) => {
      e.stopPropagation(); clearAvatarPreview();
    });

    // Save
    const btnSave = document.getElementById("btn-save");
    btnSave?.addEventListener("click", async () => {
      const slug = (document.getElementById("slug") as HTMLInputElement).value.trim();
      if (!slug) { showToast("Le slug est obligatoire.", "warning"); return; }

      // Sync markdown editors to underlying textareas
      editors.forEach((editor) => (editor.codemirror as any).save());

      const locales = ["fr", "en", "es", "ar"];
      const collect = (prefix: string) => {
        const obj: Record<string, string> = {};
        locales.forEach((loc) => { const el = document.getElementById(`${prefix}-${loc}`) as HTMLInputElement | HTMLTextAreaElement | null; const v = el?.value.trim(); if (v) obj[loc] = v; });
        return Object.keys(obj).length > 0 ? obj : null;
      };

      const sameAsRaw = (document.getElementById("sameAs") as HTMLTextAreaElement)?.value.trim();
      const sameAs = sameAsRaw ? sameAsRaw.split("\n").map((s: string) => s.trim()).filter(Boolean) : null;

      const payload: Record<string, unknown> = {
        action: "update",
        id: authorId,
        slug,
        displayName: collect("displayName"),
        givenName: collect("givenName"),
        familyName: collect("familyName"),
        jobTitle: collect("jobTitle"),
        bio: collect("bio"),
        email: (document.getElementById("email") as HTMLInputElement)?.value.trim() || null,
        website: (document.getElementById("website") as HTMLInputElement)?.value.trim() || null,
        sameAs,
        avatarId: avatarIdEl.value || null,
        avatarUrl: avatarUrlEl.value || null,
        worksForId: (document.getElementById("worksFor") as HTMLSelectElement)?.value || null,
        isFeatured: (document.getElementById("is-featured") as HTMLInputElement).checked,
        displayInHome: (document.getElementById("display-home") as HTMLInputElement).checked,
        displayInBlog: (document.getElementById("display-blog") as HTMLInputElement).checked,
        seoTitle: collect("seo-title"),
        seoDescription: collect("seo-desc"),
        seoKeywords: collect("seo-keywords"),
        canonicalUrl: collect("canonical"),
      };

      btnSave.setAttribute("disabled", "true");
      btnSave.textContent = "Enregistrement…";
      try {
        const res = await fetch("/api/admin/blog/authors", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) });
        const data = await res.json();
        if (data.ok) {
          showToast("Auteur enregistré avec succès ! Rechargement…", "success");
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || "Erreur lors de l'enregistrement.", "error");
          btnSave.removeAttribute("disabled"); btnSave.textContent = "Enregistrer";
        }
      } catch {
        showToast("Erreur réseau — vérifiez votre connexion.", "error");
        btnSave.removeAttribute("disabled"); btnSave.textContent = "Enregistrer";
      }
    });

    // Delete
    const btnDelete = document.getElementById("btn-delete");
    btnDelete?.addEventListener("click", async () => {
      if (!confirm("Supprimer définitivement cet auteur ? Cette action est irréversible.")) return;
      btnDelete.setAttribute("disabled", "true");
      try {
        const res = await fetch("/api/admin/blog/authors", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ action: "delete", id: authorId }) });
        if (res.ok) {
          showToast("Auteur supprimé. Redirection…", "success");
          setTimeout(() => { window.location.href = window.location.pathname.replace(`/${authorId}/edit`, ""); }, 1000);
        }
        else { const data = await res.json(); showToast(data.error || "Erreur lors de la suppression.", "error"); btnDelete.removeAttribute("disabled"); }
      } catch { showToast("Erreur réseau.", "error"); btnDelete.removeAttribute("disabled"); }
    });
  });
</script>

<style>
  .admin-page-header { margin-bottom: var(--space-6, 1.5rem); }
  .admin-page-title-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3, 0.75rem); }
  .admin-page-title-group { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-actions { display: flex; align-items: center; gap: var(--space-2, 0.5rem); }
  .btn-view-site {
    display: inline-flex; align-items: center; gap: var(--space-1, 0.25rem);
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    font-size: 0.8125rem; font-weight: 600; text-decoration: none;
    color: var(--color-primary, #eab308); border: 1px solid var(--color-primary, #eab308);
    border-radius: var(--border-radius-md, 0.375rem);
    background: transparent; transition: all 0.15s;
  }
  .btn-view-site:hover { background: var(--color-primary, #eab308); color: var(--bg-surface, #fff); }
  .btn-view-site [data-icon] { width: 0.875rem; height: 0.875rem; }
  .admin-page-header h1 { font-family: var(--font-family-display, "Space Grotesk", sans-serif); font-size: var(--h2-font-size, 2rem); font-weight: 800; color: var(--heading-color, #0f172a); margin: 0; }
  .admin-page-subtitle { color: var(--text-muted, #64748b); font-size: 0.9375rem; margin: var(--space-1, 0.25rem) 0 0; }
  .back-link { display: inline-flex; align-items: center; padding: var(--space-2, 0.5rem); border-radius: var(--border-radius-md, 0.375rem); color: var(--text-muted, #64748b); transition: color 0.15s, background 0.15s; }
  .back-link:hover { color: var(--text-default, #0f172a); background: var(--bg-inset, #f1f5f9); }
  .back-link [data-icon] { width: 1.25rem; height: 1.25rem; }

  .form-layout { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-6, 1.5rem); align-items: start; }
  .form-main { display: flex; flex-direction: column; gap: var(--space-4, 1rem); }
  .form-sidebar { display: flex; flex-direction: column; gap: var(--space-4, 1rem); position: sticky; top: var(--space-4, 1rem); }

  .card-title-row { display: flex; align-items: center; gap: var(--space-2, 0.5rem); font-weight: 700; font-size: 0.9375rem; color: var(--heading-color, #0f172a); }
  .card-title-icon { width: 1.125rem; height: 1.125rem; color: var(--color-primary, #eab308); }
  .card-title-danger .card-title-icon { color: var(--color-danger, #dc2626); }

  .form-field { margin-bottom: var(--space-3, 0.75rem); }
  .form-field:last-child { margin-bottom: 0; }
  .form-row { margin-bottom: var(--space-3, 0.75rem); }

---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Switch from "@components/ui/Form/Switch.astro";
import Checkbox from "@components/ui/Form/Checkbox.astro";
import MarkdownEditor from "@components/admin/MarkdownEditor.astro";
import MediaPickerModal from "@components/admin/MediaPickerModal.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import {
  blogPosts,
  blogTranslations,
  blogPostAuthors,
  blogPostCategories,
  blogPostMedia,
  blogCategories,
  blogAuthors,
} from "@database/schemas";
import { eq, inArray } from "drizzle-orm";

import tData from "@i18n/fr.json";
const currentLocale = Astro.currentLocale || "fr";
const t = tData;
const adminBase = `/${currentLocale}/admin/blog/articles`;

const articleId = Astro.params.id;
if (!articleId) return Astro.redirect(adminBase);

const db = await getDrizzle();

// Load article
const [article] = await db.select().from(blogPosts).where(eq(blogPosts.id, articleId));
if (!article) return Astro.redirect(adminBase);

// Load translations
const translations = await db.select().from(blogTranslations).where(eq(blogTranslations.postId, articleId));
const translationsByLocale = new Map<string, typeof translations[0]>();
translations.forEach((tr) => translationsByLocale.set(tr.inLanguage, tr));

// Load relations
const postAuthorRows = await db.select().from(blogPostAuthors).where(eq(blogPostAuthors.postId, articleId));
const postCategoryRows = await db.select().from(blogPostCategories).where(eq(blogPostCategories.postId, articleId));
const postMediaRows = await db.select().from(blogPostMedia).where(eq(blogPostMedia.postId, articleId));

const selectedAuthorIds = new Set(postAuthorRows.map((r) => r.authorId));
const selectedCategoryIds = new Set(postCategoryRows.map((r) => r.categoryId));
const coverMedia = postMediaRows.find((m) => m.type === "cover");

// Load all categories and authors for selectors
const allCategories = await db
  .select({ id: blogCategories.id, slug: blogCategories.slug, name: blogCategories.name })
  .from(blogCategories).orderBy(blogCategories.slug);

const allAuthors = await db
  .select({ id: blogAuthors.id, displayName: blogAuthors.displayName, slug: blogAuthors.slug })
  .from(blogAuthors).orderBy(blogAuthors.slug);

const extractLocalized = (value: unknown, locale: string = currentLocale): string => {
  if (typeof value === "string") return value;
  if (value && typeof value === "object") {
    const obj = value as Record<string, string>;
    return obj[locale] || Object.values(obj)[0] || "";
  }
  return "";
};

const getTranslationField = (locale: string, field: string): string => {
  const tr = translationsByLocale.get(locale);
  if (!tr) return "";
  const val = (tr as any)[field];
  if (typeof val === "string") return val;
  if (val && typeof val === "object") {
    return (val as Record<string, string>)[locale] || Object.values(val as Record<string, string>)[0] || "";
  }
  return "";
};

const supportedLocales = [
  { code: "fr", label: "Français", flag: "🇫🇷" },
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "ar", label: "العربية", flag: "🇸🇦" },
];

const statusBadge = (s: string) => {
  if (s === "published") return { color: "success" as const, text: "Publié" };
  if (s === "draft") return { color: "warning" as const, text: "Brouillon" };
  if (s === "scheduled") return { color: "accent" as const, text: "Planifié" };
  if (s === "archived") return { color: "default" as const, text: "Archivé" };
  return { color: "default" as const, text: s };
};
const sb = statusBadge(article.status);

// Build frontend URL
const firstCategory = allCategories.find((c) => selectedCategoryIds.has(c.id));
const frontendUrl = firstCategory ? `/${currentLocale}/blog/${firstCategory.slug}/${article.slug}` : null;
---

<AdminLayout title={`Éditer — ${extractLocalized(translationsByLocale.get(currentLocale)?.headline) || article.slug}`} activeSection="blog-articles">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <a href={adminBase} class="back-link"><Icon name="mdi:arrow-left" /></a>
        <h1>Éditer l'article</h1>
        <Badge color={sb.color} text={sb.text} />
      </div>
      <div class="admin-page-actions">
        {frontendUrl && (
          <a href={frontendUrl} target="_blank" rel="noopener" class="btn-view-site" title="Voir sur le site">
            <Icon name="mdi:open-in-new" />
            <span>Voir sur le site</span>
          </a>
        )}
      </div>
    </div>
    <p class="admin-page-subtitle">
      Slug : <code class="inline-slug">{article.slug}</code> — Créé le {article.createdAt.toLocaleDateString(currentLocale)}
    </p>
  </header>

  <form id="article-form" class="article-form" data-article-id={articleId}>
    <div class="form-layout">
      <!-- Main content column -->
      <div class="form-main">
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:translate" class="card-title-icon" />
              <span>Contenu multilingue</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="locale-tabs" role="tablist">
              {supportedLocales.map((loc, i) => {
                const hasContent = translationsByLocale.has(loc.code);
                return (
                  <button
                    type="button" role="tab"
                    class:list={["locale-tab", { active: i === 0 }]}
                    data-locale={loc.code} aria-selected={i === 0 ? "true" : "false"}
                  >
                    <span class="locale-flag">{loc.flag}</span>
                    {loc.label}
                    {hasContent && <span class="locale-dot" title="Traduction existante"></span>}
                  </button>
                );
              })}
            </div>

            {supportedLocales.map((loc, i) => (
              <div class:list={["locale-panel", { active: i === 0 }]} data-locale-panel={loc.code}>
                <div class="form-field">
                  <Label htmlFor={`headline-${loc.code}`}>Titre *</Label>
                  <Input id={`headline-${loc.code}`} name={`headline-${loc.code}`} value={getTranslationField(loc.code, "headline")} placeholder={`Titre en ${loc.label}…`} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`alt-headline-${loc.code}`}>Sous-titre</Label>
                  <Input id={`alt-headline-${loc.code}`} name={`alt-headline-${loc.code}`} value={getTranslationField(loc.code, "alternativeHeadline")} placeholder="Sous-titre optionnel…" />
                </div>
                <div class="form-field">
                  <Label htmlFor={`excerpt-${loc.code}`}>Extrait *</Label>
                  <Textarea id={`excerpt-${loc.code}`} name={`excerpt-${loc.code}`} rows={3} value={getTranslationField(loc.code, "excerpt")} placeholder={`Résumé court en ${loc.label}…`} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`body-${loc.code}`}>Contenu (Markdown) *</Label>
                  <MarkdownEditor id={`body-${loc.code}`} name={`body-${loc.code}`} rows={16} value={getTranslationField(loc.code, "articleBody")} placeholder="Écrivez votre article en Markdown…" />
                </div>

                <details class="seo-section">
                  <summary class="seo-summary">
                    <Icon name="mdi:search-web" class="seo-icon" /> SEO — {loc.label}
                  </summary>
                  <div class="seo-fields">
                    <div class="form-field">
                      <Label htmlFor={`seo-title-${loc.code}`}>Titre SEO</Label>
                      <Input id={`seo-title-${loc.code}`} name={`seo-title-${loc.code}`} value={getTranslationField(loc.code, "seoTitle")} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-desc-${loc.code}`}>Description SEO</Label>
                      <Textarea id={`seo-desc-${loc.code}`} name={`seo-desc-${loc.code}`} rows={2} value={getTranslationField(loc.code, "seoDescription")} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-keywords-${loc.code}`}>Mots-clés SEO</Label>
                      <Input id={`seo-keywords-${loc.code}`} name={`seo-keywords-${loc.code}`} value={getTranslationField(loc.code, "seoKeywords")} />
                    </div>
                  </div>
                </details>
              </div>
            ))}
          </CardContent>
        </Card>

        <!-- Media -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:image-multiple-outline" class="card-title-icon" />
              <span>Image de couverture</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="upload-zone" id="upload-zone">
              <div class="upload-actions-row">
                <button type="button" id="btn-pick-media" class="btn-pick-media">
                  <Icon name="mdi:image-search-outline" class="pick-icon" />
                  Bibliothèque
                </button>
                <span class="upload-separator">ou</span>
                <label for="cover-upload" class="btn-upload-file">
                  <Icon name="mdi:cloud-upload-outline" class="pick-icon" />
                  Uploader
                </label>
              </div>
              <input type="file" id="cover-upload" accept="image/*" class="upload-input" />
              <div id="upload-preview" class:list={["upload-preview", { hidden: !coverMedia }]}>
                {coverMedia && (
                  <Fragment>
                    <span id="current-cover-id" data-cover-id={coverMedia.mediaId}></span>
                  </Fragment>
                )}
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="form-sidebar">
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:cog-outline" class="card-title-icon" />
              <span>Publication</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="slug">Slug *</Label>
              <Input id="slug" name="slug" value={article.slug} />
            </div>
            <div class="form-field">
              <Label htmlFor="status">Statut</Label>
              <Select id="status" name="status">
                <option value="draft" selected={article.status === "draft"}>Brouillon</option>
                <option value="published" selected={article.status === "published"}>Publié</option>
                <option value="scheduled" selected={article.status === "scheduled"}>Planifié</option>
                <option value="archived" selected={article.status === "archived"}>Archivé</option>
              </Select>
            </div>
            <div class="form-field">
              <Label htmlFor="in-language">Langue principale</Label>
              <Select id="in-language" name="in-language">
                {supportedLocales.map((loc) => (
                  <option value={loc.code} selected={loc.code === article.inLanguage}>{loc.flag} {loc.label}</option>
                ))}
              </Select>
            </div>

            <div class="toggle-group">
              <div class="toggle-row">
                <Switch id="is-featured" name="is-featured" checked={article.isFeatured} />
                <Label htmlFor="is-featured">Featured</Label>
              </div>
              <div class="toggle-row">
                <Switch id="display-home" name="display-home" checked={article.displayInHome} />
                <Label htmlFor="display-home">Page d'accueil</Label>
              </div>
              <div class="toggle-row">
                <Switch id="display-blog" name="display-blog" checked={article.displayInBlog} />
                <Label htmlFor="display-blog">Visible blog</Label>
              </div>
              <div class="toggle-row">
                <Switch id="allow-comments" name="allow-comments" checked={article.allowComments} />
                <Label htmlFor="allow-comments">Commentaires</Label>
              </div>
            </div>
          </CardContent>
        </Card>

        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:tag-multiple-outline" class="card-title-icon" />
              <span>Catégories</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="checkbox-list">
              {allCategories.map((cat) => (
                <div class="checkbox-item">
                  <Checkbox id={`cat-${cat.id}`} name="categories" value={cat.id} checked={selectedCategoryIds.has(cat.id)} />
                  <Label htmlFor={`cat-${cat.id}`}>{extractLocalized(cat.name)}</Label>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>

        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:account-multiple-outline" class="card-title-icon" />
              <span>Auteurs</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="checkbox-list">
              {allAuthors.map((author) => (
                <div class="checkbox-item">
                  <Checkbox id={`author-${author.id}`} name="authors" value={author.id} checked={selectedAuthorIds.has(author.id)} />
                  <Label htmlFor={`author-${author.id}`}>{extractLocalized(author.displayName)}</Label>
                </div>
              ))}
            </div>
          </CardContent>
        </Card>

        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:information-outline" class="card-title-icon" />
              <span>Métadonnées</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="reading-time">Temps de lecture</Label>
              <Input id="reading-time" name="reading-time" value={article.readingTime || ""} placeholder="5 min" />
            </div>
            <div class="form-field">
              <Label htmlFor="license">Licence</Label>
              <Input id="license" name="license" value={article.license || ""} placeholder="CC-BY-4.0" />
            </div>
          </CardContent>
        </Card>

        <!-- Danger zone -->
        <Card elevation="sm" className="danger-card">
          <CardContent>
            <details>
              <summary class="danger-summary">
                <Icon name="mdi:alert-outline" class="danger-icon" />
                Zone dangereuse
              </summary>
              <div class="danger-actions">
                <button type="button" id="btn-delete" class="btn-danger">
                  <Icon name="mdi:delete-outline" /> Supprimer cet article
                </button>
              </div>
            </details>
          </CardContent>
        </Card>
      </div>
    </div>

    <!-- Action bar -->
    <div class="form-actions">
      <a href={adminBase} class="btn-cancel">Retour à la liste</a>
      <div class="form-actions-right">
        <button type="button" id="btn-save" class="btn-primary">
          <Icon name="mdi:content-save-outline" /> Enregistrer
        </button>
      </div>
    </div>
  </form>
  <MediaPickerModal />
</AdminLayout>

<script>
  import { initMarkdownEditors, getEditorValue } from "@lib/admin/markdown-editor";
  import { openMediaPicker } from "@lib/admin/media-picker";
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    const articleId = document.getElementById("article-form")?.dataset.articleId;

    // Initialize WYSIWYG editors
    const editors = initMarkdownEditors();

    // Locale tabs
    const tabs = document.querySelectorAll<HTMLElement>(".locale-tab");
    const panels = document.querySelectorAll<HTMLElement>(".locale-panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const locale = tab.dataset.locale!;
        tabs.forEach((t) => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
        panels.forEach((p) => p.classList.remove("active"));
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        document.querySelector(`[data-locale-panel="${locale}"]`)?.classList.add("active");
      });
    });

    // Cover image
    const coverInput = document.getElementById("cover-upload") as HTMLInputElement;
    const preview = document.getElementById("upload-preview") as HTMLElement;
    let coverId = document.getElementById("current-cover-id")?.dataset.coverId || null;

    function setCoverPreview(id: string, url: string) {
      coverId = id;
      preview.innerHTML = `<img src="${url}" alt="Preview" /><button type="button" class="remove-preview" title="Retirer">&times;</button>`;
      preview.classList.remove("hidden");
      preview.querySelector(".remove-preview")?.addEventListener("click", () => {
        coverId = null;
        preview.innerHTML = "";
        preview.classList.add("hidden");
        coverInput.value = "";
      });
    }

    // Media library picker
    document.getElementById("btn-pick-media")?.addEventListener("click", async () => {
      const result = await openMediaPicker();
      if (result) setCoverPreview(result.id, result.url);
    });

    // Upload via modal (with metadata form)
    coverInput?.addEventListener("change", async () => {
      const file = coverInput.files?.[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setCoverPreview(result.id, result.url);
      }
      coverInput.value = "";
    });

    const locales = ["fr", "en", "es", "ar"];

    function collectData() {
      const slug = (document.getElementById("slug") as HTMLInputElement).value.trim();
      const status = (document.getElementById("status") as HTMLSelectElement).value;
      const inLanguage = (document.getElementById("in-language") as HTMLSelectElement).value;
      const isFeatured = (document.getElementById("is-featured") as HTMLInputElement).checked;
      const displayInHome = (document.getElementById("display-home") as HTMLInputElement).checked;
      const displayInBlog = (document.getElementById("display-blog") as HTMLInputElement).checked;
      const allowComments = (document.getElementById("allow-comments") as HTMLInputElement).checked;
      const readingTime = (document.getElementById("reading-time") as HTMLInputElement).value.trim();
      const license = (document.getElementById("license") as HTMLInputElement).value.trim();

      const categoryIds = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="categories"]:checked')).map((cb) => cb.value);
      const authorIds = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="authors"]:checked')).map((cb) => cb.value);

      const translations: any[] = [];
      for (const loc of locales) {
        const headline = (document.getElementById(`headline-${loc}`) as HTMLInputElement)?.value.trim();
        const body = getEditorValue(editors, `body-${loc}`).trim();
        const excerpt = (document.getElementById(`excerpt-${loc}`) as HTMLTextAreaElement)?.value.trim();
        if (headline || body || excerpt) {
          translations.push({
            inLanguage: loc,
            headline: headline || "",
            alternativeHeadline: (document.getElementById(`alt-headline-${loc}`) as HTMLInputElement)?.value.trim() || "",
            articleBody: body || "",
            excerpt: excerpt || "",
            seoTitle: (document.getElementById(`seo-title-${loc}`) as HTMLInputElement)?.value.trim() || "",
            seoDescription: (document.getElementById(`seo-desc-${loc}`) as HTMLTextAreaElement)?.value.trim() || "",
            seoKeywords: (document.getElementById(`seo-keywords-${loc}`) as HTMLInputElement)?.value.trim() || "",
          });
        }
      }

      const media: any[] = [];
      if (coverId) media.push({ mediaId: coverId, type: "cover", position: "0" });

      return {
        action: "update",
        id: articleId,
        slug,
        status,
        inLanguage,
        isFeatured,
        displayInHome,
        displayInBlog,
        allowComments,
        readingTime: readingTime || undefined,
        license: license || undefined,
        translations,
        categoryIds,
        authorIds,
        media,
      };
    }

    // Save
    document.getElementById("btn-save")?.addEventListener("click", async () => {
      const headline = (document.getElementById("headline-fr") as HTMLInputElement)?.value.trim();
      if (!headline) {
        showToast("Le titre en français est obligatoire.", "warning");
        document.querySelector<HTMLElement>('[data-locale="fr"]')?.click();
        document.getElementById("headline-fr")?.focus();
        return;
      }

      const btn = document.getElementById("btn-save") as HTMLButtonElement;
      btn.disabled = true;
      try {
        const res = await fetch("/api/admin/blog/articles", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(collectData()),
        });
        const data = await res.json();
        if (data.ok) {
          showToast("Article enregistré avec succès ! Rechargement…", "success");
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || "Erreur lors de l'enregistrement.", "error");
        }
      } catch { showToast("Erreur réseau — vérifiez votre connexion.", "error"); }
      finally { btn.disabled = false; }
    });

    // Delete
    document.getElementById("btn-delete")?.addEventListener("click", async () => {
      if (!confirm("Supprimer définitivement cet article et toutes ses traductions ? Cette action est irréversible.")) return;
      try {
        const res = await fetch("/api/admin/blog/articles", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "delete", id: articleId }),
        });
        const data = await res.json();
        if (data.ok) {
          showToast("Article supprimé. Redirection…", "success");
          setTimeout(() => {
            window.location.href = document.querySelector<HTMLAnchorElement>(".back-link")?.href || window.location.pathname.replace(/\/[^/]+\/edit$/, "");
          }, 1000);
        } else {
          showToast(data.error || "Erreur lors de la suppression.", "error");
        }
      } catch { showToast("Erreur réseau.", "error"); }
    });
  });
</script>

<style>
  .admin-page-header { margin-bottom: var(--space-6, 1.5rem); }
  .admin-page-title-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3, 0.75rem); }
  .admin-page-title-group { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-actions { display: flex; align-items: center; gap: var(--space-2, 0.5rem); }
  .btn-view-site {
    display: inline-flex; align-items: center; gap: var(--space-1, 0.25rem);
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    font-size: 0.8125rem; font-weight: 600; text-decoration: none;
    color: var(--color-primary, #eab308); border: 1px solid var(--color-primary, #eab308);
    border-radius: var(--border-radius-md, 0.375rem);
    background: transparent; transition: all 0.15s;
  }
  .btn-view-site:hover { background: var(--color-primary, #eab308); color: var(--bg-surface, #fff); }
  .btn-view-site [data-icon] { width: 0.875rem; height: 0.875rem; }
  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem); font-weight: 800;
    color: var(--heading-color, #0f172a); margin: 0;
  }
  .admin-page-subtitle { color: var(--text-muted, #64748b); font-size: 0.9375rem; margin: var(--space-1, 0.25rem) 0 0; }
  .inline-slug {
    font-family: var(--font-family-mono, monospace); font-size: 0.8125rem;
    background: var(--bg-inset, #f1f5f9); padding: 0.0625rem 0.375rem;
    border-radius: var(--border-radius-sm, 0.25rem);
  }

  .back-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-md, 0.375rem); color: var(--text-muted, #64748b);
    text-decoration: none; transition: all 0.15s;
  }
  .back-link:hover { border-color: var(--color-primary, #eab308); color: var(--text-default, #0f172a); }
  .back-link [data-icon] { width: 1.25rem; height: 1.25rem; }

  .form-layout {
    display: grid; grid-template-columns: 1fr 340px;
    gap: var(--space-5, 1.25rem); align-items: start;

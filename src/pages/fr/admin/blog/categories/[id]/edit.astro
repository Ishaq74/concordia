---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Switch from "@components/ui/Form/Switch.astro";
import MarkdownEditor from "@components/admin/MarkdownEditor.astro";
import MediaPickerModal from "@components/admin/MediaPickerModal.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogCategories, blogPostCategories, blogMedia } from "@database/schemas";
import { eq, count } from "drizzle-orm";

import tData from "@i18n/fr.json";
const currentLocale = Astro.currentLocale || "fr";
const t = tData;
const adminBase = `/${currentLocale}/admin/blog/categories`;

const categoryId = Astro.params.id;
if (!categoryId) return Astro.redirect(adminBase);

const db = await getDrizzle();

// Load category
const [category] = await db.select().from(blogCategories).where(eq(blogCategories.id, categoryId));
if (!category) return Astro.redirect(adminBase);

// Count articles
const [articleCountResult] = await db
  .select({ value: count() })
  .from(blogPostCategories)
  .where(eq(blogPostCategories.categoryId, categoryId));
const articleCount = articleCountResult.value;

// Load featured image if exists
let featuredImage: { id: string; url: string } | null = null;
if (category.featuredImageId) {
  const [media] = await db.select({ id: blogMedia.id, url: blogMedia.url }).from(blogMedia).where(eq(blogMedia.id, category.featuredImageId));
  if (media) featuredImage = media;
}

// Load all categories for parent selector (exclude self and children to prevent loops)
const allCategories = await db
  .select({ id: blogCategories.id, slug: blogCategories.slug, name: blogCategories.name, parentId: blogCategories.parentId })
  .from(blogCategories)
  .orderBy(blogCategories.slug);

// Exclude self from parent options
const parentOptions = allCategories.filter((c) => c.id !== categoryId);

const extractLocalized = (value: unknown, locale: string = currentLocale): string => {
  if (typeof value === "string") return value;
  if (value && typeof value === "object") {
    const obj = value as Record<string, string>;
    return obj[locale] || "";
  }
  return "";
};

const extractLocalizedObj = (value: unknown): Record<string, string> => {
  if (typeof value === "string") return { fr: value };
  if (value && typeof value === "object") return value as Record<string, string>;
  return {};
};

const nameObj = extractLocalizedObj(category.name);
const descObj = extractLocalizedObj(category.description);
const seoTitleObj = extractLocalizedObj(category.seoTitle);
const seoDescObj = extractLocalizedObj(category.seoDescription);
const seoKeywordsObj = extractLocalizedObj(category.seoKeywords);
const canonicalUrlObj = extractLocalizedObj(category.canonicalUrl);

const supportedLocales = [
  { code: "fr", label: "Français", flag: "🇫🇷" },
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "ar", label: "العربية", flag: "🇸🇦" },
];

const frontendUrl = `/${currentLocale}/blog/${category.slug}`;
---

<AdminLayout title={`Modifier — ${extractLocalized(category.name)}`} activeSection="blog-categories">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <a href={adminBase} class="back-link"><Icon name="mdi:arrow-left" /></a>
        <div>
          <h1>{extractLocalized(category.name)}</h1>
          <div class="title-meta">
            <code class="slug-code">{category.slug}</code>
            <Badge color="primary" text={`${articleCount} article${articleCount > 1 ? "s" : ""}`} />
            {category.isFeatured && <Badge color="accent" text="★ Featured" />}
          </div>
        </div>
      </div>
      <div class="admin-page-actions">
        <a href={frontendUrl} target="_blank" rel="noopener" class="btn-view-site" title="Voir sur le site">
          <Icon name="mdi:open-in-new" />
          <span>Voir sur le site</span>
        </a>
      </div>
    </div>
  </header>

  <form id="category-form" class="category-form">
    <input type="hidden" id="category-id" value={categoryId} />
    <input type="hidden" id="admin-base" value={adminBase} />
    <div class="form-layout">
      <!-- Main content column -->
      <div class="form-main">

        <!-- Multilingual name & description -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:translate" class="card-title-icon" />
              <span>Contenu multilingue</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="locale-tabs" role="tablist">
              {supportedLocales.map((loc, i) => {
                const hasContent = nameObj[loc.code] || descObj[loc.code];
                return (
                  <button
                    type="button"
                    role="tab"
                    class:list={["locale-tab", { active: i === 0 }]}
                    data-locale={loc.code}
                    aria-selected={i === 0 ? "true" : "false"}
                  >
                    <span class="locale-flag">{loc.flag}</span>
                    {loc.label}
                    {hasContent && <span class="locale-dot" />}
                  </button>
                );
              })}
            </div>

            {supportedLocales.map((loc, i) => (
              <div class:list={["locale-panel", { active: i === 0 }]} data-locale-panel={loc.code}>
                <div class="form-field">
                  <Label htmlFor={`name-${loc.code}`}>Nom de la catégorie *</Label>
                  <Input id={`name-${loc.code}`} name={`name-${loc.code}`} placeholder={`Nom en ${loc.label}…`} value={nameObj[loc.code] || ""} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`description-${loc.code}`}>Description</Label>
                  <MarkdownEditor id={`description-${loc.code}`} name={`description-${loc.code}`} rows={4} placeholder={`Description en ${loc.label}…`} value={descObj[loc.code] || ""} minimal />
                </div>

                <!-- SEO per locale -->
                <details class="seo-section">
                  <summary class="seo-toggle">
                    <Icon name="mdi:search-web" class="seo-icon" />
                    SEO — {loc.label}
                  </summary>
                  <div class="seo-fields">
                    <div class="form-field">
                      <Label htmlFor={`seo-title-${loc.code}`}>Titre SEO</Label>
                      <Input id={`seo-title-${loc.code}`} name={`seo-title-${loc.code}`} placeholder={`Titre SEO en ${loc.label}…`} value={seoTitleObj[loc.code] || ""} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-desc-${loc.code}`}>Description SEO</Label>
                      <Textarea id={`seo-desc-${loc.code}`} name={`seo-desc-${loc.code}`} rows={2} placeholder={`Description SEO en ${loc.label}…`} value={seoDescObj[loc.code] || ""} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-keywords-${loc.code}`}>Mots-clés SEO</Label>
                      <Input id={`seo-keywords-${loc.code}`} name={`seo-keywords-${loc.code}`} placeholder="mot1, mot2, mot3…" value={seoKeywordsObj[loc.code] || ""} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`canonical-${loc.code}`}>URL canonique</Label>
                      <Input id={`canonical-${loc.code}`} name={`canonical-${loc.code}`} type="url" placeholder="https://…" value={canonicalUrlObj[loc.code] || ""} />
                    </div>
                  </div>
                </details>
              </div>
            ))}
          </CardContent>
        </Card>

        <!-- Featured image upload -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:image-outline" class="card-title-icon" />
              <span>Image de couverture</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="upload-zone" id="upload-zone">
              <div class="upload-actions-row">
                <button type="button" id="btn-pick-media" class="btn-pick-media">
                  <Icon name="mdi:image-search-outline" class="pick-icon" />
                  Bibliothèque
                </button>
                <span class="upload-separator">ou</span>
                <label class="btn-upload-file" id="btn-upload-file">
                  <Icon name="mdi:cloud-upload-outline" class="pick-icon" />
                  Uploader
                  <input type="file" id="image-input" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml" class="upload-file-input" />
                </label>
              </div>
              <div class="upload-preview" id="upload-preview" style={featuredImage ? "" : "display: none;"}>
                <img id="preview-img" src={featuredImage?.url ?? ""} alt="Aperçu" />
                <button type="button" class="upload-remove" id="remove-image" title="Retirer l'image">
                  <Icon name="mdi:close-circle" />
                </button>
              </div>
            </div>
            <input type="hidden" id="featured-image-id" name="featuredImageId" value={category.featuredImageId ?? ""} />
          </CardContent>
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="form-sidebar">

        <!-- Publication settings -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:cog-outline" class="card-title-icon" />
              <span>Paramètres</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="slug">Slug *</Label>
              <div class="slug-row">
                <Input id="slug" name="slug" placeholder="mon-slug" value={category.slug} />
                <button type="button" id="generate-slug" class="slug-btn" title="Générer depuis le nom FR">
                  <Icon name="mdi:auto-fix" />
                </button>
              </div>
              <span class="field-hint">URL : /blog/categorie/<strong id="slug-preview">{category.slug}</strong></span>
            </div>

            <div class="form-field">
              <Label htmlFor="parent-id">Catégorie parente</Label>
              <Select id="parent-id" name="parentId">
                <option value="">Aucune (racine)</option>
                {parentOptions.map((cat) => (
                  <option value={cat.id} selected={category.parentId === cat.id}>
                    {extractLocalized(cat.name)}
                  </option>
                ))}
              </Select>
            </div>

            <div class="switch-group">
              <div class="switch-item">
                <Switch id="is-featured" name="isFeatured" checked={category.isFeatured} />
                <Label htmlFor="is-featured">Featured</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-home" name="displayInHome" checked={category.displayInHome} />
                <Label htmlFor="display-home">Afficher en accueil</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-blog" name="displayInBlog" checked={category.displayInBlog} />
                <Label htmlFor="display-blog">Afficher dans le blog</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-menu" name="displayInMenu" checked={category.displayInMenu} />
                <Label htmlFor="display-menu">Afficher dans le menu</Label>
              </div>
            </div>
          </CardContent>
        </Card>

        <!-- Actions -->
        <div class="action-bar">
          <a href={adminBase} class="action-cancel">Annuler</a>
          <Button type="button" color="primary" id="btn-save" icon={{ name: "mdi:content-save-outline", side: "left" }}>
            Enregistrer
          </Button>
        </div>
        <div class="save-feedback" id="save-feedback" style="display: none;">
          <Icon name="mdi:check-circle" class="feedback-icon" />
          <span>Enregistré</span>
        </div>

        <!-- Danger zone -->
        <Card elevation="sm" className="danger-card">
          <CardContent>
            <details class="danger-details">
              <summary class="danger-toggle">
                <Icon name="mdi:alert-outline" class="danger-icon" />
                <span>Zone dangereuse</span>
              </summary>
              <div class="danger-content">
                <p class="danger-text">
                  Supprimer cette catégorie retirera l'association de {articleCount} article{articleCount > 1 ? "s" : ""}.
                  Les articles eux-mêmes ne seront pas supprimés.
                </p>
                <Button type="button" color="error" id="btn-delete" icon={{ name: "mdi:delete-outline", side: "left" }}>
                  Supprimer la catégorie
                </Button>
              </div>
            </details>
          </CardContent>
        </Card>
      </div>
    </div>
  </form>
  <MediaPickerModal />
</AdminLayout>

<script>
  import { initMarkdownEditors } from "@lib/admin/markdown-editor";
  import { openMediaPicker } from "@lib/admin/media-picker";
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    // Init markdown editors
    const editors = initMarkdownEditors();

    const categoryId = (document.getElementById("category-id") as HTMLInputElement).value;
    const adminBase = (document.getElementById("admin-base") as HTMLInputElement).value;

    // ── Locale tabs ──
    const tabs = document.querySelectorAll<HTMLElement>(".locale-tab");
    const panels = document.querySelectorAll<HTMLElement>(".locale-panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const locale = tab.dataset.locale;
        tabs.forEach((t) => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
        panels.forEach((p) => p.classList.remove("active"));
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        document.querySelector(`[data-locale-panel="${locale}"]`)?.classList.add("active");
      });
    });

    // ── Auto-slug ──
    const nameInput = document.getElementById("name-fr") as HTMLInputElement | null;
    const slugInput = document.getElementById("slug") as HTMLInputElement | null;
    const slugPreview = document.getElementById("slug-preview");
    const generateSlugBtn = document.getElementById("generate-slug");

    const slugify = (text: string): string =>
      text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

    generateSlugBtn?.addEventListener("click", () => {
      if (nameInput && slugInput) {
        slugInput.value = slugify(nameInput.value);
        if (slugPreview) slugPreview.textContent = slugInput.value || "…";
      }
    });
    slugInput?.addEventListener("input", () => {
      if (slugPreview) slugPreview.textContent = slugInput!.value || "…";
    });

    // ── Image upload ──
    const uploadZone = document.getElementById("upload-zone");
    const imageInput = document.getElementById("image-input") as HTMLInputElement | null;
    const uploadPreview = document.getElementById("upload-preview");
    const previewImg = document.getElementById("preview-img") as HTMLImageElement | null;
    const removeImageBtn = document.getElementById("remove-image");
    const featuredImageIdInput = document.getElementById("featured-image-id") as HTMLInputElement | null;

    function setImagePreview(id: string, url: string) {
      if (featuredImageIdInput) featuredImageIdInput.value = id;
      if (previewImg) previewImg.src = url;
      if (uploadPreview) uploadPreview.style.display = "block";
    }

    function clearImagePreview() {
      if (featuredImageIdInput) featuredImageIdInput.value = "";
      if (uploadPreview) uploadPreview.style.display = "none";
      if (previewImg) previewImg.src = "";
    }

    // Media library picker
    document.getElementById("btn-pick-media")?.addEventListener("click", async () => {
      const result = await openMediaPicker();
      if (result) setImagePreview(result.id, result.url);
    });

    // Direct upload → open modal with file
    imageInput?.addEventListener("change", async () => {
      const file = imageInput?.files?.[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setImagePreview(result.id, result.url);
      }
      if (imageInput) imageInput.value = "";
    });

    // Drag & drop → open modal with file
    uploadZone?.addEventListener("dragover", (e) => { e.preventDefault(); uploadZone.classList.add("dragover"); });
    uploadZone?.addEventListener("dragleave", () => uploadZone.classList.remove("dragover"));
    uploadZone?.addEventListener("drop", async (e) => {
      e.preventDefault();
      uploadZone.classList.remove("dragover");
      const file = e.dataTransfer?.files[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setImagePreview(result.id, result.url);
      }
    });

    removeImageBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      clearImagePreview();
    });

    // ── Save ──
    const btnSave = document.getElementById("btn-save");

    btnSave?.addEventListener("click", async () => {
      const slug = (document.getElementById("slug") as HTMLInputElement)?.value.trim();
      const frName = (document.getElementById("name-fr") as HTMLInputElement)?.value.trim();
      if (!frName) { showToast("Le nom en français est obligatoire.", "warning"); return; }
      if (!slug) { showToast("Le slug est obligatoire.", "warning"); return; }

      // Sync markdown editors to underlying textareas
      editors.forEach((editor) => (editor.codemirror as any).save());

      const locales = ["fr", "en", "es", "ar"];
      const name: Record<string, string> = {};
      const description: Record<string, string> = {};
      const seoTitle: Record<string, string> = {};
      const seoDescription: Record<string, string> = {};
      const seoKeywords: Record<string, string> = {};
      const canonicalUrl: Record<string, string> = {};

      locales.forEach((loc) => {
        const n = (document.getElementById("name-" + loc) as HTMLInputElement | null)?.value.trim();
        if (n) name[loc] = n;
        const d = (document.getElementById("description-" + loc) as HTMLTextAreaElement | null)?.value.trim();
        if (d) description[loc] = d;
        const st = (document.getElementById("seo-title-" + loc) as HTMLInputElement | null)?.value.trim();
        if (st) seoTitle[loc] = st;
        const sd = (document.getElementById("seo-desc-" + loc) as HTMLTextAreaElement | null)?.value.trim();
        if (sd) seoDescription[loc] = sd;
        const sk = (document.getElementById("seo-keywords-" + loc) as HTMLInputElement | null)?.value.trim();
        if (sk) seoKeywords[loc] = sk;
        const cu = (document.getElementById("canonical-" + loc) as HTMLInputElement | null)?.value.trim();
        if (cu) canonicalUrl[loc] = cu;
      });

      const payload: Record<string, unknown> = {
        action: "update",
        id: categoryId,
        slug,
        name,
        description: Object.keys(description).length > 0 ? description : null,
        featuredImageId: (document.getElementById("featured-image-id") as HTMLInputElement)?.value || null,
        parentId: (document.getElementById("parent-id") as HTMLSelectElement)?.value || null,
        isFeatured: (document.getElementById("is-featured") as HTMLInputElement)?.checked,
        displayInHome: (document.getElementById("display-home") as HTMLInputElement)?.checked,
        displayInBlog: (document.getElementById("display-blog") as HTMLInputElement)?.checked,
        displayInMenu: (document.getElementById("display-menu") as HTMLInputElement)?.checked,
        seoTitle: Object.keys(seoTitle).length > 0 ? seoTitle : null,
        seoDescription: Object.keys(seoDescription).length > 0 ? seoDescription : null,
        seoKeywords: Object.keys(seoKeywords).length > 0 ? seoKeywords : null,
        canonicalUrl: Object.keys(canonicalUrl).length > 0 ? canonicalUrl : null,
      };

      btnSave.setAttribute("disabled", "true");
      try {
        const res = await fetch("/api/admin/blog/categories", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.ok) {
          showToast("Catégorie enregistrée avec succès ! Rechargement…", "success");
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || "Erreur lors de l'enregistrement.", "error");
        }
      } catch {
        showToast("Erreur réseau — vérifiez votre connexion.", "error");
      } finally {
        btnSave.removeAttribute("disabled");
      }
    });

    // ── Delete ──
    const btnDelete = document.getElementById("btn-delete");
    btnDelete?.addEventListener("click", async () => {
      if (!confirm("Supprimer cette catégorie ? Cette action est irréversible.")) return;
      try {
        const res = await fetch("/api/admin/blog/categories", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "delete", id: categoryId }),
        });
        const data = await res.json();
        if (data.ok) {
          showToast("Catégorie supprimée. Redirection…", "success");
          setTimeout(() => { window.location.href = adminBase; }, 1000);
        } else {
          showToast(data.error || "Erreur lors de la suppression.", "error");
        }
      } catch { showToast("Erreur réseau.", "error"); }
    });
  });
</script>

<style>
  .admin-page-header { margin-bottom: var(--space-6, 1.5rem); }
  .admin-page-title-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-3, 0.75rem); }
  .admin-page-title-group { display: flex; align-items: flex-start; gap: var(--space-3, 0.75rem); }
  .admin-page-actions { display: flex; align-items: center; gap: var(--space-2, 0.5rem); }
  .btn-view-site {
    display: inline-flex; align-items: center; gap: var(--space-1, 0.25rem);
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    font-size: 0.8125rem; font-weight: 600; text-decoration: none;
    color: var(--color-primary, #eab308); border: 1px solid var(--color-primary, #eab308);
    border-radius: var(--border-radius-md, 0.375rem);
    background: transparent; transition: all 0.15s;
  }
  .btn-view-site:hover { background: var(--color-primary, #eab308); color: var(--bg-surface, #fff); }
  .btn-view-site [data-icon] { width: 0.875rem; height: 0.875rem; }
  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem); font-weight: 800;
    color: var(--heading-color, #0f172a); margin: 0;
  }
  .title-meta { display: flex; align-items: center; gap: var(--space-2, 0.5rem); margin-top: var(--space-1, 0.25rem); }
  .slug-code {
    font-family: var(--font-family-mono, monospace); font-size: 0.75rem;
    background: var(--bg-inset, #f1f5f9); padding: 0.125rem 0.5rem;
    border-radius: var(--border-radius-sm, 0.25rem); color: var(--text-muted, #64748b);
  }
  .back-link {
    display: inline-flex; align-items: center; padding: var(--space-2, 0.5rem);
    border-radius: var(--border-radius-md, 0.375rem); color: var(--text-muted, #64748b);
    transition: color 0.15s, background 0.15s;
  }
  .back-link:hover { color: var(--text-default, #0f172a); background: var(--bg-inset, #f1f5f9); }
  .back-link [data-icon] { width: 1.25rem; height: 1.25rem; }

  .form-layout {
    display: grid; grid-template-columns: 1fr 340px; gap: var(--space-6, 1.5rem); align-items: start;
  }
  .form-main { display: flex; flex-direction: column; gap: var(--space-4, 1rem); }
  .form-sidebar { display: flex; flex-direction: column; gap: var(--space-4, 1rem); position: sticky; top: var(--space-4, 1rem); }

  .card-title-row {
    display: flex; align-items: center; gap: var(--space-2, 0.5rem);
    font-weight: 700; font-size: 0.9375rem; color: var(--heading-color, #0f172a);
  }
  .card-title-icon { width: 1.125rem; height: 1.125rem; color: var(--color-primary, #eab308); }

  .form-field { margin-bottom: var(--space-3, 0.75rem); }
  .form-field:last-child { margin-bottom: 0; }
  .field-hint { font-size: 0.75rem; color: var(--text-muted, #64748b); margin-top: 0.25rem; display: block; }
  .field-hint strong { font-family: var(--font-family-mono, monospace); }

  /* Locale tabs */

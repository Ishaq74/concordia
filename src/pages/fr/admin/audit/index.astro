---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import Badge from "@components/ui/Badge.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Button from "@components/ui/Button.astro";
import Pagination from "@components/ui/Pagination.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { auditLog, user } from "@database/schemas";
import { count, eq, desc, inArray } from "drizzle-orm";

import tData from "@i18n/fr.json";
const currentLocale = Astro.currentLocale || "fr";
const t = tData;

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1"));
const perPage = 30;
const actionFilter = url.searchParams.get("action")?.trim() ?? "";

const db = await getDrizzle();

// Actions distinctes pour le filtre
const distinctActions = await db.selectDistinct({ action: auditLog.action }).from(auditLog);
const actionOptions = distinctActions.map((a) => a.action).filter(Boolean).sort();

// Conditions
const whereClause = actionFilter ? eq(auditLog.action, actionFilter) : undefined;

// Comptage total
const [totalResult] = whereClause
  ? await db.select({ value: count() }).from(auditLog).where(whereClause)
  : await db.select({ value: count() }).from(auditLog);
const totalLogs = totalResult.value;
const totalPages = Math.max(1, Math.ceil(totalLogs / perPage));

// Fetch des logs
const logs = whereClause
  ? await db
      .select()
      .from(auditLog)
      .where(whereClause)
      .orderBy(desc(auditLog.createdAt))
      .limit(perPage)
      .offset((page - 1) * perPage)
  : await db
      .select()
      .from(auditLog)
      .orderBy(desc(auditLog.createdAt))
      .limit(perPage)
      .offset((page - 1) * perPage);

// Résoudre les noms d'utilisateurs
const userIds = [...new Set(logs.map((l) => l.userId).filter((id): id is string => !!id))];
const usersMap = new Map<string, string>();
if (userIds.length > 0) {
  const users = await db
    .select({ id: user.id, name: user.name, email: user.email })
    .from(user)
    .where(inArray(user.id, userIds));
  users.forEach((u) => usersMap.set(u.id, u.name || u.email));
}

const actionBadgeColor = (action: string) => {
  if (action.includes("delete") || action.includes("ban") || action.includes("reject")) return "error" as const;
  if (action.includes("create") || action.includes("approve")) return "success" as const;
  if (action.includes("update") || action.includes("edit")) return "warning" as const;
  return "default" as const;
};

const adminBase = `/${currentLocale}/admin/audit`;
---

<AdminLayout title={t.adminPanel?.audit ?? "Journal d'audit"} activeSection="audit">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <h1>{t.adminPanel?.audit ?? "Journal d'audit"}</h1>
      <Badge color="primary" text={`${totalLogs} entrées`} />
    </div>
    <p class="admin-page-subtitle">Historique complet des actions administratives.</p>
  </header>

  <!-- Filtre par action -->
  <Card elevation="sm" className="admin-filters-card">
    <CardContent>
      <form method="get" action={adminBase} class="admin-filters-form">
        <div class="admin-filter-field">
          <Label htmlFor="action">Filtrer par action</Label>
          <Select id="action" name="action">
            <option value="">Toutes les actions</option>
            {actionOptions.map((a) => (
              <option value={a} selected={a === actionFilter}>{a}</option>
            ))}
          </Select>
        </div>
        <div class="admin-filter-actions">
          <Button type="submit" color="primary" icon={{ name: "mdi:filter-outline", side: "left" }}>
            Filtrer
          </Button>
          {actionFilter && (
            <a href={adminBase} class="admin-filter-reset">Réinitialiser</a>
          )}
        </div>
      </form>
    </CardContent>
  </Card>

  <!-- Table audit -->
  <Card>
    <CardContent>
      {logs.length === 0 ? (
        <div class="empty-state">
          <Icon name="mdi:clipboard-text-clock-outline" class="empty-state-icon" />
          <p>Aucune entrée dans le journal.</p>
        </div>
      ) : (
        <div class="table-responsive">
        <Table striped>
          <TableHeader>
            <TableRow>
              <TableHead>Date</TableHead>
              <TableHead>Action</TableHead>
              <TableHead>Utilisateur</TableHead>
              <TableHead>Cible</TableHead>
              <TableHead>IP</TableHead>
              <TableHead>Détails</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {logs.map((log) => (
              <TableRow>
                <TableCell>
                  <time datetime={log.createdAt.toISOString()} class="log-date">
                    {log.createdAt.toLocaleDateString(currentLocale, {
                      day: "2-digit",
                      month: "2-digit",
                      year: "numeric",
                    })}
                    <span class="log-time">
                      {log.createdAt.toLocaleTimeString(currentLocale, {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit",
                      })}
                    </span>
                  </time>
                </TableCell>
                <TableCell>
                  <Badge color={actionBadgeColor(log.action)} text={log.action} />
                </TableCell>
                <TableCell>
                  {log.userId ? (
                    <span class="log-user">{usersMap.get(log.userId) ?? log.userId}</span>
                  ) : (
                    <span class="text-muted">—</span>
                  )}
                </TableCell>
                <TableCell>
                  {log.targetId ? (
                    <code class="log-target">{log.targetId}</code>
                  ) : (
                    <span class="text-muted">—</span>
                  )}
                </TableCell>
                <TableCell>
                  {log.ip ? (
                    <code class="log-ip">{log.ip}</code>
                  ) : (
                    <span class="text-muted">—</span>
                  )}
                </TableCell>
                <TableCell>
                  {log.data ? (
                    <details class="log-details">
                      <summary>Voir</summary>
                      <pre class="log-json">{JSON.stringify(log.data, null, 2)}</pre>
                    </details>
                  ) : (
                    <span class="text-muted">—</span>
                  )}
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
        </div>
      )}
    </CardContent>
  </Card>

  {totalPages > 1 && (
    <div class="admin-pagination">
      <Pagination
        currentPage={page}
        totalPages={totalPages}
        baseUrl={`${adminBase}?${actionFilter ? `action=${encodeURIComponent(actionFilter)}&` : ""}page=`}
        showPrevNext
        color="primary"
      />
    </div>
  )}
</AdminLayout>

<style>
  .admin-page-header {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .admin-page-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
  }

  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem);
    font-weight: 800;
    color: var(--heading-color, #0f172a);
    margin: 0;
  }

  .admin-page-subtitle {
    color: var(--text-muted, #64748b);
    font-size: 0.9375rem;
    margin: var(--space-1, 0.25rem) 0 0;
  }

  .admin-filters-card {
    margin-bottom: var(--space-4, 1rem);
  }

  .admin-filters-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4, 1rem);
  }

  .admin-filter-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
    min-width: 220px;
    flex: 1;
    max-width: 320px;
  }

  .admin-filter-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }

  .admin-filter-reset {
    color: var(--text-muted, #64748b);
    font-size: 0.8125rem;
    text-decoration: underline;
  }

  .log-date {
    display: flex;
    flex-direction: column;
    font-size: 0.8125rem;
    color: var(--text-default, #1e293b);
    white-space: nowrap;
  }

  .log-time {
    font-size: 0.75rem;
    color: var(--text-muted, #64748b);
  }

  .log-user {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-default, #1e293b);
  }

  .log-target,
  .log-ip {
    font-family: var(--font-family-mono, monospace);
    font-size: 0.75rem;
    background: var(--bg-inset, #f1f5f9);
    padding: 0.125rem 0.375rem;
    border-radius: var(--border-radius-sm, 0.25rem);
    color: var(--text-default, #1e293b);
  }

  .text-muted {
    color: var(--text-muted, #64748b);
    font-size: 0.8125rem;
  }

  .log-details summary {
    cursor: pointer;
    font-size: 0.75rem;
    color: var(--color-primary, #eab308);
    font-weight: 500;
  }

  .log-json {
    font-size: 0.6875rem;
    line-height: 1.4;
    max-height: 200px;
    overflow: auto;
    background: var(--bg-inset, #f1f5f9);
    padding: var(--space-2, 0.5rem);
    border-radius: var(--border-radius-sm, 0.25rem);
    white-space: pre-wrap;
    word-break: break-all;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-8, 2rem);
    color: var(--text-muted, #64748b);
  }

  .empty-state-icon {
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2, 0.5rem);
    opacity: 0.5;
  }

  .admin-pagination {
    margin-top: var(--space-4, 1rem);
    display: flex;
    justify-content: center;
  }

  .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  @media (max-width: 768px) {
    .admin-filters-form { flex-direction: column; }
    .admin-filter-field { min-width: 0; max-width: none; }
    .admin-page-title-row { flex-wrap: wrap; }
    .log-target, .log-ip { font-size: 0.6875rem; word-break: break-all; }
  }

  @media (max-width: 480px) {
    .admin-page-header h1 { font-size: 1.5rem; }
    .log-json { max-height: 120px; font-size: 0.625rem; }
  }
</style>

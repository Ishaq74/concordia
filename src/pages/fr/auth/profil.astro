---
// src/pages/fr/profil.astro
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import translations from "@i18n/fr.json";
import { getAuth } from "@lib/auth/auth";

// Composants auth
import ProfileHeader from "@components/templates/auth/profile/ProfileHeader.astro";
import ProfileDetails from "@components/templates/auth/profile/ProfileDetails.astro";
import ProfileForm from "@components/templates/auth/profile/ProfileForm.astro";
import ProfileOrganization from "@components/templates/auth/profile/ProfileOrganization.astro";
import ProfileInvitations from "@components/templates/auth/profile/ProfileInvitations.astro";

// UI
import Alert from "@components/ui/Alert.astro";

// Utils
import {
  slugify,
  resolveErrorMessage,
  forwardSetCookies,
  type Status,
  type OrganizationRecord,
  type OrganizationMember,
  type InvitationRecord,
} from "@lib/auth/profile/utils";

const { user, session } = Astro.locals;
const request = Astro.request;
const response = Astro.response;
const url = new URL(request.url);

if (!user) return Astro.redirect("/fr/connexion");

let status: Status | null = null;

// --- Auth instance
const auth = await getAuth();

// --- Récupération des organisations
const organizationListing = await auth.organizationApi.list({ headers: request.headers });
const organizations: OrganizationRecord[] = Array.isArray(organizationListing)
  ? organizationListing
  : (organizationListing as any)?.organizations ?? [];

// --- Organisation active
const activeOrganizationId = (session as any)?.activeOrganizationId ?? null;

// --- Récupération des membres
let members: OrganizationMember[] = [];
try {
  const memberResult = await auth.organizationApi.listMembers({ headers: request.headers });
  members = Array.isArray(memberResult)
    ? memberResult
    : (memberResult as any)?.members ?? [];
} catch {
  members = [];
}

// --- Rôle utilisateur
const memberRole = members.find(m => m.userId === user.id)?.role ?? null;
const canManageOrganization = memberRole === "owner" || memberRole === "admin";
const isOwner = memberRole === "owner";

// --- Invitations
let invitations: InvitationRecord[] = [];
try {
  const invitationResult = await auth.organizationApi.listUserInvitations({ headers: request.headers });
  invitations = Array.isArray(invitationResult)
    ? invitationResult
    : (invitationResult as any)?.invitations ?? [];
} catch {
  invitations = [];
}

// --- Dernière connexion
const lastSignIn = session?.updatedAt
  ? new Date(session.updatedAt).toLocaleString("fr-FR")
  : null;
---

<BaseLayout lang="fr" title={translations.auth.profile ?? "Profil"}>
  <!-- ProfileHeader -->
  <ProfileHeader
    title={translations.auth.profile ?? "Profil utilisateur"}
    description={translations.auth.updateProfile ?? "Gérez vos informations personnelles et suivez vos connexions."}
    status={status}
  />

  <!-- ProfileDetails -->
  <ProfileDetails
    user={user}
    memberRole={memberRole}
    organizations={organizations}
    activeOrganizationId={activeOrganizationId}
    lastSignIn={lastSignIn}
    invitationCount={invitations.length}
  />

  <!-- ProfileForm -->
  <ProfileForm user={user} />

  <!-- ProfileOrganization -->
  <ProfileOrganization
    organizations={organizations}
    activeOrganizationId={activeOrganizationId}
    members={members}
    canManageOrganization={canManageOrganization}
    isOwner={isOwner}
    auth={auth}
    session={session}
    translations={translations}
  />

  <!-- ProfileInvitations -->
  <ProfileInvitations count={invitations.length} translations={translations} />
</BaseLayout>

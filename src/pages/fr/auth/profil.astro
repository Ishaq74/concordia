---
// src/pages/fr/profil.astro
export const prerender = false;


import BaseLayout from "@layouts/BaseLayout.astro";
import translations from "@i18n/fr.json";
import { getAuth } from "@lib/auth/auth";
import Grid from "@components/Tools/Grid.astro";
import Flex from "@components/Tools/Flex.astro";
import Tabs from "@components/ui/Tabs/Tabs.astro";
import Tab from "@components/ui/Tabs/Tab.astro";
import AvatarCard from "@components/ui/Avatar/AvatarCard.astro";
import Badge from "@components/ui/Badge.astro";
import Timeline from "@components/ui/Timeline.astro";
import Gallery from "@components/ui/Gallery.astro";
import GroupCard from "@components/ui/GroupCard.astro";
import Button from "@components/ui/Button.astro";
import Card from "@components/ui/Card/Card.astro";
import ProfileForm from "@components/templates/auth/profile/ProfileForm.astro";
import ProfileOrganization from "@components/templates/auth/profile/ProfileOrganization.astro";
import ProfileInvitations from "@components/templates/auth/profile/ProfileInvitations.astro";

// Utils
import {
  slugify,
  resolveErrorMessage,
  forwardSetCookies,
  type Status,
  type OrganizationRecord,
  type OrganizationMember,
  type InvitationRecord,
} from "@lib/auth/profile/utils";

const { user, session } = Astro.locals;
const request = Astro.request;
const response = Astro.response;
const url = new URL(request.url);

if (!user) return Astro.redirect("/fr/connexion");

let status: Status | null = null;

// --- Auth instance
const auth = await getAuth();

// --- Récupération des organisations
// TODO: brancher API organisations si disponible
const organizations: OrganizationRecord[] = [];
const activeOrganizationId = null;
let members: OrganizationMember[] = [];

// --- Rôle utilisateur
const memberRole = members.find(m => m.userId === user.id)?.role ?? null;
const canManageOrganization = memberRole === "owner" || memberRole === "admin";
const isOwner = memberRole === "owner";

// --- Invitations (placeholder)
let invitations: InvitationRecord[] = [];

// --- Dernière connexion
const lastSignIn = session?.updatedAt
  ? new Date(session.updatedAt).toLocaleString("fr-FR")
  : null;
---


<BaseLayout lang="fr" title={translations.auth.profile ?? "Profil"}>
  <Grid tag="section" cols="1" gap="xl">
    {/* HERO/HEADER */}
    <Card variant="modern" elevation="md" className="profile-hero">
      <Grid cols="auto 1fr" gap="lg" align="center">
        <div style="position:relative;display:flex;justify-content:center;align-items:center;">
          <AvatarCard
            variant="modern"
            src={typeof user.image === 'string' ? user.image : undefined}
            alt={user.name ?? user.email}
            name={user.name ?? user.email}
            size="xl"
          >
            <Button
              variant="modern"
              color="primary"
              ariaLabel="Modifier l’avatar"
              style="position:absolute;bottom:0;right:0;border-radius:50%;padding:0.5rem;"
              icon={{ name: "mdi:pencil", side: "left" }}
              onclick="window.location.href='/fr/auth/profil?edit=avatar'"
            />
          </AvatarCard>
        </div>
        <Flex direction="column" gap="sm">
          <Flex gap="sm" alignItems="center">
            <h1 style="font-size:2rem;font-weight:bold;">{user.name ?? user.email}</h1>
          </Flex>
          <Flex gap="md">
            <Button variant="modern" color="secondary" icon={{name:"mdi:share-variant",side:"left"}}>Partager</Button>
            <Button variant="modern" color="primary" icon={{name:"mdi:email-outline",side:"left"}}>Contacter</Button>
          </Flex>
        </Flex>
      </Grid>
    </Card>

    {/* TABS */}
    <Tabs name="profil-tabs" variant="modern">

      <Tab name="profil-tabs" label="Activité" icon="mdi:history" open>
        {/* GRID PRINCIPALE */}
        <Grid cols="2fr 1fr" gap="xl">
          {/* Colonne principale : Activité */}
          <Card variant="modern" elevation="sm">
            <h2 style="font-size:1.25rem;font-weight:bold;">Activité récente</h2>
            <Timeline
              events={[]}
              variant="modern"
              orientation="vertical"
              iconShape="circle"
            />
          </Card>
          {/* Colonne latérale */}
          <Flex direction="column" gap="lg">
            <Card variant="modern" elevation="sm">
              <h3>Statistiques</h3>
              <Flex direction="column" gap="xs">
                <span>Services utilisés : <b>0</b></span>
                <span>Articles lus : <b>0</b></span>
                <span>Likes donnés : <b>0</b></span>
              </Flex>
            </Card>
            <Card variant="modern" elevation="sm">
              <h3>Organisations suivies</h3>
              <Flex direction="column" gap="sm">
                <span>Aucune organisation suivie</span>
              </Flex>
            </Card>
            <Card variant="modern" elevation="sm">
              <h3>Photos récentes</h3>
              <Gallery images={[]} columns={3} gap="0.5rem" aspectRatio="1/1" showCaptions={false} />
            </Card>
          </Flex>
        </Grid>
      </Tab>

      <Tab name="profil-tabs" label="Services favoris" icon="mdi:heart">
        {/* Services favoris */}
        <Grid cols="1" gap="md">
          <span>Aucun service favori</span>
        </Grid>
      </Tab>

      <Tab name="profil-tabs" label="Articles" icon="mdi:blog-outline">
        {/* Articles de blog */}
        <Grid cols="1" gap="md">
          <span>Aucun article</span>
        </Grid>
      </Tab>

      <Tab name="profil-tabs" label="Éditer mon profil" icon="mdi:pencil">
        {/* Édition du profil */}
        <Grid cols="1" gap="xl">
          <ProfileForm user={user} />
          <ProfileOrganization
            organizations={organizations}
            activeOrganizationId={activeOrganizationId}
            members={members}
            canManageOrganization={canManageOrganization}
            isOwner={isOwner}
            session={session}
            translations={translations}
          />
          <ProfileInvitations count={invitations.length} translations={translations} />
        </Grid>
      </Tab>

    </Tabs>
  </Grid>
</BaseLayout>

---
// src/pages/[lang]/contact.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import BannerPage from "@templates/BannerPage.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Label from "@components/ui/Form/Label.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";
import { getLocalizedUrl } from "@lib/i18n/route-helpers";

const lang = Astro.params.lang as string;
const LANG = lang;
const t = getTranslations(lang);

const contactMethods = [
  { icon: "mdi:email-outline", title: t.contactPage?.methodEmail ?? "Email", value: "contact@concordia.community", href: "mailto:contact@concordia.community" },
  { icon: "mdi:map-marker-outline", title: t.contactPage?.methodAddress ?? "Adresse", value: "Paris, France", href: null },
  { icon: "mdi:clock-outline", title: t.contactPage?.methodHours ?? "Disponibilité", value: t.contactPage?.hoursValue ?? "Lun–Ven, 9h–18h", href: null },
];
---

<BaseLayout title={t.contactPage?.metaTitle ?? "Contact — Concordia"} lang={LANG}>
  <BannerPage
    title={t.contactPage?.title ?? "Contact"}
    subtitle={t.contactPage?.subtitle ?? "Une question, une suggestion ?"}
    description={t.contactPage?.description ?? "N'hésitez pas à nous écrire."}
    type="minimal"
    color="neutral"
    breadcrumbs={[]}
  />

  <main class="contact-page">
    <div class="contact-grid">
      <Card variant="retro" elevation="md" class="contact-form-card">
        <CardContent>
          <h2 class="contact-form-title">
            <Icon name="mdi:send-outline" /> {t.contactPage?.sendMessage ?? "Envoyez-nous un message"}
          </h2>
          <form class="contact-form" method="POST">
            <div class="contact-form__row">
              <div class="contact-form__field">
                <Label htmlFor="contact-name">{t.contactPage?.fullName ?? "Nom complet"}</Label>
                <Input type="text" id="contact-name" name="name" placeholder={t.contactPage?.namePlaceholder ?? "Votre nom"} required autocomplete="name" variant="retro" />
              </div>
              <div class="contact-form__field">
                <Label htmlFor="contact-email">{t.contactPage?.email ?? "Email"}</Label>
                <Input type="email" id="contact-email" name="email" placeholder={t.contactPage?.emailPlaceholder ?? "votre@email.com"} required autocomplete="email" variant="retro" />
              </div>
            </div>
            <div class="contact-form__field">
              <Label htmlFor="contact-subject">{t.contactPage?.subject ?? "Sujet"}</Label>
              <Select id="contact-subject" name="subject" required variant="retro">
                <option value="">{t.contactPage?.subjectPlaceholder ?? "Choisissez un sujet"}</option>
                <option value="question">{t.contactPage?.subjectQuestion ?? "Question générale"}</option>
                <option value="bug">{t.contactPage?.subjectBug ?? "Signaler un bug"}</option>
                <option value="partnership">{t.contactPage?.subjectPartnership ?? "Partenariat"}</option>
                <option value="press">{t.contactPage?.subjectPress ?? "Presse"}</option>
                <option value="other">{t.contactPage?.subjectOther ?? "Autre"}</option>
              </Select>
            </div>
            <div class="contact-form__field">
              <Label htmlFor="contact-message">{t.contactPage?.message ?? "Message"}</Label>
              <Textarea id="contact-message" name="message" rows={6} placeholder={t.contactPage?.messagePlaceholder ?? "Décrivez votre demande…"} required variant="retro" />
            </div>
            <Button type="submit" variant="retro" color="primary" icon={{ name: "mdi:send", side: "right" }}>
              {t.contactPage?.send ?? "Envoyer le message"}
            </Button>
          </form>
        </CardContent>
      </Card>

      <aside class="contact-sidebar">
        {contactMethods.map((method) => (
          <Card variant="retro" elevation="sm">
            <CardContent>
              <div class="contact-method">
                <div class="contact-method__icon"><Icon name={method.icon} /></div>
                <div>
                  <h3 class="contact-method__title">{method.title}</h3>
                  {method.href ? (
                    <a href={method.href} class="contact-method__value contact-method__link">{method.value}</a>
                  ) : (
                    <p class="contact-method__value">{method.value}</p>
                  )}
                </div>
              </div>
            </CardContent>
          </Card>
        ))}
        <Card variant="retro" elevation="sm" class="contact-faq-card">
          <CardContent>
            <h3 class="contact-sidebar-title"><Icon name="mdi:frequently-asked-questions" /> {t.contactPage?.faqTitle ?? "FAQ"}</h3>
            <p class="contact-sidebar-text">{t.contactPage?.faqDescription ?? "Consultez notre base de connaissances."}</p>
            <a href={getLocalizedUrl(lang, "blog")}>
              <Button variant="retro" color="secondary" icon={{ name: "mdi:arrow-right", side: "right" }}>
                {t.contactPage?.faqCta ?? "Lire le blog"}
              </Button>
            </a>
          </CardContent>
        </Card>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
.contact-page { max-width: 1280px; margin: 0 auto; padding: 2.5rem 1rem; }
.contact-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
@media (min-width: 1024px) { .contact-grid { grid-template-columns: 2fr 1fr; } }
.contact-form-title { display: flex; align-items: center; gap: 0.5rem; font-size: 1.25rem; font-weight: 700; margin: 0 0 1.5rem; color: var(--heading-color, var(--text-default)); }
.contact-form-title :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary); }
.contact-form { display: flex; flex-direction: column; gap: 1.25rem; }
.contact-form__row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
@media (max-width: 640px) { .contact-form__row { grid-template-columns: 1fr; } }
.contact-form__field { display: flex; flex-direction: column; gap: 0.375rem; }
.contact-form__field label { font-size: 0.875rem; font-weight: 600; color: var(--text-default); }
.contact-form__field input, .contact-form__field select, .contact-form__field textarea { width: 100%; padding: 0.625rem 0.75rem; border: 2px solid var(--border-default); border-radius: var(--border-radius-sm, 0.375rem); font-size: 0.9375rem; font-family: inherit; background: var(--bg-default); color: var(--text-default); transition: border-color 180ms; }
.contact-form__field input:focus, .contact-form__field select:focus, .contact-form__field textarea:focus { outline: none; border-color: var(--color-primary); box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent); }
.contact-form__field textarea { resize: vertical; min-height: 120px; }
.contact-sidebar { display: flex; flex-direction: column; gap: 1.25rem; }
.contact-method { display: flex; align-items: flex-start; gap: 0.75rem; }
.contact-method__icon { width: 2.5rem; height: 2.5rem; border-radius: 50%; background: color-mix(in srgb, var(--color-primary) 10%, transparent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.contact-method__icon :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary); }
.contact-method__title { margin: 0; font-size: 0.875rem; font-weight: 700; color: var(--text-default); }
.contact-method__value { margin: 0.125rem 0 0; font-size: 0.875rem; color: var(--text-muted); }
.contact-method__link { text-decoration: none; color: var(--color-primary); }
.contact-method__link:hover { text-decoration: underline; }
.contact-sidebar-title { display: flex; align-items: center; gap: 0.5rem; font-size: 1rem; font-weight: 700; margin: 0 0 0.5rem; color: var(--heading-color, var(--text-default)); }
.contact-sidebar-title :global(svg) { width: 1.125rem; height: 1.125rem; color: var(--color-primary); }
.contact-sidebar-text { margin: 0 0 0.75rem; font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }
</style>

---
// src/pages/[lang]/organizations/[slug]/services.astro — Organization services page
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import BannerPage from "@templates/BannerPage.astro";
import ServiceGrid from "@components/modules/services/lists/ServiceGrid.astro";
import ServiceCard from "@components/modules/services/cards/ServiceCard.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";
import { getCollection } from "astro:content";
import { getDrizzle } from "@database/drizzle";
import { blogOrganizations } from "@database/schemas";
import { eq } from "drizzle-orm";

const lang = Astro.params.lang as string;
const { slug } = Astro.params;
const t = getTranslations(lang);
const ts = t.servicesPage ?? {} as Record<string, string>;

if (!slug) return Astro.redirect(`/${lang}/organizations`);

const db = await getDrizzle();

// Fetch organization by slug
const [org] = await db.select().from(blogOrganizations).where(eq(blogOrganizations.slug, slug)).limit(1);
if (!org) return Astro.redirect(`/${lang}/organizations`);

// Fetch services for this org
const allServices = await getCollection("services");
const services = allServices
  .filter((s) => s.data.lang === lang && s.data.status === "active" && s.data.organizationId === org.id);

// Extract categories & filters
const catMap = new Map<string, { name: string; slug: string; count: number }>();
services.forEach((svc) => {
  const cat = svc.data.category;
  if (cat?.slug) {
    const existing = catMap.get(cat.slug);
    if (existing) existing.count++;
    else catMap.set(cat.slug, { name: cat.name, slug: cat.slug, count: 1 });
  }
});
const categories = Array.from(catMap.values()).sort((a, b) => b.count - a.count);

// Price bounds for budget filter
const prices = services.map((s) => parseFloat(s.data.basePrice ?? "0")).filter((p) => p > 0);
const minPrice = prices.length ? Math.floor(Math.min(...prices)) : 0;
const maxPrice = prices.length ? Math.ceil(Math.max(...prices)) : 1000;

// Service type (group vs individual via maxParticipants)
const hasGroupServices = services.some((s) => (s.data.maxParticipants ?? 1) > 1);
const hasIndividualServices = services.some((s) => (s.data.maxParticipants ?? 1) <= 1);

// Serialize for client
const serviceData = services.map((s) => ({
  id: s.data.id,
  price: parseFloat(s.data.basePrice ?? "0"),
  catSlug: s.data.category?.slug ?? "",
  type: (s.data.maxParticipants ?? 1) > 1 ? "group" : "individual",
}));
---

<BaseLayout title={`${ts.ourServices ?? "Nos Services"} — ${org.name}`} lang={lang}>
  <BannerPage
    title={`${ts.ourServices ?? "Nos Services"}`}
    subtitle={org.name}
    type="category"
    color="accent"
    breadcrumbs={[
      { label: t.breadcrumb?.home ?? "Accueil", href: `/${lang}` },
      { label: t.organizations?.title ?? "Organisations", href: `/${lang}/organizations` },
      { label: org.name, href: `/${lang}/organizations/${slug}` },
      { label: ts.title ?? "Services", href: `/${lang}/organizations/${slug}/services` },
    ]}
  />

  <main class="org-services-main">
    <div class="org-services-layout">
      <!-- Filters sidebar -->
      <aside class="org-filters">
        <!-- Category filter -->
        {categories.length > 0 && (
          <div class="filter-section">
            <h3 class="filter-title">{ts.categories ?? "Catégories"}</h3>
            <div class="filter-pills" id="cat-pills">
              <button type="button" class="fpill active" data-category="all">{ts.allCategories ?? "Tout"}</button>
              {categories.map((cat) => (
                <button type="button" class="fpill" data-category={cat.slug}>
                  {cat.name} <span class="fpill-count">({cat.count})</span>
                </button>
              ))}
            </div>
          </div>
        )}

        <!-- Budget filter -->
        {prices.length > 0 && (
          <div class="filter-section">
            <h3 class="filter-title">{ts.budget ?? "Budget"}</h3>
            <div class="budget-range">
              <input type="range" id="budget-max" min={minPrice} max={maxPrice} value={maxPrice} />
              <div class="budget-label">{ts.upTo ?? "Jusqu'à"} <span id="budget-label">{maxPrice}</span> €</div>
            </div>
          </div>
        )}

        <!-- Type filter -->
        {hasGroupServices && hasIndividualServices && (
          <div class="filter-section">
            <h3 class="filter-title">{ts.serviceType ?? "Type"}</h3>
            <div class="type-pills" id="type-pills">
              <button type="button" class="fpill active" data-type="all">{ts.allCategories ?? "Tout"}</button>
              <button type="button" class="fpill" data-type="individual">
                <Icon name="mdi:account" /> {ts.individual ?? "Individuel"}
              </button>
              <button type="button" class="fpill" data-type="group">
                <Icon name="mdi:account-group" /> {ts.group ?? "Groupe"}
              </button>
            </div>
          </div>
        )}

        <button type="button" class="reset-btn" id="reset-org-filters">
          <Icon name="mdi:filter-remove-outline" /> {ts.resetFilters ?? "Réinitialiser"}
        </button>
      </aside>

      <!-- Services grid -->
      <div class="org-services-content">
        <div class="org-toolbar">
          <span class="result-count" id="org-result-count">{services.length} {services.length > 1 ? (ts.services ?? "services") : (ts.service ?? "service")}</span>
        </div>
        <div id="org-services-grid">
          {services.length > 0 ? (
            <ServiceGrid>
              {services.map((svc) => (
                <div class="org-service-item" data-service-id={svc.data.id}>
                  <ServiceCard service={svc} lang={lang} variant="retro" />
                </div>
              ))}
            </ServiceGrid>
          ) : (
            <div class="services-empty">
              <Icon name="mdi:briefcase-remove-outline" />
              <p>{ts.noServices ?? "Aucun service disponible pour le moment."}</p>
            </div>
          )}
        </div>
        <div id="org-no-results" class="services-empty" style="display:none;">
          <Icon name="mdi:filter-remove-outline" />
          <p>{ts.noFilterResults ?? "Aucun service ne correspond à vos critères."}</p>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<div id="org-svc-data" data-services={JSON.stringify(serviceData)} style="display:none;"></div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dataEl = document.getElementById("org-svc-data");
    if (!dataEl) return;
    const services: Array<{ id: string; price: number; catSlug: string; type: string }> = JSON.parse(dataEl.dataset.services || "[]");

    const catPills = document.querySelectorAll<HTMLButtonElement>("#cat-pills .fpill");
    const typePills = document.querySelectorAll<HTMLButtonElement>("#type-pills .fpill");
    const budgetMax = document.getElementById("budget-max") as HTMLInputElement | null;
    const budgetLabel = document.getElementById("budget-label");
    const resultCount = document.getElementById("org-result-count")!;
    const grid = document.getElementById("org-services-grid")!;
    const noResults = document.getElementById("org-no-results")!;
    const resetBtn = document.getElementById("reset-org-filters");

    let activeCat = "all";
    let activeType = "all";

    function render() {
      const budget = budgetMax ? parseFloat(budgetMax.value) : Infinity;
      if (budgetLabel && budgetMax) budgetLabel.textContent = budgetMax.value;

      const visible = new Set<string>();
      for (const svc of services) {
        if (activeCat !== "all" && svc.catSlug !== activeCat) continue;
        if (activeType !== "all" && svc.type !== activeType) continue;
        if (svc.price > 0 && svc.price > budget) continue;
        visible.add(svc.id);
      }

      document.querySelectorAll<HTMLElement>(".org-service-item").forEach((el) => {
        el.style.display = el.dataset.serviceId && visible.has(el.dataset.serviceId) ? "" : "none";
      });
      resultCount.textContent = `${visible.size} service${visible.size > 1 ? "s" : ""}`;
      grid.style.display = visible.size > 0 ? "" : "none";
      noResults.style.display = visible.size === 0 ? "" : "none";
    }

    catPills.forEach((p) => p.addEventListener("click", () => {
      catPills.forEach((b) => b.classList.remove("active"));
      p.classList.add("active");
      activeCat = p.dataset.category || "all";
      render();
    }));

    typePills.forEach((p) => p.addEventListener("click", () => {
      typePills.forEach((b) => b.classList.remove("active"));
      p.classList.add("active");
      activeType = p.dataset.type || "all";
      render();
    }));

    budgetMax?.addEventListener("input", render);

    resetBtn?.addEventListener("click", () => {
      activeCat = "all";
      activeType = "all";
      catPills.forEach((p) => p.classList.toggle("active", p.dataset.category === "all"));
      typePills.forEach((p) => p.classList.toggle("active", p.dataset.type === "all"));
      if (budgetMax) budgetMax.value = budgetMax.max;
      render();
    });
  });
</script>

<style>
  .org-services-main { max-width: var(--max-width, 1200px); margin: 0 auto; padding: var(--space-6, 1.5rem); }
  .org-services-layout { display: grid; grid-template-columns: 260px 1fr; gap: var(--space-6, 1.5rem); align-items: start; }

  /* Filters */
  .org-filters {
    position: sticky; top: var(--space-6, 1.5rem);
    background: var(--bg-surface, white); border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--radius-lg, 0.5rem); padding: var(--space-4, 1rem);
  }
  .filter-section { margin-bottom: var(--space-4, 1rem); padding-bottom: var(--space-4, 1rem); border-bottom: 1px solid var(--border-default, #e2e8f0); }
  .filter-section:last-of-type { border-bottom: none; }
  .filter-title { font-size: 0.875rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-muted, #64748b); margin: 0 0 var(--space-2, 0.5rem); }
  .filter-pills { display: flex; flex-wrap: wrap; gap: var(--space-1, 0.25rem); }
  .fpill {
    display: inline-flex; align-items: center; gap: 4px;
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    border: 1px solid var(--border-default, #e2e8f0); border-radius: var(--radius-full, 9999px);
    background: transparent; cursor: pointer; font-size: 0.8125rem; transition: all 0.15s;
  }
  .fpill [data-icon] { width: 0.875rem; height: 0.875rem; }
  .fpill:hover, .fpill.active { background: var(--color-primary, #eab308); color: white; border-color: var(--color-primary, #eab308); }
  .fpill-count { opacity: 0.7; font-size: 0.75rem; }
  .budget-range { display: flex; flex-direction: column; gap: var(--space-2, 0.5rem); }
  .budget-range input[type="range"] { width: 100%; accent-color: var(--color-primary, #eab308); }
  .budget-label { font-size: 0.8125rem; color: var(--text-muted, #64748b); }
  .reset-btn {
    display: flex; align-items: center; gap: var(--space-2, 0.5rem); justify-content: center;
    width: 100%; padding: var(--space-2, 0.5rem); margin-top: var(--space-3, 0.75rem);
    background: var(--bg-inset, #f8fafc); border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--radius-md, 0.375rem); cursor: pointer; font-size: 0.8125rem;
    color: var(--text-muted, #64748b); transition: all 0.15s;
  }
  .reset-btn:hover { background: var(--bg-surface, white); color: var(--text-default, #0f172a); }
  .reset-btn [data-icon] { width: 1rem; height: 1rem; }

  /* Content */
  .org-toolbar { margin-bottom: var(--space-4, 1rem); }
  .result-count { font-size: 0.9375rem; font-weight: 600; }
  .services-empty { text-align: center; padding: var(--space-12, 3rem); color: var(--text-muted, #64748b); }
  .services-empty [data-icon] { width: 3rem; height: 3rem; opacity: 0.4; margin-bottom: var(--space-3, 0.75rem); }

  @media (max-width: 768px) {
    .org-services-layout { grid-template-columns: 1fr; }
    .org-filters { position: static; }
  }
</style>

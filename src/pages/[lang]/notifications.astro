---
// src/pages/[lang]/notifications.astro — Notification center
import BaseLayout from "@layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";

export const prerender = false;

const lang = Astro.params.lang as string;
const t = getTranslations(lang);

const categories = [
  { key: "all", icon: "mdi:inbox", label: t.notifications?.all ?? "Tous" },
  { key: "message", icon: "mdi:email-outline", label: t.notifications?.messages ?? "Messages" },
  { key: "booking", icon: "mdi:calendar-outline", label: t.notifications?.bookings ?? "Réservations" },
  { key: "blog", icon: "mdi:newspaper-variant-outline", label: t.notifications?.blog ?? "Blog & Actu" },
  { key: "system", icon: "mdi:cog-outline", label: t.notifications?.system ?? "Système" },
];
---

<BaseLayout title={t.notifications?.metaTitle ?? "Centre de Notifications — Concordia"} lang={lang}>
  <main class="notif-page">
    <div class="notif-layout">

      <!-- Sidebar -->
      <aside class="notif-sidebar">
        <!-- Category Filters -->
        <div class="notif-sidebar__card">
          <h3 class="notif-sidebar__title">{t.notifications?.filters ?? "Filtres"}</h3>
          <nav class="notif-categories">
            {categories.map(cat => (
              <button class:list={["notif-cat", { active: cat.key === "all" }]} data-category={cat.key}>
                <Icon name={cat.icon} />
                {cat.label}
              </button>
            ))}
          </nav>
        </div>

        <!-- Settings  -->
        <div class="notif-sidebar__card">
          <h3 class="notif-sidebar__title">{t.notifications?.settings ?? "Paramètres"}</h3>
          <div class="notif-settings">
            <label class="notif-toggle">
              <span class="notif-toggle__label">
                <Icon name="mdi:email-outline" />
                Email
              </span>
              <input type="checkbox" checked class="notif-toggle__input" data-channel="email" />
            </label>
            <label class="notif-toggle">
              <span class="notif-toggle__label">
                <Icon name="mdi:bell-ring-outline" />
                Push
              </span>
              <input type="checkbox" checked class="notif-toggle__input" data-channel="push" />
            </label>
          </div>
        </div>
      </aside>

      <!-- Main content -->
      <div class="notif-main">
        <!-- Header -->
        <div class="notif-header">
          <div>
            <h1 class="notif-header__title">{t.notifications?.title ?? "Centre de Notifications"}</h1>
            <p class="notif-header__subtitle">{t.notifications?.subtitle ?? "Gérez vos alertes et restez informé de l'activité."}</p>
          </div>
          <button id="markAllRead" class="notif-header__action">
            {t.notifications?.markAllRead ?? "Tout marquer comme lu"}
          </button>
        </div>

        <!-- Quick tabs -->
        <div class="notif-tabs">
          <button class="notif-tab active" data-filter="unread">
            {t.notifications?.unread ?? "Non lu"}
            <span id="unreadBadge" class="notif-tab__badge">0</span>
          </button>
          <button class="notif-tab" data-filter="all">{t.notifications?.allTab ?? "Tous"}</button>
        </div>

        <!-- Notification list -->
        <div id="notifList" class="notif-list" aria-live="polite">
          <!-- Injected by JS -->
        </div>

        <!-- Loading -->
        <div id="notifLoading" class="notif-state">
          <Icon name="mdi:loading" class="spin" />
          <p>{t.notifications?.loading ?? "Chargement..."}</p>
        </div>

        <!-- Empty -->
        <div id="notifEmpty" class="notif-state" style="display:none">
          <Icon name="mdi:bell-off-outline" />
          <h3>{t.notifications?.empty ?? "Aucune notification"}</h3>
          <p>{t.notifications?.emptyHint ?? "Vous êtes à jour ! Revenez plus tard."}</p>
        </div>

        <!-- Load more -->
        <div id="loadMore" class="notif-loadmore" style="display:none">
          <button id="loadMoreBtn" class="notif-loadmore__btn">
            <Icon name="mdi:chevron-down" />
            {t.notifications?.loadMore ?? "Charger plus"}
          </button>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>

<script is:inline define:vars={{ lang }}>
(function() {
  const list = document.getElementById("notifList");
  const loading = document.getElementById("notifLoading");
  const empty = document.getElementById("notifEmpty");
  const loadMore = document.getElementById("loadMore");
  const loadMoreBtn = document.getElementById("loadMoreBtn");
  const unreadBadge = document.getElementById("unreadBadge");
  const markAllBtn = document.getElementById("markAllRead");
  const catBtns = document.querySelectorAll(".notif-cat");
  const tabBtns = document.querySelectorAll(".notif-tab");

  let currentPage = 1;
  let currentCategory = "all";
  let unreadOnly = true;

  // Category filter
  catBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      catBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      currentCategory = btn.dataset.category;
      currentPage = 1;
      list.innerHTML = "";
      fetchNotifications();
    });
  });

  // Tab filter
  tabBtns.forEach(btn => {
    btn.addEventListener("click", () => {
      tabBtns.forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      unreadOnly = btn.dataset.filter === "unread";
      currentPage = 1;
      list.innerHTML = "";
      fetchNotifications();
    });
  });

  // Mark all read
  markAllBtn.addEventListener("click", async () => {
    await fetch("/api/notifications", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ action: "markAllRead" }),
    });
    document.querySelectorAll(".notif-item.unread").forEach(el => el.classList.remove("unread"));
    unreadBadge.textContent = "0";
  });

  // Load more
  loadMoreBtn.addEventListener("click", () => {
    currentPage++;
    fetchNotifications(true);
  });

  async function fetchNotifications(append) {
    if (!append) { loading.style.display = ""; empty.style.display = "none"; loadMore.style.display = "none"; }

    const params = new URLSearchParams({
      page: String(currentPage),
      limit: "20",
      ...(currentCategory !== "all" ? { type: currentCategory } : {}),
      ...(unreadOnly ? { unread: "true" } : {}),
    });

    try {
      const res = await fetch("/api/notifications?" + params);
      const data = await res.json();

      loading.style.display = "none";
      unreadBadge.textContent = data.unread || "0";

      if (!data.notifications || data.notifications.length === 0) {
        if (!append) empty.style.display = "";
        loadMore.style.display = "none";
        return;
      }

      const html = data.notifications.map(renderNotification).join("");
      if (append) { list.insertAdjacentHTML("beforeend", html); }
      else { list.innerHTML = html; }

      loadMore.style.display = data.notifications.length >= 20 ? "" : "none";
    } catch (err) {
      loading.style.display = "none";
      list.innerHTML = '<p class="notif-error">Erreur de chargement</p>';
    }
  }

  function renderNotification(n) {
    const typeIcons = { message: "mail", booking: "calendar_month", blog: "article", system: "settings", default: "notifications" };
    const typeColors = { message: "#3b82f6", booking: "#10b981", blog: "#8b5cf6", system: "#6b7280" };
    const icon = typeIcons[n.type] || typeIcons.default;
    const color = typeColors[n.type] || typeColors.system;
    const isUnread = !n.isRead;
    const time = n.createdAt ? new Date(n.createdAt).toLocaleString(lang === "fr" ? "fr-FR" : lang, { hour: "2-digit", minute: "2-digit", day: "numeric", month: "short" }) : "";

    return '<div class="notif-item ' + (isUnread ? "unread" : "") + '" data-id="' + n.id + '">' +
      '<div class="notif-item__icon" style="background:' + color + '15;color:' + color + '">' +
        '<span class="material-symbols-outlined">' + icon + '</span>' +
      '</div>' +
      '<div class="notif-item__content">' +
        '<div class="notif-item__header">' +
          '<h4 class="notif-item__title">' + escapeHtml(n.title) + '</h4>' +
          '<span class="notif-item__time">' + time + '</span>' +
        '</div>' +
        (n.body || n.message ? '<p class="notif-item__body">' + escapeHtml(n.body || n.message || "") + '</p>' : '') +
        '<div class="notif-item__actions">' +
          (isUnread ? '<button class="notif-action" onclick="markRead(\'' + n.id + '\', this)">Marquer comme lu</button>' : '') +
          '<button class="notif-action notif-action--danger" onclick="deleteNotif(\'' + n.id + '\', this)">Supprimer</button>' +
        '</div>' +
      '</div>' +
    '</div>';
  }

  function escapeHtml(str) {
    const d = document.createElement("div");
    d.textContent = str;
    return d.innerHTML;
  }

  window.markRead = async function(id, btn) {
    await fetch("/api/notifications", {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ action: "markRead", notificationId: id }),
    });
    const item = btn.closest(".notif-item");
    if (item) item.classList.remove("unread");
    btn.remove();
    const cur = parseInt(unreadBadge.textContent) || 0;
    unreadBadge.textContent = Math.max(0, cur - 1);
  };

  window.deleteNotif = async function(id, btn) {
    await fetch("/api/notifications?id=" + encodeURIComponent(id), { method: "DELETE" });
    const item = btn.closest(".notif-item");
    if (item) { item.style.opacity = "0"; setTimeout(() => item.remove(), 300); }
  };

  // Initial fetch
  fetchNotifications();
})();
</script>

<style>
  .notif-page {
    padding: var(--space-6) var(--space-4);
    min-height: 70vh;
  }
  .notif-layout {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: var(--space-8);
  }

  /* Sidebar */
  .notif-sidebar { width: 260px; flex-shrink: 0; }
  .notif-sidebar__card {
    background: var(--color-surface, #fff);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
    position: sticky;
    top: 5rem;
  }
  .notif-sidebar__title {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-3);
    padding: 0 var(--space-2);
  }
  .notif-categories { display: flex; flex-direction: column; gap: var(--space-1); }
  .notif-cat {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: none;
    background: none;
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }
  .notif-cat [data-icon] { width: 1.25rem; height: 1.25rem; }
  .notif-cat:hover { background: var(--color-bg-muted, #f4f0eb); color: var(--color-text); }
  .notif-cat.active { background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary); font-weight: 600; }

  /* Toggle settings */
  .notif-settings { display: flex; flex-direction: column; gap: var(--space-3); padding: 0 var(--space-2); }
  .notif-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }
  .notif-toggle__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
  .notif-toggle__label [data-icon] { width: 1rem; height: 1rem; }
  .notif-toggle__input { accent-color: var(--color-primary); width: 1rem; height: 1rem; }

  /* Main */
  .notif-main { flex: 1; min-width: 0; }
  .notif-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .notif-header__title { font-size: var(--text-2xl); font-weight: 700; color: var(--color-text); }
  .notif-header__subtitle { font-size: var(--text-sm); color: var(--color-text-muted); margin-top: var(--space-1); }
  .notif-header__action {
    background: none;
    border: none;
    color: var(--color-primary);
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    padding: var(--space-1) 0;
  }
  .notif-header__action:hover { text-decoration: underline; }

  /* Tabs */
  .notif-tabs {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    overflow-x: auto;
  }
  .notif-tab {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-2) var(--space-3);
    border: none;
    border-radius: var(--radius-full, 9999px);
    background: var(--color-bg-muted, #f4f0eb);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 500;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s;
  }
  .notif-tab:hover { background: var(--color-surface, #fff); }
  .notif-tab.active { background: var(--color-text); color: var(--color-surface, #fff); }
  .notif-tab__badge {
    background: var(--color-primary);
    color: #fff;
    font-size: 0.65rem;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full, 9999px);
    font-weight: 700;
  }

  /* Notification items (from JS) */
  .notif-list { display: flex; flex-direction: column; gap: var(--space-3); }
  :global(.notif-item) {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--color-bg-muted, #f9f7f5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: all 0.3s;
  }
  :global(.notif-item.unread) {
    background: var(--color-surface, #fff);
    border-left: 3px solid var(--color-primary);
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
  }
  :global(.notif-item__icon) {
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  :global(.notif-item__content) { flex: 1; min-width: 0; }
  :global(.notif-item__header) { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: var(--space-1); gap: var(--space-2); }
  :global(.notif-item__title) { font-size: var(--text-sm); font-weight: 600; color: var(--color-text); }
  :global(.notif-item.unread .notif-item__title) { font-weight: 700; }
  :global(.notif-item__time) { font-size: var(--text-xs); color: var(--color-text-muted); white-space: nowrap; }
  :global(.notif-item__body) { font-size: var(--text-sm); color: var(--color-text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  :global(.notif-item__actions) { display: flex; gap: var(--space-2); margin-top: var(--space-2); }
  :global(.notif-action) {
    padding: var(--space-1) var(--space-2);
    border: none;
    background: var(--color-bg-muted, #f4f0eb);
    border-radius: var(--radius);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background 0.2s;
  }
  :global(.notif-action:hover) { background: var(--color-primary); color: #fff; }
  :global(.notif-action--danger:hover) { background: var(--color-error, #ef4444); }
  :global(.notif-error) { text-align: center; color: var(--color-error, #ef4444); padding: var(--space-4); }

  /* States */
  .notif-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-12) var(--space-4);
    color: var(--color-text-muted);
    gap: var(--space-3);
  }
  .notif-state [data-icon] { width: 3rem; height: 3rem; opacity: 0.5; }
  .notif-state h3 { font-size: var(--text-lg); font-weight: 600; color: var(--color-text); }
  :global(.spin) { animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .notif-loadmore { display: flex; justify-content: center; padding: var(--space-6); }
  .notif-loadmore__btn {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    background: none;
    border: none;
    color: var(--color-primary);
    font-weight: 600;
    font-size: var(--text-sm);
    cursor: pointer;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    transition: background 0.2s;
  }
  .notif-loadmore__btn:hover { background: color-mix(in srgb, var(--color-primary) 5%, transparent); }
  .notif-loadmore__btn [data-icon] { width: 1.25rem; height: 1.25rem; }

  @media (max-width: 1024px) {
    .notif-layout { flex-direction: column; }
    .notif-sidebar { width: 100%; }
    .notif-sidebar__card { position: static; }
    .notif-categories { flex-direction: row; flex-wrap: wrap; }
  }
</style>

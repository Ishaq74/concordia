---
import DocLayout from "@layouts/DocLayout.astro";
import { Code } from "astro:components";
import { Icon } from "astro-icon/components";
import {
  Breadcrumb as BreadcrumbComponent,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
  BreadcrumbEllipsis,
} from "@components/ui/Breadcrumb";
import TableOfContents from "@/components/templates/docs/TableOfContents.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import { getTranslations } from "@i18n/translations";
const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const d = t.docs?.common ?? {};
const p = t.docs?.pages?.breadcrumb ?? {};
---

<DocLayout 
  title={p.title ?? "Breadcrumb Component"} 
  description={p.description ?? "Breadcrumb component documentation for breadcrumb navigation"}
  variant="initial"
>
  <h1 id="breadcrumb-component">{p.title ?? "Breadcrumb Component"}</h1>
  
  <p set:html={p.intro ?? `The <code class="inline-code">Breadcrumb</code> component displays a breadcrumb trail allowing users to understand their position in the site hierarchy and navigate easily.`} />

  <TableOfContents
    items={[
      { label: d.installation ?? "Installation", href: "#installation" },
      { label: d.apiReference ?? "API Reference", href: "#api" },
      { label: d.basicUsage ?? "Basic usage", href: "#basic" },
      { label: d.variants ?? "Variants", href: "#variants" },
      { label: d.colors ?? "Colors", href: "#colors" },
      { label: d.withIcons ?? "With icons", href: "#icons" },
      { label: d.customSeparators ?? "Custom separators", href: "#separators" },
      { label: d.withEllipsis ?? "With ellipsis", href: "#ellipsis" },
      { label: d.accessibility ?? "Accessibility", href: "#accessibility" },
    ]}
    title={d.tableOfContents ?? "Table of contents"}
  />

  <h2 id="installation">{d.installation ?? "Installation"}</h2>

  <Code
    lang="astro"
    code={`import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
  BreadcrumbEllipsis,
} from '@components/ui/Breadcrumb';`}
  />

  <h2 id="api">{d.apiReference ?? "API Reference"}</h2>

  <h3>{d.breadcrumbComponent ?? "Breadcrumb"}</h3>
  <p>{p.ui1 ?? "The root navigation component that contains all breadcrum..."}</p>

  <div class="props-table">
    <Table striped>
      <TableHeader>
        <TableRow>
          <TableHead>{d.prop ?? "Prop"}</TableHead>
          <TableHead>{d.type ?? "Type"}</TableHead>
          <TableHead>{d.default ?? "Default"}</TableHead>
          <TableHead>{d.description ?? "Description"}</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        <TableRow>
          <TableCell><code class="inline-code">variant</code></TableCell>
          <TableCell>initial | retro | modern | futuristic</TableCell>
          <TableCell>initial</TableCell>
          <TableCell>{d.descVisualStyle ?? "Visual style of the breadcrumb"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">color</code></TableCell>
          <TableCell>default | primary | secondary | accent</TableCell>
          <TableCell>default</TableCell>
          <TableCell>{p?.propDescs?.descCurrentColor ?? "Current page color"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">className</code></TableCell>
          <TableCell>string</TableCell>
          <TableCell>""</TableCell>
          <TableCell>{d.descAdditionalCss ?? "Additional CSS classes"}</TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </div>

  <h3>{d.breadcrumbList ?? "BreadcrumbList"}</h3>
  <p>{p.ui2 ?? "A container that displays an ordered list for breadcrumb ..."}</p>

  <h3>{d.breadcrumbItem ?? "BreadcrumbItem"}</h3>
  <p>{p.ui3 ?? "A component representing each item in the breadcrumb navi..."}</p>

  <h3>{d.breadcrumbLink ?? "BreadcrumbLink"}</h3>
  <p>{p.ui4 ?? "A component for clickable links that navigate to previous..."}</p>

  <div class="props-table">
    <Table striped>
      <TableHeader>
        <TableRow>
          <TableHead>{d.prop ?? "Prop"}</TableHead>
          <TableHead>{d.type ?? "Type"}</TableHead>
          <TableHead>{d.description ?? "Description"}</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        <TableRow>
          <TableCell><code class="inline-code">href</code></TableCell>
          <TableCell>string</TableCell>
          <TableCell>{p?.propDescs?.descUrlRequired ?? "Destination URL (required)"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">className</code></TableCell>
          <TableCell>string</TableCell>
          <TableCell>{d.descAdditionalCss ?? "Additional CSS classes"}</TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </div>

  <h3>{d.breadcrumbPage ?? "BreadcrumbPage"}</h3>
  <p>{p.ui5 ?? "Represents the current page in the breadcrumb (last eleme..."}</p>

  <h3>{d.breadcrumbSeparator ?? "BreadcrumbSeparator"}</h3>
  <p>{p.ui6 ?? "Visual separator between breadcrumb items."}</p>

  <h3>{d.breadcrumbEllipsis ?? "BreadcrumbEllipsis"}</h3>
  <p>{p.ui7 ?? "Indicates truncated items, used when there are many levels."}</p>

  <h2 id="basic">{d.basicUsage ?? "Basic usage"}</h2>

  <div class="example-section">
    <BreadcrumbComponent>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/docs">Documentation</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <Code
    lang="astro"
    code={`<BreadcrumbComponent>
  <BreadcrumbList>
    <BreadcrumbItem>
      <BreadcrumbLink href="/">Accueil</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem>
      <BreadcrumbLink href="/docs">Documentation</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem>
      <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
    </BreadcrumbItem>
  </BreadcrumbList>
</BreadcrumbComponent>`}
  />

  <h2 id="variants">{d.variants ?? "Variants"}</h2>

  <h3>{d.variantInitial ?? "Initial (default)"}</h3>
  <div class="example-section">
    <BreadcrumbComponent variant="initial">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/products">Products</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>Details</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <h3>{d.variantRetro ?? "Retro"}</h3>
  <div class="example-section">
    <BreadcrumbComponent variant="retro">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/products">Products</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>Details</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <h3>{d.variantModern ?? "Modern"}</h3>
  <div class="example-section">
    <BreadcrumbComponent variant="modern">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/products">Products</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>Details</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <h3>{d.variantFuturistic ?? "Futuristic"}</h3>
  <div class="example-section">
    <BreadcrumbComponent variant="futuristic">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/products">Products</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>Details</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <Code
    lang="astro"
    code={`<BreadcrumbComponent variant="initial">...</BreadcrumbComponent>
<BreadcrumbComponent variant="retro">...</BreadcrumbComponent>
<BreadcrumbComponent variant="modern">...</BreadcrumbComponent>
<BreadcrumbComponent variant="futuristic">...</BreadcrumbComponent>`}
  />

  <h2 id="colors">{d.colors ?? "Colors"}</h2>

  <p>{p.ui8 ?? "Colors apply to the current page:"}</p>

  <div class="example-section">
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      <div>
        <p style="margin-bottom: 0.5rem; font-weight: 600;">Default</p>
        <BreadcrumbComponent color="default">
          <BreadcrumbList>
            <BreadcrumbItem>
              <BreadcrumbLink href="/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage>Current page</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </BreadcrumbComponent>
      </div>

      <div>
        <p style="margin-bottom: 0.5rem; font-weight: 600;">Primary</p>
        <BreadcrumbComponent color="primary">
          <BreadcrumbList>
            <BreadcrumbItem>
              <BreadcrumbLink href="/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage>Current page</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </BreadcrumbComponent>
      </div>

      <div>
        <p style="margin-bottom: 0.5rem; font-weight: 600;">Secondary</p>
        <BreadcrumbComponent color="secondary">
          <BreadcrumbList>
            <BreadcrumbItem>
              <BreadcrumbLink href="/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage>Current page</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </BreadcrumbComponent>
      </div>

      <div>
        <p style="margin-bottom: 0.5rem; font-weight: 600;">Accent</p>
        <BreadcrumbComponent color="accent">
          <BreadcrumbList>
            <BreadcrumbItem>
              <BreadcrumbLink href="/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage>Current page</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </BreadcrumbComponent>
      </div>
    </div>
  </div>

  <Code
    lang="astro"
    code={`<BreadcrumbComponent color="default">...</BreadcrumbComponent>
<BreadcrumbComponent color="primary">...</BreadcrumbComponent>
<BreadcrumbComponent color="secondary">...</BreadcrumbComponent>
<BreadcrumbComponent color="accent">...</BreadcrumbComponent>`}
  />

  <h2 id="icons">{d.withIcons ?? "With icons"}</h2>

  <div class="example-section">
    <BreadcrumbComponent variant="modern" color="primary">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">
            <Icon name="mdi:home" class="size-4" />
            <span>Home</span>
          </BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator>
          <Icon name="mdi:chevron-right" class="size-4" />
        </BreadcrumbSeparator>
        <BreadcrumbItem>
          <BreadcrumbLink href="/docs">
            <Icon name="mdi:book-open" class="size-4" />
            <span>Documentation</span>
          </BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator>
          <Icon name="mdi:chevron-right" class="size-4" />
        </BreadcrumbSeparator>
        <BreadcrumbItem>
          <BreadcrumbPage>
            <Icon name="openmoji:croissant" class="size-4" />
            <span>Breadcrumb</span>
          </BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <Code
    lang="astro"
    code={`<BreadcrumbComponent variant="modern" color="primary">
  <BreadcrumbList>
    <BreadcrumbItem>
      <BreadcrumbLink href="/">
        <Icon name="mdi:home" class="size-4" />
        <span>Accueil</span>
      </BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbSeparator>
      <Icon name="mdi:chevron-right" class="size-4" />
    </BreadcrumbSeparator>
    <BreadcrumbItem>
      <BreadcrumbPage>
        <Icon name="mdi:breadcrumb" class="size-4" />
        <span>Breadcrumb</span>
      </BreadcrumbPage>
    </BreadcrumbItem>
  </BreadcrumbList>
</BreadcrumbComponent>`}
  />

  <h2 id="separators">{d.customSeparators ?? "Custom separators"}</h2>

  <p>The <code class="inline-code">BreadcrumbSeparator</code> component can contain any content:</p>

  <h3>{d.defaultSeparator ?? "Default separator (/)"}</h3>
  <div class="example-section">
    <BreadcrumbComponent>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>Page</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <h3>{d.withChevron ?? "With chevron"}</h3>
  <div class="example-section">
    <BreadcrumbComponent variant="modern">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator>
          <span>›</span>
        </BreadcrumbSeparator>
        <BreadcrumbItem>
          <BreadcrumbPage>Page</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <h3>{d.withIcon ?? "With icon"}</h3>
  <div class="example-section">
    <BreadcrumbComponent variant="modern" color="primary">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator>
          <Icon name="mdi:chevron-right" class="size-4" />
        </BreadcrumbSeparator>
        <BreadcrumbItem>
          <BreadcrumbLink href="/docs">Documentation</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator>
          <Icon name="mdi:chevron-right" class="size-4" />
        </BreadcrumbSeparator>
        <BreadcrumbItem>
          <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <h3>{d.withDoubleArrow ?? "With double arrow"}</h3>
  <div class="example-section">
    <BreadcrumbComponent variant="retro">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator>
          <span>»</span>
        </BreadcrumbSeparator>
        <BreadcrumbItem>

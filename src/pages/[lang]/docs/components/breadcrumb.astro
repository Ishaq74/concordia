  <Code
    lang="astro"
    code={`<BreadcrumbComponent variant="futuristic" color="primary">
  <BreadcrumbList>
    <BreadcrumbItem>
      <BreadcrumbLink href="/">
        <Icon name="mdi:home" class="size-3" />
      </BreadcrumbLink>
    </BreadcrumbItem>

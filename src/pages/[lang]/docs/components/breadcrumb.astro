  </div>

  <h3>{d.withDot ?? "With dot"}</h3>
  <div class="example-section">
    <BreadcrumbComponent>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator>
          <span>•</span>
        </BreadcrumbSeparator>
        <BreadcrumbItem>
          <BreadcrumbLink href="/docs">Documentation</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator>
          <span>•</span>
        </BreadcrumbSeparator>
        <BreadcrumbItem>
          <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <Code
    lang="astro"
    code={`<!-- Default separator -->
<BreadcrumbSeparator />

<!-- With custom text -->
<BreadcrumbSeparator>
  <span>›</span>
</BreadcrumbSeparator>

<!-- With icon -->
<BreadcrumbSeparator>
  <Icon name="mdi:chevron-right" class="size-4" />
</BreadcrumbSeparator>

<!-- With double arrow -->
<BreadcrumbSeparator>
  <span>»</span>
</BreadcrumbSeparator>

<!-- With dot -->
<BreadcrumbSeparator>
  <span>•</span>
</BreadcrumbSeparator>`}
  />

  <h2 id="ellipsis">{d.withEllipsis ?? "With ellipsis"}</h2>

  <p>Use <code class="inline-code">BreadcrumbEllipsis</code> to indicate hidden levels:</p>

  <div class="example-section">
    <BreadcrumbComponent>
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbEllipsis />
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/docs/components">Components</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </BreadcrumbComponent>
  </div>

  <Code
    lang="astro"
    code={`<BreadcrumbComponent>
  <BreadcrumbList>
    <BreadcrumbItem>
      <BreadcrumbLink href="/">Home</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem>
      <BreadcrumbEllipsis />
    </BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem>
      <BreadcrumbLink href="/docs/components">Components</BreadcrumbLink>
    </BreadcrumbItem>
    <BreadcrumbSeparator />
    <BreadcrumbItem>
      <BreadcrumbPage>Breadcrumb</BreadcrumbPage>
    </BreadcrumbItem>
  </BreadcrumbList>
</BreadcrumbComponent>`}
  />

  <h2 id="accessibility">{d.accessibility ?? "Accessibility"}</h2>

  <ul>
    <li><strong>Semantic navigation:</strong> Uses <code class="inline-code">&lt;nav aria-label="Breadcrumb"&gt;</code></li>
    <li><strong>Ordered list:</strong> <code class="inline-code">&lt;ol&gt;</code> for hierarchy</li>
    <li><strong>Current page:</strong> <code class="inline-code">aria-current="page"</code> on BreadcrumbPage</li>
    <li><strong>Separators:</strong> <code class="inline-code">role="presentation"</code> and <code class="inline-code">aria-hidden="true"</code></li>
    <li><strong>Keyboard:</strong> Standard Tab navigation</li>
  </ul>

  <h2>{d.bestPractices ?? "Best practices"}</h2>

  <ul>
    <li><strong>Consistency:</strong> Use the same variant as your design system</li>
    <li><strong>Clear hierarchy:</strong> Show only relevant levels</li>
    <li><strong>Smart truncation:</strong> Use BreadcrumbEllipsis for long paths</li>
    <li><strong>Mobile:</strong> The breadcrumb automatically adapts with flex-wrap</li>
    <li><strong>Performance:</strong> Components are static (no JavaScript)</li>
  </ul>

  <h2>{d.fullExample ?? "Exemple complet"}</h2>

  <div class="example-section">
    <BreadcrumbComponent variant="futuristic" color="primary">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">
            <Icon name="mdi:home" class="size-3" />

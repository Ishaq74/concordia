---
import DocLayout from "@layouts/DocLayout.astro";
import { Code } from "astro:components";
import RangeComponent from "@components/ui/Form/Range.astro";
import TableOfContents from "@components/templates/docs/TableOfContents.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import { getTranslations } from "@i18n/translations";
const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const d = t.docs?.common ?? {};
const p = t.docs?.pages?.range ?? {};
---

<DocLayout
  title={p.title ?? "Range Input"}
  description={p.description ?? "Slider (input[type=range]) with visual variants"}
  variant="initial"
>
  <h1 id="range-component">{p.title ?? "Range Input"}</h1>

  <p set:html={p.intro ?? 'Le composant <code class="inline-code">Range</code> encapsule un <code>input[type=range]</code> natif et gère les variantes visuelles. Les attributs HTML standard (min/max/step/value, etc.) sont transmis automatiquement via <code class="inline-code">&#96;...rest&#96;</code>.'} />

  <TableOfContents
    items={[
      { label: d.installation ?? "Installation", href: "#installation" },
      { label: d.props ?? "Props", href: "#props" },
      { label: d.basicUsage ?? "Basic usage", href: "#basic" },
      { label: d.variants ?? "Variants", href: "#variants" },
      { label: d.accessibility ?? "Accessibility", href: "#accessibility" },
    ]}
    title={d.tableOfContents ?? "Table of contents"}
  />

  <h2 id="installation">{d.installation ?? "Installation"}</h2>
  <Code
    lang="astro"
    code={`import Range from '@components/ui/Form/Range.astro';`}
  />

  <h2 id="props">{d.props ?? "Props"}</h2>
  <Table variant="initial">
    <TableHeader>
      <TableRow>
        <TableHead>{d.prop ?? "Prop"}</TableHead>
        <TableHead>{d.type ?? "Type"}</TableHead>
        <TableHead>{d.default ?? "Default"}</TableHead>
        <TableHead>{d.description ?? "Description"}</TableHead>
      </TableRow>
    </TableHeader>
    <TableBody>
      <TableRow>
        <TableCell><code class="inline-code">variant</code></TableCell>
        <TableCell><code class="inline-code">"initial" | "retro" | "modern" | "futuristic"</code></TableCell>
        <TableCell><code class="inline-code">"initial"</code></TableCell>
        <TableCell>{p?.propDescs?.variant ?? "Visual variant (affects track/thumb style)"}</TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code class="inline-code">min</code></TableCell>
        <TableCell><code class="inline-code">number</code></TableCell>
        <TableCell></TableCell>
        <TableCell>{p?.propDescs?.min ?? "Minimum value"}</TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code class="inline-code">max</code></TableCell>
        <TableCell><code class="inline-code">number</code></TableCell>
        <TableCell></TableCell>
        <TableCell>{p?.propDescs?.max ?? "Maximum value"}</TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code class="inline-code">step</code></TableCell>
        <TableCell><code class="inline-code">number</code></TableCell>
        <TableCell></TableCell>
        <TableCell>{p?.propDescs?.step ?? "Increment step"}</TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code class="inline-code">value</code></TableCell>
        <TableCell><code class="inline-code">number | string</code></TableCell>
        <TableCell></TableCell>
        <TableCell>{p?.propDescs?.value ?? "Initial value"}</TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code class="inline-code">className</code></TableCell>
        <TableCell><code class="inline-code">string</code></TableCell>
        <TableCell><code class="inline-code">""</code></TableCell>
        <TableCell>{d.descAdditionalCss ?? "Additional CSS classes"}</TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code class="inline-code">...rest</code></TableCell>
        <TableCell><code class="inline-code">any</code></TableCell>
        <TableCell></TableCell>
        <TableCell>{p?.propDescs?.rest ?? "Any other standard input attributes"}</TableCell>
      </TableRow>
    </TableBody>
  </Table>

  <h2 id="basic">{d.basicUsage ?? "Basic usage"}</h2>
  <p>{p.basicIntro ?? "The component simply renders a full‑width range input."}</p>
  <div class="demo-section">
    <RangeComponent min={0} max={100} value={30} />
  </div>
  <Code
    lang="astro"
    code={`<RangeComponent min={0} max={100} value={30} />`}
  />

  <h2 id="variants">{d.variants ?? "Variants"}</h2>
  <p>{p.variantsIntro ?? "Pass the \`variant\` prop or use a CSS class to switch styles."}</p>
  <div class="demo-section" style="display:flex;gap:1rem;flex-wrap:wrap;">
    <RangeComponent variant="initial" value={20} min={0} max={100} />
    <RangeComponent variant="retro" value={40} min={0} max={100} />
    <RangeComponent variant="modern" value={60} min={0} max={100} />
    <RangeComponent variant="futuristic" value={80} min={0} max={100} />
  </div>
  <Code
    lang="astro"
    code={`<RangeComponent variant="modern" min={0} max={100} value={50} />`}
  />

  <h2 id="accessibility">{d.accessibility ?? "Accessibility"}</h2>
  <p>{p.accessibility ?? "Use standard aria attributes with the \`...rest\` spread (aria-valuenow, aria-label, etc.)."}</p>
</DocLayout>
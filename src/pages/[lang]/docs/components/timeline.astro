---
import DocLayout from "@layouts/DocLayout.astro";
import { Code } from "astro:components";
import TimelineComponent from "@components/ui/Timeline.astro";
import AlertComponent from "@components/ui/Alert.astro";
import TableOfContents from "@/components/templates/docs/TableOfContents.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import { getTranslations } from "@i18n/translations";
const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const d = t.docs?.common ?? {};
const p = t.docs?.pages?.timeline ?? {};


const timelineEvents = [
  {
    year: "2020",
    title: "Company Founded",
    description: "Started our journey with a vision to change the world.",
    icon: "🚀"
  },
  {
    year: "2021",
    title: "First Product Launch",
    description: "Released our flagship product to the market with great success.",
    icon: "🎯"
  },
  {
    year: "2022",
    title: "International Expansion",
    description: "Opened offices in 5 new countries across Europe and Asia.",
    icon: "🌍"
  },
  {
    year: "2023",
    title: "Major Milestone",
    description: "Reached 1 million users and secured Series B funding.",
    icon: "💎"
  },
  {
    year: "2024",
    title: "Innovation Award",
    description: "Received industry recognition for our cutting-edge technology.",
    icon: "🏆"
  },
];

const shortEvents = timelineEvents.slice(0, 3);
---

<DocLayout 
  title={p.title ?? "Timeline Component"} 
  description={p.description ?? "Timeline component with 3 orientations and 4 pure CSS variants (ZERO JavaScript)"} 
  variant="initial"
>
  <h1 id="timeline-component">{p.title ?? "Timeline Component"}</h1>

  <p set:html={p.intro ?? `The <code class="inline-code">Timeline</code> component offers 3 orientations:  <strong>Vertical</strong>, <strong>Horizontal</strong>, and <strong>Alternate</strong> (zigzag).`} />

  <TableOfContents
    items={[
      { label: d.installation ?? "Installation", href: "#installation" },
      { label: d.verticalOrientation ?? "Vertical orientation", href: "#vertical" },
      { label: d.horizontalOrientation ?? "Horizontal orientation", href: "#horizontal" },
      { label: d.alternateOrientation ?? "Alternate orientation", href: "#alternate" },
      { label: d.iconShapes ?? "Icon shapes", href: "#shapes" },
      { label: d.variants ?? "Variants", href: "#variants" },
      { label: d.apiReference ?? "API Reference", href: "#api" },
    ]}
    title={d.tableOfContents ?? "Table of contents"}
  />

  <h2 id="installation">{d.installation ?? "Installation"}</h2>

  <Code
    lang="astro"
    code={`import Timeline from '@components/ui/Timeline.astro';`}
  />

  <h2 id="vertical">{d.verticalOrientation ?? "Vertical orientation"}</h2>
  <p>{p.ui1 ?? "Classic vertical timeline with line on the left."}</p>

  <div class="demo-section">
    <TimelineComponent 
      events={timelineEvents}
      orientation="vertical"
      iconShape="circle"
    />
  </div>

  <Code
    lang="astro"
    code={`<TimelineComponent 
  events={timelineEvents}
  orientation="vertical"
  iconShape="circle"
/>`}
  />

  <h2 id="horizontal">{d.horizontalOrientation ?? "Horizontal orientation"}</h2>
  <p>{p.ui2 ?? "Horizontal timeline with scroll (perfect for mobile)."}</p>

  <div class="demo-section">
    <TimelineComponent 
      events={timelineEvents}
      orientation="horizontal"
      iconShape="circle"
    />
  </div>

  <Code
    lang="astro"
    code={`<TimelineComponent 
  events={timelineEvents}
  orientation="horizontal"
  iconShape="circle"
/>`}
  />

  <h2 id="alternate">{d.alternateOrientation ?? "Alternate orientation (Zigzag)"}</h2>
  <p>{p.ui3 ?? "Zigzag timeline with alternating left/right elements."}</p>

  <div class="demo-section">
    <TimelineComponent 
      events={timelineEvents}
      orientation="alternate"
      iconShape="circle"
    />
  </div>

  <Code
    lang="astro"
    code={`<TimelineComponent 
  events={timelineEvents}
  orientation="alternate"
  iconShape="circle"
/>`}
  />

  <h2 id="shapes">{d.iconShapes ?? "Icon shapes"}</h2>

  <h3>{d.circle ?? "Circle (Default)"}</h3>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      orientation="vertical"
      iconShape="circle"
    />
  </div>

  <h3>{d.square ?? "Square"}</h3>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      orientation="vertical"
      iconShape="square"
    />
  </div>

  <h3>{d.diamond ?? "Diamond"}</h3>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      orientation="vertical"
      iconShape="diamond"
    />
  </div>

  <h3>{d.hexagon ?? "Hexagon"}</h3>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      orientation="vertical"
      iconShape="hexagon"
    />
  </div>

  <h2 id="variants">{d.variants ?? "Variants"}</h2>

  <h3>{d.retroVariant ?? "Retro variant"}</h3>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      variant="retro"
      orientation="vertical"
      iconShape="square"
    />
  </div>

  <Code
    lang="astro"
    code={`<TimelineComponent 
  events={shortEvents}
  variant="retro"
  orientation="vertical"
  iconShape="square"
/>`}
  />

  <h3>{d.modernVariant ?? "Modern variant"}</h3>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      variant="modern"
      orientation="vertical"
      iconShape="circle"
    />
  </div>

  <Code
    lang="astro"
    code={`<TimelineComponent 
  events={shortEvents}
  variant="modern"
  orientation="vertical"
  iconShape="circle"
/>`}
  />

  <h3>{d.futuristicVariant ?? "Futuristic variant"}</h3>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      variant="futuristic"
      orientation="vertical"
      iconShape="hexagon"
    />
  </div>

  <Code
    lang="astro"
    code={`<TimelineComponent 
  events={shortEvents}
  variant="futuristic"
  orientation="vertical"
  iconShape="hexagon"
/>`}
  />

  <h3>{d.alternateWithVariants ?? "Alternate with variants"}</h3>
  
  <h4>Retro alternate</h4>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      variant="retro"
      orientation="alternate"
      iconShape="square"
    />
  </div>

  <h4>Modern alternate</h4>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      variant="modern"
      orientation="alternate"
      iconShape="circle"
    />
  </div>

  <h4>Futuristic alternate</h4>
  <div class="demo-section">
    <TimelineComponent 
      events={shortEvents}
      variant="futuristic"
      orientation="alternate"
      iconShape="diamond"
    />
  </div>

  <h2 id="api">{d.apiReference ?? "API Reference"}</h2>

  <h3>{d.props ?? "Props"}</h3>

  <div class="props-table">
    <Table striped>
      <TableHeader>
        <TableRow>
          <TableHead>{d.prop ?? "Prop"}</TableHead>
          <TableHead>{d.type ?? "Type"}</TableHead>
          <TableHead>{d.default ?? "Default"}</TableHead>
          <TableHead>{d.description ?? "Description"}</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        <TableRow>
          <TableCell><code class="inline-code">events</code></TableCell>
          <TableCell>TimelineEvent[]</TableCell>
          <TableCell>-</TableCell>
          <TableCell>{d.descEventsArray ?? "Array of events to display"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">variant</code></TableCell>
          <TableCell>"initial" | "retro" | "modern" | "futuristic"</TableCell>
          <TableCell>"initial"</TableCell>
          <TableCell>{d.descVisualStyle ?? "Visual style of the timeline"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">orientation</code></TableCell>
          <TableCell>"vertical" | "horizontal" | "alternate"</TableCell>
          <TableCell>"vertical"</TableCell>
          <TableCell>{d.descOrientation ?? "Timeline orientation"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">iconShape</code></TableCell>
          <TableCell>"circle" | "square" | "diamond" | "hexagon"</TableCell>
          <TableCell>"circle"</TableCell>
          <TableCell>{d.descIconShape ?? "Icon shape"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">class</code></TableCell>
          <TableCell>string</TableCell>
          <TableCell>-</TableCell>
          <TableCell>{d.descAdditionalCss ?? "Additional CSS classes"}</TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </div>

  <h3>{d.timelineEventInterface ?? "TimelineEvent Interface"}</h3>

  <Code
    lang="typescript"
    code={`interface TimelineEvent {
  year?: string;        // Year or short date
  date?: string;        // Alternative date
  title: string;        // Event title
  description: string;  // Detailed description
  icon?: string;        // Emoji or icon text
}`}
  />

  <h2>{d.responsive ?? "Responsive"}</h2>

  <p>{p.ui4 ?? "The timeline automatically adapts on mobile:"}</p>

  <ul>
    <li><strong>Vertical</strong>: Stays vertical, reduced padding</li>
    <li><strong>Horizontal</strong>: Horizontal scrolling with scroll-snap</li>
    <li><strong>Alternate</strong>: Becomes vertical on mobile (line on the left)</li>
  </ul>

  <AlertComponent status="info">
    <strong>Note:</strong> ZERO JavaScript! All animations use only CSS with transitions and keyframes.
  </AlertComponent>

  <h2>{d.dataExamples ?? "Data examples"}</h2>

  <Code
    lang="typescript"
    code={`const timelineEvents = [
  {
    year: "2020",
    title: "Company Founded",
    description: "Started our journey with a vision.",
    icon: "🚀"
    },
    {
    year: "2021",
    title: "First Product Launch",
    description: "Released our flagship product.",
    icon: "🎯"
    },
    {
    year: "2022",
    title: "International Expansion",
    description: "Opened offices in 5 countries.",
    icon: "🌍"
  }
];`}
  />
</DocLayout>
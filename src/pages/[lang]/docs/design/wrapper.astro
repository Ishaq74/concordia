---
import DocLayout from "@layouts/DocLayout.astro";
import WrapperComponent from "@components/Tools/Wrapper.astro";
import { Code } from "astro:components";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import { getTranslations } from "@i18n/translations";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const d = t.docs?.common ?? {};
const p = t.docs?.pages?.wrapper ?? {};
---

<DocLayout 
  title={p.title ?? "Wrapper Component"} 
  description={p.description ?? "Complete documentation for the Wrapper component — flexible layout, responsive, layered backgrounds, overlays, animations, and more."}
  variant="initial"
>

<h1 id="wrapper-component">{p.title ?? "Wrapper Component"}</h1>

<p set:html={p.intro ?? `The <code>WrapperComponent</code> component is a highly flexible container for layouts. Supports background colors, images, videos, overlays, clip-paths, SVGs, dividers, flex/grid layouts, spacing tokens, RTL, and animation classes.`} />

<h2 id="installation">{d.installation ?? "Installation"}</h2>
<p>{d.componentAvailableAt ?? "The component is available in"} <code class="inline-code">src/components/Tools/</code></p>

<Code
  lang="typescript"
  code={`import WrapperComponent from '@components/Tools/Wrapper.astro';`}
/>

<h2 id="props">{d.props ?? "Props"}</h2>

<h3 id="wrapper-props">{d.wrapperComponent ?? "WrapperComponent"}</h3>

<div class="props-table">
<Table striped>
  <TableHeader>
    <TableRow>
      <TableHead>{d.prop ?? "Prop"}</TableHead>
      <TableHead>{d.type ?? "Type"}</TableHead>
      <TableHead>{d.default ?? "Default"}</TableHead>
      <TableHead>{d.description ?? "Description"}</TableHead>
    </TableRow>
  </TableHeader>
  <TableBody>
    <TableRow>
      <TableCell><code>tag</code></TableCell>
      <TableCell>keyof HTMLElementTagNameMap</TableCell>
      <TableCell>"section"</TableCell>
      <TableCell>HTML tag to render</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>display</code></TableCell>
      <TableCell>"block" | "flex" | "grid" | "inline-flex" | "inline-grid"</TableCell>
      <TableCell>"block"</TableCell>
      <TableCell>Layout display type</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>cols</code></TableCell>
      <TableCell>string | number</TableCell>
      <TableCell>"1fr"</TableCell>
      <TableCell>Grid columns (ignored if flex)</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>gap</code></TableCell>
      <TableCell>string (spacing token or CSS value)</TableCell>
      <TableCell>-</TableCell>
      <TableCell>Gap between grid/flex items</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>autoFit</code></TableCell>
      <TableCell>boolean</TableCell>
      <TableCell>false</TableCell>
      <TableCell>Grid auto-fit columns</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>autoFill</code></TableCell>
      <TableCell>boolean</TableCell>
      <TableCell>false</TableCell>
      <TableCell>Grid auto-fill columns</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>flexDirection</code></TableCell>
      <TableCell>"row" | "row-reverse" | "column" | "column-reverse"</TableCell>
      <TableCell>"row"</TableCell>
      <TableCell>Flex direction</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>flexWrap</code></TableCell>
      <TableCell>"nowrap" | "wrap" | "wrap-reverse"</TableCell>
      <TableCell>"nowrap"</TableCell>
      <TableCell>Flex wrapping</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>xAlign</code></TableCell>
      <TableCell>"left" | "center" | "right" | "space-between" | "space-around" | "space-evenly" | "normal"</TableCell>
      <TableCell>"normal"</TableCell>
      <TableCell>Horizontal alignment (flex/grid)</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>yAlign</code></TableCell>
      <TableCell>"top" | "center" | "bottom" | "stretch"</TableCell>
      <TableCell>"top"</TableCell>
      <TableCell>Vertical alignment (flex/grid)</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>align</code></TableCell>
      <TableCell>"center"</TableCell>
      <TableCell>-</TableCell>
      <TableCell>Shortcut to center both axes</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>justifyItems</code></TableCell>
      <TableCell>"start" | "center" | "end" | "stretch"</TableCell>
      <TableCell>"stretch"</TableCell>
      <TableCell>Align grid items horizontally</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>alignItems</code></TableCell>
      <TableCell>"flex-start" | "center" | "flex-end" | "baseline" | "stretch"</TableCell>
      <TableCell>"stretch"</TableCell>
      <TableCell>Align flex/grid items vertically</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>alignContent</code></TableCell>
      <TableCell>"flex-start" | "center" | "flex-end" | "space-between" | "space-around" | "stretch"</TableCell>
      <TableCell>"stretch"</TableCell>
      <TableCell>Align grid content</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>padding / paddingTop / paddingBottom / paddingLeft / paddingRight</code></TableCell>
      <TableCell>string (spacing token: none, xsm, sm, md, lg, xl, 2xl, or any CSS value)</TableCell>
      <TableCell>"md"</TableCell>
      <TableCell>Padding with RTL support</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>margin / marginTop / marginBottom / marginLeft / marginRight</code></TableCell>
      <TableCell>string (spacing token or CSS value)</TableCell>
      <TableCell>"md"</TableCell>
      <TableCell>Margin with RTL support</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>width / height / maxWidth / minHeight</code></TableCell>
      <TableCell>string</TableCell>
      <TableCell>100% / auto / 100% / 0</TableCell>
      <TableCell>Dimensions</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>backgroundColor / backgroundImage / backgroundVideo / backgroundBlendMode / overlayColor / overlayOpacity / clipPathTop / clipPathBottom</code></TableCell>
      <TableCell>string | number</TableCell>
      <TableCell>-</TableCell>
      <TableCell>Visual layering options</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>border / borderType / borderColor / borderWidth / borderStyle / borderRadius / boxShadow</code></TableCell>
      <TableCell>various</TableCell>
      <TableCell>-</TableCell>
      <TableCell>Border and shadow options</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>variant / color</code></TableCell>
      <TableCell>string</TableCell>
      <TableCell>initial / default</TableCell>
      <TableCell>Visual and color variant (affects background, text, shadow)</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>animate / hoverAnimate / focusAnimate / activeAnimate / transitionDuration / transitionTiming</code></TableCell>
      <TableCell>string</TableCell>
      <TableCell>-</TableCell>
      <TableCell>CSS animation classes / transitions</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>hidden / disabled / ariaLabel</code></TableCell>
      <TableCell>boolean | string</TableCell>
      <TableCell>false</TableCell>
      <TableCell>States</TableCell>
    </TableRow>
    <TableRow>
      <TableCell><code>customClasses / className / style</code></TableCell>
      <TableCell>string</TableCell>
      <TableCell>-</TableCell>
      <TableCell>Custom styling and classes</TableCell>
    </TableRow>
  </TableBody>
</Table>
</div>

<h2 id="basic-examples">{d.basicUsage ?? "Basic examples"}</h2>

<h3 id="simple-wrapper">{d.simpleWrapper ?? "Simple wrapper"}</h3>

<div class="example">
  <WrapperComponent backgroundColor="lightgray" padding="lg">
    <p>This is a simple wrapper with background color and padding.</p>
  </WrapperComponent>
</div>

<Code
  lang="astro"
  code={`<WrapperComponent backgroundColor="lightgray" padding="lg">
  <p>Simple wrapper content</p>
</WrapperComponent>`}
/>

<h3 id="wrapper-with-video">{d.wrapperVideo ?? "Wrapper with video & overlay"}</h3>

<div class="example">
  <WrapperComponent 
    backgroundVideo="https://www.w3schools.com/html/mov_bbb.mp4"
    overlayColor="rgba(0,0,0,0.5)"
    padding="xl"
  >
    <p class="text-white">Video background with overlay</p>
  </WrapperComponent>
</div>

<Code
  lang="astro"
  code={`<WrapperComponent 
  backgroundVideo="video.mp4"
  overlayColor="rgba(0,0,0,0.5)"
  padding="xl"
>
  <p class="text-white">Video overlay example</p>
</WrapperComponent>`}
/>

<h3 id="wrapper-grid-flex">{d.wrapperGridFlex ?? "Wrapper Grid & Flex"}</h3>

<div class="example-grid">
  <WrapperComponent display="flex" flexDirection="row" flexWrap="wrap" xAlign="space-between" padding="md">
    <div class="box">Flex 1</div>
    <div class="box">Flex 2</div>
    <div class="box">Flex 3</div>
  </WrapperComponent>
  <WrapperComponent display="grid" cols={3} gap="md" padding="md">
    <div class="box">Grid 1</div>
    <div class="box">Grid 2</div>
    <div class="box">Grid 3</div>
  </WrapperComponent>
</div>

<Code
  lang="astro"
  code={`<WrapperComponent display="flex" flexDirection="row" flexWrap="wrap" xAlign="space-between">
  <div>Item 1</div>
  <div>Item 2</div>
</WrapperComponent>

<WrapperComponent display="grid" cols={3} gap="md">
  <div>Item 1</div>
  <div>Item 2</div>
  <div>Item 3</div>
</WrapperComponent>`}
/>

<h3 id="wrapper-clip-overlay">{d.wrapperClipOverlay ?? "Clip-path & Overlay"}</h3>

<div class="example">
  <WrapperComponent 
    backgroundColor="skyblue"
    overlayColor="rgba(255,255,255,0.2)"
    overlayOpacity={0.5}
    clipPathTop="polygon(0 0, 100% 10%, 100% 100%, 0 100%)"
    clipPathBottom="polygon(0 0, 100% 0, 100% 90%, 0 100%)"
    padding="2xl"
  >
    <p>Wrapper with top & bottom clip-paths and overlay</p>
  </WrapperComponent>
</div>

<Code
  lang="astro"
  code={`<WrapperComponent 
  overlayColor="rgba(255,255,255,0.2)" 
  clipPathTop="polygon(...)" 
  clipPathBottom="polygon(...)" 
>
  Content
</WrapperComponent>`}
/>

<h2 id="variants">{d.variants ?? "Variants"}</h2>

<div class="example-grid">
  <WrapperComponent variant="initial" padding="lg"><p>Initial</p></WrapperComponent>
  <WrapperComponent variant="retro" padding="lg"><p>Retro</p></WrapperComponent>
  <WrapperComponent variant="modern" padding="lg"><p>Modern</p></WrapperComponent>
  <WrapperComponent variant="futuristic" padding="lg"><p>Futuristic</p></WrapperComponent>
</div>

<Code
  lang="astro"
  code={`<WrapperComponent variant="initial">...</WrapperComponent>
<WrapperComponent variant="retro">...</WrapperComponent>
<WrapperComponent variant="modern">...</WrapperComponent>
<WrapperComponent variant="futuristic">...</WrapperComponent>`}
/>

<h2 id="animations">{d.animations ?? "Animations"}</h2>

<div class="example">
  <WrapperComponent animate="fade-in" hoverAnimate="scale-up" padding="md">
    <p>Wrapper with fade-in and hover scale</p>
  </WrapperComponent>
</div>

<Code
  lang="astro"
  code={`<WrapperComponent animate="fade-in" hoverAnimate="scale-up">
  Animated wrapper
</WrapperComponent>`}
/>

<h2 id="slots">{d.slots ?? "Slots"}</h2>
<ul>
  <li><code>top-svg</code> — top SVG decoration</li>
  <li><code>divider-top</code> — top divider</li>
  <li><code>default</code> — main content</li>
  <li><code>divider-bottom</code> — bottom divider</li>
  <li><code>bottom-svg</code> — bottom SVG decoration</li>
</ul>

<h2 id="best-practices">{d.bestPractices ?? "Best practices"}</h2>
<ul>
  <li>Use <code>overlayColor</code> for text readability on images/videos</li>
  <li>Clip-paths can create dynamic section shapes</li>
  <li>Use spacing tokens for consistent padding/margin</li>
  <li>Variants standardize visual style across app</li>
  <li>Interactive animations should enhance UX without overwhelming</li>
  <li>Use <code>minHeight</code> and <code>maxWidth</code> to prevent layout breaking</li>
  <li>RTL support automatically adjusts padding/margin inline</li>
</ul>

<h2 id="accessibility">{d.accessibility ?? "Accessibility"}</h2>
<ul>
  <li>Use semantic tags via <code>tag</code> prop</li>
  <li>Provide <code>ariaLabel</code> for non-text sections</li>
  <li>Videos should have captions if relevant</li>
  <li>Overlay opacity should maintain contrast for readability</li>
</ul>

</DocLayout>
---
import DocLayout from "@layouts/DocLayout.astro";
import { Code } from "astro:components";
import { getTranslations } from "@i18n/translations";
const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const i = t.docs?.intro ?? {};
const f = i.features ?? {};
const pg = t.docs?.pages ?? {};
---

<DocLayout 
  title={i.title ?? "Introduction"} 
  description={i.description ?? "Welcome to the design system - Complete guide to components, variants and best practices"}
  variant="initial"
>
  <h1 id="introduction">{i.title ?? "Introduction"}</h1>
  
  <p set:html={i.welcome ?? `Welcome to the design system documentation. This library offers a complete collection of UI components with multiple visual variants to adapt to different styles and needs.`} />

  <h2 id="what-is-this-system">{i.whatIsTitle ?? "What is this design system?"}</h2>
  
  <p set:html={i.whatIsDescription ?? `This design system is built with Astro and native CSS, offering:`} />

  <ul>
    <li><strong>{f.reusable ?? "Reusable components"}</strong> - {f.reusableDesc ?? "Link, Button, Input, Card, Badge, Alert, etc."}</li>
    <li><strong>{f.variants ?? "Multiple visual variants"}</strong> - {f.variantsDesc ?? "Initial, Retro, Modern, Futuristic"}</li>
    <li><strong>{f.cssNative ?? "Native CSS with variables"}</strong> - {f.cssNativeDesc ?? "Easy customization via CSS custom properties"}</li>
    <li><strong>{f.tokens ?? "Design tokens"}</strong> - {f.tokensDesc ?? "Colors, typography, spacing and components"}</li>
    <li><strong>{f.accessibility ?? "Accessibility"}</strong> - {f.accessibilityDesc ?? "Built with accessibility best practices"}</li>
    <li><strong>{f.performance ?? "Optimal performance"}</strong> - {f.performanceDesc ?? "Progressive loading and minimal CSS"}</li>
  </ul>

  <h2 id="project-structure">{i.structureTitle ?? "Project Structure"}</h2>
  
  <p>{i.structureDescription ?? "The project is organized logically to facilitate navigation and maintenance:"}</p>

  <Code
    lang="plaintext"
    code={`src/
├── components/
│   ├── ui/           # Reusable UI components
│   └── templates/    # Page templates and structures
├── layouts/          # Base layouts
├── pages/            # Site pages
│   └── docs/         # Documentation
│       └── design/   # Design system documentation
├── styles/
│   ├── base.css      # Base styles
│   ├── global.css    # Global styles
│   ├── tokens/       # Design tokens
│   │   ├── colors.css
│   │   ├── typography.css
│   │   ├── spacing.css
│   │   └── components.css
│   └── components/   # Variant styles
│       ├── initial.css
│       ├── retro.css
│       ├── modern.css
│       └── futuristic.css
└── fonts/            # Custom fonts`}
  />

  <h2 id="variants">{i.variantsTitle ?? "Variants"}</h2>
  
  <p set:html={i.variantsDescription ?? `Each component can be displayed in different visual styles called <strong>variants</strong>. The four available variants are:`} />

  <div class="variants-grid">
    <div class="variant-card">
      <h3>{i.variantInitialTitle ?? "Initial"}</h3>
      <p>{i.variantInitialDesc ?? "Clean and modern design with sharp lines and subtle colors."}</p>
    </div>
    
    <div class="variant-card">
      <h3>{i.variantRetroTitle ?? "Retro"}</h3>
      <p>{i.variantRetroDesc ?? "Vintage inspiration with character fonts and nostalgic colors."}</p>
    </div>
    
    <div class="variant-card">
      <h3>{i.variantModernTitle ?? "Modern"}</h3>
      <p>{i.variantModernDesc ?? "Contemporary style with gradients and elegant visual effects."}</p>
    </div>
    
    <div class="variant-card">
      <h3>{i.variantFuturisticTitle ?? "Futuristic"}</h3>
      <p>{i.variantFuturisticDesc ?? "Avant-garde design with neon, glassmorphism and cyberpunk effects."}</p>
    </div>
  </div>

  <h2 id="getting-started">{i.getStartedTitle ?? "Getting Started"}</h2>
  
  <p>{i.getStartedDescription ?? "Explore the different sections of the documentation to discover all the components and their possibilities."}</p>

  <h2 id="design-tokens">{i.darkModeTitle ?? "Design Tokens"}</h2>
  
  <p>
    {pg.indexWhatIsDesc ?? "The system uses design tokens (CSS variables) to maintain consistency across all components:"}
  </p>

  <ul>
    <li><strong>{t.docs?.colors ?? "Colors"}</strong> - Color palette with light/dark variants</li>
    <li><strong>{t.docs?.typography ?? "Typography"}</strong> - Size scale, font families and line heights</li>
    <li><strong>{t.docs?.spacing ?? "Spacing"}</strong> - Consistent spacing system (4px, 8px, 16px, etc.)</li>
    <li><strong>{t.docs?.components ?? "Components"}</strong> - Component-specific variables (borders, shadows, etc.)</li>
  </ul>

</DocLayout>

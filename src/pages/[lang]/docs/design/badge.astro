---
import DocLayout from "@layouts/DocLayout.astro";
import BadgeComponent from "@components/ui/Badge.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import { Code } from "astro:components";
import { getTranslations } from "@i18n/translations";
const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const d = t.docs?.common ?? {};
const p = t.docs?.pages?.badge ?? {};
---

<DocLayout 
  title={p.title ?? "Badge Component"} 
  description={p.description ?? "Documentation for the Badge component to display labels, statuses, and compact information"}
  variant="initial"
>
  <h1 id="badge-component">{p.title ?? "Badge Component"}</h1>
  
  <p set:html={p.intro ?? `The <code class="inline-code">Badge</code> component lets you display labels, statuses, counters, and other compact information, with support for variants, icons, and dismissible mode.`} />

  <h2 id="installation">{d.installation ?? "Installation"}</h2>
  
  <p>{d.componentAvailableAt ?? "The component is available in"} <code class="inline-code">src/components/ui/Badge.astro</code></p>
  
  <Code
    lang="typescript"
    code={`import Badge from '@components/ui/Badge.astro';`}
  />

  <h2 id="props">{d.props ?? "Props"}</h2>

  <div class="props-table">
    <Table striped>
      <TableHeader>
        <TableRow>
          <TableHead>{d.prop ?? "Prop"}</TableHead>
          <TableHead>{d.type ?? "Type"}</TableHead>
          <TableHead>{d.default ?? "Default"}</TableHead>
          <TableHead>{d.description ?? "Description"}</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        <TableRow>
          <TableCell><code class="inline-code">variant</code></TableCell>
          <TableCell>initial | retro | modern | futuristic</TableCell>
          <TableCell>initial</TableCell>
          <TableCell>{p?.propDescs?.descBadgeVisual ?? "Badge visual style"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">color</code></TableCell>
          <TableCell>default | primary | secondary | accent</TableCell>
          <TableCell>default</TableCell>
          <TableCell>{p?.propDescs?.descBadgeColor ?? "Badge color"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">text</code></TableCell>
          <TableCell>string</TableCell>
          <TableCell>-</TableCell>
          <TableCell>{d.descBadgeText ?? "Badge text"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">icon</code></TableCell>
          <TableCell>{`{ name: string, side?: 'left' | 'right' }`}</TableCell>
          <TableCell>-</TableCell>
          <TableCell>{p?.propDescs?.descIconPosition ?? "Icon and position"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">dismissible</code></TableCell>
          <TableCell>boolean</TableCell>
          <TableCell>false</TableCell>
          <TableCell>{d.descShowClose ?? "Shows a close button"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">ariaLabel</code></TableCell>
          <TableCell>string</TableCell>
          <TableCell>-</TableCell>
          <TableCell>{d.descAriaLabel ?? "Accessibility label"}</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">className</code></TableCell>
          <TableCell>string</TableCell>
          <TableCell>-</TableCell>
          <TableCell>{d.descAdditionalCss ?? "Additional CSS classes"}</TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </div>

  <h2 id="basic-examples">{d.basicExamples ?? "Basic Examples"}</h2>

  <h3 id="simple-badges">{d.simpleBadges ?? "Simple Badges"}</h3>
  
  <div class="demo-box">
    <BadgeComponent text="New" />
    <BadgeComponent text="Beta" />
    <BadgeComponent text="v2.0" />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="New" />
<BadgeComponent text="Beta" />
<BadgeComponent text="v2.0" />`}
  />

  <h3 id="with-slot">{d.withSlotH3 ?? "With slot"}</h3>
  
  <div class="demo-box">
    <BadgeComponent>Custom Text</BadgeComponent>
    <BadgeComponent>🎉 Promo</BadgeComponent>
    <BadgeComponent>3</BadgeComponent>
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent>Custom Text</BadgeComponent>
<BadgeComponent>🎉 Promo</BadgeComponent>
<BadgeComponent>3</BadgeComponent>`}
  />

  <h2 id="colors">{d.colors ?? "Colors"}</h2>

  <h3 id="initial-colors">{d.variantInitial ?? "Initial"}</h3>
  
  <div class="demo-box">
    <BadgeComponent text="Default" />
    <BadgeComponent text="Primary" color="primary" />
    <BadgeComponent text="Secondary" color="secondary" />
    <BadgeComponent text="Accent" color="accent" />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="Default" />
<BadgeComponent text="Primary" color="primary" />
<BadgeComponent text="Secondary" color="secondary" />
<BadgeComponent text="Accent" color="accent" />`}
  />

  <h2 id="variants">{d.variants ?? "Variants"}</h2>

  <h3 id="variant-retro">{d.variantRetro ?? "Retro"}</h3>
  
  <div class="demo-box">
    <BadgeComponent text="Default" variant="retro" />
    <BadgeComponent text="Primary" variant="retro" color="primary" />
    <BadgeComponent text="Secondary" variant="retro" color="secondary" />
    <BadgeComponent text="Accent" variant="retro" color="accent" />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="Primary" variant="retro" color="primary" />`}
  />

  <h3 id="variant-modern">{d.variantModern ?? "Modern"}</h3>
  
  <div class="demo-box">
    <BadgeComponent text="Default" variant="modern" />
    <BadgeComponent text="Primary" variant="modern" color="primary" />
    <BadgeComponent text="Secondary" variant="modern" color="secondary" />
    <BadgeComponent text="Accent" variant="modern" color="accent" />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="Primary" variant="modern" color="primary" />`}
  />

  <h3 id="variant-futuristic">{d.variantFuturistic ?? "Futuristic"}</h3>
  
  <div class="demo-box">
    <BadgeComponent text="Default" variant="futuristic" />
    <BadgeComponent text="Primary" variant="futuristic" color="primary" />
    <BadgeComponent text="Secondary" variant="futuristic" color="secondary" />
    <BadgeComponent text="Accent" variant="futuristic" color="accent" />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="Primary" variant="futuristic" color="primary" />`}
  />

  <h2 id="with-icons">{d.withIcons ?? "With icons"}</h2>

  <h3 id="icon-left">{d.iconOnLeft ?? "Icon on left"}</h3>
  
  <div class="demo-box">
    <BadgeComponent 
      text="New" 
      color="primary"
      icon={{ name: "mdi:star", side: "left" }}
    />
    <BadgeComponent 
      text="In progress" 
      color="accent"
      icon={{ name: "mdi:clock", side: "left" }}
    />
    <BadgeComponent 
      text="Validated" 
      color="secondary"
      icon={{ name: "mdi:check", side: "left" }}
    />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent 
  text="Nouveau" 
  color="primary"
  icon={{ name: "mdi:star", side: "left" }}
/>`}
  />

  <h3 id="icon-right">{d.iconOnRight ?? "Icon on right"}</h3>
  
  <div class="demo-box">
    <BadgeComponent 
      text="Download" 
      color="primary"
      icon={{ name: "mdi:download", side: "right" }}
    />
    <BadgeComponent 
      text="External" 
      icon={{ name: "mdi:open-in-new", side: "right" }}
    />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent 
  text="Télécharger" 
  color="primary"
  icon={{ name: "mdi:download", side: "right" }}
/>`}
  />

  <h2 id="dismissible">{d.dismissibleBadges ?? "Dismissible badges"}</h2>

  <p>Badges can be closed by the user with the <code class="inline-code">dismissible</code> prop.</p>

  <div class="demo-box">
    <BadgeComponent text="New" color="primary" dismissible />
    <BadgeComponent text="Promo -20%" color="accent" dismissible />
    <BadgeComponent 
      text="Notification" 
      color="secondary"
      icon={{ name: "mdi:bell", side: "left" }}
      dismissible
    />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="New" color="primary" dismissible />
<BadgeComponent 
  text="Notification" 
  color="secondary"
  icon={{ name: "mdi:bell", side: "left" }}
  dismissible
/>`}
  />

  <h2 id="use-cases">{d.useCases ?? "Use cases"}</h2>

  <h3 id="counters">{d.counters ?? "Counters"}</h3>
  
  <div class="demo-box">
    <span>
      Messages
      <BadgeComponent text="3" color="primary" />
    </span>
    <span>
      Cart
      <BadgeComponent text="12" color="accent" />
    </span>
  </div>

  <Code
    lang="astro"
    code={`<span>
  Messages
  <BadgeComponent text="3" color="primary" />
</span>`}
  />

  <h3 id="statuses">{d.statuses ?? "Statuses"}</h3>
  
  <div class="demo-box">
    <BadgeComponent text="Online" color="primary" icon={{ name: "mdi:circle", side: "left" }} />
    <BadgeComponent text="Offline" icon={{ name: "mdi:circle", side: "left" }} />
    <BadgeComponent text="Busy" color="accent" icon={{ name: "mdi:circle", side: "left" }} />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="En ligne" color="primary" icon={{ name: "mdi:circle", side: "left" }} />`}
  />

  <h3 id="tags">{d.tags ?? "Tags"}</h3>
  
  <div class="demo-box">
    <BadgeComponent text="JavaScript" variant="modern" />
    <BadgeComponent text="TypeScript" variant="modern" color="primary" />
    <BadgeComponent text="React" variant="modern" color="secondary" />
    <BadgeComponent text="Astro" variant="modern" color="accent" />
    <BadgeComponent text="CSS" variant="modern" />
    <BadgeComponent text="HTML" variant="modern" />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="JavaScript" variant="modern" />
<BadgeComponent text="TypeScript" variant="modern" color="primary" />
<BadgeComponent text="React" variant="modern" color="secondary" />`}
  />

  <h3 id="versions">{d.versions ?? "Versions"}</h3>
  
  <div class="demo-box">
    <BadgeComponent text="v1.0.0" />
    <BadgeComponent text="v2.0.0" color="primary" />
    <BadgeComponent text="Beta" color="accent" />
    <BadgeComponent text="Alpha" color="secondary" />
  </div>

  <Code
    lang="astro"
    code={`<BadgeComponent text="v2.0.0" color="primary" />
<BadgeComponent text="Beta" color="accent" />`}
  />

  <h2 id="combinations">{d.variantsColorsCombinations ?? "Variants + colors combinations"}</h2>

  <div class="demo-box">
    <div>
      <BadgeComponent text="Initial" />
      <BadgeComponent text="Initial Primary" color="primary" />
      <BadgeComponent text="Initial Secondary" color="secondary" />
      <BadgeComponent text="Initial Accent" color="accent" />
    </div>
    
    <div>
      <BadgeComponent text="Retro" variant="retro" />
      <BadgeComponent text="Retro Primary" variant="retro" color="primary" />
      <BadgeComponent text="Retro Secondary" variant="retro" color="secondary" />
      <BadgeComponent text="Retro Accent" variant="retro" color="accent" />
    </div>
    
    <div>
      <BadgeComponent text="Modern" variant="modern" />
      <BadgeComponent text="Modern Primary" variant="modern" color="primary" />
      <BadgeComponent text="Modern Secondary" variant="modern" color="secondary" />
      <BadgeComponent text="Modern Accent" variant="modern" color="accent" />
    </div>
    
    <div>
      <BadgeComponent text="Futuristic" variant="futuristic" />
      <BadgeComponent text="Futuristic Primary" variant="futuristic" color="primary" />
      <BadgeComponent text="Futuristic Secondary" variant="futuristic" color="secondary" />
      <BadgeComponent text="Futuristic Accent" variant="futuristic" color="accent" />
    </div>
  </div>

  <h2 id="accessibility">{d.accessibility ?? "Accessibility"}</h2>

  <ul>
    <li>Use <code class="inline-code">ariaLabel</code> for icon-only badges</li>
    <li>{p.ui7 ?? `The close button has a default label "Close"`}</li>
    <li>Badges use semantic <code class="inline-code">&lt;span&gt;</code></li>
    <li>{p.ui1 ?? "Icons are decorative and do not affect readability"}</li>
  </ul>

  <h2 id="best-practices">{d.bestPractices ?? "Best practices"}</h2>

  <ul>
    <li>{p.ui2 ?? "Use badges for compact and non-critical information"}</li>
    <li>{p.ui3 ?? "Limit the number of badges displayed at once to avoid vis..."}</li>
    <li>{p.ui4 ?? "Use consistent colors for statuses (e.g. primary for acti..."}</li>
    <li>{p.ui5 ?? "Prefer short text (1-3 words max)"}</li>
    <li>Use <code class="inline-code">dismissible</code> for temporary notifications</li>
    <li>{p.ui6 ?? "Combine with icons to reinforce visual meaning"}</li>
  </ul>

</DocLayout>
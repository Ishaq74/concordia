---
import DocLayout from "@layouts/DocLayout.astro";
import { Code } from "astro:components";
import Alert from "@components/ui/Alert.astro";
import Badge from "@components/ui/Badge.astro";
import TOC from "@components/templates/docs/TableOfContents.astro";
import Table from "@components/ui/Table/Table.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import { getTranslations } from "@i18n/translations";
const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const d = t.docs?.common ?? {};
const p = t.docs?.pages?.headerTemplate ?? {};
---

<DocLayout 
  title={p.title ?? "Header Template"} 
  description={p.description ?? "Responsive Header template with navigation, theme switch and language chooser"} 
  variant="initial"
>
  <h1 id="header">{p.title ?? "Header Template"}</h1>

  <p set:html={p.intro ?? `The <code class="inline-code">Header</code> template is the main site header component.  It integrates the logo/brand, navigation, theme switcher and language selector.`} />

  <TOC
    items={[
      { label: d.includedComponents ?? "Included Components", href: "#composants" },
      { label: d.usage ?? "Usage", href: "#utilisation" },
      { label: d.props ?? "Props", href: "#props" },
      { label: d.variants ?? "Variants", href: "#variants" },
      { label: d.responsive ?? "Responsive", href: "#responsive" },
    ]}
    title={d.tableOfContents ?? "Table of Contents"}
  />

  <h2 id="composants">{d.includedComponents ?? "Composants inclus"}</h2>

  <p>{p.ui1 ?? "Le Header est composé de plusieurs sous-composants :"}</p>

  <ul>
    <li><strong>Brand</strong> - Logo et nom du site avec lien vers l'accueil</li>
    <li><strong>Navigation</strong> - Menu principal avec liens actifs</li>
    <li><strong>ThemeSwitch</strong> - Bouton pour changer entre light/dark mode</li>
    <li><strong>LangChooser</strong> - Dropdown pour changer de langue (FR/EN/ES/AR)</li>
  </ul>

  <h2 id="utilisation">{d.usage ?? "Utilisation"}</h2>

  <Code
    lang="astro"
    code={`---
import Header from '@components/templates/Header/Header.astro';
---

<Header variant="initial" fixed={false} />`}
  />

  <Alert variant="initial" status="info">
    <strong>✅ Auto-inclus :</strong> Le Header est automatiquement inclus dans le BaseLayout. 
    Vous n'avez pas besoin de l'importer manuellement dans vos pages.
  </Alert>

  <h2 id="props">{d.props ?? "Props"}</h2>

  <Table variant="initial">
    <TableHeader>
      <TableRow>
        <TableHead>{d.prop ?? "Prop"}</TableHead>
        <TableHead>{d.type ?? "Type"}</TableHead>
        <TableHead>{d.default ?? "Défaut"}</TableHead>
        <TableHead>{d.description ?? "Description"}</TableHead>
      </TableRow>
    </TableHeader>
    <TableBody>
      <TableRow>
        <TableCell><code>variant</code></TableCell>
        <TableCell><code>'initial' | 'retro' | 'modern' | 'futuristic'</code></TableCell>
        <TableCell><code>'initial'</code></TableCell>
        <TableCell>{p?.propDescs?.descHeaderVisual ?? "Style visuel du header"}</TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code>fixed</code></TableCell>
        <TableCell><code>boolean</code></TableCell>
        <TableCell><code>false</code></TableCell>
        <TableCell>{p?.propDescs?.descHeaderSticky ?? "Header fixe en haut (sticky)"}</TableCell>
      </TableRow>
      <TableRow>
        <TableCell><code>class</code></TableCell>
        <TableCell><code>string</code></TableCell>
        <TableCell><code>''</code></TableCell>
        <TableCell>{d.descAdditionalCss ?? "Classes CSS supplémentaires"}</TableCell>
      </TableRow>
    </TableBody>
  </Table>

  <h2 id="variants">{d.variants ?? "Variants"}</h2>

  <p>{p.ui2 ?? "Le Header supporte les 4 variants visuels :"}</p>

  <div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 1rem 0;">
    <Badge>initial</Badge>
    <Badge>retro</Badge>
    <Badge>modern</Badge>
    <Badge>futuristic</Badge>
  </div>

  <h3>{d.variantInitial ?? "Initial"}</h3>
  <p>{p.ui3 ?? "Design épuré avec background subtle et border légère."}</p>

  <h3>{d.variantRetro ?? "Retro"}</h3>
  <p>{p.ui4 ?? "Style rétro avec bordures épaisses et ombres portées."}</p>

  <h3>{d.variantModern ?? "Modern"}</h3>
  <p>{p.ui5 ?? "Design moderne avec glassmorphism et backdrop blur."}</p>

  <h3>{d.variantFuturistic ?? "Futuristic"}</h3>
  <p>{p.ui6 ?? "Style futuriste avec gradients néon et effets lumineux."}</p>

  <h2 id="responsive">{d.responsive ?? "Responsive"}</h2>

  <p>{p.ui7 ?? "Le Header s'adapte automatiquement aux différentes taille..."}</p>

  <ul>
    <li><strong>Desktop :</strong> Navigation horizontale complète</li>
    <li><strong>Tablet :</strong> Navigation compacte avec icônes</li>
    <li><strong>Mobile :</strong> Menu hamburger avec drawer</li>
  </ul>

  <h2>{d.structure ?? "Structure"}</h2>

  <Code
    lang="html"
    code={`<header class="header">
  <div class="header-container">
    <!-- Logo / Brand -->
    <Brand />
    
    <!-- Navigation principale -->
    <Navigation />
    
    <!-- Actions -->
    <div class="header-actions">
      <LangChooser />
      <ThemeSwitch />
    </div>
  </div>
</header>`}
  />

  <h2>{d.features ?? "Fonctionnalités"}</h2>

  <ul>
    <li>{p.ui8 ?? "✅ Navigation avec active state automatique"}</li>
    <li>{p.ui9 ?? "✅ Switch thème light/dark avec persistence"}</li>
    <li>{p.ui10 ?? "✅ Sélecteur de langue 4 locales (FR, EN, ES, AR)"}</li>
    <li>{p.ui11 ?? "✅ Responsive avec menu mobile"}</li>
    <li>{p.ui12 ?? "✅ Sticky header optionnel"}</li>
    <li>{p.ui13 ?? "✅ Accessibilité complète (ARIA, keyboard nav)"}</li>
    <li>{p.ui14 ?? "✅ Support 4 variants visuels"}</li>
  </ul>

  <Alert variant="initial" status="warning">
    <strong>🌍 Multilingue :</strong> Le Header détecte automatiquement la locale courante 
    et met à jour les liens de navigation en conséquence.
  </Alert>
</DocLayout>
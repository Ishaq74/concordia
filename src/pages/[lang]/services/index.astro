---
// src/pages/[lang]/services/index.astro — Public services index (wireframe refonte)
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import ServiceGrid from "@components/modules/services/lists/ServiceGrid.astro";
import ServiceCard from "@components/modules/services/cards/ServiceCard.astro";
import Input from "@components/ui/Form/Input.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const ts = t.servicesPage ?? {} as Record<string, string>;
const allServices = await getCollection("services");

const services = allServices
  .filter((s) => s.data.lang === lang)
  .filter((s) => s.data.status === "active");

// --- Unique categories with counts ---
const catMap = new Map<string, { name: string; slug: string; icon?: string; count: number }>();
services.forEach((svc) => {
  const cat = svc.data.category;
  if (cat?.slug) {
    const existing = catMap.get(cat.slug);
    if (existing) existing.count++;
    else catMap.set(cat.slug, { name: cat.name, slug: cat.slug, icon: (cat as any).icon, count: 1 });
  }
});
const categories = Array.from(catMap.values()).sort((a, b) => b.count - a.count);

// --- Featured services ---
const featuredServices = services.filter((s) => s.data.isFeatured);

// --- Best rated ---
const bestRated = [...services].filter((s) => (s.data as any).avgRating > 0).sort((a, b) => ((b.data as any).avgRating ?? 0) - ((a.data as any).avgRating ?? 0)).slice(0, 6);

// --- "How it works" steps ---
const howItWorks = [
  { icon: "mdi:magnify", title: ts.howStep1Title ?? "Recherchez", desc: ts.howStep1Desc ?? "Parcourez les services disponibles dans votre communauté." },
  { icon: "mdi:calendar-check", title: ts.howStep2Title ?? "Réservez", desc: ts.howStep2Desc ?? "Choisissez un créneau et réservez en quelques clics." },
  { icon: "mdi:handshake-outline", title: ts.howStep3Title ?? "Profitez", desc: ts.howStep3Desc ?? "Rencontrez votre prestataire et profitez du service." },
];
---

<BaseLayout title={ts.title || "Services"} lang={lang}>

  <!-- ============ HERO + SEARCH ============ -->
  <section class="services-hero">
    <div class="services-hero__inner">
      <h1 class="services-hero__title">{ts.heroTitle ?? "Trouvez le service idéal"}</h1>
      <p class="services-hero__subtitle">{ts.heroSubtitle ?? "Des prestataires de confiance, près de chez vous."}</p>
      <form class="search-bar" id="search-form" action={`/${lang}/services`} method="get">
        <div class="search-bar__field">
          <Icon name="mdi:magnify" class="search-bar__icon" />
          <Input type="search" id="search-input" name="q" placeholder={ts.searchPlaceholder ?? "Que cherchez-vous ?"} className="search-bar__input" />
        </div>
        <button type="submit" class="search-bar__btn">{ts.searchBtn ?? "Rechercher"}</button>
      </form>
    </div>
  </section>

  <main class="services-main">

    <!-- ============ POPULAR CATEGORIES ============ -->
    {categories.length > 0 && (
      <section class="services-section" aria-label={ts.categories ?? "Catégories populaires"}>
        <h2 class="section-title">
          <Icon name="mdi:tag-multiple-outline" class="section-icon" />
          {ts.popularCategories ?? "Catégories populaires"}
        </h2>
        <div class="category-grid">
          {categories.slice(0, 8).map((cat) => (
            <a href={`/${lang}/services/${cat.slug}`} class="category-card">
              <div class="category-card__icon">
                <Icon name={cat.icon || "mdi:folder-outline"} />
              </div>
              <div class="category-card__body">
                <span class="category-card__name">{cat.name}</span>
                <span class="category-card__count">{cat.count} {cat.count > 1 ? (ts.services ?? "services") : (ts.service ?? "service")}</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- ============ HOW IT WORKS ============ -->
    <section class="services-section how-it-works" aria-label={ts.howItWorks ?? "Comment ça marche"}>
      <h2 class="section-title">
        <Icon name="mdi:lightbulb-on-outline" class="section-icon" />
        {ts.howItWorks ?? "Comment ça marche"}
      </h2>
      <div class="how-grid">
        {howItWorks.map((step, idx) => (
          <div class="how-step">
            <div class="how-step__number">{idx + 1}</div>
            <div class="how-step__icon"><Icon name={step.icon} /></div>
            <h3 class="how-step__title">{step.title}</h3>
            <p class="how-step__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ BEST RATED CAROUSEL ============ -->
    {bestRated.length > 0 && (
      <section class="services-section" aria-label={ts.bestRated ?? "Mieux notés"}>
        <h2 class="section-title">
          <Icon name="mdi:star-outline" class="section-icon" />
          {ts.bestRated ?? "Les mieux notés"}
        </h2>
        <div class="rated-carousel" id="rated-carousel">
          {bestRated.map((svc) => (
            <div class="rated-carousel__item">
              <ServiceCard service={svc} lang={lang} variant="retro" />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- ============ FEATURED ============ -->
    {featuredServices.length > 0 && (
      <section class="services-section" aria-label={ts.featured ?? "En vedette"}>
        <h2 class="section-title">
          <Icon name="mdi:lightning-bolt-outline" class="section-icon" />
          {ts.featured ?? "En vedette"}
        </h2>
        <ServiceGrid>
          {featuredServices.slice(0, 6).map((svc) => (
            <ServiceCard service={svc} lang={lang} variant="retro" />
          ))}
        </ServiceGrid>
      </section>
    )}

    <!-- ============ ALL SERVICES ============ -->
    <section class="services-section" aria-label={ts.all ?? "Tous les services"} id="all-services">
      <div class="section-header-row">
        <h2 class="section-title">
          <Icon name="mdi:briefcase-variant-outline" class="section-icon" />
          {ts.all ?? "Tous les services"}
        </h2>
        <div class="category-pills">
          <button type="button" class="pill active" data-category="all">{ts.allCategories ?? "Tout"}</button>
          {categories.map((cat) => (
            <button type="button" class="pill" data-category={cat.slug}>{cat.name}</button>
          ))}
        </div>
      </div>
      <div id="services-grid">
        {services.length > 0 ? (
          <ServiceGrid>
            {services.map((svc) => (
              <div data-service-category={svc.data.category?.slug ?? ""}>
                <ServiceCard service={svc} lang={lang} variant="retro" />
              </div>
            ))}
          </ServiceGrid>
        ) : (
          <div class="services-empty">
            <Icon name="mdi:briefcase-remove-outline" />
            <p>{ts.noServices ?? "Aucun service disponible pour le moment."}</p>
          </div>
        )}
      </div>
    </section>

    <!-- ============ CTA ============ -->
    <section class="cta-section">
      <div class="cta-inner">
        <h2 class="cta-title">{ts.ctaTitle ?? "Vous proposez un service ?"}</h2>
        <p class="cta-desc">{ts.ctaDesc ?? "Rejoignez notre communauté et touchez de nouveaux clients dès aujourd'hui."}</p>
        <a href={`/${lang}/auth/sign-up`} class="cta-btn">
          <Icon name="mdi:rocket-launch-outline" />
          {ts.ctaBtn ?? "Commencer gratuitement"}
        </a>
      </div>
    </section>

  </main>
</BaseLayout>

<script>
  // Client-side category pill filtering
  document.addEventListener("DOMContentLoaded", () => {
    const pills = document.querySelectorAll<HTMLButtonElement>(".pill[data-category]");
    const items = document.querySelectorAll<HTMLElement>("[data-service-category]");

    pills.forEach((pill) => {
      pill.addEventListener("click", () => {
        pills.forEach((p) => p.classList.remove("active"));
        pill.classList.add("active");
        const cat = pill.dataset.category;
        items.forEach((item) => {
          if (cat === "all" || item.dataset.serviceCategory === cat) {
            item.style.display = "";
          } else {
            item.style.display = "none";
          }
        });
      });
    });
  });
</script>

<style>
  /* Hero */
  .services-hero {
    background: linear-gradient(135deg, var(--color-primary, #eab308) 0%, var(--color-primary-dark, #ca8a04) 100%);
    padding: var(--space-16, 4rem) var(--space-6, 1.5rem);
    text-align: center; color: white;
  }
  .services-hero__inner { max-width: 700px; margin: 0 auto; }
  .services-hero__title { font-size: 2.5rem; font-weight: 800; margin: 0 0 var(--space-3, 0.75rem); }
  .services-hero__subtitle { font-size: 1.125rem; opacity: 0.9; margin: 0 0 var(--space-6, 1.5rem); }
  .search-bar {
    display: flex; gap: 0; background: white; border-radius: var(--radius-full, 9999px);
    overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.15); max-width: 600px; margin: 0 auto;
  }
  .search-bar__field { flex: 1; display: flex; align-items: center; padding-left: var(--space-4, 1rem); }
  .search-bar__icon { width: 1.25rem; height: 1.25rem; color: var(--text-muted, #64748b); flex-shrink: 0; }
  .search-bar__input {
    flex: 1; border: none; outline: none; padding: var(--space-3, 0.75rem);
    font-size: 1rem; color: var(--text-default, #0f172a); background: transparent;
  }
  .search-bar__btn {
    padding: var(--space-3, 0.75rem) var(--space-6, 1.5rem);
    background: var(--color-primary, #eab308); color: white; border: none;
    font-weight: 700; font-size: 0.9375rem; cursor: pointer; transition: background 0.15s;
    white-space: nowrap;
  }
  .search-bar__btn:hover { background: var(--color-primary-dark, #ca8a04); }

  /* Main */
  .services-main { max-width: var(--max-width, 1200px); margin: 0 auto; padding: var(--space-6, 1.5rem); }
  .services-section { margin-bottom: var(--space-12, 3rem); }
  .section-title {
    display: flex; align-items: center; gap: var(--space-2, 0.5rem);
    font-size: 1.375rem; font-weight: 700; margin-bottom: var(--space-5, 1.25rem);
    color: var(--text-default, #0f172a);
  }
  .section-icon { width: 1.5rem; height: 1.5rem; color: var(--color-primary, #eab308); }
  .section-header-row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4, 1rem); flex-wrap: wrap; margin-bottom: var(--space-5, 1.25rem); }
  .section-header-row .section-title { margin-bottom: 0; }

  /* Category grid */
  .category-grid {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: var(--space-4, 1rem);
  }
  .category-card {
    display: flex; align-items: center; gap: var(--space-3, 0.75rem);
    padding: var(--space-4, 1rem); border-radius: var(--radius-lg, 0.5rem);
    background: var(--bg-surface, white); border: 1px solid var(--border-default, #e2e8f0);
    text-decoration: none; color: inherit; transition: all 0.2s;
  }
  .category-card:hover { border-color: var(--color-primary, #eab308); box-shadow: 0 2px 12px rgba(0,0,0,0.06); transform: translateY(-2px); }
  .category-card__icon {
    width: 48px; height: 48px; border-radius: var(--radius-md, 0.375rem);
    background: var(--bg-inset, #f1f5f9); display: flex; align-items: center; justify-content: center;
    color: var(--color-primary, #eab308); flex-shrink: 0;
  }
  .category-card__icon [data-icon] { width: 1.5rem; height: 1.5rem; }
  .category-card__name { font-weight: 600; font-size: 0.9375rem; display: block; }
  .category-card__count { font-size: 0.8125rem; color: var(--text-muted, #64748b); }

  /* How it works */
  .how-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6, 1.5rem); }
  .how-step { text-align: center; padding: var(--space-6, 1.5rem); position: relative; }
  .how-step__number {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    font-size: 3rem; font-weight: 900; color: var(--color-primary, #eab308); opacity: 0.15;
    line-height: 1;
  }
  .how-step__icon { margin: 0 auto var(--space-3, 0.75rem); color: var(--color-primary, #eab308); }
  .how-step__icon [data-icon] { width: 2.5rem; height: 2.5rem; }
  .how-step__title { font-size: 1.125rem; font-weight: 700; margin: 0 0 var(--space-2, 0.5rem); }
  .how-step__desc { font-size: 0.875rem; color: var(--text-muted, #64748b); margin: 0; line-height: 1.6; }

  /* Best rated carousel */
  .rated-carousel {
    display: flex; gap: var(--space-4, 1rem); overflow-x: auto;
    scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch;
    padding-bottom: var(--space-2, 0.5rem);
  }
  .rated-carousel__item { min-width: 280px; flex-shrink: 0; scroll-snap-align: start; }
  .rated-carousel::-webkit-scrollbar { height: 6px; }
  .rated-carousel::-webkit-scrollbar-thumb { background: var(--border-default, #e2e8f0); border-radius: 3px; }

  /* Category pills */
  .category-pills { display: flex; flex-wrap: wrap; gap: var(--space-2, 0.5rem); }
  .pill {
    padding: var(--space-1, 0.25rem) var(--space-3, 0.75rem);
    border: 1px solid var(--border-default, #e2e8f0); border-radius: var(--radius-full, 9999px);
    background: transparent; cursor: pointer; font-size: 0.8125rem; font-weight: 500;
    color: var(--text-default, #0f172a); transition: all 0.15s;
  }
  .pill:hover, .pill.active { background: var(--color-primary, #eab308); color: white; border-color: var(--color-primary, #eab308); }

  /* CTA */
  .cta-section {
    background: var(--bg-inset, #f8fafc); border-radius: var(--radius-xl, 0.75rem);
    padding: var(--space-12, 3rem) var(--space-6, 1.5rem); text-align: center;
    margin-bottom: var(--space-8, 2rem);
  }
  .cta-inner { max-width: 550px; margin: 0 auto; }
  .cta-title { font-size: 1.5rem; font-weight: 800; margin: 0 0 var(--space-3, 0.75rem); }
  .cta-desc { font-size: 0.9375rem; color: var(--text-muted, #64748b); margin: 0 0 var(--space-5, 1.25rem); }
  .cta-btn {
    display: inline-flex; align-items: center; gap: var(--space-2, 0.5rem);
    padding: var(--space-3, 0.75rem) var(--space-6, 1.5rem);
    background: var(--color-primary, #eab308); color: white; border-radius: var(--radius-full, 9999px);
    font-weight: 700; font-size: 1rem; text-decoration: none; transition: background 0.15s;
  }
  .cta-btn:hover { background: var(--color-primary-dark, #ca8a04); }
  .cta-btn [data-icon] { width: 1.25rem; height: 1.25rem; }

  /* Empty */
  .services-empty { text-align: center; padding: var(--space-12, 3rem); color: var(--text-muted, #64748b); }
  .services-empty [data-icon] { width: 3rem; height: 3rem; opacity: 0.4; margin-bottom: var(--space-3, 0.75rem); }

  @media (max-width: 768px) {
    .services-hero__title { font-size: 1.75rem; }
    .search-bar { flex-direction: column; border-radius: var(--radius-lg, 0.5rem); }
    .search-bar__btn { border-radius: 0 0 var(--radius-lg, 0.5rem) var(--radius-lg, 0.5rem); }
    .how-grid { grid-template-columns: 1fr; }
    .category-grid { grid-template-columns: 1fr 1fr; }
  }
</style>

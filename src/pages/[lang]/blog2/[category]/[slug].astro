---
import { getEntry } from "astro:content";
import QueryLoop from "@components/Tools/QueryLoop/QueryLoop.astro";
import MarkdownIt from "markdown-it";
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import ShareButtons from "@components/modules/blog/ui/ShareButtons.astro";
import PostFooter from "@components/modules/blog/single/PostFooter.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";

const { slug, category } = Astro.params;
const lang = Astro.params.lang as string;
const LANG = lang;
const t = getTranslations(lang);

const post = await getEntry("blog", `${slug}-${LANG}`);

if (!post) {
  return Astro.redirect(`/${lang}/404`);
}

// Render markdown content
const md = new MarkdownIt({
  html: true,
  linkify: true,
  typographer: true,
});
const renderedHtml = md.render(String(post.data.content ?? ""));

// Extract headings for TOC
const headingRegex = /<h([2-3])[^>]*>([^<]+)<\/h\1>/gi;
const headings: { depth: number; slug: string; text: string }[] = [];
let match: RegExpExecArray | null;
while ((match = headingRegex.exec(renderedHtml)) !== null) {
  const text = match[2].trim();
  const headingSlug = text.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  headings.push({ depth: parseInt(match[1]), slug: headingSlug, text });
}

// Inject IDs into rendered HTML headings
let processedHtml = renderedHtml;
headings.forEach((h) => {
  processedHtml = processedHtml.replace(
    new RegExp(`(<h${h.depth})(>)(${h.text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")})`),
    `$1 id="${h.slug}"$2$3`
  );
});

// determine categoryName from post itself
const currentCategory = (post.data.categories ?? []).find((c: any) => c.slug === category);
const categoryName = currentCategory?.name ?? category;

// Primary author
const primaryAuthor = post.data.authors?.[0];
---

<BaseLayout
  title={post.data.seo?.title || post.data.title}
  description={post.data.seo?.description || post.data.excerpt}
  lang={LANG}
>
  {/* ===== HERO SECTION ===== */}
  <section class="article-hero">
    <div class="article-hero__img-wrap">
      {post.data.cover?.url ? (
        <img
          src={post.data.cover.url}
          alt={post.data.cover.alt || post.data.title}
          class="article-hero__img"
          loading="eager"
        />
      ) : (
        <div class="article-hero__placeholder">
          <Icon name="mdi:image-outline" />
        </div>
      )}
      <div class="article-hero__overlay" />
    </div>
    <div class="article-hero__content">
      <nav class="article-hero__breadcrumb" aria-label={t.aria?.breadcrumb ?? "Fil d'Ariane"}>
        <a href={`/${LANG}`}>{t.breadcrumb?.home ?? "Accueil"}</a>
        <Icon name="mdi:chevron-right" />
        <a href={`/${LANG}/blog`}>{t.breadcrumb?.blog ?? "Blog"}</a>
        <Icon name="mdi:chevron-right" />
        <a href={`/${LANG}/blog/${category}`}>{categoryName}</a>
      </nav>
      <Badge variant="retro" color="accent">{categoryName}</Badge>
      <div class="article-hero__meta-row">
        {post.data.publishedAt && (
          <time datetime={post.data.publishedAt.toISOString()}>
            {post.data.publishedAt.toLocaleDateString(LANG, { day: "numeric", month: "long", year: "numeric" })}
          </time>
        )}
        {post.data.readingTime && (
          <span><Icon name="mdi:clock-outline" /> {post.data.readingTime}</span>
        )}
      </div>
      <h1 class="article-hero__title">{post.data.title}</h1>
      {post.data.excerpt && <p class="article-hero__subtitle">{post.data.excerpt}</p>}
    </div>
  </section>

  <main class="article-page">
    <div class="article-grid">

      {/* ===== ARTICLE BODY ===== */}
      <article class="article-grid__main">
        <div class="article-content" set:html={processedHtml} />

        {/* Tags */}
        {post.data.categories?.length > 0 && (
          <div class="article-tags">
            {post.data.categories.map((cat: any) => (
              <a href={`/${LANG}/blog/${cat.slug}`} class="article-tag">
                {cat.name}
              </a>
            ))}
          </div>
        )}

        {/* Share & CTA */}
        <div class="article-share-row">
          <p class="article-share-label">{t.blog?.articleShare ?? "Partager cet article"}</p>
          <ShareButtons variant="retro" title={post.data.title} />
        </div>

        {/* Authors rendered by QueryLoop using entriesOverride */}
        {console.log('[slug] before authors QueryLoop, count', post.data.authors.length)}
        <div class="article-authors">
          <QueryLoop
            collection="users"
            columns={1}
            entriesOverride={post.data.authors.map((author: any) => ({ data: author, id: author.slug }))}
          />
        </div>
        {console.log('[slug] after authors QueryLoop')}

        {/* Comments */}
        <PostFooter postId={post.data.id} postType="blog" />
      </article>

      {/* ===== SIDEBAR ===== */}
      <aside class="article-grid__sidebar">

        {/* Author / Org Card */}
        {primaryAuthor && (
          <Card variant="retro" elevation="sm" class="sidebar-author">
            <CardContent>
              <div class="sidebar-author__header">
                {primaryAuthor.avatar ? (
                  <img src={primaryAuthor.avatar} alt={primaryAuthor.name} class="sidebar-author__avatar" />
                ) : (
                  <div class="sidebar-author__avatar-placeholder">
                    {primaryAuthor.name.charAt(0).toUpperCase()}
                  </div>
                )}
                <div>
                  <p class="sidebar-author__name">{primaryAuthor.name}</p>
                  <p class="sidebar-author__role">{t.blog?.articleAuthor ?? "Auteur"}</p>
                </div>
              </div>
              {primaryAuthor.bio && (
                <p class="sidebar-author__bio">{primaryAuthor.bio}</p>
              )}
              <a href={`/${LANG}/blog/author/${primaryAuthor.slug}`}>
                <Button variant="retro" color="secondary" icon={{ name: "mdi:account-circle-outline", side: "left" }}>
                  {t.blog?.articleViewProfile ?? "Voir le profil"}
                </Button>
              </a>
            </CardContent>
          </Card>
        )}

        {/* Table of Contents */}
        {headings.length > 0 && (
          <Card variant="retro" elevation="sm" class="sidebar-toc">
            <CardContent>
              <h3 class="sidebar-section-title">
                <Icon name="mdi:table-of-contents" /> {t.blog?.articleToc ?? "Table des matières"}
              </h3>
              <nav aria-label={t.aria?.tableOfContents ?? "Table des matières"}>
                <ul class="sidebar-toc__list">
                  {headings.map((h) => (
                    <li class:list={[`sidebar-toc__item`, { "depth-3": h.depth === 3 }]}>
                      <a href={`#${h.slug}`} class="sidebar-toc__link">{h.text}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            </CardContent>
          </Card>
        )}

        {/* Related Articles (sidebar) - use QueryLoop to fetch 3 posts excluding current */}
        {console.log('[slug] before sidebar related posts QueryLoop')}
        <Card variant="retro" elevation="sm">
          <CardContent>
            <h3 class="sidebar-section-title">
              <Icon name="mdi:newspaper-variant-outline" /> {t.blog?.articleRelated ?? "Articles liés"}
            </h3>
            <QueryLoop
              collection="blog"
              filters={{ lang }}
              categoryFilter={category}
              sort={{ field: "publishedAt", order: "desc" }}
              limit={3}
              currentId={post.id}
              columns={1}
              layout="list"
            />
          </CardContent>
        </Card>
        {console.log('[slug] after sidebar related posts QueryLoop')}

        {/* Newsletter Mini */}
        <Card variant="retro" elevation="sm" class="sidebar-newsletter-card">
          <CardContent>
            <h3 class="sidebar-section-title">
              <Icon name="mdi:email-newsletter" /> {t.blog?.newsletterTitle ?? "Newsletter"}
            </h3>
            <p class="sidebar-newsletter-text">{t.blog?.articleDontMiss ?? "Ne manquez aucun article, abonnez-vous !"}</p>
            <form class="sidebar-newsletter-form" action="#" method="POST">
              <label for="article-sidebar-email" class="sr-only">{t.aria?.emailLabel ?? "Adresse e-mail"}</label>
              <input
                type="email"
                id="article-sidebar-email"
                name="email"
                placeholder={t.blog?.newsletterPlaceholder ?? "votre@email.com"}
                required
                class="sidebar-newsletter-input"
                autocomplete="email"
              />
              <Button type="submit" variant="retro" color="primary" icon={{ name: "mdi:send", side: "right" }}>
                {t.blog?.newsletterSubscribe ?? "S'abonner"}
              </Button>
            </form>
          </CardContent>
        </Card>
      </aside>
    </div>

    {/* ===== RELATED POSTS (full width) ===== */}
    <h2 class="section-heading">{t.blog?.articleRelated ?? "Articles liés"}</h2>
    {console.log('[slug] post.id =', post.id)}
    {console.log('[slug] before bottom related posts QueryLoop')}
    <QueryLoop
      collection="blog"
      filters={{ lang }}
      categoryFilter={category}
      sort={{ field: "publishedAt", order: "desc" }}
      limit={3}
      currentId={post.id}
      columns={3}
    />
    {console.log('[slug] after bottom related posts QueryLoop')}

  </main>
</BaseLayout>

<style>
/* ========================================
   ARTICLE DETAIL PAGE
   ======================================== */

/* --- Hero --- */
.article-hero {
  position: relative;
  min-height: 60vh;
  display: flex; align-items: flex-end;
  overflow: hidden;
}

.article-hero__img-wrap { position: absolute; inset: 0; }

.article-hero__img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
}

.article-hero__placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-inset);
}
.article-hero__placeholder :global(svg) { width: 4rem; height: 4rem; color: var(--text-muted); }

.article-hero__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.2) 50%, transparent 100%);
}

.article-hero__content {
  position: relative; z-index: 1;
  max-width: 1280px; width: 100%;
  margin: 0 auto; padding: 3rem 1.5rem;
  display: flex; flex-direction: column;
  gap: 0.5rem; color: #fff;
}

.article-hero__breadcrumb {
  display: flex; align-items: center; gap: 0.375rem;
  font-size: 0.8125rem; opacity: 0.85; margin-bottom: 0.5rem;
}
.article-hero__breadcrumb a { color: inherit; text-decoration: none; }
.article-hero__breadcrumb a:hover { text-decoration: underline; }
.article-hero__breadcrumb :global(svg) { width: 0.875rem; height: 0.875rem; opacity: 0.6; }

.article-hero__meta-row {
  display: flex; gap: 1rem; align-items: center;
  font-size: 0.875rem; opacity: 0.85;
}
.article-hero__meta-row :global(svg) { width: 0.875rem; height: 0.875rem; }
.article-hero__meta-row span { display: inline-flex; align-items: center; gap: 0.25rem; }

.article-hero__title { margin: 0; font-size: clamp(1.75rem, 4vw, 3rem); font-weight: 800; line-height: 1.15; }
.article-hero__subtitle { margin: 0; font-size: 1.125rem; opacity: 0.9; max-width: 60ch; line-height: 1.5; }

/* --- Page Layout --- */
.article-page {
  max-width: 1280px; margin: 0 auto;
  padding: 2.5rem 1rem;
  display: flex; flex-direction: column; gap: 3rem;
}

.article-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
@media (min-width: 1024px) { .article-grid { grid-template-columns: 8fr 4fr; } }

/* --- Article Content --- */
.article-grid__main { min-width: 0; }

.article-content {
  font-size: 1.0625rem; line-height: 1.8;
  color: var(--text-default);
}

.article-content :global(h2) {
  margin: 2rem 0 0.75rem; font-size: 1.5rem; font-weight: 800;
  color: var(--heading-color, var(--text-default));
  scroll-margin-top: 5rem;
}
.article-content :global(h3) {
  margin: 1.5rem 0 0.5rem; font-size: 1.25rem; font-weight: 700;
  color: var(--heading-color, var(--text-default));
  scroll-margin-top: 5rem;
}
.article-content :global(p) { margin: 0 0 1.25rem; }
.article-content :global(p:first-of-type::first-letter) {
  float: left; font-size: 3.25rem; font-weight: 800; line-height: 0.9;
  margin-right: 0.5rem; color: var(--color-primary);
}
.article-content :global(blockquote) {
  border-left: 4px solid var(--color-primary);
  background: var(--bg-subtle);
  padding: 1.25rem 1.5rem; margin: 1.5rem 0;
  border-radius: 0 var(--border-radius-lg, 0.75rem) var(--border-radius-lg, 0.75rem) 0;
  font-size: 1.125rem; font-style: italic; color: var(--text-muted);
}
.article-content :global(figure) { margin: 1.5rem 0; }
.article-content :global(figure img) {
  width: 100%; border-radius: var(--border-radius-lg, 0.75rem);
}
.article-content :global(figcaption) {
  margin-top: 0.5rem; text-align: center;
  font-size: 0.8125rem; color: var(--text-muted);
}
.article-content :global(img) { max-width: 100%; border-radius: var(--border-radius-sm, 0.5rem); }
.article-content :global(ul), .article-content :global(ol) {
  padding-left: 1.5rem; margin-bottom: 1.25rem;
}
.article-content :global(li) { margin-bottom: 0.375rem; }
.article-content :global(a) { color: var(--color-primary); text-decoration: underline; }

/* --- Tags --- */
.article-tags {
  display: flex; flex-wrap: wrap; gap: 0.5rem;
  padding: 1.5rem 0; border-top: 1px solid var(--border-default);
  margin-top: 2rem;
}
.article-tag {
  display: inline-block; padding: 0.375rem 1rem;
  border-radius: 9999px; font-size: 0.8125rem; font-weight: 500;
  background: var(--bg-inset); color: var(--text-muted);
  text-decoration: none; transition: background 150ms, color 150ms;
}
.article-tag:hover { background: var(--bg-subtle); color: var(--text-default); }

/* --- Share --- */
.article-share-row {
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: 1rem;
  padding: 1.25rem 0; border-bottom: 1px solid var(--border-default);
}
.article-share-label { margin: 0; font-weight: 700; color: var(--text-default); }

/* --- Authors --- */
.article-authors {
  display: flex; flex-direction: column; gap: 1rem;
  padding: 2rem 0;
}

/* --- Sidebar --- */
.article-grid__sidebar {
  display: flex; flex-direction: column; gap: 1.5rem;
}

@media (min-width: 1024px) {
  .article-grid__sidebar {
    position: sticky; top: 6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    align-self: start;
  }
}

/* Sidebar: Author */
.sidebar-author__header { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
.sidebar-author__avatar {
  width: 56px; height: 56px; border-radius: 50%; object-fit: cover;
  border: 2px solid var(--border-default);
}
.sidebar-author__avatar-placeholder {
  width: 56px; height: 56px; border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 1.25rem; font-weight: 700;
}
.sidebar-author__name { margin: 0; font-weight: 700; color: var(--text-default); }
.sidebar-author__role { margin: 0; font-size: 0.8125rem; color: var(--text-muted); }
.sidebar-author__bio {
  margin: 0 0 0.75rem; font-size: 0.875rem; color: var(--text-muted);
  line-height: 1.5; display: -webkit-box;
  -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
}

/* Sidebar: TOC */
.sidebar-section-title {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1rem; font-weight: 700; margin: 0 0 0.75rem;
  color: var(--heading-color, var(--text-default));
}
.sidebar-section-title :global(svg) { width: 1.125rem; height: 1.125rem; color: var(--color-primary); }

.sidebar-toc__list { list-style: none; padding: 0; margin: 0; border-left: 2px solid var(--border-default); }
.sidebar-toc__item { padding-left: 0.75rem; }
.sidebar-toc__item.depth-3 { padding-left: 1.5rem; }
.sidebar-toc__link {
  display: block; padding: 0.25rem 0;
  font-size: 0.8125rem; color: var(--text-muted);
  text-decoration: none; line-height: 1.4;
  transition: color 150ms;
}
.sidebar-toc__link:hover { color: var(--color-primary); }

/* Sidebar: Related */
.sidebar-related { display: flex; flex-direction: column; gap: 0.75rem; }
.sidebar-related__item {
  display: flex; gap: 0.75rem; align-items: flex-start;
  text-decoration: none; color: inherit;
  transition: background 150ms;
  padding: 0.375rem; border-radius: var(--border-radius-sm);
}
.sidebar-related__item:hover { background: var(--bg-subtle); }
.sidebar-related__img {
  width: 64px; height: 48px; border-radius: var(--border-radius-sm);
  object-fit: cover; flex-shrink: 0;
}
.sidebar-related__img-placeholder {
  width: 64px; height: 48px; border-radius: var(--border-radius-sm);
  background: var(--bg-inset); display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.sidebar-related__img-placeholder :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--text-muted); }
.sidebar-related__category { font-size: 0.6875rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-primary); }
.sidebar-related__title { margin: 0.125rem 0 0; font-size: 0.8125rem; font-weight: 600; color: var(--text-default); line-height: 1.3; }

/* Sidebar: Newsletter */
.sidebar-newsletter-text { margin: 0 0 0.75rem; font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }
.sidebar-newsletter-form { display: flex; flex-direction: column; gap: 0.5rem; }
.sidebar-newsletter-input {
  width: 100%; padding: 0.5rem 0.75rem;
  border: 2px solid var(--border-default);
  border-radius: var(--border-radius-sm, 0.375rem);
  font-size: 0.875rem;
  background: var(--bg-default); color: var(--text-default);
  transition: border-color 180ms;
}
.sidebar-newsletter-input:focus {
  outline: none; border-color: var(--color-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
}

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

/* --- Responsive --- */
@media (max-width: 768px) {
  .article-hero { min-height: 50vh; }
  .article-hero__content { padding: 2rem 1rem; }
  .article-hero__title { font-size: 1.5rem; }
  .article-content :global(p:first-of-type::first-letter) { font-size: 2.5rem; }
}
</style>

---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Pagination from "@components/ui/Pagination.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { user } from "@database/schemas";
import { count, ilike, eq, desc, or, and } from "drizzle-orm";
import { getTranslations } from "@i18n/translations";

const lang = Astro.params.lang as string;
const tData = getTranslations(lang);
const currentLocale = lang;
const t = tData;

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1"));
const perPage = 20;
const search = url.searchParams.get("q")?.trim() ?? "";
const roleFilter = url.searchParams.get("role")?.trim() ?? "";

const db = await getDrizzle();

// Conditions de filtre
const conditions = [];
if (search) {
  conditions.push(
    or(
      ilike(user.name, `%${search}%`),
      ilike(user.email, `%${search}%`),
      ilike(user.username, `%${search}%`)
    )
  );
}
if (roleFilter) {
  conditions.push(eq(user.role, roleFilter));
}

let whereClause: ReturnType<typeof and> | undefined;
if (conditions.length === 1) {
  whereClause = conditions[0];
} else if (conditions.length > 1) {
  whereClause = and(...conditions);
}

// --- Total Users
const totalUsersQuery = await db
  .select({
    value: count().as("value")  // <- Drizzle a besoin d'un alias
  })
  .from(user)
  .where(whereClause ?? undefined);

const totalUsers = totalUsersQuery[0]?.value ?? 0;
const totalPages = Math.max(1, Math.ceil(totalUsers / perPage));

// --- Fetch Users
const users = await db
  .select()
  .from(user)
  .where(whereClause ?? undefined) // safe pour optional
  .orderBy(desc(user.createdAt))
  .limit(perPage)
  .offset((page - 1) * perPage);

// --- Distinct Roles
const allRoles = await db.selectDistinct({ role: user.role }).from(user);
const roleOptions = allRoles.map(r => r.role).filter((r): r is string => !!r);

// --- Badge Color
const badgeColor = (role: string | null) => {
  if (!role) return "default" as const;
  if (role.includes("admin")) return "error" as const;
  if (role.includes("moderator")) return "warning" as const;
  return "default" as const;
};

const adminBase = `/${currentLocale}/admin/users`;
---

<AdminLayout title={t.adminPanel?.users ?? "Users"} activeSection="users">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <h1>{t.adminPanel?.users ?? "Users"}</h1>
      <Badge color="primary" text={`${totalUsers} ${t.adminBlog?.users?.total ?? "total"}`} />
    </div>
    <p class="admin-page-subtitle">{t.adminBlog?.users?.subtitle ?? "Gérer les comptes, rôles et accès des utilisateurs."}</p>
  </header>

  <!-- Filters -->
  <Card elevation="sm" className="admin-filters-card">
    <CardContent>
      <form method="get" action={adminBase} class="admin-filters-form">
        <div class="admin-filter-field">
          <Label htmlFor="q">{t.adminBlog?.common?.search ?? "Rechercher"}</Label>
          <Input
            id="q"
            name="q"
            type="search"
            placeholder={t.adminBlog?.users?.searchPlaceholder ?? "Nom, email ou identifiant…"}
            value={search}
          />
        </div>
        <div class="admin-filter-field">
          <Label htmlFor="role">{t.adminBlog?.users?.roleFilter ?? "Rôle"}</Label>
          <Select id="role" name="role">
            <option value="">{t.adminBlog?.users?.allRoles ?? "Tous les rôles"}</option>
            {roleOptions.map((r) => (
              <option value={r} selected={r === roleFilter}>{r}</option>
            ))}
          </Select>
        </div>
        <div class="admin-filter-actions">
          <Button type="submit" color="primary" icon={{ name: "mdi:magnify", side: "left" }}>
            {t.adminBlog?.common?.filter ?? "Filtrer"}
          </Button>
          {(search || roleFilter) && (
            <a href={adminBase} class="admin-filter-reset">{t.adminBlog?.common?.reset ?? "Réinitialiser"}</a>
          )}
        </div>
      </form>
    </CardContent>
  </Card>

  <!-- Users table -->
  <Card>
    <CardContent>
      {users.length === 0 ? (
        <div class="empty-state">
          <Icon name="mdi:account-off-outline" class="empty-state-icon" />
          <p>{t.adminBlog?.users?.empty ?? "Aucun utilisateur trouvé."}</p>
        </div>
      ) : (
        <div class="table-responsive">
        <Table striped>
          <TableHeader>
            <TableRow>
              <TableHead>{t.adminBlog?.users?.tableUser ?? "Utilisateur"}</TableHead>
              <TableHead>{t.adminBlog?.users?.tableEmail ?? "Email"}</TableHead>
              <TableHead>{t.adminBlog?.users?.tableRole ?? "Rôle"}</TableHead>
              <TableHead>{t.adminBlog?.users?.tableStatus ?? "Statut"}</TableHead>
              <TableHead>{t.adminBlog?.users?.tableRegistration ?? "Inscription"}</TableHead>
              <TableHead>{t.adminBlog?.users?.tableActions ?? "Actions"}</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {users.map((u) => (
              <TableRow>
                <TableCell>
                  <div class="user-cell">
                    {u.image ? (
                      <img src={u.image} alt="" class="user-avatar" width="32" height="32" loading="lazy" />
                    ) : (
                      <div class="user-avatar-fallback">
                        <Icon name="mdi:account" />
                      </div>
                    )}
                    <div>
                      <span class="user-name">{u.name}</span>
                      {u.username && <span class="user-username">@{u.displayUsername || u.username}</span>}
                    </div>
                  </div>
                </TableCell>
                <TableCell>
                  <span class="text-truncate">{u.email}</span>
                </TableCell>
                <TableCell>
                  <Badge color={badgeColor(u.role)} text={u.role || "user"} />
                </TableCell>
                <TableCell>
                  {u.banned ? (
                    <Badge color="error" icon={{ name: "mdi:cancel", side: "left" }} text={t.adminBlog?.users?.statusBanned ?? "Banni"} />
                  ) : u.emailVerified ? (
                    <Badge color="success" text={t.adminBlog?.users?.statusActive ?? "Actif"} />
                  ) : (
                    <Badge color="warning" text={t.adminBlog?.users?.statusUnverified ?? "Non vérifié"} />
                  )}
                </TableCell>
                <TableCell>
                  <time datetime={u.createdAt.toISOString()}>
                    {u.createdAt.toLocaleDateString(currentLocale)}
                  </time>
                </TableCell>
                <TableCell>
                  <div class="action-buttons">
                    <form method="post" action={`/${currentLocale}/api/admin/users`} class="inline-form">
                      <input type="hidden" name="userId" value={u.id} />
                      {u.banned ? (
                        <>
                          <input type="hidden" name="action" value="unban" />
                          <Button type="submit" color="primary" className="btn-sm"
                            icon={{ name: "mdi:account-check", side: "left" }}>
                            {t.adminBlog?.users?.unban ?? "Débannir"}
                          </Button>
                        </>
                      ) : (
                        <>
                          <input type="hidden" name="action" value="ban" />
                          <Button type="submit" color="error" className="btn-sm"
                            icon={{ name: "mdi:cancel", side: "left" }}>
                            {t.adminBlog?.users?.ban ?? "Bannir"}
                          </Button>
                        </>
                      )}
                    </form>
                  </div>
                </TableCell>
              </TableRow>
            ))}
          </TableBody>
        </Table>
        </div>
      )}
    </CardContent>
  </Card>

  <!-- Pagination -->
  {totalPages > 1 && (
    <div class="admin-pagination">
      <Pagination
        currentPage={page}
        totalPages={totalPages}
        baseUrl={`${adminBase}?${search ? `q=${encodeURIComponent(search)}&` : ""}${roleFilter ? `role=${encodeURIComponent(roleFilter)}&` : ""}page=`}
        showPrevNext
        color="primary"
      />
    </div>
  )}
</AdminLayout>

<style>
  .admin-page-header {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .admin-page-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
  }

  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem);
    font-weight: 800;
    color: var(--heading-color, #0f172a);
    margin: 0;
  }

  .admin-page-subtitle {
    color: var(--text-muted, #64748b);
    font-size: 0.9375rem;
    margin: var(--space-1, 0.25rem) 0 0;
  }

  /* Filters */
  .admin-filters-card {
    margin-bottom: var(--space-4, 1rem);
  }

  .admin-filters-form {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-4, 1rem);
  }

  .admin-filter-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1, 0.25rem);
    min-width: 180px;
    flex: 1;
  }

  .admin-filter-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }

  .admin-filter-reset {
    color: var(--text-muted, #64748b);
    font-size: 0.8125rem;
    text-decoration: underline;
  }

  /* User cell */
  .user-cell {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }

  .user-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
  }

  .user-avatar-fallback {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--bg-inset, #f1f5f9);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted, #64748b);
    font-size: 1.125rem;
  }

  .user-name {
    font-weight: 600;
    color: var(--text-default, #0f172a);
    display: block;
    font-size: 0.875rem;
  }

  .user-username {
    font-size: 0.75rem;
    color: var(--text-muted, #64748b);
  }

  .text-truncate {
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-block;
    font-size: 0.875rem;
  }

  .action-buttons {
    display: flex;
    gap: var(--space-2, 0.5rem);
  }

  .inline-form {
    display: inline;
  }

  .btn-sm {
    font-size: 0.75rem !important;
    padding: 0.25rem 0.5rem !important;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-8, 2rem);
    color: var(--text-muted, #64748b);
  }

  .empty-state-icon {
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2, 0.5rem);
    opacity: 0.5;
  }

  .admin-pagination {
    margin-top: var(--space-4, 1rem);
    display: flex;
    justify-content: center;
  }

  .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  @media (max-width: 768px) {
    .admin-filters-form { flex-direction: column; }
    .admin-filter-field { min-width: 0; }
    .text-truncate { max-width: 140px; }
    .user-avatar, .user-avatar-fallback { width: 28px; height: 28px; }
    .admin-page-title-row { flex-wrap: wrap; }
  }

  @media (max-width: 480px) {
    .admin-page-header h1 { font-size: 1.5rem; }
    .action-buttons { flex-direction: column; gap: var(--space-1, 0.25rem); }
  }
</style>

---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Switch from "@components/ui/Form/Switch.astro";
import MarkdownEditor from "@components/admin/MarkdownEditor.astro";
import MediaPickerModal from "@components/admin/MediaPickerModal.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import {
  servicesListings,
  servicesTranslations,
  servicesCategories,
  servicesAvailability,
  servicesMediaLinks,
  servicesMedia,
} from "@database/schemas";
import { eq } from "drizzle-orm";
import { getTranslations } from "@i18n/translations";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const ts = t.adminServices;
const adminBase = `/${lang}/admin/services`;

const serviceId = Astro.params.id;
if (!serviceId) return Astro.redirect(adminBase);

const db = await getDrizzle();

const [service] = await db.select().from(servicesListings).where(eq(servicesListings.id, serviceId));
if (!service) return Astro.redirect(adminBase);

const translations = await db.select().from(servicesTranslations).where(eq(servicesTranslations.serviceId, serviceId));
const translationsByLocale = new Map<string, typeof translations[0]>();
translations.forEach((tr) => translationsByLocale.set(tr.inLanguage, tr));

const availabilitySlots = await db.select().from(servicesAvailability).where(eq(servicesAvailability.serviceId, serviceId));

const mediaLinks = await db.select().from(servicesMediaLinks).where(eq(servicesMediaLinks.serviceId, serviceId));
const coverMedia = mediaLinks.find((m) => m.type === "cover");
const galleryMediaLinks = mediaLinks.filter((m) => m.type === "gallery").sort((a, b) => Number(a.position ?? 0) - Number(b.position ?? 0));

// Fetch actual media URLs for cover + gallery
const allMediaIds = mediaLinks.map((m) => m.mediaId).filter(Boolean);
const mediaMap = new Map<string, typeof servicesMedia.$inferSelect>();
if (allMediaIds.length > 0) {
  const { inArray } = await import("drizzle-orm");
  const mediaRecords = await db.select().from(servicesMedia).where(inArray(servicesMedia.id, allMediaIds));
  mediaRecords.forEach((m) => mediaMap.set(m.id, m));
}
const coverMediaRecord = coverMedia ? mediaMap.get(coverMedia.mediaId) : null;
const galleryMediaRecords = galleryMediaLinks.map((gl) => ({
  link: gl,
  media: mediaMap.get(gl.mediaId),
})).filter((g) => g.media);

const allCategories = await db
  .select({ id: servicesCategories.id, slug: servicesCategories.slug, name: servicesCategories.name })
  .from(servicesCategories)
  .orderBy(servicesCategories.slug);

const extractLocalized = (value: unknown, locale: string = lang): string => {
  if (typeof value === "string") return value;
  if (value && typeof value === "object") {
    const obj = value as Record<string, string>;
    return obj[locale] || Object.values(obj)[0] || "";
  }
  return "";
};

const getTranslationField = (locale: string, field: string): string => {
  const tr = translationsByLocale.get(locale);
  if (!tr) return "";
  const val = (tr as any)[field];
  if (typeof val === "string") return val;
  if (val && typeof val === "object") {
    return (val as Record<string, string>)[locale] || Object.values(val as Record<string, string>)[0] || "";
  }
  return "";
};

const supportedLocales = [
  { code: "fr", label: "Français", flag: "🇫🇷" },
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "ar", label: "العربية", flag: "🇸🇦" },
];

const statusBadge = (s: string) => {
  if (s === "active") return { color: "success" as const, text: ts?.status?.active ?? "Actif" };
  if (s === "draft") return { color: "warning" as const, text: ts?.status?.draft ?? "Brouillon" };
  if (s === "pending_review") return { color: "accent" as const, text: ts?.status?.pending_review ?? "En attente" };
  if (s === "suspended") return { color: "error" as const, text: ts?.status?.suspended ?? "Suspendu" };
  return { color: "default" as const, text: s };
};

const sb = statusBadge(service.status);
const frontendCategory = allCategories.find((c) => c.id === service.categoryId);
const frontendUrl = frontendCategory ? `/${lang}/services/${frontendCategory.slug}/${service.slug}` : null;
const displayTitle = extractLocalized(translationsByLocale.get(lang)?.title) || service.slug;

const dayNames = [
  t.servicesPage?.monday ?? "Lundi",
  t.servicesPage?.tuesday ?? "Mardi",
  t.servicesPage?.wednesday ?? "Mercredi",
  t.servicesPage?.thursday ?? "Jeudi",
  t.servicesPage?.friday ?? "Vendredi",
  t.servicesPage?.saturday ?? "Samedi",
  t.servicesPage?.sunday ?? "Dimanche",
];
---

<AdminLayout title={`${ts?.listings?.edit ?? "Modifier"} — ${displayTitle}`} activeSection="services">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <a href={adminBase} class="back-link"><Icon name="mdi:arrow-left" /></a>
        <h1>{ts?.listings?.edit ?? "Modifier le service"}</h1>
        <Badge color={sb.color} text={sb.text} />
      </div>
      <div class="admin-page-actions">
        {frontendUrl && (
          <a href={frontendUrl} target="_blank" rel="noopener" class="btn-view-site">
            <Icon name="mdi:open-in-new" />
            <span>{t.adminBlog?.articles?.viewOnSite ?? "Voir sur le site"}</span>
          </a>
        )}
      </div>
    </div>
    <p class="admin-page-subtitle">
      Slug: <code class="inline-slug">{service.slug}</code> — {t.adminBlog?.articles?.createdOn ?? "Créé le"} {service.createdAt.toLocaleDateString(lang, { day: "2-digit", month: "long", year: "numeric" })}
    </p>
  </header>

  <form id="service-form" class="service-form" data-service-id={serviceId}>
    <div class="form-layout">
      <!-- Main content column -->
      <div class="form-main">

        <!-- Translation tabs -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:translate" class="card-title-icon" />
              <span>{t.adminBlog?.form?.multilingual ?? "Contenu multilingue"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="locale-tabs" role="tablist">
              {supportedLocales.map((loc, i) => {
                const hasContent = translationsByLocale.has(loc.code);
                return (
                  <button
                    type="button" role="tab"
                    class:list={["locale-tab", { active: i === 0 }]}
                    data-locale={loc.code} aria-selected={i === 0 ? "true" : "false"}
                  >
                    <span class="locale-flag">{loc.flag}</span>
                    {loc.label}
                    {hasContent && <span class="locale-dot" title="Traduction existante"></span>}
                  </button>
                );
              })}
            </div>

            {supportedLocales.map((loc, i) => (
              <div class:list={["locale-panel", { active: i === 0 }]} data-locale-panel={loc.code}>
                <div class="form-field">
                  <Label htmlFor={`title-${loc.code}`}>{ts?.form?.titleLabel ?? "Titre"} *</Label>
                  <Input id={`title-${loc.code}`} name={`title-${loc.code}`} value={getTranslationField(loc.code, "title")} placeholder={`${ts?.form?.titleIn ?? "Titre en"} ${loc.label}…`} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`shortDesc-${loc.code}`}>{ts?.form?.shortDescriptionIn ?? "Description courte"}</Label>
                  <Textarea id={`shortDesc-${loc.code}`} name={`shortDesc-${loc.code}`} rows={2} value={getTranslationField(loc.code, "shortDescription")} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`desc-${loc.code}`}>{ts?.form?.descriptionIn ?? "Description"} ({loc.label}) *</Label>
                  <MarkdownEditor id={`desc-${loc.code}`} name={`desc-${loc.code}`} rows={12} placeholder={ts?.form?.descPlaceholder ?? "Décrivez le service en détail (Markdown)…"} value={getTranslationField(loc.code, "description")} />
                </div>

                <details class="seo-section">
                  <summary class="seo-summary">
                    <Icon name="mdi:search-web" class="seo-icon" />
                    {t.adminBlog?.form?.seoSection ?? "SEO —"} {loc.label}
                  </summary>
                  <div class="seo-fields">
                    <div class="form-field">
                      <Label htmlFor={`seoTitle-${loc.code}`}>{t.adminBlog?.form?.seoTitle ?? "Titre SEO"}</Label>
                      <Input id={`seoTitle-${loc.code}`} name={`seoTitle-${loc.code}`} value={getTranslationField(loc.code, "seoTitle")} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seoDesc-${loc.code}`}>{t.adminBlog?.form?.seoDescription ?? "Description SEO"}</Label>
                      <Textarea id={`seoDesc-${loc.code}`} name={`seoDesc-${loc.code}`} rows={2} value={getTranslationField(loc.code, "seoDescription")} />
                    </div>
                  </div>
                </details>
              </div>
            ))}
          </CardContent>
        </Card>

        <!-- Cover image -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:image-multiple-outline" class="card-title-icon" />
              <span>{t.adminBlog?.form?.coverImage ?? "Image de couverture"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="upload-zone" id="upload-zone">
              <div class="upload-actions-row">
                <button type="button" id="btn-pick-media" class="btn-pick-media">
                  <Icon name="mdi:image-search-outline" class="pick-icon" />
                  {t.adminBlog?.form?.library ?? "Bibliothèque"}
                </button>
                <span class="upload-separator">{t.adminBlog?.form?.or ?? "ou"}</span>
                <label for="cover-upload" class="btn-upload-file">
                  <Icon name="mdi:cloud-upload-outline" class="pick-icon" />
                  {t.adminBlog?.form?.upload ?? "Téléverser"}
                </label>
              </div>
              <input type="file" id="cover-upload" accept="image/*" class="upload-input" />
              <div id="upload-preview" class:list={["upload-preview", { hidden: !coverMediaRecord }]}>
                {coverMediaRecord && <img src={coverMediaRecord.url} alt="Cover" />}
              </div>
            </div>
          </CardContent>
        </Card>

        <!-- Gallery -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:image-multiple" class="card-title-icon" />
              <span>{ts?.form?.gallery ?? "Galerie"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div id="gallery-grid" class="gallery-grid">
              {galleryMediaRecords.map((g, i) => (
                <div class="gallery-item" data-media-id={g.link.mediaId} data-position={i}>
                  <img src={g.media!.url} alt={`Gallery ${i + 1}`} class="gallery-thumb" />
                  <button type="button" class="gallery-remove" title="Retirer">&times;</button>
                </div>
              ))}
            </div>
            <button type="button" id="btn-add-gallery" class="btn-pick-media" style="margin-top: var(--space-3, 0.75rem);">
              <Icon name="mdi:plus" class="pick-icon" />
              {ts?.form?.addGalleryImage ?? "Ajouter des images"}
            </button>
          </CardContent>
        </Card>

        <!-- Availability -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:calendar-clock" class="card-title-icon" />
              <span>{ts?.availability?.title ?? "Disponibilités"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="availability-grid" id="availability-grid">
              {[0,1,2,3,4,5,6].map((day) => {
                const slot = availabilitySlots.find((s) => s.dayOfWeek === day);
                return (
                  <div class="availability-row" data-day={day}>
                    <span class="day-label">{dayNames[day]}</span>
                    <Switch id={`avail-on-${day}`} name={`avail_on_${day}`} checked={slot?.isAvailable ?? false} />
                    <Input id={`avail-start-${day}`} type="time" name={`avail_start_${day}`} value={slot?.startTime ?? "09:00"} />
                    <span class="time-sep">–</span>
                    <Input id={`avail-end-${day}`} type="time" name={`avail_end_${day}`} value={slot?.endTime ?? "17:00"} />
                  </div>
                );
              })}
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="form-sidebar">

        <!-- Publish settings -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:cog-outline" class="card-title-icon" />
              <span>{t.adminBlog?.form?.publishing ?? "Publication"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="slug">{ts?.form?.slug ?? "Slug"} *</Label>
              <Input id="slug" name="slug" value={service.slug} />
            </div>
            <div class="form-field">
              <Label htmlFor="status">{ts?.form?.status ?? "Statut"}</Label>
              <Select id="status" name="status">
                <option value="draft" selected={service.status === "draft"}>{ts?.status?.draft ?? "Brouillon"}</option>
                <option value="pending_review" selected={service.status === "pending_review"}>{ts?.status?.pending_review ?? "En attente"}</option>
                <option value="active" selected={service.status === "active"}>{ts?.status?.active ?? "Actif"}</option>
                <option value="suspended" selected={service.status === "suspended"}>{ts?.status?.suspended ?? "Suspendu"}</option>
              </Select>
            </div>
            <div class="form-field">
              <Label htmlFor="categoryId">{ts?.form?.category ?? "Catégorie"}</Label>
              <Select id="categoryId" name="categoryId">
                <option value="">{ts?.form?.none ?? "Aucune"}</option>
                {allCategories.map((cat) => (
                  <option value={cat.id} selected={cat.id === service.categoryId}>{extractLocalized(cat.name)}</option>
                ))}
              </Select>
            </div>
            <div class="form-field">
              <Label htmlFor="inLanguage">{t.adminBlog?.form?.mainLanguage ?? "Langue principale"}</Label>
              <Select id="inLanguage" name="inLanguage">
                {supportedLocales.map((loc) => (
                  <option value={loc.code} selected={loc.code === (service.inLanguage ?? "fr")}>{loc.flag} {loc.label}</option>
                ))}
              </Select>
            </div>

            <div class="toggle-group">
              <div class="toggle-row">
                <Switch id="isFeatured" name="isFeatured" checked={service.isFeatured} />
                <Label htmlFor="isFeatured">{ts?.form?.featured ?? "En vedette"}</Label>
              </div>
              <div class="toggle-row">
                <Switch id="displayInHome" name="displayInHome" checked={service.displayInHome} />
                <Label htmlFor="displayInHome">{ts?.form?.displayHome ?? "Afficher en accueil"}</Label>
              </div>
              <div class="toggle-row">
                <Switch id="isMobile" name="isMobile" checked={service.isMobile} />
                <Label htmlFor="isMobile">{ts?.form?.mobile ?? "Service mobile"}</Label>
              </div>
              <div class="toggle-row">
                <Switch id="allowReviews" name="allowReviews" checked={service.allowReviews} />
                <Label htmlFor="allowReviews">{ts?.form?.allowReviews ?? "Autoriser les avis"}</Label>
              </div>
            </div>
          </CardContent>
        </Card>

        <!-- Pricing -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:currency-eur" class="card-title-icon" />
              <span>{ts?.form?.price ?? "Tarification"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="basePrice">{ts?.form?.basePrice ?? "Prix de base"}</Label>
              <Input id="basePrice" type="text" name="basePrice" value={service.basePrice ?? ""} placeholder="25.00" />
            </div>
            <div class="form-field">
              <Label htmlFor="priceType">{ts?.form?.priceType ?? "Type de prix"}</Label>
              <Select id="priceType" name="priceType">
                <option value="fixed" selected={service.priceType === "fixed"}>{ts?.form?.priceFixed ?? "Forfait"}</option>
                <option value="per_hour" selected={service.priceType === "per_hour"}>{ts?.form?.pricePerHour ?? "Par heure"}</option>
                <option value="per_session" selected={service.priceType === "per_session"}>{ts?.form?.pricePerSession ?? "Par séance"}</option>
                <option value="on_quote" selected={service.priceType === "on_quote"}>{ts?.form?.priceOnQuote ?? "Sur devis"}</option>
              </Select>
            </div>
            <div class="form-field">
              <Label htmlFor="currency">{ts?.form?.currency ?? "Devise"}</Label>
              <Input id="currency" type="text" name="currency" value={service.currency ?? "EUR"} />
            </div>
            <div class="form-field">
              <Label htmlFor="durationMinutes">{ts?.form?.duration ?? "Durée (minutes)"}</Label>
              <Input id="durationMinutes" type="number" name="durationMinutes" value={String(service.durationMinutes ?? "")} />
            </div>
            <div class="form-field">
              <Label htmlFor="maxParticipants">{ts?.form?.maxParticipants ?? "Participants max"}</Label>
              <Input id="maxParticipants" type="number" name="maxParticipants" value={String(service.maxParticipants ?? "")} />
            </div>
            <div class="form-field">
              <Label htmlFor="bookingAdvanceHours">{ts?.form?.bookingAdvance ?? "Réservation à l'avance (h)"}</Label>
              <Input id="bookingAdvanceHours" type="number" name="bookingAdvanceHours" value={String(service.bookingAdvanceHours ?? "")} />
            </div>
            <div class="form-field">
              <Label htmlFor="cancellationHours">{ts?.form?.cancellationHours ?? "Annulation (h)"}</Label>
              <Input id="cancellationHours" type="number" name="cancellationHours" value={String(service.cancellationHours ?? "")} />
            </div>
          </CardContent>
        </Card>

        <!-- Danger Zone -->
        <Card elevation="sm" className="danger-zone-card">
          <CardContent>
            <details class="danger-details">
              <summary class="danger-summary">
                <Icon name="mdi:alert-outline" class="danger-icon" />
                {t.adminBlog?.common?.dangerZone ?? "Zone de danger"}
              </summary>
              <div class="danger-body">
                <p class="danger-text">{ts?.listings?.deleteWarning ?? "La suppression est définitive et retire toutes les traductions, médias et disponibilités associés."}</p>
                <button type="button" id="btn-delete" class="btn-danger">
                  <Icon name="mdi:delete-outline" /> {t.adminBlog?.common?.delete ?? "Supprimer ce service"}
                </button>
              </div>
            </details>
          </CardContent>
        </Card>
      </div>
    </div>

    <!-- Action bar -->
    <div class="form-actions">
      <a href={adminBase} class="btn-cancel">{t.adminBlog?.common?.cancel ?? "Annuler"}</a>
      <div class="form-actions-right">
        <button type="button" id="btn-save" class="btn-primary">
          <Icon name="mdi:content-save-outline" /> {ts?.form?.save ?? "Enregistrer"}
        </button>
      </div>
    </div>
  </form>
  <MediaPickerModal />

  <div id="i18n-data" hidden
    data-title-required={ts?.js?.titleRequired ?? "Le titre en français est obligatoire."}
    data-service-saved={ts?.js?.serviceSaved ?? "Service enregistré avec succès."}
    data-service-deleted={ts?.js?.serviceDeleted ?? "Service supprimé. Redirection…"}
    data-error-save={ts?.js?.errorSave ?? "Erreur lors de la sauvegarde."}
    data-error-delete={ts?.js?.errorDelete ?? "Erreur lors de la suppression."}
    data-confirm-delete={ts?.js?.confirmDelete ?? "Supprimer définitivement ce service et toutes ses traductions ?"}
    data-network-error={ts?.js?.networkError ?? "Erreur réseau — vérifiez votre connexion."}
    data-cover-id={coverMedia?.mediaId ?? ""}
    data-gallery-items={JSON.stringify(galleryMediaRecords.map((g, i) => ({ id: g.link.mediaId, url: g.media!.url, position: i })))}
  ></div>
</AdminLayout>

<script>
  import { initMarkdownEditors, getEditorValue } from "@lib/admin/markdown-editor";
  import { openMediaPicker } from "@lib/admin/media-picker";
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    const i18n = document.getElementById("i18n-data")?.dataset ?? {};
    const editors = initMarkdownEditors();
    const form = document.getElementById("service-form") as HTMLFormElement;
    const serviceId = form?.dataset.serviceId;

    // ---------- Locale tabs ----------
    const tabs = document.querySelectorAll<HTMLElement>(".locale-tab");
    const panels = document.querySelectorAll<HTMLElement>(".locale-panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const locale = tab.dataset.locale!;
        tabs.forEach((t) => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
        panels.forEach((p) => p.classList.remove("active"));
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        document.querySelector(`[data-locale-panel="${locale}"]`)?.classList.add("active");
      });
    });

    // ---------- Cover image ----------
    const coverInput = document.getElementById("cover-upload") as HTMLInputElement;
    const preview = document.getElementById("upload-preview") as HTMLElement;
    let coverId: string | null = i18n.coverId || null;

    function setCoverPreview(id: string, url: string) {
      coverId = id;
      preview.innerHTML = `<img src="${url}" alt="Preview" /><button type="button" class="remove-preview" title="Supprimer">&times;</button>`;
      preview.classList.remove("hidden");
      preview.querySelector(".remove-preview")?.addEventListener("click", () => {
        coverId = null;
        preview.innerHTML = "";
        preview.classList.add("hidden");
        coverInput.value = "";
      });
    }

    // Attach remove to existing preview
    if (coverId && preview.querySelector("img")) {
      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className = "remove-preview";
      removeBtn.title = "Supprimer";
      removeBtn.textContent = "×";
      preview.appendChild(removeBtn);
      removeBtn.addEventListener("click", () => {
        coverId = null;
        preview.innerHTML = "";
        preview.classList.add("hidden");
      });
    }

    const SERVICES_API_BASE = "/api/admin/services/media";

    document.getElementById("btn-pick-media")?.addEventListener("click", async () => {
      const result = await openMediaPicker({ apiBase: SERVICES_API_BASE });
      if (result) setCoverPreview(result.id, result.url);
    });

    coverInput?.addEventListener("change", async () => {
      const file = coverInput.files?.[0];
      if (file) {
        const result = await openMediaPicker({ file, apiBase: SERVICES_API_BASE });
        if (result) setCoverPreview(result.id, result.url);
      }
      coverInput.value = "";
    });

    // ---------- Gallery ----------
    type GalleryItem = { id: string; url: string; position: number };
    let galleryItems: GalleryItem[] = JSON.parse(i18n.galleryItems || "[]");
    const galleryGrid = document.getElementById("gallery-grid") as HTMLElement;

    function renderGallery() {
      galleryGrid.innerHTML = galleryItems.map((item, idx) =>
        `<div class="gallery-item" data-media-id="${item.id}" data-position="${idx}">
          <img src="${item.url}" alt="Gallery ${idx + 1}" class="gallery-thumb" />
          <button type="button" class="gallery-remove" title="Retirer">&times;</button>
        </div>`
      ).join("");
      galleryGrid.querySelectorAll(".gallery-remove").forEach((btn, idx) => {
        btn.addEventListener("click", () => {
          galleryItems.splice(idx, 1);
          renderGallery();
        });
      });
    }

    // Attach remove handlers to server-rendered gallery items
    galleryGrid?.querySelectorAll(".gallery-remove").forEach((btn, idx) => {
      btn.addEventListener("click", () => {
        galleryItems.splice(idx, 1);
        renderGallery();
      });
    });

    document.getElementById("btn-add-gallery")?.addEventListener("click", async () => {
      const result = await openMediaPicker({ apiBase: SERVICES_API_BASE });
      if (result && !galleryItems.some((g) => g.id === result.id)) {
        galleryItems.push({ id: result.id, url: result.url, position: galleryItems.length });
        renderGallery();
      }
    });

    // ---------- Collect data ----------
    const locales = ["fr", "en", "es", "ar"];

    function collectData() {
      const slug = (document.getElementById("slug") as HTMLInputElement).value.trim();
      const status = (document.getElementById("status") as HTMLSelectElement).value;
      const categoryId = (document.getElementById("categoryId") as HTMLSelectElement).value;
      const inLanguage = (document.getElementById("inLanguage") as HTMLSelectElement).value;
      const isFeatured = (document.getElementById("isFeatured") as HTMLInputElement).checked;
      const displayInHome = (document.getElementById("displayInHome") as HTMLInputElement).checked;
      const isMobile = (document.getElementById("isMobile") as HTMLInputElement).checked;
      const allowReviews = (document.getElementById("allowReviews") as HTMLInputElement).checked;
      const basePrice = (document.getElementById("basePrice") as HTMLInputElement).value.trim();
      const priceType = (document.getElementById("priceType") as HTMLSelectElement).value;
      const currency = (document.getElementById("currency") as HTMLInputElement).value.trim() || "EUR";
      const durationMinutes = (document.getElementById("durationMinutes") as HTMLInputElement).value;
      const maxParticipants = (document.getElementById("maxParticipants") as HTMLInputElement).value;
      const bookingAdvanceHours = (document.getElementById("bookingAdvanceHours") as HTMLInputElement).value;
      const cancellationHours = (document.getElementById("cancellationHours") as HTMLInputElement).value;

      const translations: any[] = [];
      for (const loc of locales) {
        const title = (document.getElementById(`title-${loc}`) as HTMLInputElement)?.value.trim();
        const description = getEditorValue(editors, `desc-${loc}`).trim();
        const shortDescription = (document.getElementById(`shortDesc-${loc}`) as HTMLTextAreaElement)?.value.trim();
        if (title || description || shortDescription) {
          translations.push({
            inLanguage: loc,
            title: title || "",
            description: description || "",
            shortDescription: shortDescription || "",
            seoTitle: (document.getElementById(`seoTitle-${loc}`) as HTMLInputElement)?.value.trim() || "",
            seoDescription: (document.getElementById(`seoDesc-${loc}`) as HTMLTextAreaElement)?.value.trim() || "",
          });
        }
      }

      const media: any[] = [];
      if (coverId) media.push({ mediaId: coverId, type: "cover", position: "0" });
      galleryItems.forEach((g, idx) => {
        media.push({ mediaId: g.id, type: "gallery", position: String(idx + 1) });
      });

      return {
        action: "update",
        id: serviceId,
        slug,
        status,
        categoryId: categoryId || undefined,
        inLanguage,
        basePrice: basePrice || undefined,
        priceType,
        currency,
        durationMinutes: durationMinutes ? Number(durationMinutes) : null,
        maxParticipants: maxParticipants ? Number(maxParticipants) : null,
        bookingAdvanceHours: bookingAdvanceHours ? Number(bookingAdvanceHours) : null,
        cancellationHours: cancellationHours ? Number(cancellationHours) : null,
        isMobile,
        isFeatured,
        displayInHome,
        allowReviews,
        translations,
        media,
      };
    }

    function collectAvailability() {
      return [0,1,2,3,4,5,6].map((day) => ({
        dayOfWeek: day,
        isAvailable: (document.getElementById(`avail-on-${day}`) as HTMLInputElement)?.checked ?? false,
        startTime: (document.getElementById(`avail-start-${day}`) as HTMLInputElement)?.value || "09:00",
        endTime: (document.getElementById(`avail-end-${day}`) as HTMLInputElement)?.value || "17:00",
      }));
    }

    // ---------- Validation ----------
    function validate() {
      const title = (document.getElementById("title-fr") as HTMLInputElement)?.value.trim();
      if (!title) {
        showToast(i18n.titleRequired ?? "Le titre en français est obligatoire.", "warning");
        document.querySelector<HTMLElement>('[data-locale="fr"]')?.click();
        document.getElementById("title-fr")?.focus();
        return false;
      }
      return true;
    }

    // ---------- Save ----------
    document.getElementById("btn-save")?.addEventListener("click", async () => {
      if (!validate()) return;
      const btn = document.getElementById("btn-save") as HTMLButtonElement;
      btn.disabled = true;

      try {
        const data = collectData();
        const res = await fetch("/api/admin/services/services", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await res.json();

        if (result.ok || result.id) {
          // Save availability
          await fetch("/api/admin/services/availability", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "bulkSet", serviceId, slots: collectAvailability() }),
          });

          showToast(i18n.serviceSaved ?? "Enregistré !", "success");
          setTimeout(() => window.location.reload(), 800);
        } else {
          showToast(result.error || i18n.errorSave || "", "error");
        }
      } catch {
        showToast(i18n.networkError ?? "", "error");
      } finally {
        btn.disabled = false;
      }
    });

    // ---------- Delete ----------
    document.getElementById("btn-delete")?.addEventListener("click", async () => {
      if (!confirm(i18n.confirmDelete ?? "Supprimer ?")) return;
      try {
        const res = await fetch("/api/admin/services/services", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "delete", id: serviceId }),
        });
        if (res.ok) {
          showToast(i18n.serviceDeleted ?? "Supprimé.", "success");
          setTimeout(() => {
            window.location.href = document.querySelector<HTMLAnchorElement>(".back-link")?.href || window.location.pathname.replace(/\/[^/]+\/edit$/, "");
          }, 800);
        } else {
          showToast(i18n.errorDelete ?? "", "error");
        }
      } catch {
        showToast(i18n.networkError ?? "", "error");
      }
    });
  });
</script>


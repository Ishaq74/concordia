---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";
const lang = Astro.params.lang as string;
const t = getTranslations(lang);
---

<AdminLayout title={t.adminBlog?.media?.pageTitle ?? "Médias — Blog"} activeSection="blog-media">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <h1>{t.adminBlog?.media?.title ?? "Media Library"}</h1>
      </div>
      <div class="admin-page-actions">
        <button type="button" id="btn-upload" class="btn-primary">
          <Icon name="mdi:cloud-upload-outline" class="btn-icon" />
          {t.adminBlog?.media?.upload ?? "Upload"}
        </button>
      </div>
    </div>
    <p class="admin-page-subtitle">{t.adminBlog?.media?.subtitle ?? "Manage blog images and files."}</p>
  </header>

  <!-- Toolbar: search + filters -->
  <Card elevation="sm">
    <CardContent>
      <div class="media-toolbar">
        <div class="toolbar-search">
          <Icon name="mdi:magnify" class="search-icon" />
          <input type="search" id="search-input" class="search-input" placeholder={t.adminBlog?.media?.searchPlaceholder ?? "Search by filename…"} />
        </div>
        <div class="toolbar-filters">
          <select id="filter-type" class="filter-select">
            <option value="">{t.adminBlog?.allTypes ?? "All types"}</option>
            <option value="image">{t.adminBlog?.images ?? "Images"}</option>
            <option value="video">{t.adminBlog?.videos ?? "Videos"}</option>
            <option value="audio">{t.adminBlog?.audio ?? "Audio"}</option>
          </select>
        </div>
      </div>
    </CardContent>
  </Card>

  <!-- Upload zone (hidden by default) -->
  <div id="upload-section" class="upload-section" style="display:none;">
    <Card elevation="sm">
      <CardContent>
        <div class="upload-zone" id="upload-zone">
          <Icon name="mdi:cloud-upload-outline" class="upload-zone-icon" />
          <p class="upload-zone-text" set:html={t.adminBlog?.media?.dropzone ?? 'Drop your files here or <strong>click to browse</strong>'} />
          <p class="upload-zone-hint">{t.adminBlog?.media?.formats ?? "JPEG, PNG, WebP, AVIF, GIF, SVG — Max 10 MB per file"}</p>
          <input type="file" id="file-input" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml" multiple class="upload-file-hidden" />
        </div>
        <!-- Pre-upload metadata form (single file) -->
        <div id="upload-meta-form" class="upload-meta-form" style="display:none;">
          <div class="meta-form-preview">
            <img id="meta-preview-img" src="" alt="" />
          </div>
          <div class="meta-form-fields">
            <div class="meta-form-field">
              <label for="meta-filename">{t.adminBlog?.media?.fileName ?? "File name"}</label>
              <div class="meta-filename-row">
                <input type="text" id="meta-filename" placeholder="mon-image" />
                <span class="meta-filename-ext" id="meta-ext">.jpg</span>
              </div>
              <span class="meta-form-hint">{t.adminBlog?.media?.slugHint ?? "Caractères autorisés : lettres, chiffres, tirets."}</span>
            </div>
            <div class="meta-form-field">
              <label for="meta-alt">{t.adminBlog?.form?.altText ?? "Alt text"}</label>
              <input type="text" id="meta-alt" placeholder={t.adminBlog?.media?.altPlaceholder ?? "Description de l'image…"} />
            </div>
            <div class="meta-form-field">
              <label for="meta-caption">{t.adminBlog?.form?.caption ?? "Caption"}</label>
              <input type="text" id="meta-caption" placeholder={t.adminBlog?.media?.captionPlaceholder ?? "Légende optionnelle…"} />
            </div>
            <div class="meta-form-field">
              <label for="meta-description">{t.adminBlog?.form?.description ?? "Description"}</label>
              <textarea id="meta-description" rows="2" placeholder={t.adminBlog?.media?.descriptionPlaceholder ?? "Description détaillée…"}></textarea>
            </div>
            <div class="meta-form-actions">
              <button type="button" class="meta-btn-cancel" id="meta-btn-cancel">{t.adminBlog?.common?.cancel ?? "Cancel"}</button>
              <button type="button" class="meta-btn-skip" id="meta-btn-skip">{t.adminBlog?.media?.uploadNoMeta ?? "Upload without metadata"}</button>
              <button type="button" class="meta-btn-upload" id="meta-btn-upload">{t.adminBlog?.media?.upload ?? "Upload"}</button>
            </div>
          </div>
        </div>
        <div id="upload-progress" class="upload-progress" style="display:none;">
          <div class="progress-bar"><div class="progress-fill" id="progress-fill"></div></div>
          <span class="progress-text" id="progress-text">{t.adminBlog?.media?.uploading ?? "Upload en cours…"}</span>
        </div>
      </CardContent>
    </Card>
  </div>

  <!-- Media grid -->
  <div class="media-grid" id="media-grid">
    <div class="loading-state">
      <Icon name="mdi:loading" class="loading-icon spin" />
      {t.adminBlog?.common?.loading ?? "Loading…"}
    </div>
  </div>

  <!-- Pagination -->
  <div class="pagination" id="pagination"></div>

  <!-- Detail sidebar (hidden by default) -->
  <div id="detail-overlay" class="detail-overlay" style="display:none;">
    <div class="detail-panel">
      <div class="detail-header">
        <h3 class="detail-title">{t.adminBlog?.media?.details ?? "Media details"}</h3>
        <button type="button" class="detail-close" id="detail-close">&times;</button>
      </div>
      <div class="detail-body">
        <div class="detail-preview">
          <img id="detail-img" src="" alt="" />
        </div>
        <div class="detail-meta">
          <div class="meta-row">
            <span class="meta-label">{t.adminBlog?.media?.fileLabel ?? "Fichier"}</span>
            <span class="meta-value" id="detail-filename">—</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">{t.adminBlog?.media?.typeLabel ?? "Type"}</span>
            <span class="meta-value" id="detail-type">—</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">{t.adminBlog?.media?.dateLabel ?? "Date"}</span>
            <span class="meta-value" id="detail-date">—</span>
          </div>
          <div class="meta-row">
            <span class="meta-label">URL</span>
            <input type="text" id="detail-url" class="meta-url-input" readonly />
            <button type="button" class="copy-btn" id="copy-url" title={t.adminBlog?.media?.copyUrl ?? "Copier l'URL"}>
              <Icon name="mdi:content-copy" class="copy-icon" />
            </button>
          </div>
        </div>

        <div class="detail-fields">
          <div class="detail-field">
            <label for="detail-alt">{t.adminBlog?.media?.altLabel ?? "Texte alternatif"}</label>
            <input type="text" id="detail-alt" class="detail-input" placeholder={t.adminBlog?.media?.altPlaceholder ?? "Description de l'image…"} />
          </div>
          <div class="detail-field">
            <label for="detail-caption">{t.adminBlog?.media?.captionLabel ?? "Légende"}</label>
            <input type="text" id="detail-caption" class="detail-input" placeholder={t.adminBlog?.media?.captionPlaceholder ?? "Légende optionnelle…"} />
          </div>
          <div class="detail-field">
            <label for="detail-description">{t.adminBlog?.media?.descriptionLabel ?? "Description"}</label>
            <textarea id="detail-description" class="detail-input" rows="2" placeholder={t.adminBlog?.media?.descriptionPlaceholder ?? "Description détaillée…"}></textarea>
          </div>
        </div>
      </div>
      <div class="detail-footer">
        <button type="button" class="btn-danger-sm" id="detail-delete">
          <Icon name="mdi:delete-outline" class="btn-icon" />
          {t.adminBlog?.common?.delete ?? "Delete"}
        </button>
        <button type="button" class="btn-primary-sm" id="detail-save">
          {t.adminBlog?.common?.save ?? "Save"}
        </button>
      </div>
    </div>
  </div>
  <div id="i18n-js" hidden
    data-loading={t.adminBlog?.js?.loading ?? "Chargement\u2026"}
    data-no-media={t.adminBlog?.js?.noMedia ?? "Aucun m\u00e9dia trouv\u00e9."}
    data-load-error={t.adminBlog?.js?.loadError ?? "Erreur de chargement."}
    data-prev-page={t.adminBlog?.js?.prevPage ?? "\u2039 Pr\u00e9c\u00e9dent"}
    data-next-page={t.adminBlog?.js?.nextPage ?? "Suivant \u203a"}
    data-media-count={t.adminBlog?.js?.mediaCount ?? "{n} m\u00e9dia(s)"}
    data-files-uploaded={t.adminBlog?.js?.filesUploaded ?? "{n} fichier(s) upload\u00e9(s)"}
    data-upload-error={t.adminBlog?.js?.uploadError ?? "Erreur lors de l'upload."}
    data-network-error={t.adminBlog?.js?.networkError ?? "Erreur r\u00e9seau."}
    data-meta-saved={t.adminBlog?.js?.metaSaved ?? "M\u00e9tadonn\u00e9es enregistr\u00e9es."}
    data-meta-error={t.adminBlog?.js?.metaError ?? "Erreur lors de la sauvegarde."}
    data-confirm-delete-media={t.adminBlog?.js?.confirmDeleteMedia ?? "Supprimer ce m\u00e9dia ?"}
    data-media-deleted={t.adminBlog?.js?.mediaDeleted ?? "M\u00e9dia supprim\u00e9."}
    data-url-copied={t.adminBlog?.js?.urlCopied ?? "URL copi\u00e9e !"}
    data-unknown-error={t.adminBlog?.js?.unknownError ?? "Erreur inconnue."}
  ></div>
</AdminLayout>

<script>
  import { showToast } from "@lib/admin/toast";

  const i18n = document.getElementById("i18n-js")?.dataset ?? {};

  interface MediaItem {
    id: string;
    url: string;
    type: string;
    encodingFormat: string | null;
    alt: Record<string, string> | null;
    caption: Record<string, string> | null;
    description: Record<string, string> | null;
    createdAt: string;
  }

  interface MediaListResponse {
    media: MediaItem[];
    total: number;
    page: number;
    perPage: number;
    totalPages: number;
  }

  let currentPage = 1;
  let currentSearch = "";
  let currentType = "";
  let currentDetailItem: MediaItem | null = null;

  document.addEventListener("DOMContentLoaded", () => {
    loadMedia();

    // Search
    let searchTimer: ReturnType<typeof setTimeout>;
    const searchInput = document.getElementById("search-input") as HTMLInputElement;
    searchInput?.addEventListener("input", () => {
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => {
        currentSearch = searchInput.value.trim();
        currentPage = 1;
        loadMedia();
      }, 300);
    });

    // Type filter
    const filterType = document.getElementById("filter-type") as HTMLSelectElement;
    filterType?.addEventListener("change", () => {
      currentType = filterType.value;
      currentPage = 1;
      loadMedia();
    });

    // Upload toggle
    const btnUpload = document.getElementById("btn-upload");
    const uploadSection = document.getElementById("upload-section");
    btnUpload?.addEventListener("click", () => {
      const isVisible = uploadSection?.style.display !== "none";
      if (uploadSection) uploadSection.style.display = isVisible ? "none" : "block";
    });

    // Upload zone
    const uploadZone = document.getElementById("upload-zone");
    const fileInput = document.getElementById("file-input") as HTMLInputElement;
    let pendingFileForMeta: File | null = null;

    uploadZone?.addEventListener("dragover", (e) => { e.preventDefault(); uploadZone.classList.add("dragover"); });
    uploadZone?.addEventListener("dragleave", () => uploadZone.classList.remove("dragover"));
    uploadZone?.addEventListener("drop", async (e) => {
      e.preventDefault();
      uploadZone.classList.remove("dragover");
      const files = (e as DragEvent).dataTransfer?.files;
      if (files && files.length === 1) {
        showPreUploadForm(files[0]);
      } else if (files && files.length > 1) {
        await uploadFiles(files);
      }
    });

    fileInput?.addEventListener("change", async () => {
      if (fileInput.files && fileInput.files.length === 1) {
        showPreUploadForm(fileInput.files[0]);
      } else if (fileInput.files && fileInput.files.length > 1) {
        await uploadFiles(fileInput.files);
      }
      fileInput.value = "";
    });

    function showPreUploadForm(file: File) {
      pendingFileForMeta = file;
      const metaForm = document.getElementById("upload-meta-form");
      const previewImg = document.getElementById("meta-preview-img") as HTMLImageElement;
      const filenameInput = document.getElementById("meta-filename") as HTMLInputElement;
      const extSpan = document.getElementById("meta-ext");
      const altInput = document.getElementById("meta-alt") as HTMLInputElement;
      const captionInput = document.getElementById("meta-caption") as HTMLInputElement;
      const descInput = document.getElementById("meta-description") as HTMLTextAreaElement;

      // Hide upload zone, show form
      if (uploadZone) uploadZone.style.display = "none";
      if (metaForm) metaForm.style.display = "flex";

      // Local preview
      if (previewImg) previewImg.src = URL.createObjectURL(file);

      // Filename
      const parts = file.name.split(".");
      const ext = parts.length > 1 ? parts.pop()! : "";
      const nameWithoutExt = parts.join(".");
      const slugified = nameWithoutExt
        .toLowerCase()
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9-]/g, "-")
        .replace(/-+/g, "-")
        .replace(/^-|-$/g, "");

      if (filenameInput) filenameInput.value = slugified;
      if (extSpan) extSpan.textContent = `.${ext}`;
      if (altInput) altInput.value = "";
      if (captionInput) captionInput.value = "";
      if (descInput) descInput.value = "";

      setTimeout(() => filenameInput?.focus(), 100);
    }

    function hidePreUploadForm() {
      const metaForm = document.getElementById("upload-meta-form");
      if (metaForm) metaForm.style.display = "none";
      if (uploadZone) uploadZone.style.display = "flex";
      pendingFileForMeta = null;
    }

    // Cancel: go back to upload zone
    document.getElementById("meta-btn-cancel")?.addEventListener("click", hidePreUploadForm);

    // Skip: upload without metadata
    document.getElementById("meta-btn-skip")?.addEventListener("click", async () => {
      if (!pendingFileForMeta) return;
      const file = pendingFileForMeta;
      hidePreUploadForm();
      const fileList = new DataTransfer();
      fileList.items.add(file);
      await uploadFiles(fileList.files);
    });

    // Upload with metadata
    document.getElementById("meta-btn-upload")?.addEventListener("click", async () => {
      if (!pendingFileForMeta) return;
      const file = pendingFileForMeta;
      const customName = (document.getElementById("meta-filename") as HTMLInputElement)?.value.trim() || null;
      const alt = (document.getElementById("meta-alt") as HTMLInputElement)?.value.trim() || null;
      const caption = (document.getElementById("meta-caption") as HTMLInputElement)?.value.trim() || null;
      const description = (document.getElementById("meta-description") as HTMLTextAreaElement)?.value.trim() || null;

      hidePreUploadForm();
      await uploadFileWithMeta(file, customName, alt, caption, description);
    });

    // Detail panel close
    document.getElementById("detail-close")?.addEventListener("click", closeDetail);
    document.getElementById("detail-overlay")?.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).id === "detail-overlay") closeDetail();
    });

    // Copy URL
    document.getElementById("copy-url")?.addEventListener("click", () => {
      const urlInput = document.getElementById("detail-url") as HTMLInputElement;
      if (urlInput) {
        navigator.clipboard.writeText(window.location.origin + urlInput.value);
        const btn = document.getElementById("copy-url");
        if (btn) { btn.textContent = "✓"; setTimeout(() => { btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>'; }, 1500); }
      }
    });

    // Save metadata
    document.getElementById("detail-save")?.addEventListener("click", saveMetadata);

    // Delete
    document.getElementById("detail-delete")?.addEventListener("click", deleteMedia);
  });

  async function loadMedia() {
    const grid = document.getElementById("media-grid");
    if (!grid) return;

    grid.innerHTML = `<div class="loading-state">${i18n.loading ?? "Chargement…"}</div>`;

    try {
      const params = new URLSearchParams({
        page: String(currentPage),
        perPage: "30",
      });
      if (currentSearch) params.set("q", currentSearch);
      if (currentType) params.set("type", currentType);

      const res = await fetch(`/api/admin/blog/media?${params}`);
      const data: MediaListResponse = await res.json();

      if (data.media.length === 0) {
        grid.innerHTML = `<div class="empty-state"><p>${i18n.noMedia ?? "Aucun média trouvé."}</p></div>`;
        renderPagination(data);
        return;
      }

      grid.innerHTML = "";
      data.media.forEach((item) => {
        const card = document.createElement("div");
        card.className = "media-card";
        card.dataset.mediaId = item.id;

        const filename = item.url.split("/").pop() || item.id;
        const dateStr = new Date(item.createdAt).toLocaleDateString(document.documentElement.lang || "fr-FR", { day: "2-digit", month: "short", year: "numeric" });

        card.innerHTML = `
          <div class="media-thumb">
            <img src="${item.url}" alt="${filename}" loading="lazy" />
          </div>
          <div class="media-info">
            <span class="media-name" title="${filename}">${filename}</span>
            <span class="media-date">${dateStr}</span>
          </div>
        `;

        card.addEventListener("click", () => openDetail(item));
        grid.appendChild(card);
      });

      renderPagination(data);
    } catch {
      grid.innerHTML = `<div class="empty-state"><p>${i18n.loadError ?? "Erreur de chargement."}</p></div>`;
    }
  }

  function renderPagination(data: MediaListResponse) {
    const container = document.getElementById("pagination");
    if (!container) return;

    const mediaCountText = (i18n.mediaCount ?? "{n} média(s)").replace("{n}", String(data.total));

    if (data.totalPages <= 1) {
      container.innerHTML = `<span class="page-info">${mediaCountText}</span>`;
      return;
    }

    let html = `<button class="page-btn" data-page="${data.page - 1}" ${data.page <= 1 ? "disabled" : ""}>${i18n.prevPage ?? "‹ Précédent"}</button>`;

    const start = Math.max(1, data.page - 2);
    const end = Math.min(data.totalPages, data.page + 2);
    for (let i = start; i <= end; i++) {
      html += `<button class="page-btn ${i === data.page ? "active" : ""}" data-page="${i}">${i}</button>`;
    }

    html += `<button class="page-btn" data-page="${data.page + 1}" ${data.page >= data.totalPages ? "disabled" : ""}>${i18n.nextPage ?? "Suivant ›"}</button>`;
    html += `<span class="page-info">${mediaCountText}</span>`;

    container.innerHTML = html;

    container.querySelectorAll<HTMLButtonElement>(".page-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const page = parseInt(btn.dataset.page || "1");
        if (page >= 1 && page <= data.totalPages) {
          currentPage = page;
          loadMedia();
        }
      });
    });
  }

  async function uploadFiles(files: FileList) {
    const progress = document.getElementById("upload-progress");
    const progressFill = document.getElementById("progress-fill");
    const progressText = document.getElementById("progress-text");
    const uploadZone = document.getElementById("upload-zone");

    if (progress) progress.style.display = "flex";
    if (uploadZone) uploadZone.style.display = "none";

    let uploaded = 0;
    const total = files.length;

    for (const file of Array.from(files)) {
      if (progressText) progressText.textContent = `Upload ${uploaded + 1}/${total}…`;
      if (progressFill) progressFill.style.width = `${((uploaded + 0.5) / total) * 100}%`;

      try {
        const fd = new FormData();
        fd.append("file", file);
        const res = await fetch("/api/admin/blog/media", { method: "POST", body: fd });
        const data = await res.json();
        if (!data.ok) {
          showToast(data.error || (i18n.uploadError ?? "Erreur lors de l'upload."), "error");
        }
      } catch {
        showToast(i18n.networkError ?? "Erreur réseau.", "error");
      }

      uploaded++;
      if (progressFill) progressFill.style.width = `${(uploaded / total) * 100}%`;
    }

    const uploadedText = (i18n.filesUploaded ?? "{n} fichier(s) uploadé(s)").replace("{n}", String(uploaded));
    if (progressText) progressText.textContent = uploadedText;
    showToast(uploadedText, "success");

    setTimeout(() => {
      if (progress) progress.style.display = "none";
      if (progressFill) progressFill.style.width = "0%";
      if (uploadZone) uploadZone.style.display = "flex";
      loadMedia();
    }, 1000);
  }

  async function uploadFileWithMeta(
    file: File,
    customName: string | null,
    alt: string | null,
    caption: string | null,
    description: string | null
  ) {
    const progress = document.getElementById("upload-progress");
    const progressFill = document.getElementById("progress-fill");
    const progressText = document.getElementById("progress-text");
    const uploadZone = document.getElementById("upload-zone");

    if (progress) progress.style.display = "flex";
    if (uploadZone) uploadZone.style.display = "none";
    if (progressFill) progressFill.style.width = "30%";
    if (progressText) progressText.textContent = "Upload en cours…";

    try {
      const fd = new FormData();
      fd.append("file", file);
      if (customName) fd.append("customName", customName);
      if (alt) fd.append("alt", alt);
      if (caption) fd.append("caption", caption);
      if (description) fd.append("description", description);

      if (progressFill) progressFill.style.width = "60%";
      const res = await fetch("/api/admin/blog/media", { method: "POST", body: fd });
      const data = await res.json();
      if (progressFill) progressFill.style.width = "100%";

      if (data.ok) {
        const singleUploadText = (i18n.filesUploaded ?? "{n} fichier(s) uploadé(s)").replace("{n}", "1");
        if (progressText) progressText.textContent = singleUploadText;
        showToast(singleUploadText, "success");
      } else {
        showToast(data.error || (i18n.uploadError ?? "Erreur lors de l'upload."), "error");
      }
    } catch {
      showToast(i18n.networkError ?? "Erreur réseau.", "error");
    }

    setTimeout(() => {
      if (progress) progress.style.display = "none";
      if (progressFill) progressFill.style.width = "0%";
      if (uploadZone) uploadZone.style.display = "flex";
      loadMedia();
    }, 1000);
  }

  function openDetail(item: MediaItem) {
    currentDetailItem = item;
    const overlay = document.getElementById("detail-overlay");
    const img = document.getElementById("detail-img") as HTMLImageElement;
    const filename = document.getElementById("detail-filename");
    const type = document.getElementById("detail-type");
    const date = document.getElementById("detail-date");
    const url = document.getElementById("detail-url") as HTMLInputElement;
    const alt = document.getElementById("detail-alt") as HTMLInputElement;
    const caption = document.getElementById("detail-caption") as HTMLInputElement;
    const description = document.getElementById("detail-description") as HTMLTextAreaElement;

    const name = item.url.split("/").pop() || item.id;

    if (img) img.src = item.url;
    if (filename) filename.textContent = name;
    if (type) type.textContent = item.encodingFormat || item.type;
    if (date) date.textContent = new Date(item.createdAt).toLocaleDateString(document.documentElement.lang || "fr-FR", { day: "2-digit", month: "long", year: "numeric" });
    if (url) url.value = item.url;
    if (alt) alt.value = (item.alt as Record<string, string>)?.fr || "";
    if (caption) caption.value = (item.caption as Record<string, string>)?.fr || "";
    if (description) description.value = (item.description as Record<string, string>)?.fr || "";

    if (overlay) overlay.style.display = "flex";
  }

  function closeDetail() {
    const overlay = document.getElementById("detail-overlay");
    if (overlay) overlay.style.display = "none";
    currentDetailItem = null;
  }

  async function saveMetadata() {
    if (!currentDetailItem) return;

    const alt = (document.getElementById("detail-alt") as HTMLInputElement).value.trim();
    const caption = (document.getElementById("detail-caption") as HTMLInputElement).value.trim();
    const description = (document.getElementById("detail-description") as HTMLTextAreaElement).value.trim();

    try {
      const res = await fetch("/api/admin/blog/media", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "update",
          id: currentDetailItem.id,
          alt: { fr: alt },
          caption: { fr: caption },
          description: { fr: description },
        }),
      });
      const data = await res.json();
      if (data.ok) {
        showToast(i18n.metaSaved ?? "Métadonnées enregistrées.", "success");
        closeDetail();
        loadMedia();
      } else {
        showToast(data.error || (i18n.metaError ?? "Erreur lors de la sauvegarde."), "error");
      }
    } catch { showToast(i18n.networkError ?? "Erreur réseau.", "error"); }
  }

  async function deleteMedia() {
    if (!currentDetailItem) return;
    if (!confirm(i18n.confirmDeleteMedia ?? "Supprimer ce média ?")) return;

    try {
      const res = await fetch("/api/admin/blog/media", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "delete", id: currentDetailItem.id }),
      });
      const data = await res.json();
      if (data.ok) {
        showToast(i18n.mediaDeleted ?? "Média supprimé.", "success");
        closeDetail();
        loadMedia();
      } else {
        showToast(data.error || (i18n.unknownError ?? "Erreur."), "error");
      }
    } catch { showToast(i18n.networkError ?? "Erreur réseau.", "error"); }
  }
</script>


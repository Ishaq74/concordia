---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Switch from "@components/ui/Form/Switch.astro";
import Checkbox from "@components/ui/Form/Checkbox.astro";
import MarkdownEditor from "@components/admin/MarkdownEditor.astro";
import MediaPickerModal from "@components/admin/MediaPickerModal.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogCategories, blogAuthors } from "@database/schemas";
import { getTranslations } from "@i18n/translations";
const lang = Astro.params.lang as string;
const t = getTranslations(lang);

const currentLocale = lang;
const adminBase = `/${currentLocale}/admin/blog/articles`;
const orgId = Astro.url.searchParams.get("orgId") ?? "";

const db = await getDrizzle();

// Load categories for selector
const allCategories = await db
  .select({ id: blogCategories.id, slug: blogCategories.slug, name: blogCategories.name })
  .from(blogCategories)
  .orderBy(blogCategories.slug);

// Load authors for selector
const allAuthors = await db
  .select({ id: blogAuthors.id, displayName: blogAuthors.displayName, slug: blogAuthors.slug })
  .from(blogAuthors)
  .orderBy(blogAuthors.slug);

const extractLocalized = (value: unknown, locale: string = currentLocale): string => {
  if (typeof value === "string") return value;
  if (value && typeof value === "object") {
    const obj = value as Record<string, string>;
    return obj[locale] || Object.values(obj)[0] || "";
  }
  return "";
};

const supportedLocales = [
  { code: "fr", label: "Français", flag: "🇫🇷" },
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "ar", label: "العربية", flag: "🇸🇦" },
];
---

<AdminLayout title={t.adminBlog?.articles?.new ?? "Nouvel article"} activeSection="blog-articles">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <a href={adminBase} class="back-link"><Icon name="mdi:arrow-left" /></a>
        <h1>{t.adminBlog?.articles?.new ?? "Nouvel article"}</h1>
      </div>
    </div>
    <p class="admin-page-subtitle">{t.adminBlog?.articles?.subtitle ?? "Créez un article avec ses traductions, catégories, auteurs et médias."}</p>
  </header>

  <form id="article-form" class="article-form">
    <div class="form-layout">
      <!-- Main content column -->
      <div class="form-main">

        <!-- Translation tabs -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:translate" class="card-title-icon" />
              <span>{t.adminBlog?.form?.multilingual ?? "Contenu multilingue"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="locale-tabs" role="tablist">
              {supportedLocales.map((loc, i) => (
                <button
                  type="button"
                  role="tab"
                  class:list={["locale-tab", { active: i === 0 }]}
                  data-locale={loc.code}
                  aria-selected={i === 0 ? "true" : "false"}
                >
                  <span class="locale-flag">{loc.flag}</span>
                  {loc.label}
                </button>
              ))}
            </div>

            {supportedLocales.map((loc, i) => (
              <div class:list={["locale-panel", { active: i === 0 }]} data-locale-panel={loc.code}>
                <div class="form-field">
                  <Label htmlFor={`headline-${loc.code}`}>{t.adminBlog?.form?.titleLabel ?? "Titre"} *</Label>
                  <Input id={`headline-${loc.code}`} name={`headline-${loc.code}`} placeholder={`${t.adminBlog?.form?.titleIn ?? "Titre en"} ${loc.label}…`} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`alt-headline-${loc.code}`}>{t.adminBlog?.form?.subtitle ?? "Sous-titre"}</Label>
                  <Input id={`alt-headline-${loc.code}`} name={`alt-headline-${loc.code}`} placeholder={t.adminBlog?.form?.subtitlePlaceholder ?? "Sous-titre optionnel…"} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`excerpt-${loc.code}`}>{t.adminBlog?.form?.excerpt ?? "Extrait"} *</Label>
                  <Textarea id={`excerpt-${loc.code}`} name={`excerpt-${loc.code}`} rows={3} placeholder={`${t.adminBlog?.form?.excerptIn ?? "Résumé court en"} ${loc.label}…`} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`body-${loc.code}`}>{t.adminBlog?.form?.content ?? "Contenu (Markdown)"} *</Label>
                  <MarkdownEditor id={`body-${loc.code}`} name={`body-${loc.code}`} rows={16} placeholder={t.adminBlog?.form?.contentPlaceholder ?? "Écrivez votre article en Markdown…"} />
                </div>

                <!-- SEO section -->
                <details class="seo-section">
                  <summary class="seo-summary">
                    <Icon name="mdi:search-web" class="seo-icon" />
                    {t.adminBlog?.form?.seoSection ?? "SEO —"} {loc.label}
                  </summary>
                  <div class="seo-fields">
                    <div class="form-field">
                      <Label htmlFor={`seo-title-${loc.code}`}>{t.adminBlog?.form?.seoTitle ?? "Titre SEO"}</Label>
                      <Input id={`seo-title-${loc.code}`} name={`seo-title-${loc.code}`} placeholder={t.adminBlog?.form?.seoTitlePlaceholder ?? "Titre pour les moteurs de recherche…"} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-desc-${loc.code}`}>{t.adminBlog?.form?.seoDescription ?? "Description SEO"}</Label>
                      <Textarea id={`seo-desc-${loc.code}`} name={`seo-desc-${loc.code}`} rows={2} placeholder={t.adminBlog?.form?.seoDescPlaceholder ?? "160 caractères max…"} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-keywords-${loc.code}`}>{t.adminBlog?.form?.seoKeywords ?? "Mots-clés SEO"}</Label>
                      <Input id={`seo-keywords-${loc.code}`} name={`seo-keywords-${loc.code}`} placeholder={t.adminBlog?.form?.seoKeywordsPlaceholder ?? "mot-clé1, mot-clé2, mot-clé3…"} />
                    </div>
                  </div>
                </details>
              </div>
            ))}
          </CardContent>
        </Card>

        <!-- Media upload -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:image-multiple-outline" class="card-title-icon" />
              <span>{t.adminBlog?.form?.coverImage ?? "Image de couverture"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="upload-zone" id="upload-zone">
              <div class="upload-actions-row">
                <button type="button" id="btn-pick-media" class="btn-pick-media">
                  <Icon name="mdi:image-search-outline" class="pick-icon" />
                  {t.adminBlog?.form?.library ?? "Bibliothèque"}
                </button>
                <span class="upload-separator">{t.adminBlog?.form?.or ?? "ou"}</span>
                <label for="cover-upload" class="btn-upload-file">
                  <Icon name="mdi:cloud-upload-outline" class="pick-icon" />
                  {t.adminBlog?.form?.upload ?? "Téléverser"}
                </label>
              </div>
              <input type="file" id="cover-upload" accept="image/*" class="upload-input" />
              <div id="upload-preview" class="upload-preview hidden"></div>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="form-sidebar">

        <!-- Publish settings -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:cog-outline" class="card-title-icon" />
              <span>{t.adminBlog?.form?.publishing ?? "Publication"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="slug">{t.adminBlog?.form?.slug ?? "Slug"} *</Label>
              <Input id="slug" name="slug" placeholder="my-article" />
              <span class="field-hint">{t.adminBlog?.form?.slugAutoHint ?? "Auto-généré depuis le titre si vide"}</span>
            </div>
            <div class="form-field">
              <Label htmlFor="status">{t.adminBlog?.tableStatus ?? "Statut"}</Label>
              <Select id="status" name="status">
                <option value="draft" selected>{t.adminBlog?.status?.draft ?? "Brouillon"}</option>
                <option value="published">{t.adminBlog?.status?.published ?? "Publié"}</option>
                <option value="scheduled">{t.adminBlog?.status?.scheduled ?? "Planifié"}</option>
                <option value="archived">{t.adminBlog?.status?.archived ?? "Archivé"}</option>
              </Select>
            </div>
            <div class="form-field">
              <Label htmlFor="in-language">{t.adminBlog?.form?.mainLanguage ?? "Langue principale"}</Label>
              <Select id="in-language" name="in-language">
                {supportedLocales.map((loc) => (
                  <option value={loc.code} selected={loc.code === "fr"}>{loc.flag} {loc.label}</option>
                ))}
              </Select>
            </div>

            <div class="toggle-group">
              <div class="toggle-row">
                <Switch id="is-featured" name="is-featured" />
                <Label htmlFor="is-featured">{t.adminBlog?.form?.featured ?? "En vedette"}</Label>
              </div>
              <div class="toggle-row">
                <Switch id="display-home" name="display-home" />
                <Label htmlFor="display-home">{t.adminBlog?.form?.displayHomepage ?? "Afficher en page d'accueil"}</Label>
              </div>
              <div class="toggle-row">
                <Switch id="display-blog" name="display-blog" checked />
                <Label htmlFor="display-blog">{t.adminBlog?.form?.displayBlog ?? "Visible sur le blog"}</Label>
              </div>
              <div class="toggle-row">
                <Switch id="allow-comments" name="allow-comments" checked />
                <Label htmlFor="allow-comments">{t.adminBlog?.form?.allowComments ?? "Autoriser les commentaires"}</Label>
              </div>
            </div>
          </CardContent>
        </Card>

        <!-- Categories -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:tag-multiple-outline" class="card-title-icon" />
              <span>{t.adminBlog?.categories?.title ?? "Catégories"}</span>
            </div>
          </CardHeader>
          <CardContent>
            {allCategories.length === 0 ? (
              <p class="text-muted">{t.adminBlog?.form?.noCategoryAvailable ?? "Aucune catégorie disponible."}</p>
            ) : (
              <div class="checkbox-list">
                {allCategories.map((cat) => (
                  <div class="checkbox-item">
                    <Checkbox id={`cat-${cat.id}`} name="categories" value={cat.id} />
                    <Label htmlFor={`cat-${cat.id}`}>{extractLocalized(cat.name)}</Label>
                  </div>
                ))}
              </div>
            )}
          </CardContent>
        </Card>

        <!-- Authors -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:account-multiple-outline" class="card-title-icon" />
              <span>{t.adminBlog?.authors?.title ?? "Auteurs"}</span>
            </div>
          </CardHeader>
          <CardContent>
            {allAuthors.length === 0 ? (
              <p class="text-muted">{t.adminBlog?.form?.noAuthorAvailable ?? "Aucun auteur disponible."}</p>
            ) : (
              <div class="checkbox-list">
                {allAuthors.map((author) => (
                  <div class="checkbox-item">
                    <Checkbox id={`author-${author.id}`} name="authors" value={author.id} />
                    <Label htmlFor={`author-${author.id}`}>{extractLocalized(author.displayName)}</Label>
                  </div>
                ))}
              </div>
            )}
          </CardContent>
        </Card>

        <!-- Extra fields -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:information-outline" class="card-title-icon" />
              <span>{t.adminBlog?.form?.metadata ?? "Métadonnées"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="reading-time">{t.adminBlog?.form?.readingTime ?? "Temps de lecture"}</Label>
              <Input id="reading-time" name="reading-time" placeholder="5 min" />
            </div>
            <div class="form-field">
              <Label htmlFor="license">{t.adminBlog?.form?.license ?? "Licence"}</Label>
              <Input id="license" name="license" placeholder="CC-BY-4.0" />
            </div>
          </CardContent>
        </Card>
      </div>
    </div>

    <!-- Action bar -->
    <div class="form-actions">
      <a href={adminBase} class="btn-cancel">{t.adminBlog?.common?.cancel ?? "Annuler"}</a>
      <div class="form-actions-right">
        <button type="button" id="btn-save-draft" class="btn-secondary">
          <Icon name="mdi:content-save-outline" /> {t.adminBlog?.form?.saveDraft ?? "Enregistrer le brouillon"}
        </button>
        <button type="button" id="btn-publish" class="btn-primary">
          <Icon name="mdi:publish" /> {t.adminBlog?.form?.publish ?? "Publier"}
        </button>
      </div>
    </div>
  </form>
  <MediaPickerModal />

  <div id="i18n-data" hidden
    data-title-required={t.adminBlog?.js?.titleRequired ?? "Le titre en français est obligatoire."}
    data-article-created={t.adminBlog?.js?.articleCreated ?? "Article créé avec succès ! Redirection…"}
    data-unknown-error={t.adminBlog?.js?.unknownError ?? "Erreur inconnue lors de la création."}
    data-network-error={t.adminBlog?.js?.networkError ?? "Erreur réseau — vérifiez votre connexion."}
  ></div>
</AdminLayout>

<script>
  import { initMarkdownEditors, getEditorValue } from "@lib/admin/markdown-editor";
  import { openMediaPicker } from "@lib/admin/media-picker";
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    const i18n = document.getElementById("i18n-data")?.dataset ?? {};

    // Initialize WYSIWYG editors
    const editors = initMarkdownEditors();

    // Locale tabs
    const tabs = document.querySelectorAll<HTMLElement>(".locale-tab");
    const panels = document.querySelectorAll<HTMLElement>(".locale-panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const locale = tab.dataset.locale!;
        tabs.forEach((t) => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
        panels.forEach((p) => p.classList.remove("active"));
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        document.querySelector(`[data-locale-panel="${locale}"]`)?.classList.add("active");
      });
    });

    // Auto-slug from title
    const slugField = document.getElementById("slug") as HTMLInputElement;
    const headlineFr = document.getElementById("headline-fr") as HTMLInputElement;
    let slugManual = false;
    slugField?.addEventListener("input", () => { slugManual = !!slugField.value; });
    headlineFr?.addEventListener("input", () => {
      if (!slugManual) {
        slugField.value = headlineFr.value
          .toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
      }
    });

    // Image upload preview
    const coverInput = document.getElementById("cover-upload") as HTMLInputElement;
    const preview = document.getElementById("upload-preview") as HTMLElement;
    let coverId: string | null = null;

    function setCoverPreview(id: string, url: string) {
      coverId = id;
      preview.innerHTML = `<img src="${url}" alt="Preview" /><button type="button" class="remove-preview" title="Remove">&times;</button>`;
      preview.classList.remove("hidden");
      preview.querySelector(".remove-preview")?.addEventListener("click", () => {
        coverId = null;
        preview.innerHTML = "";
        preview.classList.add("hidden");
        coverInput.value = "";
      });
    }

    // Media library picker
    document.getElementById("btn-pick-media")?.addEventListener("click", async () => {
      const result = await openMediaPicker();
      if (result) setCoverPreview(result.id, result.url);
    });

    // Upload via modal (with metadata form)
    coverInput?.addEventListener("change", async () => {
      const file = coverInput.files?.[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setCoverPreview(result.id, result.url);
      }
      coverInput.value = "";
    });

    // Collect form data
    const locales = ["fr", "en", "es", "ar"];

    function collectData(status: string) {
      const slug = (document.getElementById("slug") as HTMLInputElement).value.trim();
      const inLanguage = (document.getElementById("in-language") as HTMLSelectElement).value;
      const isFeatured = (document.getElementById("is-featured") as HTMLInputElement).checked;
      const displayInHome = (document.getElementById("display-home") as HTMLInputElement).checked;
      const displayInBlog = (document.getElementById("display-blog") as HTMLInputElement).checked;
      const allowComments = (document.getElementById("allow-comments") as HTMLInputElement).checked;
      const readingTime = (document.getElementById("reading-time") as HTMLInputElement).value.trim();
      const license = (document.getElementById("license") as HTMLInputElement).value.trim();

      // Categories
      const categoryIds = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="categories"]:checked'))
        .map((cb) => cb.value);

      // Authors
      const authorIds = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="authors"]:checked'))
        .map((cb) => cb.value);

      // Translations (only filled locales)
      const translations: any[] = [];
      for (const loc of locales) {
        const headline = (document.getElementById(`headline-${loc}`) as HTMLInputElement)?.value.trim();
        const body = getEditorValue(editors, `body-${loc}`).trim();
        const excerpt = (document.getElementById(`excerpt-${loc}`) as HTMLTextAreaElement)?.value.trim();
        if (headline || body || excerpt) {
          translations.push({
            inLanguage: loc,
            headline: headline || "",
            alternativeHeadline: (document.getElementById(`alt-headline-${loc}`) as HTMLInputElement)?.value.trim() || "",
            articleBody: body || "",
            excerpt: excerpt || "",
            seoTitle: (document.getElementById(`seo-title-${loc}`) as HTMLInputElement)?.value.trim() || "",
            seoDescription: (document.getElementById(`seo-desc-${loc}`) as HTMLTextAreaElement)?.value.trim() || "",
            seoKeywords: (document.getElementById(`seo-keywords-${loc}`) as HTMLInputElement)?.value.trim() || "",
          });
        }
      }

      // Media
      const media: any[] = [];
      if (coverId) {
        media.push({ mediaId: coverId, type: "cover", position: "0" });
      }

      // Organization context (from org admin links)
      const urlOrgId = new URLSearchParams(window.location.search).get("orgId") || undefined;

      return {
        action: "create",
        slug: slug || undefined,
        title: (document.getElementById("headline-fr") as HTMLInputElement)?.value.trim(),
        status,
        inLanguage,
        organizationId: urlOrgId,
        isFeatured,
        displayInHome,
        displayInBlog,
        allowComments,
        readingTime: readingTime || undefined,
        license: license || undefined,
        translations,
        categoryIds,
        authorIds,
        media,
      };
    }

    // Validation
    function validate() {
      const headline = (document.getElementById("headline-fr") as HTMLInputElement)?.value.trim();
      if (!headline) {
        showToast(i18n.titleRequired ?? "", "warning");
        document.querySelector<HTMLElement>('[data-locale="fr"]')?.click();
        document.getElementById("headline-fr")?.focus();
        return false;
      }
      return true;
    }

    // Save draft
    document.getElementById("btn-save-draft")?.addEventListener("click", async () => {
      if (!validate()) return;
      const data = collectData("draft");
      await submitArticle(data);
    });

    // Publish
    document.getElementById("btn-publish")?.addEventListener("click", async () => {
      if (!validate()) return;
      const data = collectData("published");
      await submitArticle(data);
    });

    async function submitArticle(data: any) {
      const btns = document.querySelectorAll<HTMLButtonElement>(".form-actions button");
      btns.forEach((b) => { b.disabled = true; });
      try {
        const res = await fetch("/api/admin/blog/articles", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(data),
        });
        const result = await res.json();
        if (result.ok || result.id) {
          showToast(i18n.articleCreated ?? "", "success");
          const orgParam = new URLSearchParams(window.location.search).get("orgId");
          const backUrl = orgParam
            ? window.location.pathname.replace(/\/blog\/articles\/new.*/, `/organizations/blog?org=${orgParam}`)
            : document.querySelector<HTMLAnchorElement>(".back-link")?.href || window.location.pathname.replace("/new", "");
          setTimeout(() => {
            window.location.href = backUrl;
          }, 800);
        } else {
          showToast(result.error || i18n.unknownError || "", "error");
        }
      } catch {
        showToast(i18n.networkError ?? "", "error");
      } finally {
        btns.forEach((b) => { b.disabled = false; });
      }
    }
  });
</script>

<style>
  .admin-page-header { margin-bottom: var(--space-6, 1.5rem); }
  .admin-page-title-row { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-title-group { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem); font-weight: 800;
    color: var(--heading-color, #0f172a); margin: 0;
  }
  .admin-page-subtitle { color: var(--text-muted, #64748b); font-size: 0.9375rem; margin: var(--space-1, 0.25rem) 0 0; }

  .back-link {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-md, 0.375rem); color: var(--text-muted, #64748b);
    text-decoration: none; transition: all 0.15s;
  }
  .back-link:hover { border-color: var(--color-primary, #eab308); color: var(--text-default, #0f172a); }
  .back-link [data-icon] { width: 1.25rem; height: 1.25rem; }

  /* Two-column layout */
  .form-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-5, 1.25rem);
    align-items: start;
  }
  .form-main { display: flex; flex-direction: column; gap: var(--space-4, 1rem); }
  .form-sidebar { display: flex; flex-direction: column; gap: var(--space-4, 1rem); }

  /* Card titles */
  .card-title-row { display: flex; align-items: center; gap: var(--space-2, 0.5rem); font-weight: 600; font-size: 0.9375rem; }
  .card-title-icon { width: 1.125rem; height: 1.125rem; color: var(--text-muted, #64748b); }

  /* Form fields */
  .form-field { margin-bottom: var(--space-3, 0.75rem); }
  .form-field:last-child { margin-bottom: 0; }
  .field-hint { font-size: 0.75rem; color: var(--text-muted, #64748b); margin-top: 0.125rem; }

  /* Locale tabs */
  .locale-tabs {
    display: flex; gap: var(--space-1, 0.25rem); border-bottom: 2px solid var(--border-default, #e2e8f0);
    margin-bottom: var(--space-4, 1rem); padding-bottom: 0;
  }
  .locale-tab {
    display: inline-flex; align-items: center; gap: var(--space-1, 0.25rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border: none; background: none; cursor: pointer;
    font-size: 0.875rem; font-weight: 500; color: var(--text-muted, #64748b);
    border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all 0.15s;
  }
  .locale-tab:hover { color: var(--text-default, #0f172a); }
  .locale-tab.active {
    color: var(--color-primary, #eab308);
    border-bottom-color: var(--color-primary, #eab308);
  }
  .locale-flag { font-size: 1rem; }

---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Switch from "@components/ui/Form/Switch.astro";
import MarkdownEditor from "@components/admin/MarkdownEditor.astro";
import MediaPickerModal from "@components/admin/MediaPickerModal.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogCategories } from "@database/schemas";
import { getTranslations } from "@i18n/translations";
import { isAdminUser } from "@lib/admin/permissions";
import { getLocalizedUrl } from "@lib/i18n/route-helpers";

const currentLocale = (Astro.params.lang as string);
const t = getTranslations(currentLocale);

// Auth guard — redirect non-admins BEFORE any DB queries
const user = Astro.locals.user;
if (!user) return Astro.redirect(getLocalizedUrl(currentLocale, "auth/sign-in"), 302);
if (!isAdminUser(user)) return Astro.redirect(getLocalizedUrl(currentLocale, "/"), 302);

const adminBase = `/${currentLocale}/admin/blog/categories`;

const db = await getDrizzle();

// Load all categories for parent selector
const allCategories = await db
  .select({ id: blogCategories.id, slug: blogCategories.slug, name: blogCategories.name })
  .from(blogCategories)
  .orderBy(blogCategories.slug);

const extractLocalized = (value: unknown, locale: string = currentLocale): string => {
  if (typeof value === "string") return value;
  if (value && typeof value === "object") {
    const obj = value as Record<string, string>;
    return obj[locale] || Object.values(obj)[0] || "";
  }
  return "";
};

const supportedLocales = [
  { code: "fr", label: "Français", flag: "🇫🇷" },
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "ar", label: "العربية", flag: "🇸🇦" },
];
---

<AdminLayout title={t.adminBlog?.categories?.new ?? "Nouvelle catégorie"} activeSection="blog-categories">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <a href={adminBase} class="back-link"><Icon name="mdi:arrow-left" /></a>
        <h1>{t.adminBlog?.categories?.new ?? "Nouvelle catégorie"}</h1>
      </div>
    </div>
    <p class="admin-page-subtitle">{t.adminBlog?.categories?.subtitle ?? "Créez une catégorie avec des noms et descriptions multilingues, une image et des options de visibilité."}</p>
  </header>

  <form id="category-form" class="category-form">
    <div class="form-layout">
      <!-- Main content column -->
      <div class="form-main">

        <!-- Multilingual name & description -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:translate" class="card-title-icon" />
              <span>{t.adminBlog?.form?.multilingual ?? "Contenu multilingue"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="locale-tabs" role="tablist">
              {supportedLocales.map((loc, i) => (
                <button
                  type="button"
                  role="tab"
                  class:list={["locale-tab", { active: i === 0 }]}
                  data-locale={loc.code}
                  aria-selected={i === 0 ? "true" : "false"}
                >
                  <span class="locale-flag">{loc.flag}</span>
                  {loc.label}
                </button>
              ))}
            </div>

            {supportedLocales.map((loc, i) => (
              <div class:list={["locale-panel", { active: i === 0 }]} data-locale-panel={loc.code}>
                <div class="form-field">
                  <Label htmlFor={`name-${loc.code}`}>{t.adminBlog?.form?.categoryName ?? "Nom de la catégorie *"}</Label>
                  <Input id={`name-${loc.code}`} name={`name-${loc.code}`} placeholder={`${t.adminBlog?.form?.nameIn ?? "Nom en"} ${loc.label}…`} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`description-${loc.code}`}>{t.adminBlog?.form?.description ?? "Description"}</Label>
                  <MarkdownEditor id={`description-${loc.code}`} name={`description-${loc.code}`} rows={4} placeholder={`${t.adminBlog?.form?.descriptionIn ?? "Description en"} ${loc.label}…`} minimal />
                </div>

                <!-- SEO per locale -->
                <details class="seo-section">
                  <summary class="seo-toggle">
                    <Icon name="mdi:search-web" class="seo-icon" />
                    {t.adminBlog?.form?.seoSection ?? "SEO —"} {loc.label}
                  </summary>
                  <div class="seo-fields">
                    <div class="form-field">
                      <Label htmlFor={`seo-title-${loc.code}`}>{t.adminBlog?.form?.seoTitle ?? "Titre SEO"}</Label>
                      <Input id={`seo-title-${loc.code}`} name={`seo-title-${loc.code}`} placeholder={`${t.adminBlog?.form?.seoTitleIn ?? "Titre SEO en"} ${loc.label}…`} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-desc-${loc.code}`}>{t.adminBlog?.form?.seoDescription ?? "Description SEO"}</Label>
                      <Textarea id={`seo-desc-${loc.code}`} name={`seo-desc-${loc.code}`} rows={2} placeholder={`${t.adminBlog?.form?.seoDescIn ?? "Description SEO en"} ${loc.label}…`} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-keywords-${loc.code}`}>{t.adminBlog?.form?.seoKeywords ?? "Mots-clés SEO"}</Label>
                      <Input id={`seo-keywords-${loc.code}`} name={`seo-keywords-${loc.code}`} placeholder={t.adminBlog?.form?.seoKeywordsPlaceholder ?? "mot-clé1, mot-clé2, mot-clé3…"} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`canonical-${loc.code}`}>{t.adminBlog?.form?.canonicalUrl ?? "URL canonique"}</Label>
                      <Input id={`canonical-${loc.code}`} name={`canonical-${loc.code}`} type="url" placeholder="https://…" />
                    </div>
                  </div>
                </details>
              </div>
            ))}
          </CardContent>
        </Card>

        <!-- Featured image upload -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:image-outline" class="card-title-icon" />
              <span>{t.adminBlog?.form?.coverImage ?? "Image de couverture"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="upload-zone" id="upload-zone">
              <div class="upload-actions-row">
                <button type="button" id="btn-pick-media" class="btn-pick-media">
                  <Icon name="mdi:image-search-outline" class="pick-icon" />
                  {t.adminBlog?.form?.library ?? "Bibliothèque"}
                </button>
                <span class="upload-separator">{t.adminBlog?.form?.or ?? "ou"}</span>
                <label class="btn-upload-file" id="btn-upload-file">
                  <Icon name="mdi:cloud-upload-outline" class="pick-icon" />
                  {t.adminBlog?.form?.upload ?? "Uploader"}
                  <input type="file" id="image-input" accept="image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml" class="upload-file-input" />
                </label>
              </div>
              <div class="upload-preview" id="upload-preview" style="display: none;">
                <img id="preview-img" src="" alt={t.adminBlog?.form?.preview ?? "Aperçu"} />
                <button type="button" class="upload-remove" id="remove-image" title={t.adminBlog?.form?.removeImage ?? "Retirer l'image"}>
                  <Icon name="mdi:close-circle" />
                </button>
              </div>
            </div>
            <input type="hidden" id="featured-image-id" name="featuredImageId" value="" />
          </CardContent>
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="form-sidebar">

        <!-- Publication settings -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:cog-outline" class="card-title-icon" />
              <span>{t.adminBlog?.form?.settings ?? "Paramètres"}</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="slug">{t.adminBlog?.form?.slug ?? "Slug *"}</Label>
              <div class="slug-row">
                <Input id="slug" name="slug" placeholder="mon-slug" />
                <button type="button" id="generate-slug" class="slug-btn" title={t.adminBlog?.form?.generateSlug ?? "Générer depuis le nom FR"}>
                  <Icon name="mdi:auto-fix" />
                </button>
              </div>
              <span class="field-hint">{t.adminBlog?.form?.categorySlugHint ?? "URL de la catégorie : /blog/categorie/…"}</span>
            </div>

            <div class="form-field">
              <Label htmlFor="parent-id">{t.adminBlog?.form?.parentCategory ?? "Catégorie parente"}</Label>
              <Select id="parent-id" name="parentId">
                <option value="">{t.adminBlog?.form?.noParent ?? "Aucune (racine)"}</option>
                {allCategories.map((cat) => (
                  <option value={cat.id}>
                    {extractLocalized(cat.name)}
                  </option>
                ))}
              </Select>
            </div>

            <div class="switch-group">
              <div class="switch-item">
                <Switch id="is-featured" name="isFeatured" />
                <Label htmlFor="is-featured">{t.adminBlog?.form?.featured ?? "Featured"}</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-home" name="displayInHome" />
                <Label htmlFor="display-home">{t.adminBlog?.form?.displayHomepage ?? "Afficher en accueil"}</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-blog" name="displayInBlog" checked />
                <Label htmlFor="display-blog">{t.adminBlog?.form?.displayBlog ?? "Afficher dans le blog"}</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-menu" name="displayInMenu" checked />
                <Label htmlFor="display-menu">{t.adminBlog?.form?.displayMenu ?? "Afficher dans le menu"}</Label>
              </div>
            </div>
          </CardContent>
        </Card>

        <!-- Actions -->
        <div class="action-bar">
          <a href={adminBase} class="action-cancel">{t.adminBlog?.common?.cancel ?? "Annuler"}</a>
          <Button type="button" color="primary" id="btn-save" icon={{ name: "mdi:content-save-outline", side: "left" }}>
            {t.adminBlog?.form?.createCategory ?? "Créer la catégorie"}
          </Button>
        </div>
      </div>
    </div>
  </form>
  <MediaPickerModal />
  <div id="i18n-js" hidden
    data-cat-name-required={t.adminBlog?.js?.catNameRequired ?? "Le nom en français est obligatoire."}
    data-slug-required={t.adminBlog?.js?.slugRequired ?? "Le slug est obligatoire."}
    data-cat-created={t.adminBlog?.js?.catCreated ?? "Catégorie créée avec succès !"}
    data-unknown-error={t.adminBlog?.js?.unknownError ?? "Erreur inconnue."}
    data-network-error={t.adminBlog?.js?.networkError ?? "Erreur réseau."}
  ></div>
</AdminLayout>

<script>
  import { initMarkdownEditors } from "@lib/admin/markdown-editor";
  import { openMediaPicker } from "@lib/admin/media-picker";
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    const i18n = document.getElementById("i18n-js")?.dataset ?? {};

    // Init markdown editors
    const editors = initMarkdownEditors();

    // ── Locale tabs ──
    const tabs = document.querySelectorAll<HTMLElement>(".locale-tab");
    const panels = document.querySelectorAll<HTMLElement>(".locale-panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const locale = tab.dataset.locale!;
        tabs.forEach((t) => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
        panels.forEach((p) => p.classList.remove("active"));
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        document.querySelector(`[data-locale-panel="${locale}"]`)?.classList.add("active");
      });
    });

    // ── Auto-slug from FR name ──
    const nameInput = document.getElementById("name-fr") as HTMLInputElement | null;
    const slugInput = document.getElementById("slug") as HTMLInputElement | null;
    const slugPreview = document.getElementById("slug-preview");
    const generateSlugBtn = document.getElementById("generate-slug");

    const slugify = (text: string): string =>
      text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

    const updateSlug = () => {
      if (nameInput && slugInput) {
        slugInput.value = slugify(nameInput.value);
        if (slugPreview) slugPreview.textContent = slugInput.value || "…";
      }
    };

    generateSlugBtn?.addEventListener("click", updateSlug);
    slugInput?.addEventListener("input", () => {
      if (slugPreview) slugPreview.textContent = slugInput.value || "…";
    });

    // Auto-generate on first name typing (only if slug is empty)
    let autoSlug = true;
    nameInput?.addEventListener("input", () => {
      if (autoSlug && slugInput && !slugInput.value) updateSlug();
    });
    slugInput?.addEventListener("input", () => { autoSlug = false; });

    // ── Image upload ──
    const uploadZone = document.getElementById("upload-zone");
    const imageInput = document.getElementById("image-input") as HTMLInputElement;
    const uploadPreview = document.getElementById("upload-preview");
    const previewImg = document.getElementById("preview-img") as HTMLImageElement;
    const removeImageBtn = document.getElementById("remove-image");
    const featuredImageId = document.getElementById("featured-image-id") as HTMLInputElement;

    function setImagePreview(id: string, url: string) {
      featuredImageId.value = id;
      previewImg.src = url;
      if (uploadPreview) uploadPreview.style.display = "block";
    }

    function clearImagePreview() {
      featuredImageId.value = "";
      if (uploadPreview) uploadPreview.style.display = "none";
      previewImg.src = "";
    }

    // Media library picker
    document.getElementById("btn-pick-media")?.addEventListener("click", async () => {
      const result = await openMediaPicker();
      if (result) setImagePreview(result.id, result.url);
    });

    // Direct upload → open modal with file
    imageInput?.addEventListener("change", async () => {
      const file = imageInput.files?.[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setImagePreview(result.id, result.url);
      }
      imageInput.value = "";
    });

    // Drag & drop → open modal with file
    uploadZone?.addEventListener("dragover", (e) => { e.preventDefault(); uploadZone.classList.add("dragover"); });
    uploadZone?.addEventListener("dragleave", () => uploadZone.classList.remove("dragover"));
    uploadZone?.addEventListener("drop", async (e) => {
      e.preventDefault();
      uploadZone.classList.remove("dragover");
      const file = e.dataTransfer?.files[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setImagePreview(result.id, result.url);
      }
    });

    removeImageBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      clearImagePreview();
    });

    // ── Form submission ──
    const btnSave = document.getElementById("btn-save");
    btnSave?.addEventListener("click", async () => {
      const slug = (document.getElementById("slug") as HTMLInputElement).value.trim();
      const frName = (document.getElementById("name-fr") as HTMLInputElement).value.trim();

      if (!frName) { showToast(i18n.catNameRequired ?? "Le nom en français est obligatoire.", "warning"); return; }
      if (!slug) { showToast(i18n.slugRequired ?? "Le slug est obligatoire.", "warning"); return; }

      // Sync markdown editors to underlying textareas
      editors.forEach((editor) => (editor.codemirror as any).save());

      // Collect multilingual name / description
      const locales = ["fr", "en", "es", "ar"];
      const name: Record<string, string> = {};
      const description: Record<string, string> = {};
      const seoTitle: Record<string, string> = {};
      const seoDescription: Record<string, string> = {};
      const seoKeywords: Record<string, string> = {};
      const canonicalUrl: Record<string, string> = {};

      locales.forEach((loc) => {
        const n = (document.getElementById(`name-${loc}`) as HTMLInputElement)?.value.trim();
        if (n) name[loc] = n;
        const d = (document.getElementById(`description-${loc}`) as HTMLTextAreaElement)?.value.trim();
        if (d) description[loc] = d;
        const st = (document.getElementById(`seo-title-${loc}`) as HTMLInputElement)?.value.trim();
        if (st) seoTitle[loc] = st;
        const sd = (document.getElementById(`seo-desc-${loc}`) as HTMLTextAreaElement)?.value.trim();
        if (sd) seoDescription[loc] = sd;
        const sk = (document.getElementById(`seo-keywords-${loc}`) as HTMLInputElement)?.value.trim();
        if (sk) seoKeywords[loc] = sk;
        const cu = (document.getElementById(`canonical-${loc}`) as HTMLInputElement)?.value.trim();
        if (cu) canonicalUrl[loc] = cu;
      });

      const payload: Record<string, unknown> = {
        action: "create",
        slug,
        name,
        description: Object.keys(description).length > 0 ? description : null,
        featuredImageId: (document.getElementById("featured-image-id") as HTMLInputElement).value || null,
        parentId: (document.getElementById("parent-id") as HTMLSelectElement).value || null,
        isFeatured: (document.getElementById("is-featured") as HTMLInputElement).checked,
        displayInHome: (document.getElementById("display-home") as HTMLInputElement).checked,
        displayInBlog: (document.getElementById("display-blog") as HTMLInputElement).checked,
        displayInMenu: (document.getElementById("display-menu") as HTMLInputElement).checked,
        seoTitle: Object.keys(seoTitle).length > 0 ? seoTitle : null,
        seoDescription: Object.keys(seoDescription).length > 0 ? seoDescription : null,
        seoKeywords: Object.keys(seoKeywords).length > 0 ? seoKeywords : null,
        canonicalUrl: Object.keys(canonicalUrl).length > 0 ? canonicalUrl : null,
      };

      btnSave.setAttribute("disabled", "true");

      try {
        const res = await fetch("/api/admin/blog/categories", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.ok || data.id) {
          showToast(i18n.catCreated ?? "Catégorie créée avec succès !", "success");
          setTimeout(() => {
            window.location.href = `${window.location.pathname.replace("/new", "")}/${data.id}/edit`;
          }, 800);
        } else {
          showToast(data.error || (i18n.unknownError ?? "Erreur lors de la création."), "error");
          btnSave.removeAttribute("disabled");
        }
      } catch {
        showToast(i18n.networkError ?? "Erreur réseau.", "error");
        btnSave.removeAttribute("disabled");
      }
    });
  });
</script>

<style>
  .admin-page-header { margin-bottom: var(--space-6, 1.5rem); }
  .admin-page-title-row { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-title-group { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem); font-weight: 800;
    color: var(--heading-color, #0f172a); margin: 0;
  }
  .admin-page-subtitle { color: var(--text-muted, #64748b); font-size: 0.9375rem; margin: var(--space-1, 0.25rem) 0 0; }
  .back-link {
    display: inline-flex; align-items: center; padding: var(--space-2, 0.5rem);
    border-radius: var(--border-radius-md, 0.375rem); color: var(--text-muted, #64748b);
    transition: color 0.15s, background 0.15s;
  }
  .back-link:hover { color: var(--text-default, #0f172a); background: var(--bg-inset, #f1f5f9); }
  .back-link [data-icon] { width: 1.25rem; height: 1.25rem; }

  .form-layout {
    display: grid; grid-template-columns: 1fr 340px; gap: var(--space-6, 1.5rem); align-items: start;
  }
  .form-main { display: flex; flex-direction: column; gap: var(--space-4, 1rem); }
  .form-sidebar { display: flex; flex-direction: column; gap: var(--space-4, 1rem); position: sticky; top: var(--space-4, 1rem); }

  .card-title-row {
    display: flex; align-items: center; gap: var(--space-2, 0.5rem);
    font-weight: 700; font-size: 0.9375rem; color: var(--heading-color, #0f172a);
  }
  .card-title-icon { width: 1.125rem; height: 1.125rem; color: var(--color-primary, #eab308); }

  .form-field { margin-bottom: var(--space-3, 0.75rem); }
  .form-field:last-child { margin-bottom: 0; }

  .field-hint { font-size: 0.75rem; color: var(--text-muted, #64748b); margin-top: 0.25rem; display: block; }
  .field-hint strong { font-family: var(--font-family-mono, monospace); }

  /* Locale tabs */
  .locale-tabs {
    display: flex; gap: 0; border-bottom: 2px solid var(--border-default, #e2e8f0);
    margin-bottom: var(--space-4, 1rem);
  }
  .locale-tab {
    display: inline-flex; align-items: center; gap: var(--space-1, 0.25rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border: none; background: none; cursor: pointer;
    font-size: 0.8125rem; font-weight: 600; color: var(--text-muted, #64748b);
    border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all 0.15s;
  }
  .locale-tab:hover { color: var(--text-default, #0f172a); }
  .locale-tab.active {
    color: var(--color-primary, #eab308);
    border-bottom-color: var(--color-primary, #eab308);
  }
  .locale-flag { font-size: 1rem; }
  .locale-panel { display: none; }
  .locale-panel.active { display: block; }

  /* SEO collapsible section */
  .seo-section {
    margin-top: var(--space-3, 0.75rem);
    border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-md, 0.375rem);
  }
  .seo-toggle {
    display: flex; align-items: center; gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    font-size: 0.8125rem; font-weight: 600; color: var(--text-muted, #64748b);
    cursor: pointer; user-select: none;
  }
  .seo-toggle:hover { color: var(--text-default, #0f172a); }
  .seo-icon { width: 1rem; height: 1rem; }
  .seo-fields { padding: 0 var(--space-3, 0.75rem) var(--space-3, 0.75rem); }

  /* Slug row */
  .slug-row { display: flex; gap: var(--space-2, 0.5rem); align-items: center; }
  .slug-btn {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; flex-shrink: 0;
    border: 1px solid var(--border-default, #e2e8f0); border-radius: var(--border-radius-md, 0.375rem);
    background: var(--bg-surface, white); color: var(--text-muted, #64748b);
    cursor: pointer; transition: all 0.15s;
  }
  .slug-btn:hover { border-color: var(--color-primary, #eab308); color: var(--color-primary, #eab308); }
  .slug-btn [data-icon] { width: 1rem; height: 1rem; }

  /* Switch group */
  .switch-group {
    display: flex; flex-direction: column; gap: var(--space-3, 0.75rem);
    margin-top: var(--space-4, 1rem);
    padding-top: var(--space-4, 1rem); border-top: 1px solid var(--border-default, #e2e8f0);
  }
  .switch-item {
    display: flex; align-items: center; gap: var(--space-2, 0.5rem);
  }

  /* Upload zone */
  .upload-zone {
    border: 2px dashed var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-lg, 0.5rem);

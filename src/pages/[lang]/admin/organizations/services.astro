---
// src/pages/[lang]/admin/organizations/services.astro — Org-scoped services management
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Pagination from "@components/ui/Pagination.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { servicesListings, servicesTranslations, servicesCategories, servicesBookings } from "@database/schemas";
import { blogOrganizations } from "@database/schemas";
import { member } from "@database/schemas/auth-schema";
import { eq, and, desc, count, inArray } from "drizzle-orm";
import { getTranslations } from "@i18n/translations";
import { isAdminUser } from "@lib/admin/permissions";
import { getLocalizedUrl } from "@lib/i18n/route-helpers";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const to = t.adminOrganizations ?? ({} as Record<string, string>);
const ts = t.adminServices ?? ({} as Record<string, string>);
const adminBase = `/${lang}/admin`;

// Auth guard — redirect non-admins BEFORE any DB queries
const authUser = Astro.locals.user;
if (!authUser) return Astro.redirect(getLocalizedUrl(lang, "auth/sign-in"), 302);
if (!isAdminUser(authUser)) return Astro.redirect(getLocalizedUrl(lang, "/"), 302);

const db = await getDrizzle();

// Resolve active org
let activeOrgId = (Astro.url.searchParams.get("org")) || Astro.locals.organizationId;
if (!activeOrgId) {
  const userId = Astro.locals.user?.id;
  if (userId) {
    const [m] = await db.select({ organizationId: member.organizationId }).from(member).where(eq(member.userId, userId)).limit(1);
    if (m) activeOrgId = m.organizationId;
  }
  if (!activeOrgId) {
    const [firstOrg] = await db.select({ id: blogOrganizations.id }).from(blogOrganizations).limit(1);
    if (firstOrg) activeOrgId = firstOrg.id;
  }
}
if (!activeOrgId) return Astro.redirect(`${adminBase}/organizations`);

// URL params
const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get("page")) || 1);
const perPage = 20;
const statusFilter = url.searchParams.get("status") ?? "";
const categoryFilter = url.searchParams.get("category") ?? "";

// Build conditions
const conditions: any[] = [eq(servicesListings.organizationId, activeOrgId)];
if (statusFilter) conditions.push(eq(servicesListings.status, statusFilter));
if (categoryFilter) conditions.push(eq(servicesListings.categoryId, categoryFilter));

const whereClause = and(...conditions);

// Stats
const [totalResult] = await db.select({ value: count() }).from(servicesListings).where(eq(servicesListings.organizationId, activeOrgId));
const [activeResult] = await db.select({ value: count() }).from(servicesListings).where(and(eq(servicesListings.organizationId, activeOrgId), eq(servicesListings.isActive, true)));
const [featuredResult] = await db.select({ value: count() }).from(servicesListings).where(and(eq(servicesListings.organizationId, activeOrgId), eq(servicesListings.isFeatured, true)));

// Booking stats for this org's services
const orgServiceIds = (await db.select({ id: servicesListings.id }).from(servicesListings).where(eq(servicesListings.organizationId, activeOrgId))).map(s => s.id);
const bookingStats = orgServiceIds.length > 0
  ? await db.select({ value: count() }).from(servicesBookings).where(inArray(servicesBookings.serviceId, orgServiceIds))
  : [{ value: 0 }];
const totalBookings = bookingStats[0]?.value ?? 0;

// Pages
const [countResult] = await db.select({ value: count() }).from(servicesListings).where(whereClause);
const totalPages = Math.max(1, Math.ceil(countResult.value / perPage));

// Fetch services
const services = await db.select().from(servicesListings)
  .where(whereClause)
  .orderBy(desc(servicesListings.updatedAt))
  .limit(perPage)
  .offset((page - 1) * perPage);

// Batch translations
const serviceIds = services.map(s => s.id);
const translationsMap = new Map<string, { title: unknown; inLanguage: string }[]>();
if (serviceIds.length > 0) {
  const translations = await db
    .select({ serviceId: servicesTranslations.serviceId, title: servicesTranslations.title, inLanguage: servicesTranslations.inLanguage })
    .from(servicesTranslations)
    .where(inArray(servicesTranslations.serviceId, serviceIds));
  for (const tr of translations) {
    const list = translationsMap.get(tr.serviceId) ?? [];
    list.push(tr);
    translationsMap.set(tr.serviceId, list);
  }
}

// Categories for filter
const categories = await db.select({ id: servicesCategories.id, slug: servicesCategories.slug }).from(servicesCategories);

// Helper
const loc = (val: any, fallback = "") => {
  if (!val) return fallback;
  if (typeof val === "string") return val;
  return val[lang] ?? val.en ?? val.fr ?? Object.values(val)[0] ?? fallback;
};

const getTitle = (svcId: string) => {
  const trs = translationsMap.get(svcId) ?? [];
  const match = trs.find(t => t.inLanguage === lang) ?? trs[0];
  return match ? loc(match.title, svcId.slice(0, 8)) : svcId.slice(0, 8);
};

type BadgeColor = "default" | "primary" | "secondary" | "accent" | "success" | "warning" | "error";
const statusBadgeColor: Record<string, BadgeColor> = {
  active: "success",
  pending_review: "warning",
  draft: "secondary",
  suspended: "error",
  archived: "default",
};
---

<AdminLayout title={to.orgServices ?? "Services de l'organisation"} activeSection="org-services">
  <div class="admin-page-header">
    <div>
      <h1 class="admin-page-title"><Icon name="mdi:room-service" /> {to.orgServices ?? "Services de l'organisation"}</h1>
      <p class="admin-page-description">{to.orgServicesDesc ?? "Gérez les services proposés par votre organisation"}</p>
    </div>
    <a href={`${adminBase}/services/new`} class="btn-new">
      <Button variant="modern" color="primary">
        <Icon name="mdi:plus" /> {ts.addService ?? "Nouveau service"}
      </Button>
    </a>
  </div>

  <!-- Stats -->
  <div class="stats-row">
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact">
          <Icon name="mdi:room-service" />
          <div><span class="stat-num">{totalResult.value}</span><span class="stat-label">{to.total ?? "Total"}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-active">
          <Icon name="mdi:check-circle" />
          <div><span class="stat-num">{activeResult.value}</span><span class="stat-label">{to.active ?? "Actifs"}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-featured">
          <Icon name="mdi:star" />
          <div><span class="stat-num">{featuredResult.value}</span><span class="stat-label">{to.featured ?? "Mis en avant"}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-bookings">
          <Icon name="mdi:calendar-check" />
          <div><span class="stat-num">{totalBookings}</span><span class="stat-label">{to.totalBookings ?? "Réservations"}</span></div>
        </div>
      </CardContent>
    </Card>
  </div>

  <!-- Filters -->
  <Card variant="modern" elevation="sm" class="filters-card">
    <CardContent>
      <form class="filters-form" method="get">
        <div class="filter-field">
          <Label htmlFor="status">{to.status ?? "Statut"}</Label>
          <Select id="status" name="status">
            <option value="">{to.allStatuses ?? "Tous les statuts"}</option>
            <option value="active" selected={statusFilter === "active"}>{to.statusActive ?? "Actif"}</option>
            <option value="pending_review" selected={statusFilter === "pending_review"}>{to.statusPending ?? "En attente"}</option>
            <option value="draft" selected={statusFilter === "draft"}>{to.statusDraft ?? "Brouillon"}</option>
            <option value="suspended" selected={statusFilter === "suspended"}>{to.statusSuspended ?? "Suspendu"}</option>
          </Select>
        </div>
        {categories.length > 0 && (
          <div class="filter-field">
            <Label htmlFor="category">{to.category ?? "Catégorie"}</Label>
            <Select id="category" name="category">
              <option value="">{to.allCategories ?? "Toutes les catégories"}</option>
              {categories.map(c => (
                <option value={c.id} selected={categoryFilter === c.id}>{c.slug}</option>
              ))}
            </Select>
          </div>
        )}
        <Button type="submit" variant="modern" color="secondary" size="sm">{to.filter ?? "Filtrer"}</Button>
        {(statusFilter || categoryFilter) && <a href={`${adminBase}/organizations/services`} class="clear-filter">{to.clearFilters ?? "Effacer"}</a>}
      </form>
    </CardContent>
  </Card>

  <!-- Services table -->
  <Card variant="modern" elevation="sm">
    <CardContent>
      <Table variant="modern" striped>
        <TableHeader>
          <TableRow>
            <TableHead>{ts.service ?? "Service"}</TableHead>
            <TableHead>{ts.status ?? "Statut"}</TableHead>
            <TableHead>{ts.price ?? "Prix"}</TableHead>
            <TableHead>{ts.duration ?? "Durée"}</TableHead>
            <TableHead>{to.actions ?? "Actions"}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
            {services.map(s => {
              const title = getTitle(s.id);
              return (
                <TableRow>
                  <TableCell>
                    <div class="service-cell">
                      <strong>{title}</strong>
                      <code class="service-slug">/{s.slug}</code>
                    </div>
                  </TableCell>
                  <TableCell><Badge variant="modern" color={statusBadgeColor[s.status] ?? "secondary"}>{s.status}</Badge></TableCell>
                  <TableCell className="meta-cell">{s.basePrice ? `${s.basePrice} ${s.currency ?? "EUR"}` : "-"}</TableCell>
                  <TableCell className="meta-cell">{s.durationMinutes ? `${s.durationMinutes} min` : "-"}</TableCell>
                  <TableCell>
                    <div class="action-btns">
                      <a href={`${adminBase}/services/${s.id}/edit`} class="btn-icon" title={to.edit ?? "Éditer"}>
                        <Icon name="mdi:pencil" />
                      </a>
                    </div>
                  </TableCell>
                </TableRow>
              );
            })}
            {services.length === 0 && (
              <TableRow>
                <TableCell>
                  <div class="empty-state">
                    <Icon name="mdi:room-service-off" />
                    <p>{to.noServices ?? "Aucun service trouvé."}</p>
                    <a href={`${adminBase}/services/new`}>{ts.addService ?? "Créer un service"}</a>
                  </div>
                </TableCell>
              </TableRow>
            )}
        </TableBody>
      </Table>
    </CardContent>
  </Card>

  {totalPages > 1 && (
    <div class="pagination-wrap">
      <Pagination currentPage={page} totalPages={totalPages} baseUrl={`${adminBase}/organizations/services?${[statusFilter ? `status=${statusFilter}` : '', categoryFilter ? `category=${categoryFilter}` : ''].filter(Boolean).join('&')}${statusFilter || categoryFilter ? '&' : ''}page=`} />
    </div>
  )}
</AdminLayout>

<style>
  .admin-page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .admin-page-title { font-size: 1.75rem; font-weight: 800; margin: 0; display: flex; align-items: center; gap: 0.5rem; }
  .admin-page-title :global(svg) { width: 1.75rem; height: 1.75rem; color: var(--color-primary, #eab308); }
  .admin-page-description { font-size: 0.9375rem; color: var(--text-muted, #64748b); margin: 0.25rem 0 0; }
  .btn-new { text-decoration: none; }

  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .stat-compact { display: flex; align-items: center; gap: 0.75rem; }
  .stat-compact :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-primary, #eab308); }
  .stat-active :global(svg) { color: #22c55e; }
  .stat-featured :global(svg) { color: #f59e0b; }
  .stat-bookings :global(svg) { color: #3b82f6; }
  .stat-num { display: block; font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .stat-label { font-size: 0.8125rem; color: var(--text-muted, #64748b); }

  .filters-card { margin-bottom: 1.5rem; }
  .filters-form { display: flex; align-items: flex-end; gap: 1rem; flex-wrap: wrap; }
  .filter-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .clear-filter { font-size: 0.8125rem; color: var(--text-muted, #64748b); text-decoration: underline; }

  .service-cell strong { font-weight: 600; display: block; }
  .service-slug { font-size: 0.75rem; color: var(--text-muted, #94a3b8); }
  .meta-cell { color: var(--text-muted, #94a3b8); }
  .action-btns { display: flex; gap: 0.25rem; }
  .btn-icon { border: none; background: none; cursor: pointer; padding: 0.375rem; border-radius: 0.375rem; transition: background 0.15s; display: flex; align-items: center; justify-content: center; color: var(--text-default, #0f172a); text-decoration: none; }
  .btn-icon :global(svg) { width: 1.125rem; height: 1.125rem; }
  .btn-icon:hover { background: var(--bg-muted, #f1f5f9); }
  .empty-state { padding: 3rem 1rem; text-align: center; color: var(--text-muted, #94a3b8); }
  .empty-state :global(svg) { width: 3rem; height: 3rem; margin-bottom: 0.75rem; }
  .empty-state a { color: var(--color-primary, #eab308); font-weight: 600; }
  .pagination-wrap { margin-top: 1.5rem; display: flex; justify-content: center; }

  @media (max-width: 768px) { .stats-row { grid-template-columns: 1fr; } }
</style>

---
// src/pages/[lang]/admin/organizations/bookings.astro — Org bookings management
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Pagination from "@components/ui/Pagination.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { servicesBookings, servicesListings, servicesTranslations } from "@database/schemas";
import { member, user as userTable } from "@database/schemas/auth-schema";
import { eq, and, desc, sql, inArray } from "drizzle-orm";
import { getTranslations } from "@i18n/translations";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const to = t.adminOrganizations ?? ({} as Record<string, string>);
const adminBase = `/${lang}/admin`;

const db = await getDrizzle();

// Resolve active org: query param > session > member lookup > blogOrganizations fallback
let activeOrgId = (Astro.url.searchParams.get("org")) || Astro.locals.organizationId;
if (!activeOrgId) {
  const userId = Astro.locals.user?.id;
  if (userId) {
    const [m] = await db.select({ organizationId: member.organizationId }).from(member).where(eq(member.userId, userId)).limit(1);
    if (m) activeOrgId = m.organizationId;
  }
  if (!activeOrgId) {
    const { blogOrganizations } = await import("@database/schemas");
    const [firstOrg] = await db.select({ id: blogOrganizations.id }).from(blogOrganizations).limit(1);
    if (firstOrg) activeOrgId = firstOrg.id;
  }
}
if (!activeOrgId) return Astro.redirect(`${adminBase}/organizations`);

// Get org member userIds → these are the providers
const orgMembers = await db.select({ userId: member.userId }).from(member).where(eq(member.organizationId, activeOrgId));
const providerIds = orgMembers.map(m => m.userId);

// Filters
const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get("page")) || 1);
const perPage = 20;
const statusFilter = url.searchParams.get("status") ?? "";

// Build conditions
const baseCondition = providerIds.length > 0
  ? inArray(servicesBookings.providerId, providerIds)
  : sql`false`;

const conditions: any[] = [baseCondition];
if (statusFilter) conditions.push(eq(servicesBookings.status, statusFilter));

// Fetch bookings with service info
const allBookings = providerIds.length > 0
  ? await db.select({
    id: servicesBookings.id,
    serviceId: servicesBookings.serviceId,
    customerId: servicesBookings.customerId,
    providerId: servicesBookings.providerId,
    bookingDate: servicesBookings.bookingDate,
    bookingTime: servicesBookings.bookingTime,
    durationMinutes: servicesBookings.durationMinutes,
    totalPrice: servicesBookings.totalPrice,
    currency: servicesBookings.currency,
    status: servicesBookings.status,
    customerMessage: servicesBookings.customerMessage,
    providerResponse: servicesBookings.providerResponse,
    createdAt: servicesBookings.createdAt,
    serviceName: servicesTranslations.title,
  }).from(servicesBookings)
    .leftJoin(servicesListings, eq(servicesBookings.serviceId, servicesListings.id))
    .leftJoin(servicesTranslations, and(eq(servicesTranslations.serviceId, servicesListings.id), eq(servicesTranslations.inLanguage, lang)))
    .where(and(...conditions))
    .orderBy(desc(servicesBookings.createdAt))
  : [];

// Fetch customer names
const customerIds = [...new Set(allBookings.map(b => b.customerId))];
const customerMap = new Map<string, { name: string; email: string; image: string | null }>();
if (customerIds.length > 0) {
  const customers = await db.select({ id: userTable.id, name: userTable.name, email: userTable.email, image: userTable.image })
    .from(userTable)
    .where(inArray(userTable.id, customerIds));
  for (const c of customers) customerMap.set(c.id, c);
}

// Provider names
const providerMap = new Map<string, { name: string; email: string }>();
if (providerIds.length > 0) {
  const providers = await db.select({ id: userTable.id, name: userTable.name, email: userTable.email })
    .from(userTable)
    .where(inArray(userTable.id, providerIds));
  for (const p of providers) providerMap.set(p.id, p);
}

const total = allBookings.length;
const totalPages = Math.ceil(total / perPage);
const bookings = allBookings.slice((page - 1) * perPage, page * perPage);

// Stats
const pending = allBookings.filter(b => b.status === "pending").length;
const confirmed = allBookings.filter(b => b.status === "confirmed").length;
const completed = allBookings.filter(b => b.status === "completed").length;
110 // const cancelled = allBookings.filter(b => b.status === "cancelled").length; // unused

const loc = (val: any) => {
  if (!val) return "";
  if (typeof val === "string") return val;
  return val[lang] ?? val.en ?? val.fr ?? Object.values(val)[0] ?? "";
};

const statusBadgeColor: Record<string, string> = {
  pending: "warning",
  confirmed: "primary",
  completed: "success",
  cancelled: "secondary",
  declined: "accent",
};
const statusLabels: Record<string, string> = {
  pending: to.statusPending ?? "En attente",
  confirmed: to.statusConfirmed ?? "Confirmée",
  completed: to.statusCompleted ?? "Terminée",
  cancelled: to.statusCancelled ?? "Annulée",
  declined: to.statusDeclined ?? "Refusée",
};
---

<AdminLayout title={to.bookings ?? "Réservations"} activeSection="org-bookings">
  <div class="admin-page-header">
    <div>
      <h1 class="admin-page-title">{to.bookings ?? "Réservations"}</h1>
      <p class="admin-page-description">{to.bookingsDesc ?? "Suivez et gérez les réservations de votre organisation"}</p>
    </div>
  </div>

  <!-- Stats -->
  <div class="stats-row">
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact">
          <Icon name="mdi:calendar-clock" />
          <div><span class="stat-num">{total}</span><span class="stat-label">{to.totalBookings ?? "Total"}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-pending">
          <Icon name="mdi:clock-outline" />
          <div><span class="stat-num">{pending}</span><span class="stat-label">{statusLabels.pending}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-confirmed">
          <Icon name="mdi:calendar-check" />
          <div><span class="stat-num">{confirmed}</span><span class="stat-label">{statusLabels.confirmed}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-completed">
          <Icon name="mdi:check-all" />
          <div><span class="stat-num">{completed}</span><span class="stat-label">{statusLabels.completed}</span></div>
        </div>
      </CardContent>
    </Card>
  </div>

  <!-- Filters -->
  <Card variant="modern" elevation="sm" class="filters-card">
    <CardContent>
      <form class="filters-form" method="get">
        <div class="filter-group">
          <select name="status" class="filter-select">
            <option value="">{to.allStatuses ?? "Tous les statuts"}</option>
            {Object.entries(statusLabels).map(([val, label]) => (
              <option value={val} selected={statusFilter === val}>{label}</option>
            ))}
          </select>
        </div>
        <Button variant="modern" color="secondary" type="submit" icon={{ name: "mdi:filter", side: "left" }}>
          {to.filter ?? "Filtrer"}
        </Button>
        {statusFilter && (
          <a href={`${adminBase}/organizations/bookings`} class="clear-filter">{to.clearFilter ?? "Effacer le filtre"}</a>
        )}
      </form>
    </CardContent>
  </Card>

  <!-- Bookings table -->
  <Card variant="modern" elevation="sm">
    <CardContent>
      <div class="table-responsive">
        <table class="admin-table">
          <thead>
            <tr>
              <th>{to.service ?? "Service"}</th>
              <th>{to.customer ?? "Client"}</th>
              <th>{to.provider ?? "Prestataire"}</th>
              <th>{to.dateTime ?? "Date & Heure"}</th>
              <th>{to.price ?? "Prix"}</th>
              <th>{to.status ?? "Statut"}</th>
              <th>{to.actions ?? "Actions"}</th>
            </tr>
          </thead>
          <tbody>
            {bookings.map(b => {
              const cust = customerMap.get(b.customerId);
              const prov = providerMap.get(b.providerId);
              return (
                <tr class="booking-row" data-booking-id={b.id}>
                  <td>
                    <div class="service-cell">
                      <strong>{loc(b.serviceName) || b.serviceId.slice(0, 8)}</strong>
                    </div>
                  </td>
                  <td>
                    <div class="user-cell">
                      {cust?.image ? <img src={cust.image} alt="" class="user-avatar" /> : <div class="user-avatar-ph">{(cust?.name ?? "?").charAt(0)}</div>}
                      <div>
                        <span class="user-name">{cust?.name ?? to.unknown ?? "Inconnu"}</span>
                        <small class="user-email">{cust?.email ?? ""}</small>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="user-name">{prov?.name ?? b.providerId.slice(0, 8)}</span>
                  </td>
                  <td>
                    <div class="datetime-cell">
                      <span class="date-value">{b.bookingDate}</span>
                      <small class="time-value">{b.bookingTime} · {b.durationMinutes} min</small>
                    </div>
                  </td>
                  <td>
                    {b.totalPrice ? (
                      <strong>{b.totalPrice} {b.currency}</strong>
                    ) : (
                      <span class="meta-cell">-</span>
                    )}
                  </td>
                  <td>
                    <Badge variant="modern" color={(statusBadgeColor[b.status] ?? "secondary") as any}>{statusLabels[b.status] ?? b.status}</Badge>
                  </td>
                  <td>
                    <div class="action-btns">
                      <button class="btn-icon detail-btn" data-booking={JSON.stringify({
                        id: b.id,
                        service: loc(b.serviceName) || b.serviceId.slice(0, 8),
                        customer: cust?.name ?? "?",
                        customerEmail: cust?.email ?? "",
                        provider: prov?.name ?? "?",
                        date: b.bookingDate,
                        time: b.bookingTime,
                        duration: b.durationMinutes,
                        price: b.totalPrice,
                        currency: b.currency,
                        status: b.status,
                        message: b.customerMessage ?? "",
                        response: b.providerResponse ?? "",
                      })} title={to.details ?? "Détails"}>
                        <Icon name="mdi:eye" />
                      </button>
                      {b.status === "pending" && (
                        <>
                          <button class="btn-icon btn-success confirm-btn" data-id={b.id} title={to.confirm ?? "Confirmer"}>
                            <Icon name="mdi:check" />
                          </button>
                          <button class="btn-icon btn-danger decline-btn" data-id={b.id} title={to.decline ?? "Refuser"}>
                            <Icon name="mdi:close" />
                          </button>
                        </>
                      )}
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      {bookings.length === 0 && (
        <div class="empty-state">
          <Icon name="mdi:calendar-blank" />
          <p>{to.noBookings ?? "Aucune réservation trouvée"}</p>
        </div>
      )}
    </CardContent>
  </Card>

  {totalPages > 1 && (
    <div class="pagination-wrap">
      <Pagination currentPage={page} totalPages={totalPages} baseUrl={`${adminBase}/organizations/bookings`} />
    </div>
  )}

  <!-- Detail side panel -->
  <div class="detail-overlay" id="detail-overlay" hidden>
    <div class="detail-panel">
      <div class="detail-header">
        <h3 id="detail-title">{to.bookingDetails ?? "Détails de la réservation"}</h3>
        <button class="detail-close" id="detail-close">&times;</button>
      </div>
      <div class="detail-body" id="detail-body"></div>
    </div>
  </div>
</AdminLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const overlay = document.getElementById("detail-overlay");
    const body = document.getElementById("detail-body");
    const toast = (msg: string, type = "info") => (window as any).showToast ? (window as any).showToast(msg, type) : alert(msg);

    // Detail panel
    document.querySelectorAll(".detail-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        const d = JSON.parse((btn as HTMLElement).dataset.booking ?? "{}");
        if (body) {
          body.innerHTML = `
            <div class="detail-row"><span class="detail-label">Service</span><span>${d.service}</span></div>
            <div class="detail-row"><span class="detail-label">Client</span><span>${d.customer} <small>(${d.customerEmail})</small></span></div>
            <div class="detail-row"><span class="detail-label">Prestataire</span><span>${d.provider}</span></div>
            <div class="detail-row"><span class="detail-label">Date</span><span>${d.date}</span></div>
            <div class="detail-row"><span class="detail-label">Heure</span><span>${d.time} · ${d.duration} min</span></div>
            <div class="detail-row"><span class="detail-label">Prix</span><span>${d.price ? d.price + " " + d.currency : "-"}</span></div>
            <div class="detail-row"><span class="detail-label">Statut</span><span class="badge-${d.status}">${d.status}</span></div>
            ${d.message ? `<div class="detail-section"><h4>Message du client</h4><p>${d.message}</p></div>` : ""}
            ${d.response ? `<div class="detail-section"><h4>Réponse du prestataire</h4><p>${d.response}</p></div>` : ""}
          `;
        }
        if (overlay) overlay.hidden = false;
      });
    });
    document.getElementById("detail-close")?.addEventListener("click", () => { if (overlay) overlay.hidden = true; });
    overlay?.addEventListener("click", e => { if (e.target === overlay) overlay!.hidden = true; });

    // Confirm / Decline
    const updateStatus = async (bookingId: string, action: string) => {
      try {
        const res = await fetch("/api/admin/services/bookings", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: bookingId, action }),
        });
        if (!res.ok) throw new Error((await res.json()).error ?? "Failed");
        toast(action === "confirm" ? "Réservation confirmée" : "Réservation refusée", "success");
        setTimeout(() => location.reload(), 500);
      } catch (e: any) { toast(e.message, "error"); }
    };

    document.querySelectorAll(".confirm-btn").forEach(btn => {
      btn.addEventListener("click", () => updateStatus((btn as HTMLElement).dataset.id!, "confirm"));
    });
    document.querySelectorAll(".decline-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        if (confirm("Refuser cette réservation ?")) {
          updateStatus((btn as HTMLElement).dataset.id!, "cancel");
        }
      });
    });
  });
</script>

<style>
  .admin-page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; }
  .admin-page-title { font-size: 1.75rem; font-weight: 800; margin: 0; }
  .admin-page-description { font-size: 0.9375rem; color: var(--text-muted, #64748b); margin: 0.25rem 0 0; }

  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .stat-compact { display: flex; align-items: center; gap: 0.75rem; }
  .stat-compact :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-primary, #eab308); }
  .stat-pending :global(svg) { color: #f59e0b; }
  .stat-confirmed :global(svg) { color: #3b82f6; }
  .stat-completed :global(svg) { color: #22c55e; }
  .stat-num { display: block; font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .stat-label { font-size: 0.8125rem; color: var(--text-muted, #64748b); }

  .filters-card { margin-bottom: 1.5rem; }
  .filters-form { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .filter-group { display: flex; align-items: center; gap: 0.5rem; }
  .filter-select { border: 1px solid var(--border-default, #e2e8f0); border-radius: 0.375rem; padding: 0.5rem 0.75rem; font-size: 0.875rem; background: var(--bg-default, white); }
  .clear-filter { font-size: 0.8125rem; color: var(--text-muted, #64748b); text-decoration: underline; }

  .table-responsive { overflow-x: auto; }
  .admin-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
  .admin-table th { text-align: left; font-weight: 600; padding: 0.75rem; border-bottom: 2px solid var(--border-default, #e2e8f0); color: var(--text-muted, #64748b); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; }
  .admin-table td { padding: 0.75rem; border-bottom: 1px solid var(--border-default, #f1f5f9); vertical-align: middle; }
  .admin-table tr:hover td { background: var(--bg-muted, rgba(241,245,249,0.5)); }

  .service-cell strong { font-weight: 600; }
  .user-cell { display: flex; align-items: center; gap: 0.5rem; }
  .user-avatar { width: 28px; height: 28px; border-radius: 50%; object-fit: cover; }
  .user-avatar-ph { width: 28px; height: 28px; border-radius: 50%; background: var(--color-primary, #eab308); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.75rem; }
  .user-name { display: block; font-weight: 600; font-size: 0.8125rem; }
  .user-email { display: block; color: var(--text-muted, #94a3b8); font-size: 0.6875rem; }
  .datetime-cell { display: flex; flex-direction: column; }
  .date-value { font-weight: 600; }
  .time-value { color: var(--text-muted, #94a3b8); font-size: 0.75rem; }
  .meta-cell { color: var(--text-muted, #94a3b8); }

  .action-btns { display: flex; gap: 0.25rem; }
  .btn-icon { border: none; background: none; cursor: pointer; padding: 0.375rem; border-radius: 0.375rem; transition: background 0.15s; display: flex; align-items: center; justify-content: center; color: var(--text-default, #0f172a); }
  .btn-icon :global(svg) { width: 1.125rem; height: 1.125rem; }
  .btn-icon:hover { background: var(--bg-muted, #f1f5f9); }
  .btn-success { color: #22c55e; }
  .btn-success:hover { background: #f0fdf4; }
  .btn-danger { color: #ef4444; }
  .btn-danger:hover { background: #fef2f2; }

  .empty-state { padding: 3rem 1rem; text-align: center; color: var(--text-muted, #94a3b8); }
  .empty-state :global(svg) { width: 3rem; height: 3rem; margin-bottom: 0.75rem; }

  .pagination-wrap { margin-top: 1.5rem; display: flex; justify-content: center; }

  /* Detail side panel */
  .detail-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 1000; display: flex; justify-content: flex-end; }
  .detail-overlay[hidden] { display: none; }
  .detail-panel { width: 420px; max-width: 90vw; background: var(--bg-default, white); height: 100%; box-shadow: -4px 0 24px rgba(0,0,0,0.15); display: flex; flex-direction: column; }
  .detail-header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-default, #e2e8f0); }
  .detail-header h3 { margin: 0; font-size: 1.125rem; font-weight: 700; }
  .detail-close { border: none; background: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted, #94a3b8); }
  .detail-body { padding: 1.5rem; flex: 1; overflow-y: auto; }
  :global(.detail-row) { display: flex; justify-content: space-between; padding: 0.625rem 0; border-bottom: 1px solid var(--border-default, #f1f5f9); font-size: 0.875rem; }
  :global(.detail-label) { font-weight: 600; color: var(--text-muted, #64748b); }
  :global(.detail-section) { margin-top: 1rem; }
  :global(.detail-section h4) { font-size: 0.8125rem; font-weight: 700; margin: 0 0 0.5rem; color: var(--text-muted, #64748b); text-transform: uppercase; }
  :global(.detail-section p) { font-size: 0.875rem; background: var(--bg-muted, #f8fafc); padding: 0.75rem; border-radius: 0.5rem; margin: 0; }

  @media (max-width: 768px) { .stats-row { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .stats-row { grid-template-columns: 1fr; } }
</style>

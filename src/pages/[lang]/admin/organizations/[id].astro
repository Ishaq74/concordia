---
// src/pages/[lang]/admin/organizations/[id].astro — Super-admin: edit organization profile
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Switch from "@components/ui/Form/Switch.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogOrganizations } from "@database/schemas";
import { member, user as userTable } from "@database/schemas/auth-schema";
import { eq, inArray } from "drizzle-orm"; // removed unused sql, count
import { getTranslations } from "@i18n/translations";

const lang = Astro.params.lang as string;
const { id } = Astro.params;
const t = getTranslations(lang);
const to = t.adminOrganizations ?? ({} as Record<string, string>);
const adminBase = `/${lang}/admin`;

if (!id) return Astro.redirect(`${adminBase}/organizations`);

const db = await getDrizzle();
const [org] = await db.select().from(blogOrganizations).where(eq(blogOrganizations.id, id)).limit(1);
if (!org) return Astro.redirect(`${adminBase}/organizations`);

// Fetch members
const members = await db
  .select({ id: member.id, userId: member.userId, role: member.role, createdAt: member.createdAt, organizationId: member.organizationId })
  .from(member)
  .where(eq(member.organizationId, id));

const userIds = members.map((m) => m.userId);
const usersMap = new Map<string, { name: string; email: string; image: string | null }>();
if (userIds.length > 0) {
  const users = await db
    .select({ id: userTable.id, name: userTable.name, email: userTable.email, image: userTable.image })
    .from(userTable)
    .where(inArray(userTable.id, userIds));
  for (const u of users) usersMap.set(u.id, { name: u.name, email: u.email, image: u.image });
}

const loc = (val: any, fallback = "") => {
  if (!val) return fallback;
  if (typeof val === "string") return val;
  return val[lang] ?? val.en ?? val.fr ?? Object.values(val)[0] ?? fallback;
};

const address = (org.address ?? {}) as Record<string, string>;
const sameAs = (org.sameAs ?? []) as string[];
const knowsAbout = (org.knowsAbout ?? []) as string[];
const knowsLanguage = (org.knowsLanguage ?? []) as string[];
const areaServed = (org.areaServed ?? []) as string[];
---

<AdminLayout title={`${org.name} — ${to.edit ?? "Modifier"}`} activeSection="organizations">
  <div class="admin-page-header">
    <div>
      <a href={`${adminBase}/organizations`} class="back-link">
        <Icon name="mdi:arrow-left" /> {to.backToList ?? "Retour à la liste"}
      </a>
      <h1 class="admin-page-title">{org.name}</h1>
      <div class="org-meta">
        <code>{org.slug}</code>
        {org.isActive ? (
          <Badge variant="modern" color="success">{to.active ?? "Active"}</Badge>
        ) : (
          <Badge variant="modern" color="secondary">{to.inactive ?? "Inactive"}</Badge>
        )}
        {org.isFeatured && <Badge variant="modern" color="warning"><Icon name="mdi:star" /> {to.featured ?? "Vedette"}</Badge>}
      </div>
    </div>
    <div class="header-actions">
      <a href={`/${lang}/organizations/${org.slug}`} target="_blank">
        <Button variant="modern" color="secondary" icon={{ name: "mdi:open-in-new", side: "left" }}>
          {to.viewPublic ?? "Voir publique"}
        </Button>
      </a>
      <Button variant="modern" color="primary" icon={{ name: "mdi:content-save", side: "left" }} id="save-btn">
        {to.save ?? "Enregistrer"}
      </Button>
    </div>
  </div>

  <div class="org-edit-grid">
    <!-- Main form -->
    <div class="org-edit-main">
      <!-- Identity -->
      <Card variant="modern" elevation="sm" class="org-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:information-outline" /> {to.identity ?? "Identité"}</h2>
          <div class="form-grid">
            <div class="form-field">
              <Label htmlFor="org-name">{to.name ?? "Nom"} *</Label>
              <Input type="text" id="org-name" value={org.name} required />
            </div>
            <div class="form-field">
              <Label htmlFor="org-slug">{to.slug ?? "Slug"} *</Label>
              <Input type="text" id="org-slug" value={org.slug} required />
            </div>
            <div class="form-field form-field--full">
              <Label htmlFor="org-desc">{to.descriptionLabel ?? "Description"}</Label>
              <Textarea id="org-desc" rows={3}>{loc(org.description)}</Textarea>
            </div>
            <div class="form-field form-field--full">
              <Label htmlFor="org-slogan">{to.slogan ?? "Slogan"}</Label>
              <Input type="text" id="org-slogan" value={loc(org.slogan)} />
            </div>
            <div class="form-field">
              <Label htmlFor="org-url">{to.website ?? "Site web"}</Label>
              <Input type="url" id="org-url" value={org.url ?? ""} />
            </div>
            <div class="form-field">
              <Label htmlFor="org-legal">{to.legalName ?? "Raison sociale"}</Label>
              <Input type="text" id="org-legal" value={loc(org.legalName)} />
            </div>
            <div class="form-field">
              <Label htmlFor="org-tax">{to.taxId ?? "SIRET / RNA"}</Label>
              <Input type="text" id="org-tax" value={org.taxID ?? ""} />
            </div>
            <div class="form-field">
              <Label htmlFor="org-nonprofit">{to.nonprofitStatus ?? "Statut non-lucratif"}</Label>
              <Input type="text" id="org-nonprofit" value={org.nonprofitStatus ?? ""} />
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Contact -->
      <Card variant="modern" elevation="sm" class="org-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:card-account-mail-outline" /> {to.contact ?? "Contact"}</h2>
          <div class="form-grid">
            <div class="form-field">
              <Label htmlFor="org-email">{to.email ?? "Email"}</Label>
              <Input type="email" id="org-email" value={org.email ?? ""} />
            </div>
            <div class="form-field">
              <Label htmlFor="org-phone">{to.phone ?? "Téléphone"}</Label>
              <Input type="tel" id="org-phone" value={org.telephone ?? ""} />
            </div>
            <div class="form-field form-field--full">
              <Label htmlFor="org-address">{to.address ?? "Adresse"}</Label>
              <Input type="text" id="org-address" value={address.streetAddress ?? ""} placeholder="Rue" />
            </div>
            <div class="form-field">
              <Label htmlFor="org-city">{to.city ?? "Ville"}</Label>
              <Input type="text" id="org-city" value={address.addressLocality ?? ""} />
            </div>
            <div class="form-field">
              <Label htmlFor="org-zip">{to.postalCode ?? "Code postal"}</Label>
              <Input type="text" id="org-zip" value={address.postalCode ?? ""} />
            </div>
            <div class="form-field">
              <Label htmlFor="org-country">{to.country ?? "Pays"}</Label>
              <Input type="text" id="org-country" value={address.addressCountry ?? ""} />
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Branding -->
      <Card variant="modern" elevation="sm" class="org-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:palette" /> {to.branding ?? "Marque"}</h2>
          <div class="form-grid">
            <div class="form-field">
              <Label htmlFor="org-logo">{to.logoUrl ?? "URL Logo"}</Label>
              <Input type="text" id="org-logo" value={org.logo ?? ""} />
              {org.logo && <img src={org.logo} alt="Logo" class="preview-img" />}
            </div>
            <div class="form-field">
              <Label htmlFor="org-image">{to.imageUrl ?? "URL Image couverture"}</Label>
              <Input type="text" id="org-image" value={org.image ?? ""} />
              {org.image && <img src={org.image} alt="Cover" class="preview-img preview-img--wide" />}
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Tags & Meta -->
      <Card variant="modern" elevation="sm" class="org-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:tag-multiple" /> {to.tags ?? "Tags & Métadonnées"}</h2>
          <div class="form-grid">
            <div class="form-field form-field--full">
              <Label htmlFor="org-knows">{to.expertise ?? "Domaines d'expertise"} <small>(virgules)</small></Label>
              <Input type="text" id="org-knows" value={knowsAbout.join(", ")} />
            </div>
            <div class="form-field form-field--full">
              <Label htmlFor="org-languages">{to.languages ?? "Langues"} <small>(virgules)</small></Label>
              <Input type="text" id="org-languages" value={knowsLanguage.join(", ")} />
            </div>
            <div class="form-field form-field--full">
              <Label htmlFor="org-areas">{to.areasServed ?? "Zones desservies"} <small>(virgules)</small></Label>
              <Input type="text" id="org-areas" value={areaServed.join(", ")} />
            </div>
            <div class="form-field form-field--full">
              <Label htmlFor="org-socials">{to.socialLinks ?? "Liens sociaux"} <small>(un par ligne)</small></Label>
              <Textarea id="org-socials" rows={3}>{sameAs.join("\n")}</Textarea>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Flags -->
      <Card variant="modern" elevation="sm" class="org-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:toggle-switch" /> {to.flags ?? "Options"}</h2>
          <div class="switch-grid">
            <div class="switch-row">
              <Switch id="org-active" name="isActive" checked={org.isActive} />
              <Label htmlFor="org-active">{to.active ?? "Active"}</Label>
            </div>
            <div class="switch-row">
              <Switch id="org-featured" name="isFeatured" checked={org.isFeatured} />
              <Label htmlFor="org-featured">{to.featured ?? "En vedette"}</Label>
            </div>
          </div>
        </CardContent>
      </Card>
    </div>

    <!-- Sidebar -->
    <aside class="org-edit-sidebar">
      <!-- Members card -->
      <Card variant="modern" elevation="sm" class="org-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:account-group" /> {to.members ?? "Membres"} ({members.length})</h2>
          <div class="members-list">
            {members.map((m) => {
              const u = usersMap.get(m.userId);
              return (
                <div class="member-row">
                  {u?.image ? (
                    <img src={u.image} alt={u?.name ?? "?"} class="member-avatar" />
                  ) : (
                    <div class="member-avatar member-avatar--placeholder">{(u?.name ?? "?").charAt(0)}</div>
                  )}
                  <div class="member-info">
                    <span class="member-name">{u?.name ?? m.userId}</span>
                    <span class="member-email">{u?.email ?? ""}</span>
                  </div>
                  <Badge variant="modern" color={m.role === "owner" ? "error" : m.role === "admin" ? "warning" : "secondary"}>
                    {m.role}
                  </Badge>
                </div>
              );
            })}
            {members.length === 0 && (
              <p class="no-members">{to.noMembers ?? "Aucun membre"}</p>
            )}
          </div>
          <a href={`${adminBase}/organizations/members`} class="sidebar-link">
            <Icon name="mdi:arrow-right" /> {to.manageMembers ?? "Gérer les membres"}
          </a>
        </CardContent>
      </Card>

      <!-- Quick info -->
      <Card variant="modern" elevation="sm" class="org-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:clock-outline" /> {to.info ?? "Informations"}</h2>
          <div class="info-list">
            <div class="info-row">
              <span class="info-label">{to.created ?? "Créée le"}</span>
              <span class="info-value">{org.createdAt.toLocaleDateString(lang, { day: "numeric", month: "long", year: "numeric" })}</span>
            </div>
            <div class="info-row">
              <span class="info-label">{to.updated ?? "Modifiée le"}</span>
              <span class="info-value">{org.updatedAt.toLocaleDateString(lang, { day: "numeric", month: "long", year: "numeric" })}</span>
            </div>
            {org.foundingDate && (
              <div class="info-row">
                <span class="info-label">{to.foundingDate ?? "Fondée"}</span>
                <span class="info-value">{new Date(org.foundingDate).getFullYear()}</span>
              </div>
            )}
            {org.numberOfEmployees && (
              <div class="info-row">
                <span class="info-label">{to.employees ?? "Employés"}</span>
                <span class="info-value">{org.numberOfEmployees}</span>
              </div>
            )}
          </div>
        </CardContent>
      </Card>

      <!-- Danger zone -->
      <Card variant="modern" elevation="sm" class="org-section danger-zone">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:alert-circle" /> {to.dangerZone ?? "Zone de danger"}</h2>
          <p class="danger-text">{to.deleteWarning ?? "Supprimer définitivement cette organisation et toutes ses données."}</p>
          <Button variant="modern" color="error" id="delete-btn" icon={{ name: "mdi:delete", side: "left" }}>
            {to.deleteOrg ?? "Supprimer l'organisation"}
          </Button>
        </CardContent>
      </Card>
    </aside>
  </div>
</AdminLayout>

<script is:inline define:vars={{ orgId: id }}>
  document.addEventListener("DOMContentLoaded", () => {
    const saveBtn = document.getElementById("save-btn");
    const deleteBtn = document.getElementById("delete-btn");

    function val(id) { return document.getElementById(id)?.value?.trim() ?? ""; }
    function checked(id) { return document.getElementById(id)?.checked ?? false; }
    function csvToArr(id) { return val(id).split(",").map(s => s.trim()).filter(Boolean); }
    function linesToArr(id) { return val(id).split("\n").map(s => s.trim()).filter(Boolean); }

    saveBtn?.addEventListener("click", async () => {
      const body = {
        action: "update",
        organizationId: orgId,
        name: val("org-name"),
        slug: val("org-slug"),
        description: { fr: val("org-desc"), en: val("org-desc") },
        slogan: { fr: val("org-slogan"), en: val("org-slogan") },
        url: val("org-url") || null,
        legalName: { fr: val("org-legal"), en: val("org-legal") },
        taxID: val("org-tax") || null,
        nonprofitStatus: val("org-nonprofit") || null,
        email: val("org-email") || null,
        telephone: val("org-phone") || null,
        address: {
          streetAddress: val("org-address"),
          addressLocality: val("org-city"),
          postalCode: val("org-zip"),
          addressCountry: val("org-country"),
        },
        logo: val("org-logo") || null,
        image: val("org-image") || null,
        knowsAbout: csvToArr("org-knows"),
        knowsLanguage: csvToArr("org-languages"),
        areaServed: csvToArr("org-areas"),
        sameAs: linesToArr("org-socials"),
        isActive: checked("org-active"),
        isFeatured: checked("org-featured"),
      };

      try {
        const res = await fetch("/api/admin/organizations/profile", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || "Failed");
        }
        if (window.showToast) window.showToast("Enregistré !", "success");
        else alert("Enregistré !");
        setTimeout(() => location.reload(), 600);
      } catch (e) {
        if (window.showToast) window.showToast(e.message, "error");
        else alert("Erreur: " + e.message);
      }
    });

    deleteBtn?.addEventListener("click", async () => {
      if (!confirm("Supprimer définitivement cette organisation ?")) return;
      try {
        const res = await fetch("/api/admin/organizations/profile", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "delete", organizationId: orgId }),
        });
        if (!res.ok) throw new Error("Failed");
        window.location.href = document.querySelector(".back-link")?.href || window.location.pathname.replace(/\/[^/]+$/, "");
      } catch {
        if (window.showToast) window.showToast("Erreur lors de la suppression", "error");
      }
    });
  });
</script>

<style>
  .admin-page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .admin-page-title { font-size: 1.75rem; font-weight: 800; margin: 0.25rem 0 0; }
  .back-link { display: inline-flex; align-items: center; gap: 0.25rem; font-size: 0.8125rem; color: var(--text-muted, #64748b); text-decoration: none; }
  .back-link:hover { color: var(--color-primary, #eab308); }
  .back-link :global(svg) { width: 1rem; height: 1rem; }
  .org-meta { display: flex; align-items: center; gap: 0.5rem; margin-top: 0.25rem; }
  .org-meta code { font-size: 0.75rem; background: var(--bg-muted, #f1f5f9); padding: 0.125rem 0.375rem; border-radius: 0.25rem; }
  .header-actions { display: flex; gap: 0.5rem; }

  .org-edit-grid { display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start; }
  .org-edit-main { display: flex; flex-direction: column; gap: 1.5rem; }
  .org-edit-sidebar { display: flex; flex-direction: column; gap: 1.5rem; position: sticky; top: 1.5rem; }

  .org-section { margin: 0; }
  .section-title { font-size: 1rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1rem; }
  .section-title :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary, #eab308); }

  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-field { display: flex; flex-direction: column; gap: 0.25rem; }
  .form-field--full { grid-column: 1 / -1; }

  .preview-img { max-width: 120px; max-height: 80px; border-radius: 0.375rem; margin-top: 0.5rem; object-fit: cover; }
  .preview-img--wide { max-width: 200px; }

  .switch-grid { display: flex; flex-direction: column; gap: 0.75rem; }
  .switch-row { display: flex; align-items: center; gap: 0.75rem; }

  /* Members sidebar */
  .members-list { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: 0.75rem; max-height: 300px; overflow-y: auto; }
  .member-row { display: flex; align-items: center; gap: 0.5rem; padding: 0.375rem 0; }
  .member-avatar { width: 32px; height: 32px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .member-avatar--placeholder { background: var(--bg-muted, #f1f5f9); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; color: var(--text-muted, #64748b); }
  .member-info { display: flex; flex-direction: column; flex: 1; min-width: 0; }
  .member-name { font-weight: 600; font-size: 0.8125rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .member-email { font-size: 0.6875rem; color: var(--text-muted, #64748b); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .no-members { font-size: 0.8125rem; color: var(--text-muted, #64748b); text-align: center; padding: 1rem 0; }
  .sidebar-link { display: flex; align-items: center; gap: 0.25rem; font-size: 0.8125rem; color: var(--color-primary, #eab308); text-decoration: none; font-weight: 600; }
  .sidebar-link:hover { text-decoration: underline; }
  .sidebar-link :global(svg) { width: 1rem; height: 1rem; }

  /* Info */
  .info-list { display: flex; flex-direction: column; gap: 0.5rem; }
  .info-row { display: flex; justify-content: space-between; font-size: 0.8125rem; }
  .info-label { color: var(--text-muted, #64748b); }
  .info-value { font-weight: 600; }

  /* Danger */
  .danger-zone { border-color: var(--color-error, #ef4444); }
  .danger-zone .section-title :global(svg) { color: var(--color-error, #ef4444); }
  .danger-text { font-size: 0.8125rem; color: var(--text-muted, #64748b); margin: 0 0 0.75rem; }

  @media (max-width: 1024px) {
    .org-edit-grid { grid-template-columns: 1fr; }
    .org-edit-sidebar { position: static; }
  }
  @media (max-width: 768px) {
    .form-grid { grid-template-columns: 1fr; }
    .header-actions { flex-direction: column; }
  }
</style>

---
// src/pages/[lang]/admin/organizations/blog.astro — Org blog management
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Pagination from "@components/ui/Pagination.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogPosts, blogTranslations, blogComments } from "@database/schemas";
import { member } from "@database/schemas/auth-schema";
import { eq, and, desc, sql } from "drizzle-orm";
import { getTranslations } from "@i18n/translations";
import { isAdminUser } from "@lib/admin/permissions";
import { getLocalizedUrl } from "@lib/i18n/route-helpers";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const to = t.adminOrganizations ?? ({} as Record<string, string>);
const adminBase = `/${lang}/admin`;

// Auth guard — redirect non-admins BEFORE any DB queries
const authUser = Astro.locals.user;
if (!authUser) return Astro.redirect(getLocalizedUrl(lang, "auth/sign-in"), 302);
if (!isAdminUser(authUser)) return Astro.redirect(getLocalizedUrl(lang, "/"), 302);

const db = await getDrizzle();

// Resolve active org: query param > session > member lookup > blogOrganizations fallback
let activeOrgId = (Astro.url.searchParams.get("org")) || Astro.locals.organizationId;
if (!activeOrgId) {
  const userId = Astro.locals.user?.id;
  if (userId) {
    const [m] = await db.select({ organizationId: member.organizationId }).from(member).where(eq(member.userId, userId)).limit(1);
    if (m) activeOrgId = m.organizationId;
  }
  if (!activeOrgId) {
    const { blogOrganizations } = await import("@database/schemas");
    const [firstOrg] = await db.select({ id: blogOrganizations.id }).from(blogOrganizations).limit(1);
    if (firstOrg) activeOrgId = firstOrg.id;
  }
}
if (!activeOrgId) return Astro.redirect(`${adminBase}/organizations`);

const url = Astro.url;
const page = Math.max(1, Number(url.searchParams.get("page")) || 1);
const perPage = 15;
const statusFilter = url.searchParams.get("status") ?? "";
const search = url.searchParams.get("q") ?? "";

// Build conditions
const conditions = [eq(blogPosts.organizationId, activeOrgId)];
if (statusFilter) conditions.push(eq(blogPosts.status, statusFilter));

// Fetch posts with translations
const allPosts = await db.select({
  id: blogPosts.id,
  slug: blogPosts.slug,
  status: blogPosts.status,
  inLanguage: blogPosts.inLanguage,
  publishedAt: blogPosts.publishedAt,
  isFeatured: blogPosts.isFeatured,
  displayInHome: blogPosts.displayInHome,
  readingTime: blogPosts.readingTime,
  createdAt: blogPosts.createdAt,
  updatedAt: blogPosts.updatedAt,
}).from(blogPosts)
  .where(and(...conditions))
  .orderBy(desc(blogPosts.createdAt));

// Fetch translations for these posts to get titles
const postIds = allPosts.map(p => p.id);
const translations = postIds.length > 0
  ? await db.select({
    postId: blogTranslations.postId,
    inLanguage: blogTranslations.inLanguage,
    headline: blogTranslations.headline,
  }).from(blogTranslations)
    .where(sql`${blogTranslations.postId} IN (${sql.join(postIds.map(id => sql`${id}`), sql`, `)})`)
  : [];

// Map translations to posts
const translationMap = new Map<string, Record<string, any>>();
for (const tr of translations) {
  if (!translationMap.has(tr.postId)) translationMap.set(tr.postId, {});
  translationMap.get(tr.postId)![tr.inLanguage] = tr.headline;
}

const loc = (val: any) => {
  if (!val) return "";
  if (typeof val === "string") return val;
  return val[lang] ?? val.en ?? val.fr ?? Object.values(val)[0] ?? "";
};

// Apply search filter on title
let filteredPosts = allPosts.map(p => {
  const headlines = translationMap.get(p.id) ?? {};
  const title = loc(headlines[lang]) || loc(headlines[p.inLanguage]) || loc(headlines.fr) || p.slug;
  return { ...p, title };
});
if (search) {
  const q = search.toLowerCase();
  filteredPosts = filteredPosts.filter(p => p.title.toLowerCase().includes(q) || p.slug.toLowerCase().includes(q));
}

const total = filteredPosts.length;
const totalPages = Math.ceil(total / perPage);
const posts = filteredPosts.slice((page - 1) * perPage, page * perPage);

// Stats
const published = allPosts.filter(p => p.status === "published").length;
const drafts = allPosts.filter(p => p.status === "draft").length;
const featured = allPosts.filter(p => p.isFeatured).length;

// Comments moderation — fetch comments for this org's posts
const orgPostIds = allPosts.map(p => p.id);
const allComments = orgPostIds.length > 0
  ? await db.select({
    id: blogComments.id,
    postId: blogComments.postId,
    authorName: blogComments.authorName,
    authorEmail: blogComments.authorEmail,
    content: blogComments.content,
    status: blogComments.status,
    createdAt: blogComments.createdAt,
  }).from(blogComments)
    .where(sql`${blogComments.postId} IN (${sql.join(orgPostIds.map(id => sql`${id}`), sql`, `)})`)
    .orderBy(desc(blogComments.createdAt))
  : [];
const pendingComments = allComments.filter(c => c.status === "pending");

type BadgeColor = "default" | "primary" | "secondary" | "accent" | "success" | "warning" | "error";
const statusBadgeColor: Record<string, BadgeColor> = {
  published: "success",
  draft: "secondary",
  pending: "warning",
  archived: "accent",
};
---

<AdminLayout title={to.orgBlog ?? "Blog de l'organisation"} activeSection="org-blog">
  <div class="admin-page-header">
    <div>
      <h1 class="admin-page-title">{to.orgBlog ?? "Blog de l'organisation"}</h1>
      <p class="admin-page-description">{to.blogDesc ?? "Gérez les articles de blog de votre organisation"}</p>
    </div>
    <a href={`${adminBase}/blog/articles/new?orgId=${activeOrgId}`}>
      <Button variant="modern" color="primary" icon={{ name: "mdi:plus", side: "left" }}>
        {to.writeArticle ?? "Écrire un article"}
      </Button>
    </a>
  </div>

  <!-- Stats -->
  <div class="stats-row">
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact">
          <Icon name="mdi:file-document-multiple" />
          <div><span class="stat-num">{total}</span><span class="stat-label">{to.totalArticles ?? "Total articles"}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-published">
          <Icon name="mdi:check-circle" />
          <div><span class="stat-num">{published}</span><span class="stat-label">{to.published ?? "Publiés"}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-drafts">
          <Icon name="mdi:pencil-outline" />
          <div><span class="stat-num">{drafts}</span><span class="stat-label">{to.drafts ?? "Brouillons"}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-star">
          <Icon name="mdi:star" />
          <div><span class="stat-num">{featured}</span><span class="stat-label">{to.featured ?? "En vedette"}</span></div>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm">
      <CardContent>
        <div class="stat-compact stat-comments">
          <Icon name="mdi:comment-alert-outline" />
          <div><span class="stat-num">{pendingComments.length}</span><span class="stat-label">{to.pendingComments ?? "Commentaires en attente"}</span></div>
        </div>
      </CardContent>
    </Card>
  </div>

  <!-- Filters -->
  <Card variant="modern" elevation="sm" class="filters-card">
    <CardContent>
      <form class="filters-form" method="get">
        <div class="filter-field filter-search">
          <Label htmlFor="q">{to.searchArticle ?? "Rechercher"}</Label>
          <Input id="q" name="q" type="search" value={search} placeholder={to.searchArticle ?? "Rechercher un article..."} icon="mdi:magnify" iconPosition="left" />
        </div>
        <div class="filter-field">
          <Label htmlFor="status">{to.status ?? "Statut"}</Label>
          <Select id="status" name="status">
            <option value="">{to.allStatuses ?? "Tous les statuts"}</option>
            <option value="published" selected={statusFilter === "published"}>{to.statusPublished ?? "Publiés"}</option>
            <option value="draft" selected={statusFilter === "draft"}>{to.statusDraft ?? "Brouillons"}</option>
            <option value="pending" selected={statusFilter === "pending"}>{to.statusPending ?? "En attente"}</option>
            <option value="archived" selected={statusFilter === "archived"}>{to.statusArchivés ?? "Archivés"}</option>
          </Select>
        </div>
        <Button variant="modern" color="secondary" type="submit" icon={{ name: "mdi:filter", side: "left" }}>
          {to.filter ?? "Filtrer"}
        </Button>
      </form>
    </CardContent>
  </Card>

  <!-- Table -->
  <Card variant="modern" elevation="sm">
    <CardContent>
      <Table variant="modern" striped>
        <TableHeader>
          <TableRow>
            <TableHead>{to.article ?? "Article"}</TableHead>
            <TableHead>{to.status ?? "Statut"}</TableHead>
            <TableHead>{to.language ?? "Langue"}</TableHead>
            <TableHead>{to.readingTime ?? "Lecture"}</TableHead>
            <TableHead>{to.publishedAt ?? "Publié le"}</TableHead>
            <TableHead>{to.actions ?? "Actions"}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {posts.map(p => (
            <TableRow>
              <TableCell>
                <div class="article-cell">
                  <strong class="article-title">{p.title}</strong>
                  <code class="article-slug">/{p.slug}</code>
                </div>
              </TableCell>
              <TableCell><Badge variant="modern" color={statusBadgeColor[p.status] ?? "secondary"}>{p.status}</Badge></TableCell>
              <TableCell><Badge variant="modern" color="accent">{p.inLanguage.toUpperCase()}</Badge></TableCell>
              <TableCell className="meta-cell">{p.readingTime ?? "-"}</TableCell>
              <TableCell className="meta-cell">{p.publishedAt ? p.publishedAt.toLocaleDateString(lang, { day: "numeric", month: "short", year: "numeric" }) : "-"}</TableCell>
              <TableCell>
                <div class="action-btns">
                  <a href={`${adminBase}/blog/articles/${p.id}`} class="btn-icon" title={to.edit ?? "Éditer"}>
                    <Icon name="mdi:pencil" />
                  </a>
                  <a href={`/${lang}/blog/${p.slug}`} target="_blank" class="btn-icon" title={to.view ?? "Voir"}>
                    <Icon name="mdi:open-in-new" />
                  </a>
                </div>
              </TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
      {posts.length === 0 && (
        <div class="empty-state">
          <Icon name="mdi:file-document-outline" />
          <p>{to.noArticles ?? "Aucun article trouvé"}</p>
          <a href={`${adminBase}/blog/articles/new?orgId=${activeOrgId}`}>
            <Button variant="modern" color="primary" icon={{ name: "mdi:plus", side: "left" }}>{to.writeFirst ?? "Écrire le premier article"}</Button>
          </a>
        </div>
      )}
    </CardContent>
  </Card>

  {totalPages > 1 && (
    <div class="pagination-wrap">
      <Pagination currentPage={page} totalPages={totalPages} baseUrl={`${adminBase}/organizations/blog`} />
    </div>
  )}

  <!-- Comments Moderation -->
  {pendingComments.length > 0 && (
    <Card variant="modern" elevation="sm" class="comments-section">
      <CardContent>
        <h2 class="section-title"><Icon name="mdi:comment-alert-outline" /> {to.pendingComments ?? "Commentaires en attente de modération"} <Badge variant="modern" color="warning">{pendingComments.length}</Badge></h2>
        <Table variant="modern" striped>
          <TableHeader>
            <TableRow>
              <TableHead>{to.author ?? "Auteur"}</TableHead>
              <TableHead>{to.comment ?? "Commentaire"}</TableHead>
              <TableHead>{to.date ?? "Date"}</TableHead>
              <TableHead>{to.actions ?? "Actions"}</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {pendingComments.slice(0, 10).map(c => {
              const txt = typeof c.content === "string" ? c.content : (c.content as any)?.text ?? JSON.stringify(c.content);
              const postTitle = filteredPosts.find(p => p.id === c.postId)?.title ?? c.postId.slice(0, 8);
              return (
                <TableRow>
                  <TableCell>
                    <div class="comment-author">
                      <strong>{c.authorName}</strong>
                      <small>{c.authorEmail}</small>
                    </div>
                  </TableCell>
                  <TableCell>
                    <div class="comment-content">
                      <small class="comment-post">sur: {postTitle}</small>
                      <p class="comment-text">{txt.slice(0, 120)}{txt.length > 120 ? "..." : ""}</p>
                    </div>
                  </TableCell>
                  <TableCell className="meta-cell">{c.createdAt.toLocaleDateString(lang, { day: "numeric", month: "short" })}</TableCell>
                  <TableCell>
                    <div class="action-btns">
                      <button class="btn-icon btn-success approve-comment" data-id={c.id} title={to.approve ?? "Approuver"}>
                        <Icon name="mdi:check" />
                      </button>
                      <button class="btn-icon btn-danger reject-comment" data-id={c.id} title={to.reject ?? "Rejeter"}>
                        <Icon name="mdi:close" />
                      </button>
                    </div>
                  </TableCell>
                </TableRow>
              );
            })}
          </TableBody>
        </Table>
        {pendingComments.length > 10 && (
          <p class="comments-more">{to.andMore ?? "et"} {pendingComments.length - 10} {to.moreComments ?? "commentaires supplémentaires..."}</p>
        )}
      </CardContent>
    </Card>
  )}
</AdminLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const toast = (msg: string, type = "info") => (window as any).showToast ? (window as any).showToast(msg, type) : alert(msg);

    async function moderateComment(id: string, action: "approve" | "reject") {
      try {
        const res = await fetch("/api/admin/blog/comments", {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id, action }),
        });
        if (!res.ok) throw new Error((await res.json()).error ?? "Erreur");
        toast(action === "approve" ? "Commentaire approuvé" : "Commentaire rejeté", "success");
        const btn = document.querySelector(`[data-id="${id}"]`);
        const row = btn?.closest("tr") as HTMLElement | null;
        if (row) { row.style.opacity = "0.3"; setTimeout(() => row.remove(), 400); }
      } catch (e: any) { toast(e.message, "error"); }
    }

    document.querySelectorAll(".approve-comment").forEach(btn => {
      btn.addEventListener("click", () => moderateComment((btn as HTMLElement).dataset.id!, "approve"));
    });
    document.querySelectorAll(".reject-comment").forEach(btn => {
      btn.addEventListener("click", () => moderateComment((btn as HTMLElement).dataset.id!, "reject"));
    });
  });
</script>

<style>
  .admin-page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .admin-page-title { font-size: 1.75rem; font-weight: 800; margin: 0; }
  .admin-page-description { font-size: 0.9375rem; color: var(--text-muted, #64748b); margin: 0.25rem 0 0; }

  .stats-row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1rem; margin-bottom: 1.5rem; }
  .stat-compact { display: flex; align-items: center; gap: 0.75rem; }
  .stat-compact :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-primary, #eab308); }
  .stat-published :global(svg) { color: #22c55e; }
  .stat-drafts :global(svg) { color: #94a3b8; }
  .stat-star :global(svg) { color: #f59e0b; }
  .stat-comments :global(svg) { color: #ef4444; }
  .stat-num { display: block; font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .stat-label { font-size: 0.8125rem; color: var(--text-muted, #64748b); }

  .filters-card { margin-bottom: 1.5rem; }
  .filters-form { display: flex; align-items: flex-end; gap: 1rem; flex-wrap: wrap; }
  .filter-field { flex: 1; min-width: 180px; }
  .filter-search { flex: 2; }

  .article-cell { display: flex; flex-direction: column; gap: 0.125rem; }
  .article-title { font-weight: 600; }
  .article-slug { font-size: 0.75rem; color: var(--text-muted, #94a3b8); font-family: monospace; }
  .meta-cell { font-size: 0.8125rem; color: var(--text-muted, #64748b); }

  .action-btns { display: flex; gap: 0.25rem; }
  .btn-icon { border: none; background: none; cursor: pointer; padding: 0.375rem; border-radius: 0.375rem; transition: background 0.15s; display: flex; align-items: center; justify-content: center; color: var(--text-default, #0f172a); text-decoration: none; }
  .btn-icon :global(svg) { width: 1.125rem; height: 1.125rem; }
  .btn-icon:hover { background: var(--bg-muted, #f1f5f9); color: var(--color-primary, #eab308); }

  .empty-state { padding: 3rem 1rem; text-align: center; color: var(--text-muted, #94a3b8); }
  .empty-state :global(svg) { width: 3rem; height: 3rem; margin-bottom: 0.75rem; }
  .empty-state p { margin-bottom: 1rem; }

  .pagination-wrap { margin-top: 1.5rem; display: flex; justify-content: center; }

  @media (max-width: 768px) { .stats-row { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .stats-row { grid-template-columns: 1fr; } }

  /* Comments moderation */
  .comments-section { margin-top: 1.5rem; }
  .section-title { font-size: 1.125rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1rem; }
  .section-title :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary, #eab308); }
  .comment-author { display: flex; flex-direction: column; }
  .comment-author strong { font-weight: 600; }
  .comment-author small { color: var(--text-muted, #64748b); font-size: 0.75rem; }
  .comment-content { display: flex; flex-direction: column; gap: 0.25rem; max-width: 400px; }
  .comment-post { color: var(--color-primary, #eab308); font-size: 0.75rem; font-weight: 600; }
  .comment-text { margin: 0; font-size: 0.875rem; line-height: 1.4; }
  .comments-more { margin: 0.75rem 0 0; font-size: 0.8125rem; color: var(--text-muted, #94a3b8); text-align: center; }
  .btn-success { color: #22c55e; }
  .btn-success:hover { background: #f0fdf4; }
  .btn-danger { color: #ef4444; }
  .btn-danger:hover { background: #fef2f2; }
</style>

---
// src/pages/[lang]/admin/organizations/index.astro — Super-admin: all organizations list
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Pagination from "@components/ui/Pagination.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogOrganizations } from "@database/schemas";
import { member } from "@database/schemas/auth-schema";
import { count, eq, desc, ilike, and, sql } from "drizzle-orm";
import { getTranslations } from "@i18n/translations";
import { isAdminUser } from "@lib/admin/permissions";
import { getLocalizedUrl } from "@lib/i18n/route-helpers";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const to = t.adminOrganizations ?? ({} as Record<string, string>);

// Auth guard — redirect non-admins BEFORE any DB queries
const user = Astro.locals.user;
if (!user) return Astro.redirect(getLocalizedUrl(lang, "auth/sign-in"), 302);
if (!isAdminUser(user)) return Astro.redirect(getLocalizedUrl(lang, "/"), 302);

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1"));
const perPage = 20;
const search = url.searchParams.get("q")?.trim() ?? "";
const statusFilter = url.searchParams.get("status")?.trim() ?? "";
const featuredFilter = url.searchParams.get("featured")?.trim() ?? "";

const db = await getDrizzle();

// Build filters
const conditions: any[] = [];
if (search) conditions.push(ilike(blogOrganizations.name, `%${search}%`));
if (statusFilter === "active") conditions.push(eq(blogOrganizations.isActive, true));
if (statusFilter === "inactive") conditions.push(eq(blogOrganizations.isActive, false));
if (featuredFilter === "true") conditions.push(eq(blogOrganizations.isFeatured, true));
if (featuredFilter === "false") conditions.push(eq(blogOrganizations.isFeatured, false));

const whereClause = conditions.length > 0 ? and(...conditions) : undefined;

// Count
const [totalResult] = whereClause
  ? await db.select({ value: count() }).from(blogOrganizations).where(whereClause)
  : await db.select({ value: count() }).from(blogOrganizations);
const total = totalResult.value;
const totalPages = Math.max(1, Math.ceil(total / perPage));
const offset = (page - 1) * perPage;

// Fetch orgs
const orgs = whereClause
  ? await db.select().from(blogOrganizations).where(whereClause).orderBy(desc(blogOrganizations.createdAt)).limit(perPage).offset(offset)
  : await db.select().from(blogOrganizations).orderBy(desc(blogOrganizations.createdAt)).limit(perPage).offset(offset);

// Batch fetch member counts per org (using auth member table linked by shared name/slug or id convention)
// Note: blogOrganizations.id and member.organizationId may be linked differently
// We'll count member rows that reference these org IDs
const orgIds = orgs.map((o) => o.id);
const memberCounts = new Map<string, number>();
if (orgIds.length > 0) {
  const counts = await db
    .select({ organizationId: member.organizationId, cnt: count() })
    .from(member)
    .where(sql`${member.organizationId} IN (${sql.join(orgIds.map((id) => sql`${id}`), sql`, `)})`)
    .groupBy(member.organizationId);
  for (const c of counts) memberCounts.set(c.organizationId, c.cnt);
}

// Stats
const [totalAll] = await db.select({ value: count() }).from(blogOrganizations);
const [totalActive] = await db.select({ value: count() }).from(blogOrganizations).where(eq(blogOrganizations.isActive, true));
const [totalFeatured] = await db.select({ value: count() }).from(blogOrganizations).where(eq(blogOrganizations.isFeatured, true));

const loc = (val: any, fallback = "") => {
  if (!val) return fallback;
  if (typeof val === "string") return val;
  return val[lang] ?? val.en ?? val.fr ?? Object.values(val)[0] ?? fallback;
};

const buildUrl = (params: Record<string, string>) => {
  const u = new URL(url);
  for (const [k, v] of Object.entries(params)) {
    if (v) u.searchParams.set(k, v);
    else u.searchParams.delete(k);
  }
  return u.pathname + u.search;
};

const adminBase = `/${lang}/admin`;
---

<AdminLayout title={to.title ?? "Organisations"} activeSection="organizations">
  <div class="admin-page-header">
    <div>
      <h1 class="admin-page-title">{to.title ?? "Organisations"}</h1>
      <p class="admin-page-description">{to.description ?? "Gérer toutes les organisations de la plateforme"}</p>
    </div>
    <a href={`${adminBase}/organizations/new`}>
      <Button variant="modern" color="primary" icon={{ name: "mdi:plus", side: "left" }}>
        {to.create ?? "Nouvelle organisation"}
      </Button>
    </a>
  </div>

  <!-- Stats -->
  <div class="admin-stats-row">
    <Card variant="modern" elevation="sm" class="admin-stat-card">
      <CardContent>
        <div class="stat-icon"><Icon name="mdi:domain" /></div>
        <div class="stat-info">
          <span class="stat-value">{totalAll.value}</span>
          <span class="stat-label">{to.totalOrgs ?? "Total"}</span>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm" class="admin-stat-card">
      <CardContent>
        <div class="stat-icon stat-icon--success"><Icon name="mdi:check-circle" /></div>
        <div class="stat-info">
          <span class="stat-value">{totalActive.value}</span>
          <span class="stat-label">{to.active ?? "Actives"}</span>
        </div>
      </CardContent>
    </Card>
    <Card variant="modern" elevation="sm" class="admin-stat-card">
      <CardContent>
        <div class="stat-icon stat-icon--warning"><Icon name="mdi:star" /></div>
        <div class="stat-info">
          <span class="stat-value">{totalFeatured.value}</span>
          <span class="stat-label">{to.featured ?? "En vedette"}</span>
        </div>
      </CardContent>
    </Card>
  </div>

  <!-- Filters -->
  <Card variant="modern" elevation="sm" class="admin-filters-card">
    <CardContent>
      <form method="get" class="admin-filters-form">
        <div class="filter-group">
          <Label htmlFor="q">{t.adminServices?.listings?.search ?? "Rechercher"}</Label>
          <Input type="text" name="q" id="q" value={search} placeholder={to.searchPlaceholder ?? "Nom de l'organisation..."} />
        </div>
        <div class="filter-group">
          <Label htmlFor="status">{t.adminServices?.listings?.statusFilter ?? "Statut"}</Label>
          <Select name="status" id="status">
            <option value="">{to.allStatuses ?? "Tous"}</option>
            <option value="active" selected={statusFilter === "active"}>{to.active ?? "Active"}</option>
            <option value="inactive" selected={statusFilter === "inactive"}>{to.inactive ?? "Inactive"}</option>
          </Select>
        </div>
        <div class="filter-group">
          <Label htmlFor="featured">{to.featured ?? "En vedette"}</Label>
          <Select name="featured" id="featured">
            <option value="">{to.allStatuses ?? "Tous"}</option>
            <option value="true" selected={featuredFilter === "true"}>{to.yes ?? "Oui"}</option>
            <option value="false" selected={featuredFilter === "false"}>{to.no ?? "Non"}</option>
          </Select>
        </div>
        <div class="filter-actions">
          <Button variant="modern" color="primary" type="submit" icon={{ name: "mdi:magnify", side: "left" }}>
            {t.adminServices?.listings?.search ?? "Filtrer"}
          </Button>
          <a href={`${adminBase}/organizations`}>
            <Button variant="modern" color="secondary" type="button" icon={{ name: "mdi:filter-remove-outline", side: "left" }}>
              {to.reset ?? "Réinitialiser"}
            </Button>
          </a>
        </div>
      </form>
    </CardContent>
  </Card>

  <!-- Table -->
  <Card variant="modern" elevation="sm">
    <CardContent>
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead></TableHead>
            <TableHead>{to.name ?? "Nom"}</TableHead>
            <TableHead>{to.slug ?? "Slug"}</TableHead>
            <TableHead>{to.members ?? "Membres"}</TableHead>
            <TableHead>{t.adminServices?.listings?.statusFilter ?? "Statut"}</TableHead>
            <TableHead>{to.featured ?? "Vedette"}</TableHead>
            <TableHead>{to.created ?? "Créée le"}</TableHead>
            <TableHead>{t.adminServices?.listings?.actions ?? "Actions"}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {orgs.map((org) => {
            const descText = loc(org.description, "—");
            return (
              <TableRow>
                <TableCell>
                  {org.logo ? (
                    <img src={org.logo} alt={org.name} class="org-thumb" />
                  ) : (
                    <div class="org-thumb org-thumb--placeholder">{org.name.charAt(0)}</div>
                  )}
                </TableCell>
                <TableCell>
                  <div class="org-name-cell">
                    <a href={`${adminBase}/organizations/${org.id}`} class="org-name-link">{org.name}</a>
                    <span class="org-desc-preview">{descText.length > 60 ? descText.slice(0, 60) + "…" : descText}</span>
                  </div>
                </TableCell>
                <TableCell><code class="org-slug">{org.slug}</code></TableCell>
                <TableCell>
                  <span class="member-count">{memberCounts.get(org.id) ?? 0}</span>
                </TableCell>
                <TableCell>
                  {org.isActive ? (
                    <Badge variant="modern" color="success">{to.active ?? "Active"}</Badge>
                  ) : (
                    <Badge variant="modern" color="secondary">{to.inactive ?? "Inactive"}</Badge>
                  )}
                </TableCell>
                <TableCell>
                  {org.isFeatured ? (
                    <Badge variant="modern" color="warning"><Icon name="mdi:star" /></Badge>
                  ) : "—"}
                </TableCell>
                <TableCell>
                  <time datetime={org.createdAt.toISOString()}>
                    {org.createdAt.toLocaleDateString(lang, { day: "numeric", month: "short", year: "numeric" })}
                  </time>
                </TableCell>
                <TableCell>
                  <div class="action-btns">
                    <a href={`${adminBase}/organizations/${org.id}`} title={to.edit ?? "Modifier"}>
                      <Icon name="mdi:pencil" />
                    </a>
                    <a href={`/${lang}/organizations/${org.slug}`} target="_blank" title={to.viewPublic ?? "Voir publique"}>
                      <Icon name="mdi:open-in-new" />
                    </a>
                    <button type="button" class="toggle-active-btn" data-org-id={org.id} data-active={String(org.isActive)} title={org.isActive ? (to.deactivate ?? "Désactiver") : (to.activate ?? "Activer")}>
                      <Icon name={org.isActive ? "mdi:eye-off" : "mdi:eye"} />
                    </button>
                  </div>
                </TableCell>
              </TableRow>
            );
          })}
          {orgs.length === 0 && (
            <TableRow>
              <TableCell colspan={8}>
                <div class="empty-state">
                  <Icon name="mdi:domain-off" />
                  <p>{to.noOrgs ?? "Aucune organisation trouvée."}</p>
                </div>
              </TableCell>
            </TableRow>
          )}
        </TableBody>
      </Table>

      {totalPages > 1 && (
        <Pagination currentPage={page} totalPages={totalPages} baseUrl={buildUrl({ page: "" })} />
      )}
    </CardContent>
  </Card>
</AdminLayout>

<script>
  import { showToast } from "@lib/admin/toast";

  document.querySelectorAll<HTMLButtonElement>(".toggle-active-btn").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const orgId = btn.dataset.orgId;
      const isActive = btn.dataset.active === "true";
      try {
        const res = await fetch("/api/admin/organizations/profile", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "toggle-active", organizationId: orgId, isActive: !isActive }),
        });
        if (!res.ok) throw new Error("Failed");
        showToast(isActive ? "Organisation désactivée" : "Organisation activée", "success");
        setTimeout(() => location.reload(), 600);
      } catch {
        showToast("Erreur", "error");
      }
    });
  });
</script>

<style>
  .admin-page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .admin-page-title { font-size: 1.75rem; font-weight: 800; margin: 0; }
  .admin-page-description { font-size: 0.9375rem; color: var(--text-muted, #64748b); margin: 0.25rem 0 0; }

  .admin-stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; margin-bottom: 1.5rem; }
  .admin-stat-card :global(.card-content) { display: flex; align-items: center; gap: 1rem; padding: 1rem; }
  .stat-icon { width: 2.5rem; height: 2.5rem; border-radius: 0.5rem; background: var(--color-primary-light, #fef3c7); color: var(--color-primary, #eab308); display: flex; align-items: center; justify-content: center; }
  .stat-icon--success { background: #dcfce7; color: #16a34a; }
  .stat-icon--warning { background: #fef3c7; color: #eab308; }
  .stat-icon :global(svg) { width: 1.25rem; height: 1.25rem; }
  .stat-value { font-size: 1.5rem; font-weight: 800; display: block; }
  .stat-label { font-size: 0.8125rem; color: var(--text-muted, #64748b); }

  .admin-filters-card { margin-bottom: 1.5rem; }
  .admin-filters-form { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-end; }
  .filter-group { display: flex; flex-direction: column; gap: 0.25rem; min-width: 160px; flex: 1; }
  .filter-actions { display: flex; gap: 0.5rem; align-items: end; }

  .org-thumb { width: 40px; height: 40px; border-radius: 0.5rem; object-fit: cover; }
  .org-thumb--placeholder { background: var(--bg-muted, #f1f5f9); display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.125rem; color: var(--text-muted, #64748b); }
  .org-name-cell { display: flex; flex-direction: column; gap: 0.125rem; }
  .org-name-link { font-weight: 600; color: var(--text-default, #0f172a); text-decoration: none; }
  .org-name-link:hover { color: var(--color-primary, #eab308); text-decoration: underline; }
  .org-desc-preview { font-size: 0.75rem; color: var(--text-muted, #64748b); }
  .org-slug { font-size: 0.75rem; background: var(--bg-muted, #f1f5f9); padding: 0.125rem 0.375rem; border-radius: 0.25rem; }
  .member-count { font-weight: 600; }

  .action-btns { display: flex; gap: 0.5rem; align-items: center; }
  .action-btns a, .action-btns button { color: var(--text-muted, #64748b); background: none; border: none; cursor: pointer; padding: 0.25rem; border-radius: 0.25rem; transition: color 0.15s; }
  .action-btns a:hover, .action-btns button:hover { color: var(--color-primary, #eab308); }
  .action-btns :global(svg) { width: 1.125rem; height: 1.125rem; }

  .empty-state { text-align: center; padding: 2rem; color: var(--text-muted, #64748b); }
  .empty-state :global(svg) { width: 2.5rem; height: 2.5rem; opacity: 0.4; margin-bottom: 0.5rem; }

  @media (max-width: 768px) {
    .admin-filters-form { flex-direction: column; }
    .admin-stats-row { grid-template-columns: 1fr; }
  }
</style>

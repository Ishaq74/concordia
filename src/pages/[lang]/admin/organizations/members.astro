---
// src/pages/[lang]/admin/organizations/members.astro — Org members & roles management
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Label from "@components/ui/Form/Label.astro";
import Select from "@components/ui/Form/Select.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { member, user as userTable, invitation } from "@database/schemas/auth-schema";
import { eq } from "drizzle-orm";
import { getTranslations } from "@i18n/translations";
import { isAdminUser } from "@lib/admin/permissions";
import { getLocalizedUrl } from "@lib/i18n/route-helpers";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const to = t.adminOrganizations ?? ({} as Record<string, string>);
const adminBase = `/${lang}/admin`;

// Auth guard — redirect non-admins BEFORE any DB queries
const authUser = Astro.locals.user;
if (!authUser) return Astro.redirect(getLocalizedUrl(lang, "auth/sign-in"), 302);
if (!isAdminUser(authUser)) return Astro.redirect(getLocalizedUrl(lang, "/"), 302);

const db = await getDrizzle();

// Resolve active org: query param > session > member lookup > blogOrganizations fallback
let activeOrgId = (Astro.url.searchParams.get("org")) || Astro.locals.organizationId;
if (!activeOrgId) {
  const userId = Astro.locals.user?.id;
  if (userId) {
    const [m] = await db.select({ organizationId: member.organizationId }).from(member).where(eq(member.userId, userId)).limit(1);
    if (m) activeOrgId = m.organizationId;
  }
  if (!activeOrgId) {
    const { blogOrganizations } = await import("@database/schemas");
    const [firstOrg] = await db.select({ id: blogOrganizations.id }).from(blogOrganizations).limit(1);
    if (firstOrg) activeOrgId = firstOrg.id;
  }
}
if (!activeOrgId) return Astro.redirect(`${adminBase}/organizations`);

const [members, invitations] = await Promise.all([
  db.select({
    id: member.id,
    userId: member.userId,
    role: member.role,
    createdAt: member.createdAt,
    name: userTable.name,
    email: userTable.email,
    image: userTable.image,
  }).from(member)
    .innerJoin(userTable, eq(member.userId, userTable.id))
    .where(eq(member.organizationId, activeOrgId)),
  db.select().from(invitation).where(eq(invitation.organizationId, activeOrgId)),
]);

const pendingInvitations = invitations.filter(i => i.status === "pending");

// Role breakdown
const roleCounts = members.reduce((acc, m) => { acc[m.role] = (acc[m.role] || 0) + 1; return acc; }, {} as Record<string, number>);

const roleLabels: Record<string, string> = {
  owner: to.roleOwner ?? "Propriétaire",
  admin: to.roleAdmin ?? "Administrateur",
  member: to.roleMember ?? "Membre",
  editor: to.roleEditor ?? "Rédacteur",
  manager: to.roleManager ?? "Gestionnaire",
  translator: to.roleTranslator ?? "Traducteur",
};
type BadgeColor = "default" | "primary" | "secondary" | "accent" | "success" | "warning" | "error";
const roleBadgeColor: Record<string, BadgeColor> = {
  owner: "warning",
  admin: "primary",
  member: "secondary",
  editor: "accent",
  manager: "success",
  translator: "default",
};
---

<AdminLayout title={to.membersRoles ?? "Membres & Rôles"} activeSection="org-members">
  <div class="admin-page-header">
    <div>
      <h1 class="admin-page-title">{to.membersRoles ?? "Membres & Rôles"}</h1>
      <p class="admin-page-description">{to.membersDesc ?? "Gérez les membres de votre organisation et leurs rôles d'accès"}</p>
    </div>
    <Button id="invite-open-btn" variant="modern" color="primary" icon={{ name: "mdi:account-plus", side: "left" }}>
      {to.inviteMember ?? "Inviter un membre"}
    </Button>
  </div>

  <div class="members-grid">
    <!-- Main content -->
    <div class="members-main">

      <!-- Stats -->
      <div class="stats-row">
        <Card variant="modern" elevation="sm">
          <CardContent>
            <div class="stat-compact">
              <Icon name="mdi:account-group" />
              <div>
                <span class="stat-num">{members.length}</span>
                <span class="stat-label">{to.members ?? "Membres"}</span>
              </div>
            </div>
          </CardContent>
        </Card>
        <Card variant="modern" elevation="sm">
          <CardContent>
            <div class="stat-compact stat-admin">
              <Icon name="mdi:shield-account" />
              <div>
                <span class="stat-num">{(roleCounts.admin ?? 0) + (roleCounts.owner ?? 0)}</span>
                <span class="stat-label">{to.admins ?? "Administrateurs"}</span>
              </div>
            </div>
          </CardContent>
        </Card>
        <Card variant="modern" elevation="sm">
          <CardContent>
            <div class="stat-compact stat-editor">
              <Icon name="mdi:pencil-outline" />
              <div>
                <span class="stat-num">{roleCounts.editor ?? 0}</span>
                <span class="stat-label">{to.editors ?? "Rédacteurs"}</span>
              </div>
            </div>
          </CardContent>
        </Card>
        <Card variant="modern" elevation="sm">
          <CardContent>
            <div class="stat-compact stat-invite">
              <Icon name="mdi:email-outline" />
              <div>
                <span class="stat-num">{pendingInvitations.length}</span>
                <span class="stat-label">{to.pendingInvitations ?? "Invitations en attente"}</span>
              </div>
            </div>
          </CardContent>
        </Card>
      </div>

      <!-- Filter toolbar -->
      <Card variant="modern" elevation="sm" class="filter-bar">
        <CardContent>
          <div class="filter-row">
            <div class="filter-field filter-search">
              <Label htmlFor="member-search">{to.searchMembers ?? "Rechercher"}</Label>
              <Input id="member-search" type="search" placeholder={to.searchMembers ?? "Rechercher un membre..."} icon="mdi:magnify" iconPosition="left" />
            </div>
            <div class="filter-field">
              <Label htmlFor="role-filter">{to.roleLabel ?? "Rôle"}</Label>
              <Select id="role-filter">
                <option value="">{to.allRoles ?? "Tous les rôles"}</option>
                {Object.entries(roleLabels).map(([val, label]) => (
                  <option value={val}>{label}</option>
                ))}
              </Select>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Members table -->
      <Card variant="modern" elevation="sm">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:account-group" /> {to.currentMembers ?? "Membres actuels"}</h2>
          <Table variant="modern" striped>
            <TableHeader>
              <TableRow>
                <TableHead>{to.member ?? "Membre"}</TableHead>
                <TableHead>{to.role ?? "Rôle"}</TableHead>
                <TableHead>{to.joinedAt ?? "Rejoint le"}</TableHead>
                <TableHead>{to.actions ?? "Actions"}</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {members.map(m => (
                <TableRow data-member-id={m.id}>
                  <TableCell>
                    <div class="member-cell">
                      {m.image ? (
                        <img src={m.image} alt={m.name} class="member-avatar" />
                      ) : (
                        <div class="member-avatar-placeholder">{m.name.charAt(0)}</div>
                      )}
                      <div>
                        <strong class="member-name">{m.name}</strong>
                        <small class="member-email">{m.email}</small>
                      </div>
                    </div>
                  </TableCell>
                  <TableCell>
                    <div class="role-selector" data-member-id={m.id}>
                      <Select id={`role-${m.id}`} className="role-select" data-current={m.role}>
                        {Object.entries(roleLabels).map(([val, label]) => (
                          <option value={val} selected={val === m.role}>{label}</option>
                        ))}
                      </Select>
                    </div>
                  </TableCell>
                  <TableCell className="date-cell">{m.createdAt.toLocaleDateString(lang, { day: "numeric", month: "short", year: "numeric" })}</TableCell>
                  <TableCell>
                    {m.role !== "owner" && (
                      <button class="btn-icon btn-danger remove-member-btn" data-member-id={m.id} data-name={m.name} title={to.removeMember ?? "Retirer"}>
                        <Icon name="mdi:account-remove" />
                      </button>
                    )}
                  </TableCell>
                </TableRow>
              ))}
            </TableBody>
          </Table>
          {members.length === 0 && (
            <div class="empty-state">
              <Icon name="mdi:account-off" />
              <p>{to.noMembers ?? "Aucun membre"}</p>
            </div>
          )}
        </CardContent>
      </Card>

      <!-- Pending invitations -->
      {pendingInvitations.length > 0 && (
        <Card variant="modern" elevation="sm">
          <CardContent>
            <h2 class="section-title"><Icon name="mdi:email-fast" /> {to.pendingInvitations ?? "Invitations en attente"}</h2>
            <Table variant="modern" striped>
              <TableHeader>
                <TableRow>
                  <TableHead>{to.email ?? "Email"}</TableHead>
                  <TableHead>{to.role ?? "Rôle"}</TableHead>
                  <TableHead>{to.sentAt ?? "Envoyée le"}</TableHead>
                  <TableHead>{to.expiresAt ?? "Expire le"}</TableHead>
                  <TableHead>{to.actions ?? "Actions"}</TableHead>
                </TableRow>
              </TableHeader>
              <TableBody>
                {pendingInvitations.map(inv => (
                  <TableRow data-invitation-id={inv.id}>
                    <TableCell><strong>{inv.email}</strong></TableCell>
                    <TableCell><Badge variant="modern" color={roleBadgeColor[inv.role ?? "member"] ?? "secondary"}>{roleLabels[inv.role ?? "member"] ?? inv.role}</Badge></TableCell>
                    <TableCell className="date-cell">{inv.createdAt.toLocaleDateString(lang, { day: "numeric", month: "short" })}</TableCell>
                    <TableCell className="date-cell">{inv.expiresAt.toLocaleDateString(lang, { day: "numeric", month: "short" })}</TableCell>
                    <TableCell>
                      <button class="btn-icon btn-danger cancel-invite-btn" data-inv-id={inv.id} title={to.cancelInvitation ?? "Annuler"}>
                        <Icon name="mdi:close-circle" />
                      </button>
                    </TableCell>
                  </TableRow>
                ))}
              </TableBody>
            </Table>
          </CardContent>
        </Card>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="members-sidebar">
      <!-- Role legend -->
      <Card variant="modern" elevation="sm">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:shield-account" /> {to.roleGuide ?? "Guide des rôles"}</h2>
          <div class="role-list">
            <div class="role-item">
              <Badge variant="modern" color="warning">{roleLabels.owner}</Badge>
              <small>{to.ownerDesc ?? "Accès complet, gestion de l'organisation"}</small>
            </div>
            <div class="role-item">
              <Badge variant="modern" color="primary">{roleLabels.admin}</Badge>
              <small>{to.adminDesc ?? "Gestion des membres, contenu, réservations"}</small>
            </div>
            <div class="role-item">
              <Badge variant="modern" color="secondary">{roleLabels.member}</Badge>
              <small>{to.memberDesc ?? "Accès en lecture, participation aux activités"}</small>
            </div>
            <div class="role-item">
              <Badge variant="modern" color="primary">{roleLabels.editor}</Badge>
              <small>{to.editorDesc ?? "Rédaction et édition du contenu blog"}</small>
            </div>
            <div class="role-item">
              <Badge variant="modern" color="success">{roleLabels.manager}</Badge>
              <small>{to.managerDesc ?? "Gestion des services et réservations"}</small>
            </div>
            <div class="role-item">
              <Badge variant="modern" color="accent">{roleLabels.translator}</Badge>
              <small>{to.translatorDesc ?? "Traduction du contenu multilingue"}</small>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Quick nav -->
      <Card variant="modern" elevation="sm">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:navigation" /> Navigation</h2>
          <nav class="sidebar-nav">
            <a href={`${adminBase}/organizations/dashboard`} class="sidebar-nav-link"><Icon name="mdi:view-dashboard" /> {to.dashboard ?? "Tableau de bord"}</a>
            <a href={`${adminBase}/organizations/profile`} class="sidebar-nav-link"><Icon name="mdi:badge-account-horizontal" /> {to.profile ?? "Profil"}</a>
            <a href={`${adminBase}/organizations/blog`} class="sidebar-nav-link"><Icon name="mdi:post-outline" /> Blog</a>
            <a href={`${adminBase}/organizations/bookings`} class="sidebar-nav-link"><Icon name="mdi:calendar-check" /> {to.bookings ?? "Réservations"}</a>
          </nav>
        </CardContent>
      </Card>
    </aside>
  </div>

  <!-- Invite modal -->
  <div class="modal-overlay" id="invite-modal" hidden>
    <div class="modal-card">
      <div class="modal-header">
        <h3>{to.inviteMember ?? "Inviter un membre"}</h3>
        <button class="modal-close" id="invite-close-btn" aria-label="Fermer">&times;</button>
      </div>
      <div class="modal-body">
        <div class="form-field">
          <Label htmlFor="inv-email">{to.emailAddress ?? "Adresse email"} *</Label>
          <Input type="email" id="inv-email" placeholder="nom@example.com" required />
        </div>
        <div class="form-field">
          <Label htmlFor="inv-role">{to.role ?? "Rôle"}</Label>
          <Select id="inv-role">
            <option value="member">{roleLabels.member}</option>
            <option value="editor">{roleLabels.editor}</option>
            <option value="manager">{roleLabels.manager}</option>
            <option value="translator">{roleLabels.translator}</option>
            <option value="admin">{roleLabels.admin}</option>
          </Select>
        </div>
      </div>
      <div class="modal-footer">
        <Button variant="modern" color="secondary" id="invite-cancel-btn">{to.cancel ?? "Annuler"}</Button>
        <Button variant="modern" color="primary" id="invite-send-btn" icon={{ name: "mdi:send", side: "left" }}>
          {to.sendInvitation ?? "Envoyer l'invitation"}
        </Button>
      </div>
    </div>
  </div>
</AdminLayout>

<script is:inline define:vars={{ orgId: activeOrgId }}>
  document.addEventListener("DOMContentLoaded", () => {
    const API = "/api/admin/organizations/members";
    const modal = document.getElementById("invite-modal");
    const toast = (msg, type = "info") => window.showToast ? window.showToast(msg, type) : alert(msg);

    // --- Invite modal ---
    document.getElementById("invite-open-btn")?.addEventListener("click", () => modal.hidden = false);
    document.getElementById("invite-close-btn")?.addEventListener("click", () => modal.hidden = true);
    document.getElementById("invite-cancel-btn")?.addEventListener("click", () => modal.hidden = true);
    modal?.addEventListener("click", e => { if (e.target === modal) modal.hidden = true; });

    document.getElementById("invite-send-btn")?.addEventListener("click", async () => {
      const email = document.getElementById("inv-email")?.value?.trim();
      const role = document.getElementById("inv-role")?.value ?? "member";
      if (!email) return toast("Email requis", "error");

      try {
        const res = await fetch(API, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ action: "invite", organizationId: orgId, email, role }),
        });
        if (!res.ok) throw new Error((await res.json()).error ?? "Failed");
        toast("Invitation envoyée !", "success");
        setTimeout(() => location.reload(), 600);
      } catch (e) { toast(e.message, "error"); }
    });

    // --- Role change ---
    document.querySelectorAll(".role-select").forEach(sel => {
      const original = sel.dataset.current;
      sel.addEventListener("change", async () => {
        const memberId = sel.closest("[data-member-id]").dataset.memberId;
        const role = sel.value;
        try {
          const res = await fetch(API, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "update-role", organizationId: orgId, memberId, role }),
          });
          if (!res.ok) throw new Error((await res.json()).error ?? "Failed");
          toast("Rôle mis à jour", "success");
          sel.dataset.current = role;
        } catch (e) {
          toast(e.message, "error");
          sel.value = original;
        }
      });
    });

    // --- Remove member ---
    document.querySelectorAll(".remove-member-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const { memberId, name } = btn.dataset;
        if (!confirm(`Retirer ${name} de l'organisation ?`)) return;
        try {
          const res = await fetch(API, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "remove-member", organizationId: orgId, memberId }),
          });
          if (!res.ok) throw new Error((await res.json()).error ?? "Failed");
          toast("Membre retiré", "success");
          setTimeout(() => location.reload(), 400);
        } catch (e) { toast(e.message, "error"); }
      });
    });

    // --- Cancel invitation ---
    document.querySelectorAll(".cancel-invite-btn").forEach(btn => {
      btn.addEventListener("click", async () => {
        const invId = btn.dataset.invId;
        if (!confirm("Annuler cette invitation ?")) return;
        try {
          const res = await fetch(API, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action: "cancel-invitation", organizationId: orgId, invitationId: invId }),
          });
          if (!res.ok) throw new Error((await res.json()).error ?? "Failed");
          toast("Invitation annulée", "success");
          setTimeout(() => location.reload(), 400);
        } catch (e) { toast(e.message, "error"); }
      });
    });

    // --- Client-side filter ---
    const searchInput = document.getElementById("member-search");
    const roleFilter = document.getElementById("role-filter");
    const rows = Array.from(document.querySelectorAll("tr.table-row")).filter(row => row.querySelector(".member-name"));

    function applyFilter() {
      const q = (searchInput?.value ?? "").toLowerCase();
      const role = roleFilter?.value ?? "";
      rows.forEach(row => {
        const name = (row.querySelector(".member-name")?.textContent ?? "").toLowerCase();
        const email = (row.querySelector(".member-email")?.textContent ?? "").toLowerCase();
        const memberRole = row.querySelector(".role-select")?.getAttribute("data-current") ?? "";
        const matchSearch = !q || name.includes(q) || email.includes(q);
        const matchRole = !role || memberRole === role;
        row.style.display = matchSearch && matchRole ? "" : "none";
      });
    }
    searchInput?.addEventListener("input", applyFilter);
    roleFilter?.addEventListener("change", applyFilter);
  });
</script>

<style>
  .admin-page-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .admin-page-title { font-size: 1.75rem; font-weight: 800; margin: 0; }
  .admin-page-description { font-size: 0.9375rem; color: var(--text-muted, #64748b); margin: 0.25rem 0 0; }

  .members-grid { display: grid; grid-template-columns: 1fr 300px; gap: 1.5rem; align-items: start; }
  .members-main { display: flex; flex-direction: column; gap: 1.5rem; }
  .members-sidebar { display: flex; flex-direction: column; gap: 1.5rem; }

  .stats-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .stat-compact { display: flex; align-items: center; gap: 0.75rem; }
  .stat-compact :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-primary, #eab308); }
  .stat-admin :global(svg) { color: #8b5cf6; }
  .stat-editor :global(svg) { color: #3b82f6; }
  .stat-invite :global(svg) { color: #f59e0b; }
  .stat-num { display: block; font-size: 1.5rem; font-weight: 800; line-height: 1; }
  .stat-label { font-size: 0.8125rem; color: var(--text-muted, #64748b); }

  .filter-bar { margin-bottom: 0; }
  .filter-row { display: flex; align-items: flex-end; gap: 1rem; }
  .filter-field { flex: 1; min-width: 180px; }
  .filter-search { flex: 2; }

  .section-title { font-size: 1rem; font-weight: 700; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1rem; }
  .section-title :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary, #eab308); }

  .member-cell { display: flex; align-items: center; gap: 0.75rem; }
  .member-avatar { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
  .member-avatar-placeholder { width: 36px; height: 36px; border-radius: 50%; background: var(--color-primary, #eab308); color: white; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; }
  .member-name { display: block; font-weight: 600; }
  .member-email { display: block; color: var(--text-muted, #64748b); font-size: 0.75rem; }
  .date-cell { font-size: 0.8125rem; color: var(--text-muted, #64748b); }

  .role-select { padding: 0.25rem 0.5rem; border-radius: 0.375rem; border: 1px solid var(--border-default, #e2e8f0); font-size: 0.8125rem; background: var(--bg-default, white); cursor: pointer; }

  .btn-icon { border: none; background: none; cursor: pointer; padding: 0.375rem; border-radius: 0.375rem; transition: background 0.15s; display: flex; align-items: center; justify-content: center; }
  .btn-icon :global(svg) { width: 1.125rem; height: 1.125rem; }
  .btn-danger { color: #ef4444; }
  .btn-danger:hover { background: #fef2f2; }

  .empty-state { padding: 2rem; text-align: center; color: var(--text-muted, #94a3b8); }
  .empty-state :global(svg) { width: 2.5rem; height: 2.5rem; margin-bottom: 0.5rem; }

  /* Role legend */
  .role-list { display: flex; flex-direction: column; gap: 0.75rem; }
  .role-item { display: flex; flex-direction: column; gap: 0.125rem; }
  .role-item small { color: var(--text-muted, #94a3b8); font-size: 0.75rem; }

  /* Sidebar nav */
  .sidebar-nav { display: flex; flex-direction: column; gap: 0.25rem; }
  .sidebar-nav-link { display: flex; align-items: center; gap: 0.5rem; padding: 0.5rem 0.75rem; border-radius: 0.375rem; text-decoration: none; color: var(--text-default, #0f172a); font-size: 0.875rem; transition: background 0.15s; }
  .sidebar-nav-link:hover { background: var(--bg-muted, #f1f5f9); color: var(--color-primary, #eab308); }
  .sidebar-nav-link :global(svg) { width: 1.125rem; height: 1.125rem; }

  /* Modal */
  .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 1000; display: flex; align-items: center; justify-content: center; }
  .modal-overlay[hidden] { display: none; }
  .modal-card { background: var(--bg-default, white); border-radius: 1rem; padding: 0; min-width: 420px; max-width: 90vw; box-shadow: 0 16px 48px rgba(0,0,0,0.2); }
  .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border-default, #e2e8f0); }
  .modal-header h3 { margin: 0; font-size: 1.125rem; font-weight: 700; }
  .modal-close { border: none; background: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted, #94a3b8); padding: 0.25rem; line-height: 1; }
  .modal-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1rem; }

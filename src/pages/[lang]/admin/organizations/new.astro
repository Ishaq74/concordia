---
// src/pages/[lang]/admin/organizations/new.astro — Create a new organization
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const to = t.adminOrganizations ?? ({} as Record<string, string>);
const adminBase = `/${lang}/admin`;
---

<AdminLayout title={to.newOrganization ?? "Nouvelle organisation"} activeSection="organizations">
  <div class="admin-page-header">
    <div>
      <a href={`${adminBase}/organizations`} class="back-link">
        <Icon name="mdi:arrow-left" /> {to.backToList ?? "Retour à la liste"}
      </a>
      <h1 class="admin-page-title">{to.newOrganization ?? "Nouvelle organisation"}</h1>
      <p class="admin-page-description">{to.newOrgDesc ?? "Créez une nouvelle organisation sur la plateforme"}</p>
    </div>
  </div>

  <!-- Stepper -->
  <div class="onboarding-stepper">
    <div class="stepper">
      <button class="stepper__step active" data-step="1">
        <span class="stepper__num">1</span>
        <span class="stepper__label">{to.stepIdentity ?? "Identité"}</span>
      </button>
      <div class="stepper__line"></div>
      <button class="stepper__step" data-step="2">
        <span class="stepper__num">2</span>
        <span class="stepper__label">{to.stepContact ?? "Contact & Adresse"}</span>
      </button>
      <div class="stepper__line"></div>
      <button class="stepper__step" data-step="3">
        <span class="stepper__num">3</span>
        <span class="stepper__label">{to.stepBranding ?? "Identité visuelle"}</span>
      </button>
    </div>
    <div class="stepper-progress">
      <div class="stepper-progress__bar" id="stepperBar" style="width:33%"></div>
    </div>
  </div>

  <div class="form-layout">
    <main class="form-main">
      <!-- Step 1: Identity -->
      <div class="wizard-step" data-wizard-step="1">
      <Card variant="modern" elevation="sm" class="form-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:domain" /> {to.identity ?? "Identité"}</h2>
          <div class="form-grid">
            <div class="form-field">
              <Label htmlFor="org-name">{to.name ?? "Nom"} *</Label>
              <Input type="text" id="org-name" required placeholder="Ex: Mon Organisation" />
            </div>
            <div class="form-field">
              <Label htmlFor="org-slug">{to.slug ?? "Slug"} *</Label>
              <Input type="text" id="org-slug" required placeholder="mon-organisation" />
            </div>
            <div class="form-field form-field--full">
              <Label htmlFor="org-desc">{to.descriptionLabel ?? "Description"}</Label>
              <Textarea id="org-desc" rows={3} />
            </div>
            <div class="form-field form-field--full">
              <Label htmlFor="org-slogan">{to.slogan ?? "Slogan"}</Label>
              <Input type="text" id="org-slogan" placeholder="Notre mission en une phrase" />
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Contact -->
      </div>
      <div class="wizard-step" data-wizard-step="2" style="display:none">
      <Card variant="modern" elevation="sm" class="form-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:card-account-phone" /> {to.contact ?? "Contact"}</h2>
          <div class="form-grid">
            <div class="form-field">
              <Label htmlFor="org-email">{to.email ?? "Email"}</Label>
              <Input type="email" id="org-email" placeholder="contact@example.com" />
            </div>
            <div class="form-field">
              <Label htmlFor="org-phone">{to.phone ?? "Téléphone"}</Label>
              <Input type="tel" id="org-phone" placeholder="+33 4 50 00 00 00" />
            </div>
            <div class="form-field">
              <Label htmlFor="org-url">{to.website ?? "Site web"}</Label>
              <Input type="url" id="org-url" placeholder="https://example.com" />
            </div>
            <div class="form-field">
              <Label htmlFor="org-legal">{to.legalName ?? "Raison sociale"}</Label>
              <Input type="text" id="org-legal" />
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Address -->
      <Card variant="modern" elevation="sm" class="form-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:map-marker" /> {to.addressLabel ?? "Adresse"}</h2>
          <div class="form-grid">
            <div class="form-field form-field--full">
              <Label htmlFor="org-address">{to.streetAddress ?? "Rue"}</Label>
              <Input type="text" id="org-address" />
            </div>
            <div class="form-field">
              <Label htmlFor="org-city">{to.city ?? "Ville"}</Label>
              <Input type="text" id="org-city" />
            </div>
            <div class="form-field">
              <Label htmlFor="org-zip">{to.postalCode ?? "Code postal"}</Label>
              <Input type="text" id="org-zip" />
            </div>
            <div class="form-field">
              <Label htmlFor="org-country">{to.country ?? "Pays"}</Label>
              <Input type="text" id="org-country" value="FR" />
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Branding -->
      </div>
      <div class="wizard-step" data-wizard-step="3" style="display:none">
      <Card variant="modern" elevation="sm" class="form-section">
        <CardContent>
          <h2 class="section-title"><Icon name="mdi:palette" /> {to.branding ?? "Identité visuelle"}</h2>
          <div class="form-grid">
            <div class="form-field">
              <Label htmlFor="org-logo">{to.logoUrl ?? "URL du logo"}</Label>
              <Input type="url" id="org-logo" placeholder="https://..." />
            </div>
            <div class="form-field">
              <Label htmlFor="org-image">{to.coverUrl ?? "URL de couverture"}</Label>
              <Input type="url" id="org-image" placeholder="https://..." />
            </div>
          </div>
        </CardContent>
      </Card>
      </div>
    </main>

    <aside class="form-sidebar">
      <!-- Live Preview -->
      <Card variant="modern" elevation="sm" class="sticky-card">
        <CardContent>
          <h3 class="sidebar-title"><Icon name="mdi:eye-outline" /> Aperçu</h3>
          <div class="preview-card" id="livePreview">
            <div class="preview-cover" id="previewCover"></div>
            <div class="preview-logo" id="previewLogo">
              <Icon name="mdi:domain" />
            </div>
            <div class="preview-body">
              <h4 class="preview-name" id="previewName">Mon Organisation</h4>
              <p class="preview-slug" id="previewSlug">@mon-organisation</p>
              <p class="preview-desc" id="previewDesc">Description de l'organisation</p>
              <div class="preview-location" id="previewLocation">
                <Icon name="mdi:map-marker-outline" />
                <span id="previewCity">Ville, FR</span>
              </div>
            </div>
          </div>
        </CardContent>
      </Card>

      <!-- Actions -->
      <Card variant="modern" elevation="sm" class="sticky-card" style="margin-top:1rem">
        <CardContent>
          <h3 class="sidebar-title"><Icon name="mdi:content-save" /> {to.actions ?? "Actions"}</h3>
          <div class="wizard-nav">
            <button id="prevStep" class="wizard-btn wizard-btn--secondary" style="display:none">
              <Icon name="mdi:arrow-left" /> Précédent
            </button>
            <button id="nextStep" class="wizard-btn wizard-btn--primary">
              Suivant <Icon name="mdi:arrow-right" />
            </button>
          </div>
          <Button id="create-org-btn" variant="modern" color="primary" className="btn-full" style="display:none">
            <Icon name="mdi:plus-circle" /> {to.createOrganization ?? "Créer l'organisation"}
          </Button>
          <a href={`${adminBase}/organizations`} class="btn-cancel">{to.cancel ?? "Annuler"}</a>
        </CardContent>
      </Card>
    </aside>
  </div>
</AdminLayout>

<script>
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    const nameEl = document.getElementById("org-name") as HTMLInputElement;
    const slugEl = document.getElementById("org-slug") as HTMLInputElement;

    // Auto-generate slug from name
    let slugManuallyEdited = false;
    slugEl?.addEventListener("input", () => { slugManuallyEdited = true; });
    nameEl?.addEventListener("input", () => {
      if (!slugManuallyEdited) {
        slugEl.value = nameEl.value
          .toLowerCase()
          .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/(^-|-$)/g, "");
      }
    });

    // === Wizard navigation ===
    let currentStep = 1;
    const totalSteps = 3;
    const steps = document.querySelectorAll<HTMLElement>(".wizard-step");
    const stepBtns = document.querySelectorAll<HTMLElement>(".stepper__step");
    const bar = document.getElementById("stepperBar") as HTMLElement;
    const prevBtn = document.getElementById("prevStep") as HTMLElement;
    const nextBtn = document.getElementById("nextStep") as HTMLElement;
    const createBtn = document.getElementById("create-org-btn") as HTMLElement;

    function goToStep(n: number) {
      if (n < 1 || n > totalSteps) return;
      currentStep = n;
      steps.forEach(s => { s.style.display = s.dataset.wizardStep === String(n) ? "block" : "none"; });
      stepBtns.forEach(b => {
        const sn = Number(b.dataset.step);
        b.classList.toggle("active", sn === n);
        b.classList.toggle("done", sn < n);
      });
      bar.style.width = `${(n / totalSteps) * 100}%`;
      prevBtn.style.display = n > 1 ? "inline-flex" : "none";
      nextBtn.style.display = n < totalSteps ? "inline-flex" : "none";
      createBtn.style.display = n === totalSteps ? "flex" : "none";
    }

    prevBtn?.addEventListener("click", () => goToStep(currentStep - 1));
    nextBtn?.addEventListener("click", () => goToStep(currentStep + 1));
    stepBtns.forEach(b => b.addEventListener("click", () => goToStep(Number(b.dataset.step))));

    // === Live preview ===
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value?.trim() ?? "";

    function updatePreview() {
      const name = val("org-name") || "Mon Organisation";
      const slug = val("org-slug") || "mon-organisation";
      const desc = val("org-desc") || "Description de l'organisation";
      const city = val("org-city") || "Ville";
      const country = val("org-country") || "FR";
      const logo = val("org-logo");
      const cover = val("org-image");

      const pName = document.getElementById("previewName");
      const pSlug = document.getElementById("previewSlug");
      const pDesc = document.getElementById("previewDesc");
      const pCity = document.getElementById("previewCity");
      const pLogo = document.getElementById("previewLogo");
      const pCover = document.getElementById("previewCover");

      if (pName) pName.textContent = name;
      if (pSlug) pSlug.textContent = `@${slug}`;
      if (pDesc) pDesc.textContent = desc;
      if (pCity) pCity.textContent = `${city}, ${country}`;
      if (pCover) pCover.style.backgroundImage = cover ? `url(${cover})` : "";
      if (pLogo) {
        if (logo) {
          pLogo.innerHTML = `<img src="${logo}" alt="Logo" style="width:100%;height:100%;object-fit:cover;border-radius:50%"/>`;
        }
      }
    }

    ["org-name","org-slug","org-desc","org-city","org-country","org-logo","org-image"].forEach(id => {
      document.getElementById(id)?.addEventListener("input", updatePreview);
    });

    // === Create organization ===
    createBtn?.addEventListener("click", async () => {
      const name = val("org-name");
      const slug = val("org-slug");
      if (!name || !slug) { showToast("Nom et slug requis", "error"); goToStep(1); return; }

      const body = {
        action: "create",
        name,
        slug,
        description: val("org-desc") ? { fr: val("org-desc") } : null,
        slogan: val("org-slogan") ? { fr: val("org-slogan") } : null,
        email: val("org-email") || null,
        telephone: val("org-phone") || null,
        url: val("org-url") || null,
        legalName: val("org-legal") ? { fr: val("org-legal") } : null,
        address: {
          streetAddress: val("org-address"),
          addressLocality: val("org-city"),
          postalCode: val("org-zip"),
          addressCountry: val("org-country"),
        },
        logo: val("org-logo") || null,
        image: val("org-image") || null,
      };

      try {
        const res = await fetch("/api/admin/organizations/profile", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(body),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error ?? "Failed");
        showToast("Organisation créée !", "success");
        setTimeout(() => {
          window.location.href = window.location.pathname.replace(/\/new$/, `/${data.organization.id}`);
        }, 600);
      } catch (e: any) {
        showToast(e.message, "error");
      }
    });
  });
</script>

<style>
  .admin-page-header { margin-bottom: 1.5rem; }
  .back-link { display: inline-flex; align-items: center; gap: 0.375rem; font-size: 0.8125rem; color: var(--text-muted, #64748b); text-decoration: none; margin-bottom: 0.5rem; }
  .back-link:hover { color: var(--color-primary, #eab308); }
  .back-link :global(svg) { width: 1rem; height: 1rem; }
  .admin-page-title { font-size: 1.75rem; font-weight: 800; margin: 0; }
  .admin-page-description { font-size: 0.9375rem; color: var(--text-muted, #64748b); margin: 0.25rem 0 0; }

  /* Stepper */
  .onboarding-stepper { margin-bottom: 2rem; }
  .stepper { display: flex; align-items: center; justify-content: center; gap: 0; }
  .stepper__step {
    display: flex; align-items: center; gap: 0.5rem;
    background: none; border: none; cursor: pointer;
    padding: 0.5rem 1rem; border-radius: 999px;
    font-size: 0.875rem; font-weight: 600;
    color: var(--text-muted, #64748b);
    transition: all 0.2s;
  }
  .stepper__step.active { color: var(--color-primary, #eab308); }
  .stepper__step.done { color: var(--color-success, #22c55e); }
  .stepper__num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 1.75rem; height: 1.75rem; border-radius: 50%;
    background: var(--color-surface, #f1f5f9); border: 2px solid var(--border, #e2e8f0);
    font-size: 0.75rem; font-weight: 700; transition: all 0.2s;
  }
  .stepper__step.active .stepper__num { background: var(--color-primary, #eab308); color: #fff; border-color: var(--color-primary, #eab308); }
  .stepper__step.done .stepper__num { background: var(--color-success, #22c55e); color: #fff; border-color: var(--color-success, #22c55e); }
  .stepper__line { width: 3rem; height: 2px; background: var(--border, #e2e8f0); }
  .stepper-progress { height: 4px; background: var(--color-surface, #f1f5f9); border-radius: 999px; margin-top: 1rem; overflow: hidden; }
  .stepper-progress__bar { height: 100%; background: var(--color-primary, #eab308); border-radius: 999px; transition: width 0.4s ease; }

  .form-layout { display: grid; grid-template-columns: 1fr 320px; gap: 1.5rem; align-items: start; }
  .form-main { display: flex; flex-direction: column; gap: 1.5rem; }
  .section-title { font-size: 1.125rem; font-weight: 700; margin: 0 0 1rem; display: flex; align-items: center; gap: 0.5rem; }
  .section-title :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary, #eab308); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .form-field { display: flex; flex-direction: column; gap: 0.375rem; }
  .form-field--full { grid-column: 1 / -1; }

  .sticky-card { position: sticky; top: 1rem; }
  .sidebar-title { font-size: 1rem; font-weight: 700; margin: 0 0 1rem; display: flex; align-items: center; gap: 0.5rem; }
  .sidebar-title :global(svg) { width: 1.125rem; height: 1.125rem; color: var(--color-primary, #eab308); }
  .btn-full { width: 100%; justify-content: center; }
  .btn-cancel { display: block; text-align: center; margin-top: 0.75rem; font-size: 0.875rem; color: var(--text-muted, #64748b); text-decoration: underline; }

  /* Wizard nav */
  .wizard-nav { display: flex; gap: 0.5rem; margin-bottom: 0.75rem; }
  .wizard-btn {
    display: inline-flex; align-items: center; gap: 0.375rem;
    padding: 0.5rem 1rem; border-radius: 0.5rem; font-size: 0.875rem; font-weight: 600;
    border: none; cursor: pointer; transition: all 0.2s;
  }
  .wizard-btn :global(svg) { width: 1rem; height: 1rem; }
  .wizard-btn--primary { background: var(--color-primary, #eab308); color: #fff; flex: 1; justify-content: center; }
  .wizard-btn--primary:hover { filter: brightness(1.1); }
  .wizard-btn--secondary { background: var(--color-surface, #f1f5f9); color: var(--color-text, #0f172a); }
  .wizard-btn--secondary:hover { background: var(--border, #e2e8f0); }

  /* Live preview */
  .preview-card { border: 1px solid var(--border, #e2e8f0); border-radius: 0.75rem; overflow: hidden; }
  .preview-cover { height: 80px; background: linear-gradient(135deg, var(--color-primary, #eab308) 0%, #f59e0b 100%); background-size: cover; background-position: center; }
  .preview-logo {
    width: 3rem; height: 3rem; border-radius: 50%;
    background: #fff; border: 3px solid #fff;
    display: flex; align-items: center; justify-content: center;
    margin: -1.5rem auto 0; position: relative; z-index: 1;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1); overflow: hidden;
  }
  .preview-logo :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-primary, #eab308); }
  .preview-body { padding: 0.75rem 1rem 1rem; text-align: center; }
  .preview-name { font-size: 0.9375rem; font-weight: 700; margin: 0; }
  .preview-slug { font-size: 0.75rem; color: var(--text-muted, #64748b); margin: 0.125rem 0 0.5rem; }
  .preview-desc { font-size: 0.8125rem; color: var(--color-text, #0f172a); margin: 0 0 0.5rem; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .preview-location { display: flex; align-items: center; justify-content: center; gap: 0.25rem; font-size: 0.75rem; color: var(--text-muted, #64748b); }
  .preview-location :global(svg) { width: 0.875rem; height: 0.875rem; }

  @media (max-width: 768px) {
    .form-layout { grid-template-columns: 1fr; }
    .form-grid { grid-template-columns: 1fr; }
    .stepper { flex-wrap: wrap; gap: 0.5rem; }
    .stepper__line { width: 1.5rem; }
  }
</style>

---
// src/pages/[lang]/citizens/index.astro — Citizen census / directory
import BaseLayout from "@layouts/BaseLayout.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Pagination from "@components/ui/Pagination.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";
import { getDrizzle } from "@database/drizzle";
import { user as userTable, organization } from "@database/schemas/auth-schema";
import { profile } from "@database/schemas/profile.schema";
import { servicesListings } from "@database/schemas";
import { eq, ilike, or, count, desc, and } from "drizzle-orm";

export const prerender = false;

const lang = Astro.params.lang as string;
const t = getTranslations(lang);
const db = await getDrizzle();

const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") || "1"));
const search = Astro.url.searchParams.get("q") || "";
const roleFilter = Astro.url.searchParams.get("role") || "";
const perPage = 12;
const offset = (page - 1) * perPage;

// Build filters
const conditions = [eq(userTable.banned, false)];
if (search) {
  const pattern = `%${search}%`;
  conditions.push(or(
    ilike(userTable.name, pattern),
    ilike(userTable.username, pattern),
    ilike(profile.bio, pattern),
    ilike(profile.location, pattern),
  )!);
}
if (roleFilter) {
  conditions.push(eq(userTable.role, roleFilter));
}

// Parallel data fetch
const [citizensResult, totalResult, statsResult] = await Promise.all([
  db.select({
    id: userTable.id,
    name: userTable.name,
    username: userTable.username,
    image: userTable.image,
    role: userTable.role,
    createdAt: userTable.createdAt,
    bio: profile.bio,
    location: profile.location,
    website: profile.website,
  })
  .from(userTable)
  .leftJoin(profile, eq(profile.userId, userTable.id))
  .where(and(...conditions))
  .orderBy(desc(userTable.createdAt))
  .limit(perPage)
  .offset(offset),

  db.select({ count: count() })
  .from(userTable)
  .leftJoin(profile, eq(profile.userId, userTable.id))
  .where(and(...conditions)),

  Promise.all([
    db.select({ count: count() }).from(userTable).where(eq(userTable.banned, false)),
    db.select({ count: count() }).from(organization),
    db.select({ count: count() }).from(servicesListings).where(eq(servicesListings.status, "active")),
  ]),
]);

const citizens = citizensResult;
const total = totalResult[0]?.count ?? 0;
const totalPages = Math.ceil(total / perPage);
const totalCitizens = statsResult[0][0]?.count ?? 0;
const totalOrgs = statsResult[1][0]?.count ?? 0;
const totalServices = statsResult[2][0]?.count ?? 0;

const districts = [
  { key: "cartography", icon: "mdi:map-outline", label: t.citizens?.districtMap ?? "Cartographie" },
  { key: "mediation", icon: "mdi:account-voice", label: t.citizens?.districtMediation ?? "Médiation" },
  { key: "skills", icon: "mdi:tools", label: t.citizens?.districtSkills ?? "Compétences" },
  { key: "education", icon: "mdi:school-outline", label: t.citizens?.districtEducation ?? "Éducation" },
];

const roles = [
  { value: "", label: t.citizens?.allRoles ?? "Tous les rôles" },
  { value: "user", label: t.citizens?.roleUser ?? "Citoyen" },
  { value: "admin", label: t.citizens?.roleAdmin ?? "Administrateur" },
];

function roleLabel(role: string) {
  const map: Record<string, string> = { admin: "Administrateur", user: "Citoyen", moderator: "Modérateur" };
  return map[role] || role;
}
function roleColor(role: string): "default" | "primary" | "secondary" | "accent" | "success" | "warning" | "error" {
  const map: Record<string, "default" | "primary" | "secondary" | "accent" | "success" | "warning" | "error"> = { admin: "accent", user: "secondary", moderator: "primary" };
  return map[role] || "secondary";
}

// Pagination URL
const filterParams = new URLSearchParams();
if (search) filterParams.set("q", search);
if (roleFilter) filterParams.set("role", roleFilter);
const paginationBase = `/${lang}/citizens?${filterParams.toString()}${filterParams.toString() ? "&" : ""}page=`;
---

<BaseLayout title={t.citizens?.metaTitle ?? "Recensement de la Cité — Concordia"} lang={lang}>
  <main class="citizens-page">
    <div class="citizens-container">

      <!-- Hero -->
      <section class="citizens-hero">
        <h1 class="citizens-hero__title">{t.citizens?.title ?? "Recensement de la Cité"}</h1>
        <p class="citizens-hero__subtitle">
          {t.citizens?.subtitle ?? "Chaque citoyen est un fil unique dans le tissu de Concordia. Votre présence renforce notre œuvre collective et nourrit la concorde de notre cité-état."}
        </p>
      </section>

      <!-- Stats -->
      <section class="citizens-stats">
        <div class="stat-card">
          <div class="stat-icon stat-icon--primary">
            <Icon name="mdi:account-group-outline" />
          </div>
          <div class="stat-info">
            <span class="stat-label">{t.citizens?.statCitizens ?? "Citoyens enregistrés"}</span>
            <span class="stat-value">{totalCitizens.toLocaleString("fr-FR")}</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon stat-icon--secondary">
            <Icon name="mdi:domain" />
          </div>
          <div class="stat-info">
            <span class="stat-label">{t.citizens?.statOrgs ?? "Organisations actives"}</span>
            <span class="stat-value">{totalOrgs.toLocaleString("fr-FR")}</span>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon stat-icon--accent">
            <Icon name="mdi:hand-heart-outline" />
          </div>
          <div class="stat-info">
            <span class="stat-label">{t.citizens?.statServices ?? "Services proposés"}</span>
            <span class="stat-value">{totalServices.toLocaleString("fr-FR")}</span>
          </div>
        </div>
      </section>

      <!-- Search & Filters -->
      <section class="citizens-search">
        <form method="get" class="search-form">
          <div class="filter-field filter-search">
            <Label htmlFor="q">{t.citizens?.searchLabel ?? "Rechercher"}</Label>
            <Input id="q" name="q" type="search" placeholder={t.citizens?.searchPlaceholder ?? "Rechercher un citoyen, un talent ou un district..."} value={search} icon="mdi:magnify" iconPosition="left" />
          </div>
          <div class="search-filters">
            <div class="filter-field">
              <Label htmlFor="role">{t.citizens?.roleLabel ?? "Rôle"}</Label>
              <Select id="role" name="role">
                {roles.map(r => (
                  <option value={r.value} selected={roleFilter === r.value}>{r.label}</option>
                ))}
              </Select>
            </div>
            <Button type="submit" color="primary" icon={{ name: "mdi:magnify", side: "left" }}>
              {t.citizens?.filterBtn ?? "Filtrer"}
            </Button>
          </div>
        </form>
      </section>

      <!-- District chips -->
      <div class="district-chips">
        {districts.map(d => (
          <span class="district-chip">
            <Icon name={d.icon} />
            {d.label}
          </span>
        ))}
      </div>

      <!-- Citizens Grid -->
      {citizens.length > 0 ? (
        <section class="citizens-grid">
          {citizens.map(c => (
            <a href={`/${lang}/citizens/${c.username || c.id}`} class="citizen-card">
              <div class="citizen-card__header">
                <div class="citizen-avatar">
                  {c.image ? (
                    <img src={c.image} alt={c.name || ""} loading="lazy" />
                  ) : (
                    <Icon name="mdi:account" />
                  )}
                </div>
                <Badge variant="retro" color={roleColor(c.role || "user")}>
                  {roleLabel(c.role || "user")}
                </Badge>
              </div>
              <h3 class="citizen-name">{c.name || c.username || "Citoyen anonyme"}</h3>
              {c.location && (
                <p class="citizen-location">
                  <Icon name="mdi:map-marker-outline" />
                  {c.location}
                </p>
              )}
              {c.bio && <p class="citizen-bio">{c.bio.slice(0, 100)}{c.bio.length > 100 ? "..." : ""}</p>}
              <div class="citizen-card__footer">
                <span class="citizen-cta">{t.citizens?.viewProfile ?? "Voir le profil"}</span>
              </div>
            </a>
          ))}
        </section>
      ) : (
        <div class="citizens-empty">
          <Icon name="mdi:account-search-outline" />
          <h3>{t.citizens?.noResults ?? "Aucun citoyen trouvé"}</h3>
          <p>{t.citizens?.noResultsHint ?? "Essayez avec d'autres critères de recherche."}</p>
        </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <div class="citizens-pagination">
          <p class="pagination-info">
            {t.citizens?.showing ?? "Affichage de"} <strong>{offset + 1} - {Math.min(offset + perPage, total)}</strong> {t.citizens?.of ?? "sur"} <strong>{total}</strong>
          </p>
          <Pagination currentPage={page} totalPages={totalPages} baseUrl={paginationBase} showPrevNext showFirstLast color="primary" />
        </div>
      )}
    </div>
  </main>
</BaseLayout>

<style>
  .citizens-page {
    padding: var(--space-6) var(--space-4);
    min-height: 70vh;
  }
  .citizens-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* Hero */
  .citizens-hero { max-width: 720px; }
  .citizens-hero__title {
    font-size: var(--text-4xl, 2.25rem);
    font-weight: 900;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin-bottom: var(--space-3);
  }
  .citizens-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Stats */
  .citizens-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-4);
  }
  .stat-card {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-surface, #fff);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .stat-icon {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .stat-icon [data-icon] { width: 1.75rem; height: 1.75rem; }
  .stat-icon--primary { background: color-mix(in srgb, var(--color-primary) 10%, transparent); color: var(--color-primary); }
  .stat-icon--secondary { background: color-mix(in srgb, var(--color-secondary, #6b7280) 10%, transparent); color: var(--color-secondary, #6b7280); }
  .stat-icon--accent { background: color-mix(in srgb, var(--color-accent, #8da399) 10%, transparent); color: var(--color-accent, #8da399); }
  .stat-info { display: flex; flex-direction: column; }
  .stat-label { font-size: var(--text-xs); font-weight: 500; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: 0.05em; }
  .stat-value { font-size: var(--text-2xl); font-weight: 700; color: var(--color-text); }

  /* Search */
  .citizens-search {
    background: var(--color-surface, #fff);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
  }
  .search-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .filter-field { flex: 1; min-width: 180px; }
  .filter-search { flex: 2; }
  .search-filters {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    align-items: flex-end;
  }

  /* District chips */
  .district-chips {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }
  .district-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 15%, transparent);
    border-radius: var(--radius-full, 9999px);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .district-chip [data-icon] { width: 0.875rem; height: 0.875rem; }

  /* Grid */
  .citizens-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--space-5);
  }

  /* Citizen card */
  .citizen-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface, #fff);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .citizen-card:hover {
    border-color: color-mix(in srgb, var(--color-primary) 30%, transparent);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }
  .citizen-card__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }
  .citizen-avatar {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--color-primary);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-primary) 10%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-primary) 10%, transparent);
    color: var(--color-primary);
  }
  .citizen-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .citizen-avatar [data-icon] { width: 2rem; height: 2rem; }
  .citizen-name {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-1);
    transition: color 0.2s;
  }
  .citizen-card:hover .citizen-name { color: var(--color-primary); }
  .citizen-location {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
  }
  .citizen-location [data-icon] { width: 0.875rem; height: 0.875rem; }
  .citizen-bio {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin-bottom: var(--space-4);
    flex: 1;
  }
  .citizen-card__footer { margin-top: auto; }
  .citizen-cta {
    display: block;
    text-align: center;
    padding: var(--space-2);
    background: color-mix(in srgb, var(--color-primary) 5%, transparent);
    border-radius: var(--radius);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: all 0.2s;
  }
  .citizen-card:hover .citizen-cta {
    background: var(--color-primary);
    color: #fff;
  }

  /* Empty */
  .citizens-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-12) var(--space-4);
    color: var(--color-text-muted);
    gap: var(--space-3);
  }
  .citizens-empty [data-icon] { width: 3rem; height: 3rem; opacity: 0.5; }
  .citizens-empty h3 { font-size: var(--text-lg); font-weight: 600; color: var(--color-text); }

  /* Pagination */
  .citizens-pagination {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .pagination-info { font-size: var(--text-sm); color: var(--color-text-muted); }
  .pagination-info strong { color: var(--color-text); }

  @media (min-width: 768px) {
    .search-form { flex-direction: row; align-items: flex-end; }
  }
</style>

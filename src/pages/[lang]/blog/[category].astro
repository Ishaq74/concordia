---
// src/pages/[lang]/blog/[category].astro
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import BannerPage from "@templates/BannerPage.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import { Icon } from "astro-icon/components";
import { getTranslations } from "@i18n/translations";
// import { getLocalizedUrl } from "@lib/i18n/route-helpers"; // unused

export const prerender = true;

export async function getStaticPaths() {
  const locales = ["fr", "en", "es", "ar"];
  const allPosts = await getCollection("blog");

  return locales.flatMap((lang) => {
    const langPosts = allPosts.filter((p) => p.data.lang === lang);
    const categories = new Map<string, string>();
    langPosts.forEach((post) => {
      post.data.categories.forEach((cat: any) => {
        if (!categories.has(cat.slug)) {
          categories.set(cat.slug, cat.name);
        }
      });
    });

    return Array.from(categories.entries()).map(([slug, name]) => ({
      params: { lang, category: slug },
      props: { name },
    }));
  });
}

const { category } = Astro.params;
const { name } = Astro.props;
const lang = Astro.params.lang as string;
const LANG = lang;

const t = getTranslations(lang);

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((p) => p.data.lang === LANG)
  .filter((p) => p.data.categories.some((c: any) => c.slug === category))
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt || 0).getTime() -
      new Date(a.data.publishedAt || 0).getTime(),
  );

// --- All categories (sidebar) ---
const catMap = new Map<string, { name: string; slug: string; count: number }>();
allPosts
  .filter((p) => p.data.lang === LANG)
  .forEach((post) => {
    (post.data.categories ?? []).forEach((cat: any) => {
      const existing = catMap.get(cat.slug);
      if (existing) existing.count++;
      else catMap.set(cat.slug, { name: cat.name, slug: cat.slug, count: 1 });
    });
  });
const allCategories = Array.from(catMap.values()).sort((a, b) => b.count - a.count);

// --- Featured post ---
const featuredPost = posts.find((p) => p.data.isFeatured) ?? posts[0];
const featuredCat = featuredPost?.data.categories?.[0];
const featuredLink = featuredCat
  ? `/${LANG}/blog/${featuredCat.slug}/${featuredPost.data.slug}`
  : `/${LANG}/blog/${featuredPost?.data.slug}`;

// --- Remaining posts ---
const remainingPosts = posts.filter((p) => p.data.id !== featuredPost?.data.id);

// --- Popular tags ---
const tagMap = new Map<string, number>();
posts.forEach((p) => {
  (p.data.categories ?? []).forEach((c: any) => {
    tagMap.set(c.name, (tagMap.get(c.name) || 0) + 1);
  });
});
const popularTags = Array.from(tagMap.entries())
  .sort((a, b) => b[1] - a[1])
  .slice(0, 10);
---

<BaseLayout
  title={`${name} — ${t.blog?.title ?? "Blog"}`}
  description={`${posts.length} ${t.blog?.categoryAllArticles ?? "articles dans cette catégorie"}`}
  lang={LANG}
>
  <BannerPage
    title={name}
    subtitle={`${posts.length} ${t.blog?.categoryAllArticles ?? "articles dans cette catégorie"}`}
    description={t.blog?.categorySubtitle ?? "Découvrez les projets et idées qui transforment notre communauté."}
    type="category"
    color="accent"
    breadcrumbs={[
      { label: t.blog?.title ?? "Blog", href: `/${LANG}/blog` },
    ]}
  />

  <main class="cat-page">

    {/* ===== FEATURED POST HERO ===== */}
    {featuredPost && (
      <section class="cat-featured" aria-label={t.blog?.categoryFeatured ?? "À la une"}>
        <a href={featuredLink} class="cat-featured__link">
          <div class="cat-featured__img-wrap">
            {featuredPost.data.cover?.url ? (
              <img
                src={featuredPost.data.cover.url}
                alt={featuredPost.data.cover.alt || featuredPost.data.title}
                class="cat-featured__img"
                loading="eager"
              />
            ) : (
              <div class="cat-featured__placeholder">
                <Icon name="mdi:image-outline" />
              </div>
            )}
            <div class="cat-featured__overlay" />
          </div>
          <div class="cat-featured__content">
            <Badge variant="retro" color="accent">{t.blog?.categoryFeatured ?? "À la une"}</Badge>
            {featuredPost.data.publishedAt && (
              <time class="cat-featured__date" datetime={featuredPost.data.publishedAt.toISOString()}>
                {featuredPost.data.publishedAt.toLocaleDateString(LANG, { day: "numeric", month: "long", year: "numeric" })}
              </time>
            )}
            <h2 class="cat-featured__title">{featuredPost.data.title}</h2>
            {featuredPost.data.excerpt && (
              <p class="cat-featured__excerpt">{featuredPost.data.excerpt}</p>
            )}
          </div>
        </a>
      </section>
    )}

    {/* ===== MAIN GRID: FEED + SIDEBAR ===== */}
    <div class="cat-grid">

      {/* --- Main Feed --- */}
      <section class="cat-grid__main" aria-label={t.blog?.categoryRecent ?? "Articles récents"}>
        <h2 class="cat-section-title">
          <Icon name="mdi:newspaper-variant-outline" /> {t.blog?.categoryRecent ?? "Articles récents"}
        </h2>

        {remainingPosts.length > 0 ? (
          <div class="cat-feed">
            {remainingPosts.map((post) => {
              const cat = post.data.categories?.[0];
              const link = cat
                ? `/${LANG}/blog/${cat.slug}/${post.data.slug}`
                : `/${LANG}/blog/${post.data.slug}`;
              return (
                <article class="cat-feed__item">
                  <a href={link} class="cat-feed__img-wrap" aria-hidden="true" tabindex="-1">
                    {post.data.cover?.url ? (
                      <img src={post.data.cover.url} alt="" class="cat-feed__img" loading="lazy" />
                    ) : (
                      <div class="cat-feed__placeholder">
                        <Icon name="mdi:image-outline" />
                      </div>
                    )}
                  </a>
                  <div class="cat-feed__body">
                    {cat && (
                      <span class="cat-feed__category">{cat.name}</span>
                    )}
                    <a href={link} class="cat-feed__title-link">
                      <h3 class="cat-feed__title">{post.data.title}</h3>
                    </a>
                    {post.data.excerpt && (
                      <p class="cat-feed__excerpt">{post.data.excerpt}</p>
                    )}
                    <div class="cat-feed__meta">
                      {post.data.readingTime && (
                        <span><Icon name="mdi:clock-outline" /> {post.data.readingTime}</span>
                      )}
                      {post.data.authors?.[0] && (
                        <span class="cat-feed__author">
                          {post.data.authors[0].avatar && (
                            <img src={post.data.authors[0].avatar} alt="" class="cat-feed__author-avatar" />
                          )}
                          {post.data.authors[0].name}
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>
        ) : (
          <div class="cat-empty">
            <Icon name="mdi:text-box-remove-outline" />
            <p>{t.blog?.categoryEmpty ?? "Aucun autre article dans cette catégorie pour le moment."}</p>
          </div>
        )}
      </section>

      {/* --- Sidebar --- */}
      <aside class="cat-grid__sidebar">

        {/* Categories */}
        <Card variant="retro" elevation="sm">
          <CardContent>
            <h3 class="sidebar-title">
              <Icon name="mdi:tag-multiple-outline" /> {t.blog?.categorySidebar ?? "Catégories"}
            </h3>
            <ul class="sidebar-categories">
              {allCategories.map((cat) => (
                <li>
                  <a
                    href={`/${LANG}/blog/${cat.slug}`}
                    class:list={["sidebar-cat-link", { active: cat.slug === category }]}
                    aria-current={cat.slug === category ? "page" : undefined}
                  >
                    <span>{cat.name}</span>
                    <Badge variant="retro" color={cat.slug === category ? "primary" : "secondary"}>
                      {cat.count}
                    </Badge>
                  </a>
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>

        {/* Popular Tags */}
        {popularTags.length > 0 && (
          <Card variant="retro" elevation="sm">
            <CardContent>
              <h3 class="sidebar-title">
                <Icon name="mdi:tag-outline" /> {t.blog?.categoryTags ?? "Tags populaires"}
              </h3>
              <div class="sidebar-tags">
                {popularTags.map(([tagName]) => (
                  <span class="sidebar-tag">{tagName}</span>
                ))}
              </div>
            </CardContent>
          </Card>
        )}

        {/* Newsletter */}
        <Card variant="retro" elevation="sm">
          <CardContent>
            <h3 class="sidebar-title">
              <Icon name="mdi:email-newsletter" /> {t.blog?.newsletterTitle ?? "Newsletter"}
            </h3>
            <p class="sidebar-text">{t.blog?.newsletterDescription ?? "Recevez les derniers articles dans votre boîte mail."}</p>
            <form class="sidebar-newsletter" action="#" method="POST">
              <label for="sidebar-email" class="sr-only">{t.aria?.emailLabel ?? "Adresse e-mail"}</label>
              <input
                type="email"
                id="sidebar-email"
                name="email"
                placeholder={t.blog?.newsletterPlaceholder ?? "votre@email.com"}
                required
                class="sidebar-input"
                autocomplete="email"
              />
              <Button type="submit" variant="retro" color="primary" icon={{ name: "mdi:send", side: "right" }}>
                {t.blog?.newsletterSubscribe ?? "S'abonner"}
              </Button>
            </form>
          </CardContent>
        </Card>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
/* ========================================
   CATEGORY PAGE
   ======================================== */

.cat-page {
  max-width: 1280px;
  margin: 0 auto;
  padding: 2rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

/* --- Featured Hero --- */
.cat-featured {
  border-radius: var(--border-radius-lg, 1rem);
  overflow: hidden;
  aspect-ratio: 21 / 9;
}

.cat-featured__link {
  display: block; position: relative;
  width: 100%; height: 100%;
  text-decoration: none; color: inherit;
}

.cat-featured__img-wrap { position: absolute; inset: 0; }

.cat-featured__img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 400ms ease;
}
.cat-featured__link:hover .cat-featured__img { transform: scale(1.03); }

.cat-featured__placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-inset);
}
.cat-featured__placeholder :global(svg) { width: 3rem; height: 3rem; color: var(--text-muted); }

.cat-featured__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, transparent 65%);
}

.cat-featured__content {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; justify-content: flex-end;
  gap: 0.5rem; padding: 2rem; height: 100%; color: #fff;
}

.cat-featured__date { font-size: 0.875rem; opacity: 0.85; }
.cat-featured__title { margin: 0; font-size: clamp(1.25rem, 3vw, 2rem); font-weight: 800; line-height: 1.2; }
.cat-featured__excerpt { margin: 0; font-size: 0.9375rem; opacity: 0.9; max-width: 60ch; line-height: 1.5; }

/* --- Main Grid --- */
.cat-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
@media (min-width: 1024px) { .cat-grid { grid-template-columns: 8fr 4fr; } }

/* --- Section Title --- */
.cat-section-title {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1.25rem; font-weight: 700; margin: 0 0 1.25rem;
  color: var(--heading-color, var(--text-default));
}
.cat-section-title :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary); }

/* --- Feed Items (horizontal cards) --- */
.cat-feed { display: flex; flex-direction: column; gap: 0; }

.cat-feed__item {
  display: flex; gap: 1.25rem;
  padding: 1.25rem 0;
  border-bottom: 1px solid var(--border-default);
}
.cat-feed__item:first-child { padding-top: 0; }
.cat-feed__item:last-child { border-bottom: none; }

.cat-feed__img-wrap {
  flex-shrink: 0; width: 220px; height: 150px;
  border-radius: var(--border-radius-lg, 0.75rem); overflow: hidden;
}
.cat-feed__img {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 200ms;
}
.cat-feed__img-wrap:hover .cat-feed__img { transform: scale(1.04); }
.cat-feed__placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-inset);
}
.cat-feed__placeholder :global(svg) { width: 2rem; height: 2rem; color: var(--text-muted); }

.cat-feed__body { display: flex; flex-direction: column; gap: 0.375rem; flex: 1; min-width: 0; }
.cat-feed__category {
  font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;
  color: var(--color-primary);
}
.cat-feed__title-link { text-decoration: none; }
.cat-feed__title {
  margin: 0; font-size: 1.125rem; font-weight: 700;
  color: var(--text-default); line-height: 1.3;
}
.cat-feed__title-link:hover .cat-feed__title {
  text-decoration: underline;
  color: var(--color-primary);
}
.cat-feed__excerpt {
  margin: 0; font-size: 0.875rem; color: var(--text-muted);
  line-height: 1.5; display: -webkit-box;
  -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
}

.cat-feed__meta {
  display: flex; gap: 0.75rem; font-size: 0.8125rem;
  color: var(--text-muted); align-items: center; margin-top: auto;
}
.cat-feed__meta :global(svg) { width: 0.875rem; height: 0.875rem; }
.cat-feed__meta span { display: inline-flex; align-items: center; gap: 0.25rem; }

.cat-feed__author { display: inline-flex; align-items: center; gap: 0.375rem; }
.cat-feed__author-avatar {
  width: 20px; height: 20px; border-radius: 50%; object-fit: cover;
}

/* --- Empty --- */
.cat-empty {
  display: flex; flex-direction: column; align-items: center; gap: 1rem;
  padding: 3rem 2rem; text-align: center; color: var(--text-muted);
  border: 2px dashed var(--border-default);
  border-radius: var(--border-radius-lg, 1rem);
}
.cat-empty :global(svg) { width: 2.5rem; height: 2.5rem; opacity: 0.4; }

/* --- Sidebar --- */
.cat-grid__sidebar { display: flex; flex-direction: column; gap: 1.5rem; }

.sidebar-title {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1rem; font-weight: 700; margin: 0 0 0.75rem;
  color: var(--heading-color, var(--text-default));
}
.sidebar-title :global(svg) { width: 1.125rem; height: 1.125rem; color: var(--color-primary); }

.sidebar-categories { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.125rem; }

.sidebar-cat-link {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0.5rem 0.75rem;
  border-radius: var(--border-radius-sm, 0.375rem);
  text-decoration: none; font-size: 0.9rem;
  color: var(--text-default); transition: background 150ms;
}
.sidebar-cat-link:hover { background: var(--bg-subtle); }
.sidebar-cat-link.active {
  font-weight: 700; color: var(--color-primary);
  background: color-mix(in srgb, var(--color-primary) 10%, transparent);
}

.sidebar-tags { display: flex; flex-wrap: wrap; gap: 0.375rem; }
.sidebar-tag {
  display: inline-block; padding: 0.25rem 0.75rem;
  border-radius: 9999px; font-size: 0.8125rem;
  background: var(--bg-inset); color: var(--text-muted);
  transition: background 150ms, color 150ms;
}
.sidebar-tag:hover { background: var(--bg-subtle); color: var(--text-default); }

.sidebar-text { margin: 0 0 0.75rem; font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }
.sidebar-newsletter { display: flex; flex-direction: column; gap: 0.5rem; }

.sidebar-input {
  width: 100%; padding: 0.5rem 0.75rem;
  border: 2px solid var(--border-default);
  border-radius: var(--border-radius-sm, 0.375rem);
  font-size: 0.875rem;
  background: var(--bg-default); color: var(--text-default);
  transition: border-color 180ms;
}
.sidebar-input:focus {
  outline: none; border-color: var(--color-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
}

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

/* --- Responsive --- */
@media (max-width: 768px) {
  .cat-featured { aspect-ratio: 16 / 9; }
  .cat-feed__item { flex-direction: column; }
  .cat-feed__img-wrap { width: 100%; height: 200px; }
}

@media (max-width: 480px) {
  .cat-featured__content { padding: 1.25rem; }
}
</style>

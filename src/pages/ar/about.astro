---
// src/pages/ar/about.astro
import BaseLayout from "@layouts/BaseLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import { Icon } from "astro-icon/components";

const LANG = "ar";

const values = [
  { icon: "mdi:map-marker-radius-outline", title: "القرب", desc: "نقرّب المواطنين من منطقتهم وجيرانهم لخلق نسيج اجتماعي متين." },
  { icon: "mdi:handshake-outline", title: "التضامن", desc: "كل عمل على كونكورديا يعزز روابط التعاون المتبادل داخل المجتمع المحلي." },
  { icon: "mdi:hand-heart-outline", title: "الالتزام", desc: "نقدم لك وسائل ملموسة للمشاركة والانخراط في حياة حيّك." },
  { icon: "mdi:leaf", title: "الاستدامة", desc: "نهجنا يفضل الحلول المستدامة والمحترمة للبيئة والإنسان." },
];

const pillars = [
  { icon: "mdi:map-outline", title: "خرائط محلية", desc: "اكتشف الفاعلين والمبادرات والخدمات من حولك بفضل خريطة حية." },
  { icon: "mdi:account-voice", title: "الوساطة", desc: "أدوات لحل النزاعات وتعزيز الحوار بين أعضاء المجتمع." },
  { icon: "mdi:tools", title: "المهارات", desc: "شارك وطوّر معارفك من خلال ورش العمل والتبادلات التعاونية." },
  { icon: "mdi:school-outline", title: "التعليم والصحة", desc: "الوصول إلى موارد تعليمية ورفاهية لتعزيز مرونة المجتمع." },
];

const coreValues = [
  { icon: "mdi:eye-outline", title: "شفافية كاملة", desc: "جميع القرارات موثقة ومتاحة. كل يورو يمكن تتبعه. كل تصويت علني." },
  { icon: "mdi:sprout", title: "بيئة رقمية", desc: "بنية تحتية بسيطة، استضافة خضراء، اعتدال خوارزمي. كود أقل، معنى أكثر." },
  { icon: "mdi:account-group-outline", title: "شمول للجميع", desc: "إمكانية وصول WCAG، تعدد لغات، تصميم عالمي. كونكورديا مبنية ليستخدمها الجميع." },
];

const stats = [
  { value: "12k+", label: "وساطة مكتملة" },
  { value: "850", label: "مشروع أُطلق" },
  { value: "45k", label: "ساعة تطوعية" },
  { value: "94%", label: "معدل الثقة" },
];
---

<BaseLayout title="من نحن — كونكورديا" lang={LANG}>
  <section class="about-hero" dir="rtl">
    <div class="about-hero__bg" aria-hidden="true">
      <img src="/images/placeholder.jpg" alt="" class="about-hero__bg-img" loading="eager" />
      <div class="about-hero__overlay" />
    </div>
    <div class="about-hero__content">
      <Badge variant="retro" color="accent">مهمتنا</Badge>
      <h1 class="about-hero__title">تعزيز الروابط الاجتماعية، محلياً.</h1>
      <p class="about-hero__subtitle">كونكورديا منصة مواطنية، صُمّمت لتقريب السكان والجمعيات والفاعلين المحليين في فضاء موحد من الثقة.</p>
      <a href="#mission">
        <Button variant="retro" color="primary" icon={{ name: "mdi:arrow-down", side: "right" }}>انضم إلى الحركة</Button>
      </a>
    </div>
  </section>

  <main class="about-page" dir="rtl">
    <section class="about-mission" id="mission" aria-label="مهمتنا">
      <div class="about-mission__grid">
        <div class="about-mission__text">
          <span class="about-label">لماذا كونكورديا؟</span>
          <h2 class="about-h2">تكنولوجيا في خدمة الرابط الإنساني</h2>
          <p class="about-body">في عالم يزداد تفككاً، تخلق كونكورديا فضاءات رقمية تعزز حياة الحي. تربط منصتنا السكان بالمبادرات المحلية وخدمات القرب والأشخاص الذين يُحيون مجتمعهم.</p>
          <p class="about-body">نؤمن بأن التكنولوجيا يجب أن تكون غير مرئية: أداة بسيطة وميسّرة تعزز الروابط بدلاً من استبدالها.</p>
        </div>
        <div class="about-mission__cards">
          {values.map((v, i) => (
            <Card variant="retro" elevation="sm" class:list={["about-value-card", i % 2 === 1 && "about-value-card--offset"]}>
              <CardContent>
                <div class="about-value-card__icon"><Icon name={v.icon} /></div>
                <h3 class="about-value-card__title">{v.title}</h3>
                <p class="about-value-card__desc">{v.desc}</p>
              </CardContent>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <section class="about-pillars" aria-label="أركاننا">
      <span class="about-label">أركاننا الأربعة</span>
      <h2 class="about-h2">أسس كونكورديا</h2>
      <div class="about-pillars__grid">
        {pillars.map((p) => (
          <Card variant="retro" elevation="sm" class="about-pillar-card">
            <CardContent>
              <div class="about-pillar-card__icon"><Icon name={p.icon} /></div>
              <h3 class="about-pillar-card__title">{p.title}</h3>
              <p class="about-pillar-card__desc">{p.desc}</p>
            </CardContent>
          </Card>
        ))}
      </div>
    </section>

    <section class="about-core" aria-label="قيمنا الأساسية">
      <span class="about-label">قيمنا الأساسية</span>
      <h2 class="about-h2">ما نؤمن به</h2>
      <div class="about-core__grid">
        {coreValues.map((v) => (
          <Card variant="retro" elevation="sm" class="about-core-card">
            <CardContent>
              <div class="about-core-card__icon"><Icon name={v.icon} /></div>
              <h3 class="about-core-card__title">{v.title}</h3>
              <p class="about-core-card__desc">{v.desc}</p>
            </CardContent>
          </Card>
        ))}
      </div>
    </section>

    <section class="about-impact" aria-label="تأثيرنا">
      <span class="about-label">تأثيرنا</span>
      <h2 class="about-h2">أرقام تتحدث</h2>
      <div class="about-impact__grid">
        {stats.map((s) => (
          <div class="about-impact__stat">
            <span class="about-impact__value">{s.value}</span>
            <span class="about-impact__label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="about-cta" aria-label="دعوة للعمل">
      <div class="about-cta__inner">
        <h2 class="about-cta__title">مستعد لإحداث فرق في حيّك؟</h2>
        <p class="about-cta__desc">انضم إلى كونكورديا وشارك في مغامرة مواطنية ذات معنى.</p>
        <div class="about-cta__buttons">
          <Button variant="retro" color="primary" icon={{ name: "mdi:account-plus-outline", side: "left" }}>إنشاء حساب</Button>
          <a href={`/${LANG}/blog`}>
            <Button variant="retro" color="secondary" icon={{ name: "mdi:newspaper-variant-outline", side: "left" }}>اقرأ المدونة</Button>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
.about-hero { position: relative; min-height: 480px; display: flex; align-items: center; overflow: hidden; }
.about-hero__bg { position: absolute; inset: 0; }
.about-hero__bg-img { width: 100%; height: 100%; object-fit: cover; display: block; }
.about-hero__overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.25) 50%, transparent 100%); }
.about-hero__content { position: relative; z-index: 1; max-width: 1280px; width: 100%; margin: 0 auto; padding: 4rem 1.5rem; display: flex; flex-direction: column; gap: 1rem; color: #fff; }
.about-hero__title { margin: 0; font-size: clamp(2rem, 5vw, 3.25rem); font-weight: 800; line-height: 1.1; }
.about-hero__subtitle { margin: 0; font-size: 1.125rem; max-width: 55ch; opacity: 0.9; line-height: 1.6; }
.about-page { max-width: 1280px; margin: 0 auto; padding: 3rem 1rem; display: flex; flex-direction: column; gap: 4rem; }
.about-label { display: inline-block; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-primary); margin-bottom: 0.25rem; }
.about-h2 { margin: 0 0 1.5rem; font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; color: var(--heading-color, var(--text-default)); line-height: 1.2; }
.about-body { font-size: 1rem; color: var(--text-muted); line-height: 1.7; margin: 0 0 1rem; }
.about-mission__grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; }
@media (min-width: 1024px) { .about-mission__grid { grid-template-columns: 1fr 1fr; } }
.about-mission__text { display: flex; flex-direction: column; justify-content: center; }
.about-mission__cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
.about-value-card--offset { margin-top: 2rem; }
@media (max-width: 640px) { .about-value-card--offset { margin-top: 0; } }
.about-value-card__icon { width: 2.5rem; height: 2.5rem; border-radius: 50%; background: color-mix(in srgb, var(--color-primary) 10%, transparent); display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem; }
.about-value-card__icon :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary); }
.about-value-card__title { margin: 0 0 0.375rem; font-size: 1rem; font-weight: 700; color: var(--text-default); }
.about-value-card__desc { margin: 0; font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }
.about-pillars { background: color-mix(in srgb, var(--color-primary) 5%, var(--bg-default)); border-radius: var(--border-radius-lg, 1rem); padding: 3rem 2rem; text-align: center; }
.about-pillars__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; text-align: right; }
.about-pillar-card { transition: transform 200ms, border-color 200ms; }
.about-pillar-card:hover { transform: translateY(-2px); }
.about-pillar-card__icon { width: 2.5rem; height: 2.5rem; border-radius: var(--border-radius-sm); background: color-mix(in srgb, var(--color-primary) 10%, transparent); display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem; transition: background 200ms; }
.about-pillar-card:hover .about-pillar-card__icon { background: var(--color-primary); }
.about-pillar-card__icon :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary); }
.about-pillar-card:hover .about-pillar-card__icon :global(svg) { color: #fff; }
.about-pillar-card__title { margin: 0 0 0.375rem; font-weight: 700; color: var(--text-default); }
.about-pillar-card__desc { margin: 0; font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }
.about-core { text-align: center; }
.about-core__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; text-align: right; }
.about-core-card__icon { width: 3rem; height: 3rem; border-radius: 50%; background: color-mix(in srgb, var(--color-primary) 8%, transparent); display: flex; align-items: center; justify-content: center; margin-bottom: 0.75rem; }
.about-core-card__icon :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-primary); }
.about-core-card__title { margin: 0 0 0.375rem; font-size: 1.125rem; font-weight: 700; color: var(--text-default); }
.about-core-card__desc { margin: 0; font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; }
.about-impact { text-align: center; }
.about-impact__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.5rem; }
.about-impact__stat { display: flex; flex-direction: column; align-items: center; gap: 0.25rem; padding: 1.5rem 1rem; border-radius: var(--border-radius-lg, 1rem); background: var(--bg-subtle); }
.about-impact__value { font-size: 2.25rem; font-weight: 800; color: var(--color-primary); }
.about-impact__label { font-size: 0.875rem; color: var(--text-muted); }
.about-cta__inner { background: var(--color-primary); color: #fff; text-align: center; padding: 3.5rem 2rem; border-radius: var(--border-radius-lg, 1rem); position: relative; overflow: hidden; }
.about-cta__title { margin: 0 0 0.5rem; font-size: 1.75rem; font-weight: 800; }
.about-cta__desc { margin: 0 0 1.5rem; font-size: 1rem; opacity: 0.9; }
.about-cta__buttons { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
@media (max-width: 640px) {
  .about-hero { min-height: 360px; }
  .about-hero__content { padding: 2.5rem 1rem; }
  .about-mission__cards { grid-template-columns: 1fr; }
  .about-pillars { padding: 2rem 1rem; }
}
</style>

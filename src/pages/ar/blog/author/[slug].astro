---
// src/pages/ar/blog/author/[slug].astro
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import PostCard from "@components/modules/blog/cards/PostCard.astro";
import PostGrid from "@components/modules/blog/lists/PostGrid.astro";
import Badge from "@components/ui/Badge.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import { Icon } from "astro-icon/components";

export const prerender = true;

export async function getStaticPaths() {
  const LANG = "ar";
  const allPosts = await getCollection("blog");
  const arPosts = allPosts.filter((p) => p.data.lang === LANG);

  const authors = new Map();
  arPosts.forEach((post) => {
    post.data.authors.forEach((author: any) => {
      if (!authors.has(author.slug)) {
        authors.set(author.slug, author);
      }
    });
  });

  return Array.from(authors.values()).map((author) => ({
    params: { slug: author.slug },
    props: { author },
  }));
}

const { author } = Astro.props;
const { slug } = Astro.params;
const LANG = "ar";

const allPosts = await getCollection("blog");

const posts = allPosts
  .filter((p) => p.data.lang === LANG)
  .filter((p) => p.data.authors.some((a: any) => a.slug === slug))
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt || 0).getTime() -
      new Date(a.data.publishedAt || 0).getTime(),
  );

// Unique categories for this author
const authorCats = new Map<string, string>();
posts.forEach((p) => {
  (p.data.categories ?? []).forEach((c: any) => {
    if (!authorCats.has(c.slug)) authorCats.set(c.slug, c.name);
  });
});
---

<BaseLayout
  title={`${author.name} — كاتب`}
  description={`اكتشف المقالات التي كتبها ${author.name}`}
  lang={LANG}
>
  {/* ===== PROFILE HERO ===== */}
  <section class="author-hero">
    <div class="author-hero__bg" aria-hidden="true">
      <div class="author-hero__pattern" />
    </div>
    <div class="author-hero__content" dir="rtl">
      <nav class="author-hero__breadcrumb" aria-label="مسار التنقل">
        <a href={`/${LANG}`}>الرئيسية</a>
        <Icon name="mdi:chevron-right" />
        <a href={`/${LANG}/blog`}>المدونة</a>
        <Icon name="mdi:chevron-right" />
        <span>كاتب</span>
      </nav>

      <div class="author-hero__profile">
        <div class="author-hero__avatar-wrap">
          {author.avatar ? (
            <img src={author.avatar} alt={author.name} class="author-hero__avatar" />
          ) : (
            <div class="author-hero__avatar-placeholder">
              {author.name.charAt(0).toUpperCase()}
            </div>
          )}
        </div>
        <div class="author-hero__info">
          <Badge variant="retro" color="primary">كاتب</Badge>
          <h1 class="author-hero__name">{author.name}</h1>
          {author.bio && <p class="author-hero__bio">{author.bio}</p>}

          {/* Skills / Categories */}
          {authorCats.size > 0 && (
            <div class="author-hero__tags">
              {Array.from(authorCats.entries()).map(([catSlug, catName]) => (
                <a href={`/${LANG}/blog/${catSlug}`} class="author-hero__tag">
                  {catName}
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <main class="author-page" dir="rtl">
    <div class="author-grid">

      {/* ===== MAIN: ARTICLES ===== */}
      <section class="author-grid__main" aria-label="مقالات الكاتب">

        {/* Impact Dashboard */}
        <div class="author-stats">
          <Card variant="retro" elevation="sm" class="author-stat-card">
            <CardContent>
              <div class="author-stat">
                <Icon name="mdi:newspaper-variant-outline" />
                <span class="author-stat__value">{posts.length}</span>
                <span class="author-stat__label">{posts.length > 1 ? "مقالات" : "مقال"}</span>
              </div>
            </CardContent>
          </Card>
          <Card variant="retro" elevation="sm" class="author-stat-card">
            <CardContent>
              <div class="author-stat">
                <Icon name="mdi:tag-multiple-outline" />
                <span class="author-stat__value">{authorCats.size}</span>
                <span class="author-stat__label">{authorCats.size > 1 ? "فئات" : "فئة"}</span>
              </div>
            </CardContent>
          </Card>
          <Card variant="retro" elevation="sm" class="author-stat-card">
            <CardContent>
              <div class="author-stat">
                <Icon name="mdi:calendar-check-outline" />
                <span class="author-stat__value">
                  {posts[0]?.data.publishedAt
                    ? posts[0].data.publishedAt.toLocaleDateString(LANG, { month: "short", year: "numeric" })
                    : "—"
                  }
                </span>
                <span class="author-stat__label">آخر مقال</span>
              </div>
            </CardContent>
          </Card>
        </div>

        <h2 class="author-section-title">
          <Icon name="mdi:newspaper-variant-multiple-outline" /> مقالات منشورة
        </h2>

        {posts.length > 0 ? (
          <PostGrid>
            {posts.map((post) => (
              <PostCard post={post} lang={LANG} variant="retro" />
            ))}
          </PostGrid>
        ) : (
          <div class="author-empty">
            <Icon name="mdi:text-box-remove-outline" />
            <p>لم ينشر هذا الكاتب أي مقالات بعد.</p>
          </div>
        )}
      </section>

      {/* ===== SIDEBAR ===== */}
      <aside class="author-grid__sidebar">
        <Card variant="retro" elevation="sm">
          <CardContent>
            <h3 class="sidebar-title">
              <Icon name="mdi:shield-check-outline" /> الثقة والشفافية
            </h3>
            <ul class="trust-list">
              <li class="trust-item">
                <Icon name="mdi:check-circle" />
                <span>ملف شخصي موثق</span>
              </li>
              <li class="trust-item">
                <Icon name="mdi:check-circle" />
                <span>مقالات مراجعة من هيئة التحرير</span>
              </li>
              <li class="trust-item">
                <Icon name="mdi:check-circle" />
                <span>عضو نشط في المجتمع</span>
              </li>
            </ul>
          </CardContent>
        </Card>

        <Card variant="retro" elevation="sm">
          <CardContent>
            <h3 class="sidebar-title">
              <Icon name="mdi:tag-multiple-outline" /> التخصصات
            </h3>
            <div class="sidebar-specialties">
              {Array.from(authorCats.entries()).map(([catSlug, catName]) => (
                <a href={`/${LANG}/blog/${catSlug}`}>
                  <Badge variant="retro" color="secondary">{catName}</Badge>
                </a>
              ))}
              {authorCats.size === 0 && (
                <p class="sidebar-empty-text">لا توجد تخصصات مسجلة.</p>
              )}
            </div>
          </CardContent>
        </Card>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
/* ========================================
   AUTHOR PROFILE PAGE
   ======================================== */

/* --- Hero --- */
.author-hero {
  position: relative;
  background: var(--bg-inset);
  overflow: hidden;
}

.author-hero__bg {
  position: absolute; inset: 0;
  background: linear-gradient(135deg, color-mix(in srgb, var(--color-primary) 12%, var(--bg-default)), var(--bg-default));
}

.author-hero__pattern {
  position: absolute; inset: 0; opacity: 0.04;
  background-image: radial-gradient(circle, var(--text-default) 1px, transparent 1px);
  background-size: 24px 24px;
}

.author-hero__content {
  position: relative; z-index: 1;
  max-width: 1280px; margin: 0 auto;
  padding: 2rem 1rem 3rem;
}

.author-hero__breadcrumb {
  display: flex; align-items: center; gap: 0.375rem;
  font-size: 0.8125rem; color: var(--text-muted); margin-bottom: 1.5rem;
}
.author-hero__breadcrumb a {
  color: var(--text-muted); text-decoration: none;
}
.author-hero__breadcrumb a:hover { text-decoration: underline; color: var(--text-default); }
.author-hero__breadcrumb :global(svg) { width: 0.875rem; height: 0.875rem; opacity: 0.5; }

.author-hero__profile {
  display: flex; align-items: flex-start; gap: 2rem;
}

.author-hero__avatar-wrap { flex-shrink: 0; }

.author-hero__avatar {
  width: 120px; height: 120px; border-radius: 50%;
  object-fit: cover;
  border: 4px solid var(--color-primary);
  box-shadow: var(--shadow-lg);
}

.author-hero__avatar-placeholder {
  width: 120px; height: 120px; border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
  color: #fff; display: flex; align-items: center; justify-content: center;
  font-size: 3rem; font-weight: 800;
  border: 4px solid var(--color-primary);
  box-shadow: var(--shadow-lg);
}

.author-hero__info { flex: 1; min-width: 0; }
.author-hero__name {
  margin: 0.5rem 0 0; font-size: clamp(1.5rem, 4vw, 2.5rem);
  font-weight: 800; color: var(--heading-color, var(--text-default));
}
.author-hero__bio {
  margin: 0.5rem 0 0; font-size: 1rem; color: var(--text-muted);
  line-height: 1.6; max-width: 60ch;
}

.author-hero__tags {
  display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 1rem;
}
.author-hero__tag {
  display: inline-block; padding: 0.25rem 0.75rem;
  border-radius: 9999px; font-size: 0.8125rem; font-weight: 500;
  background: color-mix(in srgb, var(--color-primary) 10%, transparent);
  color: var(--color-primary);
  text-decoration: none; transition: background 150ms;
}
.author-hero__tag:hover {
  background: color-mix(in srgb, var(--color-primary) 20%, transparent);
}

/* --- Page --- */
.author-page {
  max-width: 1280px; margin: 0 auto;
  padding: 2rem 1rem;
}

.author-grid { display: grid; grid-template-columns: 1fr; gap: 2rem; }
@media (min-width: 1024px) { .author-grid { grid-template-columns: 2fr 1fr; } }

.author-grid__main { display: flex; flex-direction: column; gap: 2rem; }
.author-grid__sidebar { display: flex; flex-direction: column; gap: 1.5rem; }

/* --- Stats --- */
.author-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }

.author-stat {
  display: flex; flex-direction: column; align-items: center; gap: 0.25rem;
  text-align: center; padding: 0.5rem 0;
}
.author-stat :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-primary); }
.author-stat__value { font-size: 1.375rem; font-weight: 800; color: var(--text-default); }
.author-stat__label { font-size: 0.75rem; color: var(--text-muted); }

/* --- Section Title --- */
.author-section-title {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1.25rem; font-weight: 700;
  margin: 0; color: var(--heading-color, var(--text-default));
}
.author-section-title :global(svg) { width: 1.25rem; height: 1.25rem; color: var(--color-primary); }

/* --- Empty --- */
.author-empty {
  display: flex; flex-direction: column; align-items: center; gap: 1rem;
  padding: 3rem 2rem; text-align: center; color: var(--text-muted);
  border: 2px dashed var(--border-default);
  border-radius: var(--border-radius-lg, 1rem);
}
.author-empty :global(svg) { width: 2.5rem; height: 2.5rem; opacity: 0.4; }

/* --- Sidebar --- */
.sidebar-title {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1rem; font-weight: 700; margin: 0 0 0.75rem;
  color: var(--heading-color, var(--text-default));
}
.sidebar-title :global(svg) { width: 1.125rem; height: 1.125rem; color: var(--color-primary); }

.trust-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.5rem; }
.trust-item {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 0.875rem; color: var(--text-default);
}
.trust-item :global(svg) { width: 1.125rem; height: 1.125rem; color: var(--color-success); flex-shrink: 0; }

.sidebar-specialties { display: flex; flex-wrap: wrap; gap: 0.375rem; }
.sidebar-specialties a { text-decoration: none; }
.sidebar-empty-text { font-size: 0.875rem; color: var(--text-muted); margin: 0; }

/* --- Responsive --- */
@media (max-width: 640px) {
  .author-hero__profile { flex-direction: column; align-items: center; text-align: center; }
  .author-hero__tags { justify-content: center; }
  .author-stats { grid-template-columns: 1fr; }
}
</style>

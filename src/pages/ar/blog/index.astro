---
// src/pages/ar/blog/index.astro
import { getCollection } from "astro:content";
import { getDrizzle } from "@database/drizzle";
import { blogComments } from "@database/schemas";
import { sql, eq } from "drizzle-orm";
import BaseLayout from "@layouts/BaseLayout.astro";
import BannerPage from "@templates/BannerPage.astro";
import PostGrid from "@components/modules/blog/lists/PostGrid.astro";
import PostCard from "@components/modules/blog/cards/PostCard.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import { Icon } from "astro-icon/components";

const LANG = Astro.currentLocale || "ar";
const t = await import(`../../../i18n/${LANG}.json`);
const allPosts = await getCollection("blog");

const db = await getDrizzle();
const liveStats = await db
  .select({
    postId: blogComments.postId,
    avgRating: sql<number>`avg(${blogComments.rating})`.mapWith(Number),
    count: sql<number>`count(${blogComments.id})`.mapWith(Number),
  })
  .from(blogComments)
  .where(eq(blogComments.postType, "blog"))
  .groupBy(blogComments.postId);

const statsMap = new Map(liveStats.map((s) => [s.postId, s]));

const posts = allPosts
  .filter((post) => post.data.lang === LANG)
  .sort(
    (a, b) =>
      new Date(b.data.publishedAt || 0).getTime() -
      new Date(a.data.publishedAt || 0).getTime(),
  );

// --- Catégories uniques ---
const catMap = new Map<string, { name: string; slug: string; count: number }>();
posts.forEach((post) => {
  (post.data.categories ?? []).forEach((cat: any) => {
    const existing = catMap.get(cat.slug);
    if (existing) existing.count++;
    else catMap.set(cat.slug, { name: cat.name, slug: cat.slug, count: 1 });
  });
});
const categories = Array.from(catMap.values()).sort((a, b) => b.count - a.count);

// --- Article vedette (le plus récent featured, ou le premier) ---
const featuredPosts = posts.filter((p) => p.data.isFeatured);
const hero = featuredPosts[0] ?? posts[0];
const heroCategory = hero?.data.categories?.[0];
const heroAuthor = hero?.data.authors?.[0];
const heroLink = heroCategory
  ? `/${LANG}/blog/${heroCategory.slug}/${hero.data.slug}`
  : `/${LANG}/blog/${hero?.data.slug}`;

// --- Remaining posts (exclude hero) ---
const remainingPosts = posts.filter((p) => p.data.id !== hero?.data.id);
---

<BaseLayout title={t.blog?.title || "المدونة"} lang={LANG}>
  <BannerPage
    title={t.blog?.title || "المدونة"}
    subtitle={t.blog?.description || "تقارير وصور شخصية وأخبار من منطقتنا."}
    type="blog"
    color="accent"
    breadcrumbs={[]}
  />

  <main class="blog-main" dir="rtl">
    {/* ============================================ */}
    {/* HERO FEATURED ARTICLE                       */}
    {/* ============================================ */}
    {hero && (
      <section class="blog-hero" aria-label="مقال مميز">
        <a href={heroLink} class="blog-hero__link">
          <div class="blog-hero__image-wrap">
            {hero.data.cover?.url ? (
              <img
                src={hero.data.cover.url}
                alt={hero.data.cover.alt || hero.data.title}
                class="blog-hero__image"
                loading="eager"
              />
            ) : (
              <div class="blog-hero__image-placeholder">
                <Icon name="mdi:newspaper-variant-outline" />
              </div>
            )}
            <div class="blog-hero__overlay" />
          </div>
          <div class="blog-hero__content">
            {heroCategory && (
              <Badge variant="retro" color="accent">{heroCategory.name}</Badge>
            )}
            <h2 class="blog-hero__title">{hero.data.title}</h2>
            {hero.data.excerpt && (
              <p class="blog-hero__excerpt">{hero.data.excerpt}</p>
            )}
            <div class="blog-hero__meta">
              {heroAuthor && <span class="blog-hero__author">{heroAuthor.name}</span>}
              {hero.data.publishedAt && (
                <time datetime={hero.data.publishedAt.toISOString()}>
                  {hero.data.publishedAt.toLocaleDateString(LANG, { day: "numeric", month: "long", year: "numeric" })}
                </time>
              )}
              {hero.data.readingTime && <span>{hero.data.readingTime}</span>}
            </div>
          </div>
        </a>
      </section>
    )}

    {/* ============================================ */}
    {/* CATEGORY FILTER BAR                         */}
    {/* ============================================ */}
    {categories.length > 0 && (
      <nav class="blog-categories" aria-label="تصفية حسب الفئة">
        <a href={`/${LANG}/blog`} class="blog-categories__pill active" aria-current="page">
          الكل
        </a>
        {categories.map((cat) => (
          <a href={`/${LANG}/blog/${cat.slug}`} class="blog-categories__pill">
            {cat.name}
            <span class="blog-categories__count">{cat.count}</span>
          </a>
        ))}
      </nav>
    )}

    {/* ============================================ */}
    {/* FEATURED POSTS (up to 3)                    */}
    {/* ============================================ */}
    {featuredPosts.length > 1 && (
      <section class="blog-featured" aria-label="مقالات مميزة">
        <h2 class="blog-section-title">
          <Icon name="mdi:star-outline" /> مقالات مميزة
        </h2>
        <PostGrid>
          {featuredPosts.slice(1, 4).map((post) => {
            const stats = statsMap.get(post.data.id);
            return (
              <PostCard
                post={post}
                lang={LANG}
                rating={stats?.avgRating}
                count={stats?.count}
                variant="retro"
              />
            );
          })}
        </PostGrid>
      </section>
    )}

    {/* ============================================ */}
    {/* ALL ARTICLES GRID                           */}
    {/* ============================================ */}
    <section class="blog-all" aria-label="جميع المقالات">
      <h2 class="blog-section-title">
        <Icon name="mdi:newspaper-variant-multiple-outline" /> جميع المقالات
      </h2>
      {remainingPosts.length > 0 ? (
        <PostGrid>
          {remainingPosts.map((post) => {
            const stats = statsMap.get(post.data.id);
            return (
              <PostCard
                post={post}
                lang={LANG}
                rating={stats?.avgRating}
                count={stats?.count}
                variant="retro"
              />
            );
          })}
        </PostGrid>
      ) : (
        <div class="blog-empty">
          <Icon name="mdi:text-box-remove-outline" />
          <p>لا توجد مقالات متاحة حالياً.</p>
        </div>
      )}
    </section>

    {/* ============================================ */}
    {/* NEWSLETTER CTA                              */}
    {/* ============================================ */}
    <section class="blog-newsletter" aria-label="النشرة الإخبارية">
      <Card variant="retro" elevation="md">
        <CardContent>
          <div class="blog-newsletter__inner">
            <div class="blog-newsletter__text">
              <Icon name="mdi:email-newsletter" />
              <div>
                <h2 class="blog-newsletter__title">ابقَ على اطلاع</h2>
                <p class="blog-newsletter__desc">احصل على أفضل مقالاتنا وآخر أخبار المجتمع مباشرة في بريدك الإلكتروني.</p>
              </div>
            </div>
            <form class="blog-newsletter__form" action="#" method="POST">
              <label for="newsletter-email" class="sr-only">البريد الإلكتروني</label>
              <input
                type="email"
                id="newsletter-email"
                name="email"
                placeholder="your@email.com"
                required
                class="blog-newsletter__input"
                autocomplete="email"
              />
              <Button type="submit" variant="retro" color="primary" icon={{ name: "mdi:send", side: "right" }}>
                اشترك
              </Button>
            </form>
          </div>
        </CardContent>
      </Card>
    </section>
  </main>
</BaseLayout>

<style>
/* ========================================
   BLOG INDEX PAGE
   ======================================== */

.blog-main {
  max-width: var(--max-width, 1280px);
  margin: 0 auto;
  padding: 2rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 3rem;
}

/* --- Hero --- */
.blog-hero { border-radius: var(--border-radius-lg, 1rem); overflow: hidden; }

.blog-hero__link {
  display: block;
  position: relative;
  text-decoration: none;
  color: inherit;
  min-height: 400px;
}

.blog-hero__image-wrap { position: absolute; inset: 0; }

.blog-hero__image {
  width: 100%; height: 100%;
  object-fit: cover; display: block;
  transition: transform 400ms ease;
}

.blog-hero__link:hover .blog-hero__image { transform: scale(1.03); }

.blog-hero__image-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  background: var(--bg-inset, #f1f5f9);
}
.blog-hero__image-placeholder :global(svg) { width: 4rem; height: 4rem; color: var(--text-muted, #94a3b8); }

.blog-hero__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.1) 60%, transparent 100%);
}

.blog-hero__content {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; justify-content: flex-end;
  gap: 0.75rem; padding: 2.5rem; min-height: 400px; color: #fff;
}

.blog-hero__title { margin: 0; font-size: clamp(1.5rem, 4vw, 2.5rem); font-weight: 800; line-height: 1.15; }
.blog-hero__excerpt { margin: 0; font-size: 1rem; line-height: 1.6; opacity: 0.9; max-width: 60ch; }
.blog-hero__meta { display: flex; flex-wrap: wrap; gap: 0.75rem; font-size: 0.875rem; opacity: 0.8; }
.blog-hero__author { font-weight: 600; }

/* --- Category pills --- */
.blog-categories { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }

.blog-categories__pill {
  display: inline-flex; align-items: center; gap: 0.375rem;
  padding: 0.5rem 1rem;
  border: 2px solid var(--border-default, #e2e8f0);
  border-radius: 9999px;
  font-size: 0.875rem; font-weight: 600;
  color: var(--text-default); background: var(--bg-default);
  text-decoration: none; transition: all 180ms ease; white-space: nowrap;
}

.blog-categories__pill:hover {
  border-color: var(--color-primary);
  color: var(--color-primary);
  background: color-mix(in srgb, var(--color-primary) 8%, var(--bg-default));
}

.blog-categories__pill.active {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--text-inverted, #fff);
}

.blog-categories__count { font-size: 0.75rem; opacity: 0.7; }

/* --- Section titles --- */
.blog-section-title {
  display: flex; align-items: center; gap: 0.5rem;
  font-size: 1.5rem; font-weight: 800;
  margin: 0 0 1.25rem; color: var(--heading-color, var(--text-default));
}
.blog-section-title :global(svg) { width: 1.5rem; height: 1.5rem; color: var(--color-primary); }

/* --- Empty --- */
.blog-empty {
  display: flex; flex-direction: column; align-items: center; gap: 1rem;
  padding: 4rem 2rem; text-align: center; color: var(--text-muted);
  border: 2px dashed var(--border-default); border-radius: var(--border-radius-lg, 1rem);
}
.blog-empty :global(svg) { width: 3rem; height: 3rem; opacity: 0.4; }

/* --- Newsletter --- */
.blog-newsletter__inner { display: flex; flex-direction: column; gap: 1.5rem; }
.blog-newsletter__text { display: flex; align-items: flex-start; gap: 1rem; }
.blog-newsletter__text :global(svg) { width: 2.5rem; height: 2.5rem; color: var(--color-primary); flex-shrink: 0; }
.blog-newsletter__title { margin: 0; font-size: 1.25rem; font-weight: 700; color: var(--heading-color, var(--text-default)); }
.blog-newsletter__desc { margin: 0.25rem 0 0; font-size: 0.9375rem; color: var(--text-muted); line-height: 1.5; }
.blog-newsletter__form { display: flex; gap: 0.75rem; flex-wrap: wrap; }

.blog-newsletter__input {
  flex: 1; min-width: 220px;
  padding: 0.625rem 1rem;
  border: 2px solid var(--border-default);
  border-radius: var(--border-radius-sm, 0.375rem);
  font-size: 0.9375rem;
  background: var(--bg-default); color: var(--text-default);
  transition: border-color 180ms;
}
.blog-newsletter__input:focus {
  outline: none; border-color: var(--color-primary);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-primary) 20%, transparent);
}

.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

@media (max-width: 640px) {
  .blog-hero__content { padding: 1.5rem; min-height: 300px; }
  .blog-hero__title { font-size: 1.5rem; }
  .blog-newsletter__form { flex-direction: column; }
  .blog-newsletter__input { min-width: 0; }
}
</style>

---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import ResetPasswordForm from "@components/templates/auth/ResetPasswordForm.astro";
import translations from "@i18n/ar.json";
import { getAuth } from "@lib/auth/auth";

const pageTitle =
  translations.auth.resetPassword ?? "إعادة تعيين كلمة المرور";

const request = Astro.request;
const token = new URL(request.url).searchParams.get("token") ?? "";

if (!token && request.method === "GET") {
  // Token is required to view this page
}

let status: { type: "success" | "error"; message: string } | null = null;

if (request.method === "POST") {
  const formData = await request.formData();
  const password = (formData.get("password") ?? "").toString();
  const confirmPassword = (formData.get("confirmPassword") ?? "").toString();
  const tokenInput = (formData.get("token") ?? "").toString();

  if (password !== confirmPassword) {
    status = {
      type: "error",
      message:
        translations.auth.passwordsDontMatch ??
        "كلمتا المرور غير متطابقتين.",
    };
  } else if (password.length < 8) {
    status = {
      type: "error",
      message:
        translations.auth.passwordTooShort ?? "كلمة المرور قصيرة جدًا.",
    };
  } else {
    try {
      const auth = await getAuth();
      const response = await auth.api.resetPassword({
        body: {
          newPassword: password,
          token: tokenInput || token,
        },
        asResponse: true,
      });

      if (!response.ok) {
        const payload = await response.json().catch(() => ({}));
        status = {
          type: "error",
          message: payload.message || "خطأ أثناء إعادة التعيين.",
        };
      } else {
        return Astro.redirect("/ar/auth/sign-in?status=password_reset");
      }
    } catch (e) {
      status = { type: "error", message: "خطأ في الخادم." };
    }
  }
}
---

<BaseLayout lang="ar" title={pageTitle}>
  <section
    class="mx-auto flex min-h-[60vh] w-full max-w-5xl items-center justify-center px-4 py-16"
  >
    <ResetPasswordForm
      translations={translations}
      status={status}
      token={token}
    />
  </section>
</BaseLayout>

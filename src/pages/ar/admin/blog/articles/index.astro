---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Select from "@components/ui/Form/Select.astro";
import Label from "@components/ui/Form/Label.astro";
import Pagination from "@components/ui/Pagination.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import {
  blogPosts,
  blogTranslations,
  blogPostAuthors,
  blogAuthors,
  blogPostCategories,
  blogCategories,
} from "@database/schemas";
import { count, eq, desc, ilike, inArray, and } from "drizzle-orm";

const currentLocale = Astro.currentLocale || "ar";

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1"));
const perPage = 20;
const search = url.searchParams.get("q")?.trim() ?? "";
const statusFilter = url.searchParams.get("status")?.trim() ?? "";
const featuredFilter = url.searchParams.get("featured")?.trim() ?? "";
const homeFilter = url.searchParams.get("home")?.trim() ?? "";
const blogFilter = url.searchParams.get("blog")?.trim() ?? "";
const categoryFilter = url.searchParams.get("category")?.trim() ?? "";

const db = await getDrizzle();

// Build filter conditions
const conditions: any[] = [];
if (search) conditions.push(ilike(blogPosts.slug, `%${search}%`));
if (statusFilter) conditions.push(eq(blogPosts.status, statusFilter));
if (featuredFilter === "true") conditions.push(eq(blogPosts.isFeatured, true));
if (featuredFilter === "false") conditions.push(eq(blogPosts.isFeatured, false));
if (homeFilter === "true") conditions.push(eq(blogPosts.displayInHome, true));
if (homeFilter === "false") conditions.push(eq(blogPosts.displayInHome, false));
if (blogFilter === "true") conditions.push(eq(blogPosts.displayInBlog, true));
if (blogFilter === "false") conditions.push(eq(blogPosts.displayInBlog, false));

// Category filter: get postIds first
let categoryPostIds: string[] | null = null;
if (categoryFilter) {
  const catPosts = await db
    .select({ postId: blogPostCategories.postId })
    .from(blogPostCategories)
    .where(eq(blogPostCategories.categoryId, categoryFilter));
  categoryPostIds = catPosts.map((cp) => cp.postId);
  if (categoryPostIds.length > 0) {
    conditions.push(inArray(blogPosts.id, categoryPostIds));
  }
}

const whereClause = conditions.length > 0 ? and(...conditions) : undefined;
const noResults = categoryFilter && categoryPostIds !== null && categoryPostIds.length === 0;

// Counts
const [totalResult] = noResults
  ? [{ value: 0 }]
  : whereClause
    ? await db.select({ value: count() }).from(blogPosts).where(whereClause)
    : await db.select({ value: count() }).from(blogPosts);
const totalArticles = totalResult.value;
const totalPages = Math.max(1, Math.ceil(totalArticles / perPage));

// Fetch articles
const articles = noResults
  ? []
  : whereClause
    ? await db.select().from(blogPosts).where(whereClause).orderBy(desc(blogPosts.createdAt)).limit(perPage).offset((page - 1) * perPage)
    : await db.select().from(blogPosts).orderBy(desc(blogPosts.createdAt)).limit(perPage).offset((page - 1) * perPage);

// Translations for titles
const postIds = articles.map((a) => a.id);
const translationsMap = new Map<string, string>();
if (postIds.length > 0) {
  const translations = await db
    .select({ postId: blogTranslations.postId, headline: blogTranslations.headline, inLanguage: blogTranslations.inLanguage })
    .from(blogTranslations)
    .where(inArray(blogTranslations.postId, postIds));
  translations.forEach((tr) => {
    const key = tr.postId;
    if (tr.inLanguage === currentLocale || !translationsMap.has(key)) {
      const h = tr.headline;
      if (typeof h === "string") translationsMap.set(key, h);
      else if (h && typeof h === "object") {
        const obj = h as Record<string, string>;
        translationsMap.set(key, obj[currentLocale] || Object.values(obj)[0] || "Sans titre");
      }
    }
  });
}

// Authors
const authorsMap = new Map<string, string[]>();
if (postIds.length > 0) {
  const postAuthors = await db
    .select({ postId: blogPostAuthors.postId, authorId: blogPostAuthors.authorId })
    .from(blogPostAuthors)
    .where(inArray(blogPostAuthors.postId, postIds));
  const authorIdSet = [...new Set(postAuthors.map((pa) => pa.authorId))];
  const authorNames = new Map<string, string>();
  if (authorIdSet.length > 0) {
    const authors = await db
      .select({ id: blogAuthors.id, displayName: blogAuthors.displayName })
      .from(blogAuthors)
      .where(inArray(blogAuthors.id, authorIdSet));
    authors.forEach((a) => {
      const dn = a.displayName;
      authorNames.set(a.id, typeof dn === "string" ? dn : (dn as Record<string, string>)?.[currentLocale] || Object.values(dn as Record<string, string>)[0] || "—");
    });
  }
  postAuthors.forEach((pa) => {
    const list = authorsMap.get(pa.postId) ?? [];
    const name = authorNames.get(pa.authorId);
    if (name) list.push(name);
    authorsMap.set(pa.postId, list);
  });
}

// Categories for each post
const postCatsMap = new Map<string, string[]>();
if (postIds.length > 0) {
  const postCats = await db
    .select({ postId: blogPostCategories.postId, categoryId: blogPostCategories.categoryId })
    .from(blogPostCategories)
    .where(inArray(blogPostCategories.postId, postIds));
  postCats.forEach((pc) => {
    const list = postCatsMap.get(pc.postId) ?? [];
    list.push(pc.categoryId);
    postCatsMap.set(pc.postId, list);
  });
}

// All categories for filter dropdown
const allCategories = await db
  .select({ id: blogCategories.id, slug: blogCategories.slug, name: blogCategories.name })
  .from(blogCategories)
  .orderBy(blogCategories.slug);

const categoryNameMap = new Map<string, string>();
allCategories.forEach((c) => {
  const n = c.name;
  categoryNameMap.set(c.id, typeof n === "string" ? n : (n as Record<string, string>)?.[currentLocale] || Object.values(n as Record<string, string>)[0] || c.slug);
});

// Stats
const [publishedCount] = await db.select({ value: count() }).from(blogPosts).where(eq(blogPosts.status, "published"));
const [draftCount] = await db.select({ value: count() }).from(blogPosts).where(eq(blogPosts.status, "draft"));
const [featuredCount] = await db.select({ value: count() }).from(blogPosts).where(eq(blogPosts.isFeatured, true));
const [homeCount] = await db.select({ value: count() }).from(blogPosts).where(eq(blogPosts.displayInHome, true));

const statusBadge = (s: string) => {
  if (s === "published") return { color: "success" as const, text: "منشور" };
  if (s === "draft") return { color: "warning" as const, text: "مسودة" };
  if (s === "scheduled") return { color: "accent" as const, text: "مجدول" };
  if (s === "archived") return { color: "default" as const, text: "مؤرشف" };
  return { color: "default" as const, text: s };
};

const adminBase = `/${currentLocale}/admin/blog/articles`;
const hasFilters = search || statusFilter || featuredFilter || homeFilter || blogFilter || categoryFilter;

const filterParams = new URLSearchParams();
if (search) filterParams.set("q", search);
if (statusFilter) filterParams.set("status", statusFilter);
if (featuredFilter) filterParams.set("featured", featuredFilter);
if (homeFilter) filterParams.set("home", homeFilter);
if (blogFilter) filterParams.set("blog", blogFilter);
if (categoryFilter) filterParams.set("category", categoryFilter);
const paginationBase = `${adminBase}?${filterParams.toString()}${filterParams.toString() ? "&" : ""}page=`;
---

<AdminLayout title="المقالات" activeSection="blog-articles">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <h1>المقالات</h1>
        <Badge color="primary" text={`${totalArticles} نتيجة`} />
      </div>
      <a href={`${adminBase}/new`} class="btn-create">
        <Icon name="mdi:plus-circle-outline" />
        مقال جديد
      </a>
    </div>
    <p class="admin-page-subtitle">أنشئ، حرّر وانشر مقالات المدونة. أدر الترجمات والفئات والوسائط.</p>
  </header>

  <!-- Quick stats -->
  <div class="stats-grid">
    <a href={`${adminBase}?status=published`} class:list={["stat-card", { active: statusFilter === "published" }]}>
      <div class="stat-icon stat-icon--success"><Icon name="mdi:check-circle-outline" /></div>
      <div class="stat-info">
        <span class="stat-value">{publishedCount.value}</span>
        <span class="stat-label">منشورة</span>
      </div>
    </a>
    <a href={`${adminBase}?status=draft`} class:list={["stat-card", { active: statusFilter === "draft" }]}>
      <div class="stat-icon stat-icon--warning"><Icon name="mdi:file-edit-outline" /></div>
      <div class="stat-info">
        <span class="stat-value">{draftCount.value}</span>
        <span class="stat-label">مسودات</span>
      </div>
    </a>
    <a href={`${adminBase}?featured=true`} class:list={["stat-card", { active: featuredFilter === "true" }]}>
      <div class="stat-icon stat-icon--accent"><Icon name="mdi:star-outline" /></div>
      <div class="stat-info">
        <span class="stat-value">{featuredCount.value}</span>
        <span class="stat-label">Featured</span>
      </div>
    </a>
    <a href={`${adminBase}?home=true`} class:list={["stat-card", { active: homeFilter === "true" }]}>
      <div class="stat-icon stat-icon--primary"><Icon name="mdi:home-outline" /></div>
      <div class="stat-info">
        <span class="stat-value">{homeCount.value}</span>
        <span class="stat-label">الرئيسية</span>
      </div>
    </a>
  </div>

  <!-- Filters -->
  <Card elevation="sm" className="admin-filters-card">
    <CardContent>
      <form method="get" action={adminBase} class="admin-filters-form">
        <div class="admin-filters-row">
          <div class="admin-filter-field filter-search">
            <Label htmlFor="q">بحث</Label>
            <Input id="q" name="q" type="search" placeholder="الرابط، العنوان…" value={search} />
          </div>
          <div class="admin-filter-field">
            <Label htmlFor="status">الحالة</Label>
            <Select id="status" name="status">
              <option value="">الكل</option>
              <option value="published" selected={statusFilter === "published"}>منشور</option>
              <option value="draft" selected={statusFilter === "draft"}>مسودة</option>
              <option value="scheduled" selected={statusFilter === "scheduled"}>مجدول</option>
              <option value="archived" selected={statusFilter === "archived"}>مؤرشف</option>
            </Select>
          </div>
          <div class="admin-filter-field">
            <Label htmlFor="category">الفئة</Label>
            <Select id="category" name="category">
              <option value="">الكل</option>
              {allCategories.map((cat) => (
                <option value={cat.id} selected={categoryFilter === cat.id}>
                  {categoryNameMap.get(cat.id)}
                </option>
              ))}
            </Select>
          </div>
        </div>
        <div class="admin-filters-row">
          <div class="admin-filter-field">
            <Label htmlFor="featured">Featured</Label>
            <Select id="featured" name="featured">
              <option value="">الكل</option>
              <option value="true" selected={featuredFilter === "true"}>نعم</option>
              <option value="false" selected={featuredFilter === "false"}>لا</option>
            </Select>
          </div>
          <div class="admin-filter-field">
            <Label htmlFor="home">الرئيسية</Label>
            <Select id="home" name="home">
              <option value="">الكل</option>
              <option value="true" selected={homeFilter === "true"}>نعم</option>
              <option value="false" selected={homeFilter === "false"}>لا</option>
            </Select>
          </div>
          <div class="admin-filter-field">
            <Label htmlFor="blog">ظاهر في المدونة</Label>
            <Select id="blog" name="blog">
              <option value="">الكل</option>
              <option value="true" selected={blogFilter === "true"}>نعم</option>
              <option value="false" selected={blogFilter === "false"}>لا</option>
            </Select>
          </div>
          <div class="admin-filter-actions">
            <Button type="submit" color="primary" icon={{ name: "mdi:magnify", side: "left" }}>
              تصفية
            </Button>
            {hasFilters && (
              <a href={adminBase} class="admin-filter-reset">إعادة تعيين</a>
            )}
          </div>
        </div>
      </form>
    </CardContent>
  </Card>

  <!-- Articles table -->
  <Card>
    <CardContent>
      {articles.length === 0 ? (
        <div class="empty-state">
          <Icon name="mdi:newspaper-variant-outline" class="empty-state-icon" />
          <p>{noResults ? "لا توجد مقالات في هذه الفئة." : "لم يتم العثور على مقالات."}</p>
          <a href={`${adminBase}/new`} class="btn-create-sm">
            <Icon name="mdi:plus" /> إنشاء مقال
          </a>
        </div>
      ) : (
        <div class="table-responsive">
          <Table striped>
            <TableHeader>
              <TableRow>
                <TableHead>المقال</TableHead>
                <TableHead>الفئات</TableHead>
                <TableHead>المؤلف(ون)</TableHead>
                <TableHead>الحالة</TableHead>
                <TableHead>العلامات</TableHead>
                <TableHead>التاريخ</TableHead>
                <TableHead>الإجراءات</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {articles.map((article) => {
                const title = translationsMap.get(article.id) ?? article.slug;
                const authors = authorsMap.get(article.id) ?? [];
                const catIds = postCatsMap.get(article.id) ?? [];
                const sb = statusBadge(article.status);
                return (
                  <TableRow>
                    <TableCell>
                      <a href={`${adminBase}/${article.id}/edit`} class="article-title-link">
                        <span class="article-title">{title}</span>
                      </a>
                      <code class="article-slug">{article.slug}</code>
                    </TableCell>
                    <TableCell>
                      <div class="tag-list">
                        {catIds.length > 0 ? catIds.map((cId) => (
                          <a href={`${adminBase}?category=${cId}`} class="tag-chip">
                            {categoryNameMap.get(cId) || cId}
                          </a>
                        )) : <span class="text-muted">—</span>}
                      </div>
                    </TableCell>
                    <TableCell>
                      {authors.length > 0 ? (
                        <span class="article-authors">{authors.join(", ")}</span>
                      ) : <span class="text-muted">—</span>}
                    </TableCell>
                    <TableCell>
                      <Badge color={sb.color} text={sb.text} />
                    </TableCell>
                    <TableCell>
                      <div class="flag-list">
                        {article.isFeatured && <Badge color="accent" text="★ Featured" />}
                        {article.displayInHome && <Badge color="primary" text="Home" />}
                        {article.displayInBlog && <Badge color="success" text="Blog" />}
                      </div>
                    </TableCell>
                    <TableCell>
                      <div class="date-cell">
                        {article.publishedAt ? (
                          <time datetime={article.publishedAt.toISOString()} class="date-main">
                            {article.publishedAt.toLocaleDateString(currentLocale, { day: "2-digit", month: "short", year: "numeric" })}
                          </time>
                        ) : (
                          <span class="text-muted">غير منشور</span>
                        )}
                        <time datetime={article.createdAt.toISOString()} class="date-sub">
                          أُنشئ {article.createdAt.toLocaleDateString(currentLocale, { day: "2-digit", month: "short" })}
                        </time>
                      </div>
                    </TableCell>
                    <TableCell>
                      <div class="action-buttons">
                        <a href={`${adminBase}/${article.id}/edit`} class="action-btn" title="تعديل">
                          <Icon name="mdi:pencil-outline" />
                        </a>
                        <button type="button" class="action-btn action-btn--duplicate" title="نسخ" data-action="duplicate" data-id={article.id}>
                          <Icon name="mdi:content-copy" />
                        </button>
                        {article.status === "draft" ? (
                          <button type="button" class="action-btn action-btn--publish" title="نشر" data-action="publish" data-id={article.id}>
                            <Icon name="mdi:publish" />
                          </button>
                        ) : article.status === "published" ? (
                          <button type="button" class="action-btn action-btn--unpublish" title="إلغاء النشر" data-action="unpublish" data-id={article.id}>
                            <Icon name="mdi:eye-off-outline" />
                          </button>
                        ) : null}
                        <button type="button" class="action-btn action-btn--delete" title="حذف" data-action="delete" data-id={article.id} data-title={title}>
                          <Icon name="mdi:delete-outline" />
                        </button>
                      </div>
                    </TableCell>
                  </TableRow>
                );
              })}
            </TableBody>
          </Table>
        </div>
      )}
    </CardContent>
  </Card>

  {totalPages > 1 && (
    <div class="admin-pagination">
      <Pagination currentPage={page} totalPages={totalPages} baseUrl={paginationBase} showPrevNext color="primary" />
    </div>
  )}
</AdminLayout>

<script>
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll<HTMLElement>("[data-action]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        const action = btn.dataset.action!;
        const id = btn.dataset.id!;
        const title = btn.dataset.title || "";

        if (action === "delete" && !confirm(`حذف المقال « ${title} »؟ هذا الإجراء لا رجعة فيه.`)) return;
        if (action === "duplicate" && !confirm("نسخ هذا المقال؟")) return;

        try {
          const res = await fetch("/api/admin/blog/articles", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ action, id }),
          });
          const data = await res.json();
          if (data.ok || data.id) {
            showToast("تم تنفيذ الإجراء.", "success");
            setTimeout(() => window.location.reload(), 1000);
          } else {
            showToast(`خطأ: ${data.error || "غير معروف"}`  , "error");
          }
        } catch {
          showToast("خطأ في الشبكة.", "error");
        }
      });
    });
  });
</script>

<style>
  .admin-page-header { margin-bottom: var(--space-6, 1.5rem); }
  .admin-page-title-row {
    display: flex; align-items: center; justify-content: space-between;
    flex-wrap: wrap; gap: var(--space-3, 0.75rem);
  }
  .admin-page-title-group { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem); font-weight: 800;
    color: var(--heading-color, #0f172a); margin: 0;
  }
  .admin-page-subtitle { color: var(--text-muted, #64748b); font-size: 0.9375rem; margin: var(--space-1, 0.25rem) 0 0; }

  .btn-create {
    display: inline-flex; align-items: center; gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    background: var(--color-primary, #eab308); color: var(--color-primary-contrast, #0f172a);
    border-radius: var(--border-radius-md, 0.375rem); font-weight: 600; font-size: 0.875rem;
    text-decoration: none; transition: opacity 0.15s, transform 0.1s; white-space: nowrap;
  }
  .btn-create:hover { opacity: 0.9; transform: translateY(-1px); }
  .btn-create [data-icon] { width: 1.25rem; height: 1.25rem; }

  .btn-create-sm {
    display: inline-flex; align-items: center; gap: var(--space-1, 0.25rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    background: var(--color-primary, #eab308); color: var(--color-primary-contrast, #0f172a);
    border-radius: var(--border-radius-md, 0.375rem); font-weight: 600; font-size: 0.8125rem;
    text-decoration: none; margin-top: var(--space-3, 0.75rem);
  }
  .btn-create-sm [data-icon] { width: 1rem; height: 1rem; }

  .stats-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3, 0.75rem); margin-bottom: var(--space-4, 1rem);
  }
  .stat-card {
    display: flex; align-items: center; gap: var(--space-3, 0.75rem);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    background: var(--bg-surface, white); border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-lg, 0.5rem); text-decoration: none; color: inherit;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .stat-card:hover { border-color: var(--color-primary, #eab308); box-shadow: 0 2px 8px rgba(0,0,0,0.06); }
  .stat-card.active { border-color: var(--color-primary, #eab308); background: var(--bg-subtle, #f8fafc); }
  .stat-icon {
    width: 2.5rem; height: 2.5rem; display: flex; align-items: center; justify-content: center;
    border-radius: var(--border-radius-md, 0.375rem);
  }
  .stat-icon [data-icon] { width: 1.25rem; height: 1.25rem; }
  .stat-icon--success { background: #dcfce7; color: #16a34a; }
  .stat-icon--warning { background: #fef3c7; color: #d97706; }
  .stat-icon--accent { background: #ede9fe; color: #7c3aed; }
  .stat-icon--primary { background: #fef9c3; color: #ca8a04; }
  .stat-info { display: flex; flex-direction: column; }
  .stat-value { font-weight: 700; font-size: 1.25rem; color: var(--text-default, #0f172a); line-height: 1.2; }
  .stat-label { font-size: 0.75rem; color: var(--text-muted, #64748b); }

  .admin-filters-card { margin-bottom: var(--space-4, 1rem); }
  .admin-filters-form { display: flex; flex-direction: column; gap: var(--space-3, 0.75rem); }
  .admin-filters-row { display: flex; flex-wrap: wrap; align-items: flex-end; gap: var(--space-3, 0.75rem); }
  .admin-filter-field { display: flex; flex-direction: column; gap: var(--space-1, 0.25rem); min-width: 140px; flex: 1; }
  .filter-search { flex: 2; min-width: 200px; }
  .admin-filter-actions { display: flex; align-items: center; gap: var(--space-2, 0.5rem); }
  .admin-filter-reset { color: var(--text-muted, #64748b); font-size: 0.8125rem; text-decoration: underline; }

  .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  .article-title-link { text-decoration: none; }
  .article-title-link:hover .article-title { color: var(--color-primary, #eab308); }
  .article-title {
    font-weight: 600; font-size: 0.875rem; color: var(--text-default, #0f172a);
    display: block; transition: color 0.15s;
  }
  .article-slug {
    font-family: var(--font-family-mono, monospace); font-size: 0.6875rem;

---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";
import Badge from "@components/ui/Badge.astro";
import Button from "@components/ui/Button.astro";
import Pagination from "@components/ui/Pagination.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogComments, blogPosts } from "@database/schemas";
import { count, eq, desc, inArray } from "drizzle-orm";

import tData from "@i18n/ar.json";
const currentLocale = Astro.currentLocale || "ar";
const t = tData;

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get("page") ?? "1"));
const perPage = 20;
const statusFilter = url.searchParams.get("status")?.trim() ?? "";

const db = await getDrizzle();

// Conditions

// Comptage
const [totalResult] = statusFilter
  ? await db.select({ value: count() }).from(blogComments).where(eq(blogComments.status, statusFilter))
  : await db.select({ value: count() }).from(blogComments);

const totalComments = totalResult.value;
const totalPages = Math.max(1, Math.ceil(totalComments / perPage));

// Fetch des commentaires
const comments = statusFilter
  ? await db
      .select()
      .from(blogComments)
      .where(eq(blogComments.status, statusFilter))
      .orderBy(desc(blogComments.createdAt))
      .limit(perPage)
      .offset((page - 1) * perPage)
  : await db
      .select()
      .from(blogComments)
      .orderBy(desc(blogComments.createdAt))
      .limit(perPage)
      .offset((page - 1) * perPage);

// Récupérer les posts associés
const postIds = [...new Set(comments.map((c) => c.postId).filter(Boolean))];
const postsMap = new Map<string, { slug: string }>();
if (postIds.length > 0) {
  const posts = await db
    .select({ id: blogPosts.id, slug: blogPosts.slug })
    .from(blogPosts)
    .where(inArray(blogPosts.id, postIds));
  posts.forEach((p) => postsMap.set(p.id, p));
}

// Comptage par statut pour les badges
const [pendingCount] = await db.select({ value: count() }).from(blogComments).where(eq(blogComments.status, "pending"));
const [approvedCount] = await db.select({ value: count() }).from(blogComments).where(eq(blogComments.status, "approved"));
const [rejectedCount] = await db.select({ value: count() }).from(blogComments).where(eq(blogComments.status, "rejected"));

const statusBadgeColor = (s: string) => {
  if (s === "approved") return "success" as const;
  if (s === "rejected") return "error" as const;
  if (s === "pending") return "warning" as const;
  return "default" as const;
};

const statusLabel = (s: string) => {
  if (s === "approved") return "موافق عليه";
  if (s === "rejected") return "مرفوض";
  if (s === "pending") return "قيد الانتظار";
  return s;
};

const extractText = (content: unknown): string => {
  if (typeof content === "string") return content;
  if (content && typeof content === "object") {
    if (currentLocale in (content as Record<string, unknown>)) {
      return String((content as Record<string, string>)[currentLocale]);
    }
    const vals = Object.values(content as Record<string, unknown>);
    if (vals.length > 0) return String(vals[0]);
  }
  return "—";
};

const adminBase = `/${currentLocale}/admin/moderation`;
---

<AdminLayout title={t.adminPanel?.moderation ?? "Modération"} activeSection="moderation">
  <header class="admin-page-header">
    <h1>{t.adminPanel?.moderation ?? "Modération"}</h1>
    <p class="admin-page-subtitle">إشراف على تعليقات الزوار.</p>
  </header>

  <!-- Compteurs rapides -->
  <div class="moderation-summary">
    <a href={`${adminBase}?status=pending`} class:list={["summary-chip", { active: statusFilter === "pending" }]}>
      <Icon name="mdi:clock-outline" class="chip-icon" />
      <span>قيد الانتظار</span>
      <Badge color="warning" text={String(pendingCount.value)} />
    </a>
    <a href={`${adminBase}?status=approved`} class:list={["summary-chip", { active: statusFilter === "approved" }]}>
      <Icon name="mdi:check-circle-outline" class="chip-icon" />
      <span>موافق عليها</span>
      <Badge color="success" text={String(approvedCount.value)} />
    </a>
    <a href={`${adminBase}?status=rejected`} class:list={["summary-chip", { active: statusFilter === "rejected" }]}>
      <Icon name="mdi:close-circle-outline" class="chip-icon" />
      <span>مرفوضة</span>
      <Badge color="error" text={String(rejectedCount.value)} />
    </a>
    {statusFilter && (
      <a href={adminBase} class="summary-chip-reset">عرض الكل</a>
    )}
  </div>

  <!-- Table de commentaires -->
  <Card>
    <CardContent>
      {comments.length === 0 ? (
        <div class="empty-state">
          <Icon name="mdi:comment-check-outline" class="empty-state-icon" />
          <p>لا توجد تعليقات للإشراف.</p>
        </div>
      ) : (
        <div class="table-responsive">
        <Table striped>
          <TableHeader>
            <TableRow>
              <TableHead>المؤلف</TableHead>
              <TableHead>التعليق</TableHead>
              <TableHead>المقال</TableHead>
              <TableHead>الحالة</TableHead>
              <TableHead>التاريخ</TableHead>
              <TableHead>الإجراءات</TableHead>
            </TableRow>
          </TableHeader>
          <TableBody>
            {comments.map((comment) => {
              const post = postsMap.get(comment.postId);
              return (
                <TableRow>
                  <TableCell>
                    <div class="comment-author">
                      <span class="comment-author-name">{comment.authorName}</span>
                      <span class="comment-author-email">{comment.authorEmail}</span>
                    </div>
                  </TableCell>
                  <TableCell>
                    <p class="comment-excerpt">{extractText(comment.content).slice(0, 120)}…</p>
                  </TableCell>
                  <TableCell>
                    <span class="comment-post-slug">{post?.slug ?? comment.postId}</span>
                    <Badge color="default" text={comment.postType} className="ml-1" />
                  </TableCell>
                  <TableCell>
                    <Badge color={statusBadgeColor(comment.status)} text={statusLabel(comment.status)} />
                  </TableCell>
                  <TableCell>
                    <time datetime={comment.createdAt.toISOString()}>
                      {comment.createdAt.toLocaleDateString(currentLocale)}
                    </time>
                  </TableCell>
                  <TableCell>
                    <div class="action-buttons">
                      {comment.status !== "approved" && (
                        <form method="post" action={`/${currentLocale}/api/admin/moderate`} class="inline-form">
                          <input type="hidden" name="entity" value="blogComments" />
                          <input type="hidden" name="entityId" value={comment.id} />
                          <input type="hidden" name="action" value="approve" />
                          <Button type="submit" color="primary" className="btn-sm"
                            icon={{ name: "mdi:check", side: "left" }}>
                            موافقة
                          </Button>
                        </form>
                      )}
                      {comment.status !== "rejected" && (
                        <form method="post" action={`/${currentLocale}/api/admin/moderate`} class="inline-form">
                          <input type="hidden" name="entity" value="blogComments" />
                          <input type="hidden" name="entityId" value={comment.id} />
                          <input type="hidden" name="action" value="reject" />
                          <Button type="submit" color="error" className="btn-sm"
                            icon={{ name: "mdi:close", side: "left" }}>
                            رفض
                          </Button>
                        </form>
                      )}
                    </div>
                  </TableCell>
                </TableRow>
              );
            })}
          </TableBody>
        </Table>
        </div>
      )}
    </CardContent>
  </Card>

  {totalPages > 1 && (
    <div class="admin-pagination">
      <Pagination
        currentPage={page}
        totalPages={totalPages}
        baseUrl={`${adminBase}?${statusFilter ? `status=${encodeURIComponent(statusFilter)}&` : ""}page=`}
        showPrevNext
        color="primary"
      />
    </div>
  )}
</AdminLayout>

<style>
  .admin-page-header {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem);
    font-weight: 800;
    color: var(--heading-color, #0f172a);
    margin: 0 0 var(--space-1, 0.25rem);
  }

  .admin-page-subtitle {
    color: var(--text-muted, #64748b);
    font-size: 0.9375rem;
    margin: 0;
  }

  /* Chips de résumé */
  .moderation-summary {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2, 0.5rem);
    margin-bottom: var(--space-4, 1rem);
    align-items: center;
  }

  .summary-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-md, 0.375rem);
    background: var(--bg-surface, white);
    text-decoration: none;
    color: var(--text-default, #1e293b);
    font-size: 0.875rem;
    font-weight: 500;
    transition: border-color 0.15s, background 0.15s;
  }

  .summary-chip:hover {
    border-color: var(--color-primary, #eab308);
    background: var(--bg-subtle, #f8fafc);
  }

  .summary-chip.active {
    border-color: var(--color-primary, #eab308);
    background: var(--bg-inset, #f1f5f9);
  }

  .chip-icon {
    width: 1rem;
    height: 1rem;
    opacity: 0.7;
  }

  .summary-chip-reset {
    font-size: 0.8125rem;
    color: var(--text-muted, #64748b);
    text-decoration: underline;
    margin-left: var(--space-2, 0.5rem);
  }

  /* Cellules commentaires */
  .comment-author {
    display: flex;
    flex-direction: column;
  }

  .comment-author-name {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-default, #0f172a);
  }

  .comment-author-email {
    font-size: 0.75rem;
    color: var(--text-muted, #64748b);
  }

  .comment-excerpt {
    font-size: 0.8125rem;
    color: var(--text-default, #1e293b);
    line-height: 1.4;
    margin: 0;
    max-width: 300px;
  }

  .comment-post-slug {
    font-size: 0.8125rem;
    color: var(--text-muted, #64748b);
    font-family: var(--font-family-mono, monospace);
  }

  .ml-1 {
    margin-left: var(--space-1, 0.25rem);
  }

  .action-buttons {
    display: flex;
    gap: var(--space-2, 0.5rem);
  }

  .inline-form {
    display: inline;
  }

  .btn-sm {
    font-size: 0.75rem !important;
    padding: 0.25rem 0.5rem !important;
  }

  .empty-state {
    text-align: center;
    padding: var(--space-8, 2rem);
    color: var(--text-muted, #64748b);
  }

  .empty-state-icon {
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2, 0.5rem);
    opacity: 0.5;
  }

  .admin-pagination {
    margin-top: var(--space-4, 1rem);
    display: flex;
    justify-content: center;
  }

  .table-responsive { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  @media (max-width: 768px) {
    .moderation-summary {
      flex-direction: column;
    }

    .comment-excerpt {
      max-width: 180px;
    }

    .action-buttons {
      flex-direction: column;
      gap: var(--space-1, 0.25rem);
    }
  }

  @media (max-width: 480px) {
    .admin-page-header h1 {
      font-size: 1.5rem;
    }

    .summary-chip {
      width: 100%;
      justify-content: center;
    }
  }
</style>

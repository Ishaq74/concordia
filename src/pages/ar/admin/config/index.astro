---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Badge from "@components/ui/Badge.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { user } from "@database/schemas";
import { count, eq } from "drizzle-orm";
import { getRoleDefinitions } from "@lib/admin/permissions";

import tData from "@i18n/ar.json";
const currentLocale = Astro.currentLocale || "ar";
const t = tData;

const db = await getDrizzle();

// Stats générales
const [totalUsers] = await db.select({ value: count() }).from(user);
const [adminCount] = await db.select({ value: count() }).from(user).where(eq(user.role, "admin"));
const [bannedCount] = await db.select({ value: count() }).from(user).where(eq(user.banned, true));

// Rôles définis dans le système
let roleDefinitions: { name: string; description: string }[] = [];
try {
  const defs = getRoleDefinitions();
  if (Array.isArray(defs)) {
    roleDefinitions = defs.map((d: any) => ({
      name: String(d.name ?? d.role ?? ""),
      description: String(d.description ?? d.label ?? ""),
    }));
  }
} catch {
  // Fallback si getRoleDefinitions n'est pas dispo
  roleDefinitions = [
    { name: "admin", description: "وصول كامل للإدارة" },
    { name: "moderator", description: "إشراف على المحتوى والتعليقات" },
    { name: "editor", description: "إنشاء وتحرير المحتوى" },
    { name: "user", description: "مستخدم عادي" },
  ];
}

if (roleDefinitions.length === 0) {
  roleDefinitions = [
    { name: "admin", description: "وصول كامل للإدارة" },
    { name: "moderator", description: "إشراف على المحتوى والتعليقات" },
    { name: "editor", description: "إنشاء وتحرير المحتوى" },
    { name: "user", description: "مستخدم عادي" },
  ];
}

const roleBadgeColor = (name: string) => {
  if (name === "admin") return "error" as const;
  if (name === "moderator") return "warning" as const;
  if (name === "editor") return "accent" as const;
  return "default" as const;
};

const adminBase = `/${currentLocale}/admin`;
---

<AdminLayout title={t.adminPanel?.config ?? "Configuration"} activeSection="config">
  <header class="admin-page-header">
    <h1>{t.adminPanel?.config ?? "Configuration"}</h1>
    <p class="admin-page-subtitle">الإعدادات العامة للإدارة وإدارة الأدوار.</p>
  </header>

  <div class="config-grid">
    <!-- Vue d'ensemble rapide -->
    <Card>
      <CardHeader>
        <div class="card-title-row">
          <Icon name="mdi:information-outline" class="card-title-icon" />
          <h2 class="card-section-title">نظرة عامة</h2>
        </div>
      </CardHeader>
      <CardContent>
        <dl class="config-stats">
          <div class="config-stat">
            <dt>إجمالي المستخدمين</dt>
            <dd>{totalUsers.value}</dd>
          </div>
          <div class="config-stat">
            <dt>المديرون</dt>
            <dd>{adminCount.value}</dd>
          </div>
          <div class="config-stat">
            <dt>المستخدمون المحظورون</dt>
            <dd class="stat-danger">{bannedCount.value}</dd>
          </div>
        </dl>
      </CardContent>
    </Card>

    <!-- Rôles du système -->
    <Card>
      <CardHeader>
        <div class="card-title-row">
          <Icon name="mdi:shield-account" class="card-title-icon" />
          <h2 class="card-section-title">الأدوار والصلاحيات</h2>
        </div>
      </CardHeader>
      <CardContent>
        <ul class="roles-list" role="list">
          {roleDefinitions.map((role) => (
            <li class="role-item">
              <div class="role-info">
                <Badge color={roleBadgeColor(role.name)} text={role.name} />
                <span class="role-description">{role.description}</span>
              </div>
            </li>
          ))}
        </ul>
      </CardContent>
    </Card>

    <!-- Sécurité -->
    <Card>
      <CardHeader>
        <div class="card-title-row">
          <Icon name="mdi:lock-outline" class="card-title-icon" />
          <h2 class="card-section-title">الأمان</h2>
        </div>
      </CardHeader>
      <CardContent>
        <ul class="config-checklist" role="list">
          <li class="config-check-item">
            <Icon name="mdi:check-circle" class="check-icon check-ok" />
            <span>مصادقة better-auth مفعّلة</span>
          </li>
          <li class="config-check-item">
            <Icon name="mdi:check-circle" class="check-icon check-ok" />
            <span>إضافة الإدارة نشطة</span>
          </li>
          <li class="config-check-item">
            <Icon name="mdi:check-circle" class="check-icon check-ok" />
            <span>حماية middleware على /admin</span>
          </li>
          <li class="config-check-item">
            <Icon name="mdi:check-circle" class="check-icon check-ok" />
            <span>سجل المراجعة مفعّل</span>
          </li>
          <li class="config-check-item">
            <Icon name="mdi:check-circle" class="check-icon check-ok" />
            <span>التحقق من البريد الإلكتروني مطلوب</span>
          </li>
        </ul>
      </CardContent>
    </Card>

    <!-- Liens rapides -->
    <Card>
      <CardHeader>
        <div class="card-title-row">
          <Icon name="mdi:link-variant" class="card-title-icon" />
          <h2 class="card-section-title">إجراءات سريعة</h2>
        </div>
      </CardHeader>
      <CardContent>
        <div class="quick-actions">
          <a href={`${adminBase}/users`} class="quick-action">
            <Icon name="mdi:account-group" class="quick-action-icon" />
            <span>إدارة المستخدمين</span>
          </a>
          <a href={`${adminBase}/moderation`} class="quick-action">
            <Icon name="mdi:shield-check" class="quick-action-icon" />
            <span>إشراف على المحتوى</span>
          </a>
          <a href={`${adminBase}/audit`} class="quick-action">
            <Icon name="mdi:clipboard-text-clock" class="quick-action-icon" />
            <span>عرض السجلات</span>
          </a>
          <a href={`${adminBase}/blog/articles`} class="quick-action">
            <Icon name="mdi:newspaper-variant-outline" class="quick-action-icon" />
            <span>إدارة المقالات</span>
          </a>
        </div>
      </CardContent>
    </Card>
  </div>
</AdminLayout>

<style>
  .admin-page-header {
    margin-bottom: var(--space-6, 1.5rem);
  }

  .admin-page-header h1 {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: var(--h2-font-size, 2rem);
    font-weight: 800;
    color: var(--heading-color, #0f172a);
    margin: 0 0 var(--space-1, 0.25rem);
  }

  .admin-page-subtitle {
    color: var(--text-muted, #64748b);
    font-size: 0.9375rem;
    margin: 0;
  }

  .config-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: var(--space-4, 1rem);
  }

  .card-title-row {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    width: 100%;
  }

  .card-title-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary, #eab308);
    flex-shrink: 0;
  }

  .card-section-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--heading-color, #0f172a);
    margin: 0;
  }

  /* Stats de config */
  .config-stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
    margin: 0;
  }

  .config-stat {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2, 0.5rem) 0;
    border-bottom: 1px solid var(--border-default, #e2e8f0);
  }

  .config-stat:last-child {
    border-bottom: none;
  }

  .config-stat dt {
    font-size: 0.875rem;
    color: var(--text-muted, #64748b);
  }

  .config-stat dd {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--heading-color, #0f172a);
    margin: 0;
  }

  .stat-danger {
    color: var(--color-danger, #dc2626) !important;
  }

  /* Rôles */
  .roles-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3, 0.75rem);
  }

  .role-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-2, 0.5rem) 0;
    border-bottom: 1px solid var(--border-default, #e2e8f0);
  }

  .role-item:last-child {
    border-bottom: none;
  }

  .role-info {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
  }

  .role-description {
    font-size: 0.8125rem;
    color: var(--text-muted, #64748b);
  }

  /* Checklist sécurité */
  .config-checklist {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .config-check-item {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    font-size: 0.875rem;
    color: var(--text-default, #1e293b);
  }

  .check-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
  }

  .check-ok {
    color: var(--color-success, #16a34a);
  }

  /* Actions rapides */
  .quick-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2, 0.5rem);
  }

  .quick-action {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border-radius: var(--border-radius-md, 0.375rem);
    text-decoration: none;
    color: var(--text-default, #1e293b);
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 0.15s;
  }

  .quick-action:hover {
    background: var(--bg-inset, #f1f5f9);
  }

  .quick-action-icon {
    width: 1.125rem;
    height: 1.125rem;
    color: var(--color-primary, #eab308);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .config-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .admin-page-header h1 {
      font-size: 1.5rem;
    }

    .config-stat dd {
      font-size: 1rem;
    }

    .role-item {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2, 0.5rem);
    }
  }
</style>

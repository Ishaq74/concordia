---
import DocLayout from "@layouts/DocLayout.astro";
import { Code } from "astro:components";
import NewTab from "@components/ui/NewTab/NewTab.astro";
import TableOfContents from "@components/templates/docs/TableOfContents.astro";
import Card from "@components/ui/Card/Card.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Grid from "@components/Tools/Grid.astro";
import Table from "@components/ui/Table/Table.astro";
import TableHeader from "@components/ui/Table/TableHeader.astro";
import TableBody from "@components/ui/Table/TableBody.astro";
import TableRow from "@components/ui/Table/TableRow.astro";
import TableHead from "@components/ui/Table/TableHead.astro";
import TableCell from "@components/ui/Table/TableCell.astro";

const tabsData = [
  { id: 'overview', label: 'Overview', icon: 'mdi:eye' },
  { id: 'code', label: 'Code', icon: 'mdi:code-tags' },
  { id: 'features', label: 'Features', icon: 'mdi:star' },
  { id: 'docs', label: 'Documentation', icon: 'mdi:book-open' },
];

const panelsData = [
  { id: 'overview', content: 'Welcome to the NewTab demo!' },
  { id: 'features', content: 'Key features described below.' },
  { id: 'docs', content: 'This documentation covers every aspect of the component.' },
];

---

<DocLayout
  title="NewTab Component"
  description="Documentation for the new NewTab component: accessible tabs with JS logic and 5 variants"
  variant="initial"
>
  <h1 id="newtab-component">NewTab Component</h1>

  <p>
    The <code class="inline-code">NewTab</code> component is a modern rewrite of the
    existing <code class="inline-code">Tabs</code> component. It adds lightweight JavaScript
    for state management, a flexible Astro API, and supports all design system variants.
  </p>

  <h2>Interactive demo</h2>

  <div class="demo-section">
    <p>This full demonstration ("Formula 1" level) showcases all five variants with
      dark/light toggling and color switches. The example lives in a standalone HTML file
      loaded via an <code class="inline-code">iframe</code> to avoid style conflicts.
    </p>

    <iframe
      src="/newtab-demo.html"
      title="Full NewTab demo"
      style="width:100%;height:800px;border:1px solid var(--border-color);"
    ></iframe>
  </div>

  <TableOfContents
    items={[
      { label: "Installation", href: "#installation" },
      { label: "Basic usage", href: "#basic-usage" },
      { label: "Available props", href: "#props" },
      { label: "Variants", href: "#variants" },
      { label: "Advanced examples", href: "#examples" },
      { label: "Best practices", href: "#best-practices" },
      { label: "Accessibility", href: "#accessibility" },
    ]}
    title="Table of contents"
  />

  <h2 id="installation">Installation</h2>
  <p>The component lives under <code class="inline-code">src/components/ui/NewTab/</code>.</p>
  <Code
    lang="typescript"
    code={`import NewTab from '@components/ui/NewTab/NewTab.astro';`}
  />

  <h2 id="basic-usage">Basic usage</h2>
  <p>
    NewTab uses a props-based API rather than slots. Pass an array of tabs and a matching
    array of panels in the same order.
  </p>

  <Code
    lang="astro"
    code={`<NewTab
  variant="initial"
  tabs={[
    { id: 'home', label: 'Home', icon: 'mdi:home' },
    { id: 'settings', label: 'Settings', icon: 'mdi:cog' },
  ]}
  panels={[
    { id: 'home', content: <p>Home content</p> },
    { id: 'settings', content: <p>Settings content</p> },
  ]}
/>`}
  />

  <h2 id="props">Available props</h2>
  <div class="props-table">
    <Table striped>
      <TableHeader>
        <TableRow>
          <TableHead>Prop</TableHead>
          <TableHead>Type</TableHead>
          <TableHead>Default</TableHead>
          <TableHead>Description</TableHead>
        </TableRow>
      </TableHeader>
      <TableBody>
        <TableRow>
          <TableCell><code class="inline-code">variant</code></TableCell>
          <TableCell>string</TableCell>
          <TableCell><code>'initial'</code></TableCell>
          <TableCell>Visual style.</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">tabs</code></TableCell>
          <TableCell><code>TabItem[]</code></TableCell>
          <TableCell>–</TableCell>
          <TableCell>List of tabs (label, id, icon).</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">panels</code></TableCell>
          <TableCell><code>TabPanelItem[]</code></TableCell>
          <TableCell>–</TableCell>
          <TableCell>List of associated contents.</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">active</code></TableCell>
          <TableCell>number</TableCell>
          <TableCell><code>0</code></TableCell>
          <TableCell>Index of initially active tab.</TableCell>
        </TableRow>
        <TableRow>
          <TableCell><code class="inline-code">onTabChange</code></TableCell>
          <TableCell>function</TableCell>
          <TableCell>–</TableCell>
          <TableCell>Callback when tab changes.</TableCell>
        </TableRow>
      </TableBody>
    </Table>
  </div>

  <h2 id="variants">Variants</h2>
  <p>All design system variants are supported:</p>
  <ul>
    <li>initial</li>
    <li>retro</li>
    <li>modern</li>
    <li>futuristic</li>
    <li>native (unstyled)</li>
  </ul>

  <h3>Demo by variant</h3>
  <Grid display="grid" cols="repeat(auto-fit,minmax(240px,1fr))" gap="lg" className="example-grid">
    <Card variant="initial">
      <CardContent>
        <h4>Initial</h4>
        <NewTab variant="initial" tabs={tabsData} panels={panelsData} />
        <Code lang="astro" code={`<NewTab variant="initial" tabs={tabsData} panels={panelsData} />`} />
      </CardContent>
    </Card>

    <Card variant="retro">
      <CardContent>
        <h4>Retro</h4>
        <NewTab variant="retro" tabs={tabsData} panels={panelsData} />
        <Code lang="astro" code={`<NewTab variant="retro" tabs={tabsData} panels={panelsData} />`} />
      </CardContent>
    </Card>

    <Card variant="modern">
      <CardContent>
        <h4>Modern</h4>
        <NewTab variant="modern" tabs={tabsData} panels={panelsData} />
        <Code lang="astro" code={`<NewTab variant="modern" tabs={tabsData} panels={panelsData} />`} />
      </CardContent>
    </Card>

    <Card variant="futuristic">
      <CardContent>
        <h4>Futuristic</h4>
        <NewTab variant="futuristic" tabs={tabsData} panels={panelsData} />
        <Code lang="astro" code={`<NewTab variant="futuristic" tabs={tabsData} panels={panelsData} />`} />
      </CardContent>
    </Card>

    <Card variant="initial">
      <CardContent>
        <h4>Native</h4>
        <NewTab variant="native" tabs={tabsData} panels={panelsData} />
        <Code lang="astro" code={`<NewTab variant="native" tabs={tabsData} panels={panelsData} />`} />
      </CardContent>
    </Card>
  </Grid>

  <h2 id="accessibility">Accessibility</h2>
  <p>NewTab follows best practices:</p>
  <ul>
    <li>Correct ARIA roles</li>
    <li>Keyboard navigation (arrows, home/end, visible focus)</li>
    <li>Tabindex updated dynamically</li>
    <li>WCAG contrast and target size</li>
  </ul>

  <h2 id="examples">Advanced examples</h2>
  <p>Some common scenarios:</p>
  <ul>
    <li>Using <code class="inline-code">onTabChange</code> to synchronize external state:</li>
  </ul>
  <Code lang="astro" code={`<script setup lang="ts">
let active = 0;
function handleTab(id) {
  console.log('switched to', id);
}
</script>

<NewTab
  tabs={[
    { id: 'a', label: 'A' },
    { id: 'b', label: 'B' },
  ]}
  panels={[
    { id: 'a', content: 'Content A' },
    { id: 'b', content: 'Content B' },
  ]}
  active={active}
  onTabChange={handleTab}
/>`} />

  <h2 id="best-practices">Best practices</h2>
  <ul>
    <li>Always provide a unique identifier for each tab.</li>
    <li>Ensure the <code class="inline-code">tabs</code> and <code class="inline-code">panels</code> arrays have equal length and matching ids.</li>
    <li>Use short, descriptive labels for tabs.</li>
    <li>Use the <code class="inline-code">native</code> variant to disable design-system styling when embedding inside a custom UI.</li>
    <li>Test with a screen reader to verify roles and aria attributes are announced.</li>
  </ul>

</DocLayout>

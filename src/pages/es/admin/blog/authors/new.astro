---
export const prerender = false;

import AdminLayout from "@layouts/AdminLayout.astro";
import Card from "@components/ui/Card/Card.astro";
import CardHeader from "@components/ui/Card/CardHeader.astro";
import CardContent from "@components/ui/Card/CardContent.astro";
import Button from "@components/ui/Button.astro";
import Input from "@components/ui/Form/Input.astro";
import Label from "@components/ui/Form/Label.astro";
import Textarea from "@components/ui/Form/Textarea.astro";
import Switch from "@components/ui/Form/Switch.astro";
import MarkdownEditor from "@components/admin/MarkdownEditor.astro";
import MediaPickerModal from "@components/admin/MediaPickerModal.astro";
import { Icon } from "astro-icon/components";
import { getDrizzle } from "@database/drizzle";
import { blogOrganizations } from "@database/schemas";

const currentLocale = Astro.currentLocale || "es";
const adminBase = `/${currentLocale}/admin/blog/authors`;

const db = await getDrizzle();
const allOrgs = await db.select({ id: blogOrganizations.id, name: blogOrganizations.name }).from(blogOrganizations).orderBy(blogOrganizations.name);

const extractLocalized = (value: unknown, locale: string = currentLocale): string => {
  if (typeof value === "string") return value;
  if (value && typeof value === "object") { const obj = value as Record<string, string>; return obj[locale] || Object.values(obj)[0] || ""; }
  return "";
};

const supportedLocales = [
  { code: "fr", label: "Français", flag: "🇫🇷" },
  { code: "en", label: "English", flag: "🇬🇧" },
  { code: "es", label: "Español", flag: "🇪🇸" },
  { code: "ar", label: "العربية", flag: "🇸🇦" },
];
---

<AdminLayout title="Nuevo autor" activeSection="blog-authors">
  <header class="admin-page-header">
    <div class="admin-page-title-row">
      <div class="admin-page-title-group">
        <a href={adminBase} class="back-link"><Icon name="mdi:arrow-left" /></a>
        <h1>Nuevo autor</h1>
      </div>
    </div>
    <p class="admin-page-subtitle">Cree un perfil de autor multilingüe con biografía, avatar, redes y opciones de visibilidad.</p>
  </header>

  <form id="author-form" class="author-form">
    <div class="form-layout">
      <!-- Main content -->
      <div class="form-main">

        <!-- Multilingual fields -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:translate" class="card-title-icon" />
              <span>Contenido multilingüe</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="locale-tabs" role="tablist">
              {supportedLocales.map((loc, i) => (
                <button type="button" role="tab" class:list={["locale-tab", { active: i === 0 }]} data-locale={loc.code} aria-selected={i === 0 ? "true" : "false"}>
                  <span class="locale-flag">{loc.flag}</span>
                  {loc.label}
                </button>
              ))}
            </div>

            {supportedLocales.map((loc, i) => (
              <div class:list={["locale-panel", { active: i === 0 }]} data-locale-panel={loc.code}>
                <div class="form-row">
                  <div class="form-field">
                    <Label htmlFor={`displayName-${loc.code}`}>Nombre mostrado *</Label>
                    <Input id={`displayName-${loc.code}`} name={`displayName-${loc.code}`} placeholder={`Nombre en ${loc.label}…`} />
                  </div>
                </div>
                <div class="form-row form-row--2">
                  <div class="form-field">
                    <Label htmlFor={`givenName-${loc.code}`}>Nombre</Label>
                    <Input id={`givenName-${loc.code}`} name={`givenName-${loc.code}`} placeholder={`Nombre en ${loc.label}…`} />
                  </div>
                  <div class="form-field">
                    <Label htmlFor={`familyName-${loc.code}`}>Apellido</Label>
                    <Input id={`familyName-${loc.code}`} name={`familyName-${loc.code}`} placeholder={`Apellido en ${loc.label}…`} />
                  </div>
                </div>
                <div class="form-field">
                <Label htmlFor={`jobTitle-${loc.code}`}>Título / Cargo</Label>
                <Input id={`jobTitle-${loc.code}`} name={`jobTitle-${loc.code}`} placeholder={`Ej: Redactor jefe`} />
                </div>
                <div class="form-field">
                  <Label htmlFor={`bio-${loc.code}`}>Biografía</Label>
                  <MarkdownEditor id={`bio-${loc.code}`} name={`bio-${loc.code}`} rows={4} placeholder={`Bio en ${loc.label}…`} minimal />
                </div>

                <details class="seo-section">
                  <summary class="seo-toggle">
                    <Icon name="mdi:search-web" class="seo-icon" />
                    SEO — {loc.label}
                  </summary>
                  <div class="seo-fields">
                    <div class="form-field">
                      <Label htmlFor={`seo-title-${loc.code}`}>Título SEO</Label>
                      <Input id={`seo-title-${loc.code}`} name={`seo-title-${loc.code}`} placeholder={`Título SEO en ${loc.label}…`} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-desc-${loc.code}`}>Descripción SEO</Label>
                      <Textarea id={`seo-desc-${loc.code}`} name={`seo-desc-${loc.code}`} rows={2} placeholder={`Descripción SEO en ${loc.label}…`} />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`seo-keywords-${loc.code}`}>Palabras clave SEO</Label>
                      <Input id={`seo-keywords-${loc.code}`} name={`seo-keywords-${loc.code}`} placeholder="palabra1, palabra2, palabra3…" />
                    </div>
                    <div class="form-field">
                      <Label htmlFor={`canonical-${loc.code}`}>URL canónica</Label>
                      <Input id={`canonical-${loc.code}`} name={`canonical-${loc.code}`} type="url" placeholder="https://…" />
                    </div>
                  </div>
                </details>
              </div>
            ))}
          </CardContent>
        </Card>

        <!-- Contact & social -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:link-variant" class="card-title-icon" />
              <span>Contacto y redes</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-row form-row--2">
              <div class="form-field">
                <Label htmlFor="email">Email</Label>
                <Input id="email" name="email" type="email" placeholder="auteur@example.com" />
              </div>
              <div class="form-field">
                <Label htmlFor="website">Sitio web</Label>
                <Input id="website" name="website" type="url" placeholder="https://…" />
              </div>
            </div>
            <div class="form-field">
              <Label htmlFor="sameAs">Perfiles sociales (uno por línea)</Label>
              <Textarea id="sameAs" name="sameAs" rows={3} placeholder={"https://twitter.com/…\nhttps://linkedin.com/in/…\nhttps://github.com/…"} />
              <span class="field-hint">URLs de perfiles sociales, una por línea. Se almacenará en formato JSON-LD sameAs.</span>
            </div>
          </CardContent>
        </Card>

        <!-- Avatar upload -->
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:account-circle-outline" class="card-title-icon" />
              <span>Foto / Avatar</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="upload-zone" id="upload-zone">
              <div class="upload-actions-row">
                <button type="button" id="btn-pick-media" class="btn-pick-media">
                  <Icon name="mdi:image-search-outline" class="pick-icon" />
                  Biblioteca
                </button>
                <span class="upload-separator">o</span>
                <label class="btn-upload-file" id="btn-upload-file">
                  <Icon name="mdi:cloud-upload-outline" class="pick-icon" />
                  Subir
                  <input type="file" id="image-input" accept="image/jpeg,image/png,image/webp,image/avif" class="upload-file-input" />
                </label>
              </div>
              <div class="upload-preview" id="upload-preview" style="display: none;">
                <img id="preview-img" src="" alt="Vista previa" />
                <button type="button" class="upload-remove" id="remove-image" title="Quitar imagen">
                  <Icon name="mdi:close-circle" />
                </button>
              </div>
            </div>
            <input type="hidden" id="avatar-id" name="avatarId" value="" />
            <input type="hidden" id="avatar-url" name="avatarUrl" value="" />
          </CardContent>
        </Card>
      </div>

      <!-- Sidebar -->
      <div class="form-sidebar">
        <Card elevation="sm">
          <CardHeader>
            <div class="card-title-row">
              <Icon name="mdi:cog-outline" class="card-title-icon" />
              <span>Configuración</span>
            </div>
          </CardHeader>
          <CardContent>
            <div class="form-field">
              <Label htmlFor="slug">Slug *</Label>
              <div class="slug-row">
                <Input id="slug" name="slug" placeholder="jean-dupont" />
                <button type="button" id="generate-slug" class="slug-btn" title="Generar desde el nombre FR">
                  <Icon name="mdi:auto-fix" />
                </button>
              </div>
              <span class="field-hint">URL : /blog/autor/<strong id="slug-preview">…</strong></span>
            </div>

            {allOrgs.length > 0 && (
              <div class="form-field">
                <Label htmlFor="worksFor">Organización</Label>
                <select id="worksFor" name="worksForId" class="select-native">
                  <option value="">Ninguna</option>
                  {allOrgs.map((org) => (
                    <option value={org.id}>{extractLocalized(org.name)}</option>
                  ))}
                </select>
              </div>
            )}

            <div class="switch-group">
              <div class="switch-item">
                <Switch id="is-featured" name="isFeatured" />
                <Label htmlFor="is-featured">Featured</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-home" name="displayInHome" />
                <Label htmlFor="display-home">Mostrar en inicio</Label>
              </div>
              <div class="switch-item">
                <Switch id="display-blog" name="displayInBlog" checked />
                <Label htmlFor="display-blog">Mostrar en el blog</Label>
              </div>
            </div>
          </CardContent>
        </Card>

        <div class="action-bar">
          <a href={adminBase} class="action-cancel">Cancelar</a>
          <Button type="button" color="primary" id="btn-save" icon={{ name: "mdi:content-save-outline", side: "left" }}>
            Crear autor
          </Button>
        </div>
      </div>
    </div>
  </form>
  <MediaPickerModal />
</AdminLayout>

<script>
  import { initMarkdownEditors } from "@lib/admin/markdown-editor";
  import { openMediaPicker } from "@lib/admin/media-picker";
  import { showToast } from "@lib/admin/toast";

  document.addEventListener("DOMContentLoaded", () => {
    // Init markdown editors
    const editors = initMarkdownEditors();

    // Locale tabs
    const tabs = document.querySelectorAll<HTMLElement>(".locale-tab");
    const panels = document.querySelectorAll<HTMLElement>(".locale-panel");
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const locale = tab.dataset.locale!;
        tabs.forEach((t) => { t.classList.remove("active"); t.setAttribute("aria-selected", "false"); });
        panels.forEach((p) => p.classList.remove("active"));
        tab.classList.add("active");
        tab.setAttribute("aria-selected", "true");
        document.querySelector(`[data-locale-panel="${locale}"]`)?.classList.add("active");
      });
    });

    // Slug
    const nameInput = document.getElementById("displayName-fr") as HTMLInputElement | null;
    const slugInput = document.getElementById("slug") as HTMLInputElement | null;
    const slugPreview = document.getElementById("slug-preview");
    const generateSlugBtn = document.getElementById("generate-slug");

    const slugify = (text: string): string =>
      text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");

    const updateSlug = () => {
      if (nameInput && slugInput) {
        slugInput.value = slugify(nameInput.value);
        if (slugPreview) slugPreview.textContent = slugInput.value || "…";
      }
    };

    generateSlugBtn?.addEventListener("click", updateSlug);
    slugInput?.addEventListener("input", () => { if (slugPreview) slugPreview.textContent = slugInput.value || "…"; });

    let autoSlug = true;
    nameInput?.addEventListener("input", () => { if (autoSlug && slugInput && !slugInput.value) updateSlug(); });
    slugInput?.addEventListener("input", () => { autoSlug = false; });

    // Image upload
    const uploadZone = document.getElementById("upload-zone");
    const imageInput = document.getElementById("image-input") as HTMLInputElement;
    const uploadPreview = document.getElementById("upload-preview");
    const previewImg = document.getElementById("preview-img") as HTMLImageElement;
    const removeImageBtn = document.getElementById("remove-image");
    const avatarId = document.getElementById("avatar-id") as HTMLInputElement;
    const avatarUrl = document.getElementById("avatar-url") as HTMLInputElement;

    function setAvatarPreview(id: string, url: string) {
      avatarId.value = id;
      avatarUrl.value = url;
      previewImg.src = url;
      uploadPreview!.style.display = "block";
    }

    function clearAvatarPreview() {
      avatarId.value = ""; avatarUrl.value = "";
      uploadPreview!.style.display = "none"; previewImg.src = "";
    }

    // Media library picker
    document.getElementById("btn-pick-media")?.addEventListener("click", async () => {
      const result = await openMediaPicker();
      if (result) setAvatarPreview(result.id, result.url);
    });

    // Upload via modal (with metadata form)
    imageInput?.addEventListener("change", async () => {
      const file = imageInput.files?.[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setAvatarPreview(result.id, result.url);
      }
      imageInput.value = "";
    });

    // Drag & drop → open modal with file
    uploadZone?.addEventListener("dragover", (e) => { e.preventDefault(); uploadZone.classList.add("dragover"); });
    uploadZone?.addEventListener("dragleave", () => uploadZone.classList.remove("dragover"));
    uploadZone?.addEventListener("drop", async (e) => {
      e.preventDefault(); uploadZone.classList.remove("dragover");
      const file = e.dataTransfer?.files[0];
      if (file) {
        const result = await openMediaPicker({ file });
        if (result) setAvatarPreview(result.id, result.url);
      }
    });

    removeImageBtn?.addEventListener("click", (e) => {
      e.stopPropagation();
      clearAvatarPreview();
    });

    // Form submission
    const btnSave = document.getElementById("btn-save");
    btnSave?.addEventListener("click", async () => {
      const slug = (document.getElementById("slug") as HTMLInputElement).value.trim();
      const frName = (document.getElementById("displayName-fr") as HTMLInputElement).value.trim();
      if (!frName) { showToast("El nombre mostrado en francés es obligatorio.", "warning"); return; }
      if (!slug) { showToast("El slug es obligatorio.", "warning"); return; }

      // Sync markdown editors to underlying textareas
      editors.forEach((editor) => (editor.codemirror as any).save());

      const locales = ["fr", "en", "es", "ar"];
      const collect = (prefix: string) => {
        const obj: Record<string, string> = {};
        locales.forEach((loc) => {
          const el = document.getElementById(`${prefix}-${loc}`) as HTMLInputElement | HTMLTextAreaElement | null;
          const v = el?.value.trim();
          if (v) obj[loc] = v;
        });
        return Object.keys(obj).length > 0 ? obj : null;
      };

      const sameAsRaw = (document.getElementById("sameAs") as HTMLTextAreaElement)?.value.trim();
      const sameAs = sameAsRaw ? sameAsRaw.split("\n").map((s: string) => s.trim()).filter(Boolean) : null;

      const payload: Record<string, unknown> = {
        action: "create",
        slug,
        displayName: collect("displayName"),
        givenName: collect("givenName"),
        familyName: collect("familyName"),
        jobTitle: collect("jobTitle"),
        bio: collect("bio"),
        email: (document.getElementById("email") as HTMLInputElement)?.value.trim() || null,
        website: (document.getElementById("website") as HTMLInputElement)?.value.trim() || null,
        sameAs,
        avatarId: (document.getElementById("avatar-id") as HTMLInputElement).value || null,
        avatarUrl: (document.getElementById("avatar-url") as HTMLInputElement).value || null,
        worksForId: (document.getElementById("worksFor") as HTMLSelectElement)?.value || null,
        isFeatured: (document.getElementById("is-featured") as HTMLInputElement).checked,
        displayInHome: (document.getElementById("display-home") as HTMLInputElement).checked,
        displayInBlog: (document.getElementById("display-blog") as HTMLInputElement).checked,
        seoTitle: collect("seo-title"),
        seoDescription: collect("seo-desc"),
        seoKeywords: collect("seo-keywords"),
        canonicalUrl: collect("canonical"),
      };

      btnSave.setAttribute("disabled", "true");
      btnSave.textContent = "Creando…";

      try {
        const res = await fetch("/api/admin/blog/authors", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.ok || data.id) {
          showToast("¡Autor creado con éxito! Redireccionando…", "success");
          setTimeout(() => {
            window.location.href = `${window.location.pathname.replace("/new", "")}/${data.id}/edit`;
          }, 800);
        } else {
          showToast(data.error || "Error al crear.", "error");
          btnSave.removeAttribute("disabled");
          btnSave.textContent = "Crear autor";
        }
      } catch {
        showToast("Error de red — verifique su conexión.", "error");
        btnSave.removeAttribute("disabled");
        btnSave.textContent = "Crear autor";
      }
    });
  });
</script>

<style>
  .admin-page-header { margin-bottom: var(--space-6, 1.5rem); }
  .admin-page-title-row { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-title-group { display: flex; align-items: center; gap: var(--space-3, 0.75rem); }
  .admin-page-header h1 { font-family: var(--font-family-display, "Space Grotesk", sans-serif); font-size: var(--h2-font-size, 2rem); font-weight: 800; color: var(--heading-color, #0f172a); margin: 0; }
  .admin-page-subtitle { color: var(--text-muted, #64748b); font-size: 0.9375rem; margin: var(--space-1, 0.25rem) 0 0; }
  .back-link { display: inline-flex; align-items: center; padding: var(--space-2, 0.5rem); border-radius: var(--border-radius-md, 0.375rem); color: var(--text-muted, #64748b); transition: color 0.15s, background 0.15s; }
  .back-link:hover { color: var(--text-default, #0f172a); background: var(--bg-inset, #f1f5f9); }
  .back-link [data-icon] { width: 1.25rem; height: 1.25rem; }

  .form-layout { display: grid; grid-template-columns: 1fr 340px; gap: var(--space-6, 1.5rem); align-items: start; }
  .form-main { display: flex; flex-direction: column; gap: var(--space-4, 1rem); }
  .form-sidebar { display: flex; flex-direction: column; gap: var(--space-4, 1rem); position: sticky; top: var(--space-4, 1rem); }

  .card-title-row { display: flex; align-items: center; gap: var(--space-2, 0.5rem); font-weight: 700; font-size: 0.9375rem; color: var(--heading-color, #0f172a); }
  .card-title-icon { width: 1.125rem; height: 1.125rem; color: var(--color-primary, #eab308); }
  .form-field { margin-bottom: var(--space-3, 0.75rem); }
  .form-field:last-child { margin-bottom: 0; }
  .form-row { margin-bottom: var(--space-3, 0.75rem); }
  .form-row--2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3, 0.75rem); }
  .form-row--2 .form-field { margin-bottom: 0; }
  .field-hint { font-size: 0.75rem; color: var(--text-muted, #64748b); margin-top: 0.25rem; display: block; }
  .field-hint strong { font-family: var(--font-family-mono, monospace); }

  .locale-tabs { display: flex; gap: 0; border-bottom: 2px solid var(--border-default, #e2e8f0); margin-bottom: var(--space-4, 1rem); }
  .locale-tab { display: inline-flex; align-items: center; gap: var(--space-1, 0.25rem); padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem); border: none; background: none; cursor: pointer; font-size: 0.8125rem; font-weight: 600; color: var(--text-muted, #64748b); border-bottom: 2px solid transparent; margin-bottom: -2px; transition: all 0.15s; }
  .locale-tab:hover { color: var(--text-default, #0f172a); }
  .locale-tab.active { color: var(--color-primary, #eab308); border-bottom-color: var(--color-primary, #eab308); }
  .locale-flag { font-size: 1rem; }
  .locale-panel { display: none; }
  .locale-panel.active { display: block; }

  .seo-section { margin-top: var(--space-3, 0.75rem); border: 1px solid var(--border-default, #e2e8f0); border-radius: var(--border-radius-md, 0.375rem); }
  .seo-toggle { display: flex; align-items: center; gap: var(--space-2, 0.5rem); padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem); font-size: 0.8125rem; font-weight: 600; color: var(--text-muted, #64748b); cursor: pointer; user-select: none; }
  .seo-toggle:hover { color: var(--text-default, #0f172a); }
  .seo-icon { width: 1rem; height: 1rem; }
  .seo-fields { padding: 0 var(--space-3, 0.75rem) var(--space-3, 0.75rem); }

  .slug-row { display: flex; gap: var(--space-2, 0.5rem); align-items: center; }
  .slug-btn { display: inline-flex; align-items: center; justify-content: center; width: 2.25rem; height: 2.25rem; flex-shrink: 0; border: 1px solid var(--border-default, #e2e8f0); border-radius: var(--border-radius-md, 0.375rem); background: var(--bg-surface, white); color: var(--text-muted, #64748b); cursor: pointer; transition: all 0.15s; }
  .slug-btn:hover { border-color: var(--color-primary, #eab308); color: var(--color-primary, #eab308); }
  .slug-btn [data-icon] { width: 1rem; height: 1rem; }

  .select-native { width: 100%; padding: 0.5rem 0.75rem; border: 1px solid var(--border-default, #e2e8f0); border-radius: var(--border-radius-md, 0.375rem); background: var(--bg-surface, white); font-size: 0.875rem; color: var(--text-default, #1e293b); }

  .switch-group { display: flex; flex-direction: column; gap: var(--space-3, 0.75rem); margin-top: var(--space-4, 1rem); padding-top: var(--space-4, 1rem); border-top: 1px solid var(--border-default, #e2e8f0); }
  .switch-item { display: flex; align-items: center; gap: var(--space-2, 0.5rem); }

  .upload-zone { border: 2px dashed var(--border-default, #e2e8f0); border-radius: var(--border-radius-lg, 0.5rem); transition: border-color 0.15s, background 0.15s; overflow: hidden; }
  .upload-zone:hover, .upload-zone.dragover { border-color: var(--color-primary, #eab308); background: var(--bg-subtle, #fffbeb); }
  .upload-actions-row { display: flex; align-items: center; justify-content: center; gap: var(--space-3, 0.75rem); padding: var(--space-6, 1.5rem); }

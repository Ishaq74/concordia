---
export const prerender = false;

import BaseLayout from "@layouts/BaseLayout.astro";
import Link from "@components/ui/Link.astro";
import Badge from "@components/ui/Badge.astro";
import Select from "@components/ui/Form/Select.astro";
import { Icon } from "astro-icon/components";
import { getLocalizedUrl } from "@lib/i18n/route-helpers";
import { isAdminUser } from "@lib/admin/permissions";
import AdminToast from "@components/admin/AdminToast.astro";
import { getDrizzle } from "@database/drizzle";
import { organization, member } from "@database/schemas/auth-schema";
import { eq, inArray } from "drizzle-orm";

interface Props {
  title: string;
  description?: string;
  activeSection?: string;
}

const { title, description, activeSection } = Astro.props;
import { getTranslations } from "@i18n/translations";
const currentLocale = Astro.currentLocale || "fr";
const t = getTranslations(currentLocale);

const user = Astro.locals.user;

// Double protection : session + rôle admin
if (!user) {
  return Astro.redirect(
    `/${currentLocale}/auth/${({ fr: "connexion", en: "sign-in", ar: "sign-in", es: "sign-in" } as Record<string, string>)[currentLocale] ?? "sign-in"}?redirect=${encodeURIComponent(Astro.url.pathname)}`,
    302,
  );
}

if (!isAdminUser(user)) {
  return Astro.redirect(getLocalizedUrl(currentLocale, "/") || "/", 302);
}

const adminBase = `/${currentLocale}/admin`;

// Fetch user's organizations for the org selector
const db = await getDrizzle();
const userMemberships = user
  ? await db.select({ organizationId: member.organizationId, role: member.role }).from(member).where(eq(member.userId, user.id))
  : [];
const orgIds = userMemberships.map((m) => m.organizationId);
const userOrgs: { id: string; name: string; slug: string; logo: string | null }[] = [];
if (orgIds.length > 0) {
  const orgs = await db
    .select({ id: organization.id, name: organization.name, slug: organization.slug, logo: organization.logo })
    .from(organization)
    .where(inArray(organization.id, orgIds));
  userOrgs.push(...orgs);
}
const activeOrgId = Astro.locals.organizationId ?? null;

interface AdminNavGroup {
  label: string;
  items: AdminNavItem[];
}

interface AdminNavItem {
  key: string;
  label: string;
  href: string;
  icon: string;
}

const navGroups: AdminNavGroup[] = [
  {
    label: t.adminPanel?.title ?? "Administration",
    items: [
      {
        key: "dashboard",
        label: t.adminPanel?.dashboard ?? "Tableau de bord",
        href: adminBase,
        icon: "mdi:view-dashboard",
      },
      {
        key: "users",
        label: t.adminPanel?.users ?? "Utilisateurs",
        href: `${adminBase}/users`,
        icon: "mdi:account-group",
      },
      {
        key: "moderation",
        label: t.adminPanel?.moderation ?? "Modération",
        href: `${adminBase}/moderation`,
        icon: "mdi:shield-check",
      },
      {
        key: "audit",
        label: t.adminPanel?.audit ?? "Journal d'audit",
        href: `${adminBase}/audit`,
        icon: "mdi:clipboard-text-clock",
      },
      {
        key: "config",
        label: t.adminPanel?.config ?? "Configuration",
        href: `${adminBase}/config`,
        icon: "mdi:cog",
      },
    ],
  },
  {
    label: t.nav?.blog ?? "Blog",
    items: [
      {
        key: "blog-articles",
        label: t.adminPanel?.navArticles ?? "Articles",
        href: `${adminBase}/blog/articles`,
        icon: "mdi:newspaper-variant-outline",
      },
      {
        key: "blog-categories",
        label: t.adminPanel?.navCategories ?? "Catégories",
        href: `${adminBase}/blog/categories`,
        icon: "mdi:folder-outline",
      },
      {
        key: "blog-authors",
        label: t.adminPanel?.navAuthors ?? "Auteurs",
        href: `${adminBase}/blog/authors`,
        icon: "mdi:account-edit",
      },
      {
        key: "blog-media",
        label: t.adminPanel?.navMedia ?? "Médias",
        href: `${adminBase}/blog/media`,
        icon: "mdi:image-multiple",
      },
      {
        key: "blog-comments",
        label: t.adminPanel?.navComments ?? "Commentaires",
        href: `${adminBase}/blog/comments`,
        icon: "mdi:comment-text-multiple-outline",
      },
    ],
  },
  {
    label: t.adminServices?.listings?.title ?? "Services",
    items: [
      {
        key: "services",
        label: t.adminServices?.listings?.title ?? "Services",
        href: `${adminBase}/services`,
        icon: "mdi:briefcase-outline",
      },
      {
        key: "services-categories",
        label: t.adminServices?.categories?.title ?? "Catégories",
        href: `${adminBase}/services/categories`,
        icon: "mdi:shape-outline",
      },
      {
        key: "services-bookings",
        label: t.adminServices?.bookings?.title ?? "Réservations",
        href: `${adminBase}/services/bookings`,
        icon: "mdi:calendar-check",
      },
    ],
  },
  {
    label: t.adminPanel?.organizations ?? "Organisations",
    items: [
      {
        key: "organizations",
        label: t.adminPanel?.orgList ?? "Toutes les orgs",
        href: `${adminBase}/organizations`,
        icon: "mdi:domain",
      },
      {
        key: "org-dashboard",
        label: t.adminPanel?.orgDashboard ?? "Tableau de bord org",
        href: `${adminBase}/organizations/dashboard`,
        icon: "mdi:view-dashboard-variant",
      },
      {
        key: "org-profile",
        label: t.adminPanel?.orgProfile ?? "Profil & Config",
        href: `${adminBase}/organizations/profile`,
        icon: "mdi:badge-account-horizontal",
      },
      {
        key: "org-members",
        label: t.adminPanel?.orgMembers ?? "Membres & Rôles",
        href: `${adminBase}/organizations/members`,
        icon: "mdi:account-multiple-check",
      },
      {
        key: "org-blog",
        label: t.adminPanel?.orgBlog ?? "Blog org",
        href: `${adminBase}/organizations/blog`,
        icon: "mdi:post-outline",
      },
      {
        key: "org-services",
        label: t.adminPanel?.orgServices ?? "Services org",
        href: `${adminBase}/organizations/services`,
        icon: "mdi:room-service-outline",
      },
      {
        key: "org-bookings",
        label: t.adminPanel?.orgBookings ?? "Réservations org",
        href: `${adminBase}/organizations/bookings`,
        icon: "mdi:calendar-account",
      },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <div class="admin-layout">
    <!-- Mobile top bar -->
    <div class="admin-mobile-bar">
      <button type="button" class="admin-hamburger" id="admin-hamburger" aria-label={t.adminPanel?.menuAdmin ?? "Menu admin"} aria-expanded="false">
        <Icon name="mdi:menu" class="hamburger-icon" />
      </button>
      <div class="admin-mobile-bar-title">
        <Badge color="error" text="Admin" />
        <span class="admin-sidebar-title">{t.adminPanel?.title ?? "Administration"}</span>
      </div>
    </div>

    <!-- Backdrop overlay -->
    <div class="admin-sidebar-backdrop" id="admin-sidebar-backdrop"></div>

    <nav class="admin-sidebar" id="admin-sidebar" aria-label={t.adminPanel?.title ?? "Administration"}>
      <div class="admin-sidebar-header">
        <Badge color="error" text="Admin" />
        <span class="admin-sidebar-title">{t.adminPanel?.title ?? "Administration"}</span>
        <button type="button" class="admin-sidebar-close" id="admin-sidebar-close" aria-label={t.adminPanel?.closeMenu ?? "Fermer le menu"}>
          <Icon name="mdi:close" />
        </button>
      </div>

      {userOrgs.length > 0 && (
        <div class="org-selector">
          <Select id="org-selector" className="org-select" aria-label={t.adminPanel?.orgSelector ?? "Organisation"}>
            <option value="">{t.adminPanel?.allOrgs ?? "Toutes les organisations"}</option>
            {userOrgs.map((org) => (
              <option value={org.id} selected={org.id === activeOrgId}>{org.name}</option>
            ))}
          </Select>
        </div>
      )}

      {navGroups.map((group) => (
        <div class="admin-nav-group">
          <h3 class="admin-nav-group-label">{group.label}</h3>
          <ul class="admin-nav" role="list">
            {group.items.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={["admin-nav-link", { active: activeSection === item.key }]}
                  aria-current={activeSection === item.key ? "page" : undefined}
                >
                  <Icon name={item.icon} class="admin-nav-icon" />
                  <span>{item.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="admin-sidebar-footer">
        <Link
          href={getLocalizedUrl(currentLocale, "/") || "/"}
          style="link"
          className="admin-back-link"
        >
          <Icon name="mdi:arrow-left" class="admin-back-icon" />
          {t.common?.back ?? "Retour"}
        </Link>
      </div>
    </nav>

    <main class="admin-content">
      <slot />
    </main>
    <AdminToast />
  </div>
</BaseLayout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const hamburger = document.getElementById("admin-hamburger");
    const sidebar = document.getElementById("admin-sidebar");
    const backdrop = document.getElementById("admin-sidebar-backdrop");
    const closeBtn = document.getElementById("admin-sidebar-close");

    function openSidebar() {
      sidebar?.classList.add("open");
      backdrop?.classList.add("visible");
      hamburger?.setAttribute("aria-expanded", "true");
      document.body.style.overflow = "hidden";
    }
    function closeSidebar() {
      sidebar?.classList.remove("open");
      backdrop?.classList.remove("visible");
      hamburger?.setAttribute("aria-expanded", "false");
      document.body.style.overflow = "";
    }

    hamburger?.addEventListener("click", openSidebar);
    closeBtn?.addEventListener("click", closeSidebar);
    backdrop?.addEventListener("click", closeSidebar);

    // Org selector: switch active organization via Better Auth API
    const orgSelector = document.getElementById("org-selector") as HTMLSelectElement | null;
    orgSelector?.addEventListener("change", async () => {
      const orgId = orgSelector.value;
      try {
        await fetch("/api/auth/organization/set-active", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ organizationId: orgId || null }),
        });
        window.location.reload();
      } catch {
        console.error("Failed to switch organization");
      }
    });
  });
</script>

<style>
  .admin-layout {
    display: grid;
    grid-template-columns: 260px 1fr;
    min-height: calc(100vh - 80px);
    gap: 0;
  }

  /* Mobile top bar - hidden on desktop */
  .admin-mobile-bar {
    display: none;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem);
    background: var(--bg-subtle, #f8fafc);
    border-bottom: 1px solid var(--border-default, #e2e8f0);
  }

  .admin-hamburger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-md, 0.375rem);
    background: var(--bg-surface, white);
    color: var(--text-default, #1e293b);
    cursor: pointer;
    transition: border-color 0.15s;
    flex-shrink: 0;
  }

  .admin-hamburger:hover {
    border-color: var(--color-primary, #eab308);
  }

  .hamburger-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .admin-mobile-bar-title {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
  }

  /* Sidebar close button - hidden on desktop */
  .admin-sidebar-close {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: none;
    border-radius: var(--border-radius-md, 0.375rem);
    background: transparent;
    color: var(--text-muted, #64748b);
    cursor: pointer;
    margin-left: auto;
    transition: color 0.15s, background 0.15s;
  }

  .admin-sidebar-close:hover {
    color: var(--text-default, #0f172a);
    background: var(--bg-inset, #f1f5f9);
  }

  .admin-sidebar-close [data-icon] {
    width: 1.25rem;
    height: 1.25rem;
  }

  /* Backdrop - hidden by default */
  .admin-sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    z-index: 998;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .admin-sidebar-backdrop.visible {
    opacity: 1;
  }

  .admin-sidebar {
    background: var(--bg-subtle, #f8fafc);
    border-right: 1px solid var(--border-default, #e2e8f0);
    position: sticky;
    top: 80px;
    height: calc(100vh - 80px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .admin-sidebar-header {
    display: flex;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    padding: var(--space-4, 1rem);
    border-bottom: 1px solid var(--border-default, #e2e8f0);
  }

  /* Org selector */
  .org-selector {
    padding: 0 var(--space-4, 1rem) var(--space-3, 0.75rem);
    border-bottom: 1px solid var(--border-default, #e2e8f0);
  }
  .org-select {
    width: 100%; padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    border: 1px solid var(--border-default, #e2e8f0);
    border-radius: var(--border-radius-md, 0.375rem);
    background: var(--bg-surface, white); color: var(--text-default, #0f172a);
    font-size: 0.8125rem; font-weight: 500; cursor: pointer;
    transition: border-color 0.15s;
  }
  .org-select:hover, .org-select:focus { border-color: var(--color-primary, #eab308); outline: none; }

  .admin-sidebar-title {
    font-family: var(--font-family-display, "Space Grotesk", sans-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--heading-color, #0f172a);
  }

  .admin-nav-group {
    padding: var(--space-2, 0.5rem) 0;
  }

  .admin-nav-group + .admin-nav-group {
    border-top: 1px solid var(--border-default, #e2e8f0);
  }

  .admin-nav-group-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted, #64748b);
    padding: var(--space-3, 0.75rem) var(--space-4, 1rem) var(--space-1, 0.25rem);
    margin: 0;
  }

  .admin-nav {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .admin-nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-2, 0.5rem) var(--space-4, 1rem);
    text-decoration: none;
    color: var(--text-muted, #64748b);
    font-size: 0.875rem;
    border-left: 3px solid transparent;
    transition: background-color 0.15s, color 0.15s;
  }

  .admin-nav-link:hover {
    background: var(--bg-inset, #f1f5f9);
    color: var(--text-default, #1e293b);
  }

  .admin-nav-link.active {
    background: var(--bg-inset, #f1f5f9);
    color: var(--color-primary, #eab308);
    border-left-color: var(--color-primary, #eab308);
    font-weight: 600;
  }

  .admin-nav-icon {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    opacity: 0.65;
  }

  .admin-nav-link.active .admin-nav-icon,
  .admin-nav-link:hover .admin-nav-icon {
    opacity: 1;
  }

  .admin-sidebar-footer {
    margin-top: auto;
    padding: var(--space-4, 1rem);
    border-top: 1px solid var(--border-default, #e2e8f0);
  }

  .admin-back-link {
    display: inline-flex !important;
    align-items: center;
    gap: var(--space-2, 0.5rem);
    font-size: 0.8125rem;
  }

  .admin-back-icon {
    width: 1rem;
    height: 1rem;
  }

  .admin-content {
    padding: var(--space-6, 1.5rem) var(--space-8, 2rem);
    max-width: 1400px;
    min-height: 100%;
    min-width: 0;
  }

  /* ── Tablet: 1024px ── */
  @media (max-width: 1024px) {
    .admin-content {
      padding: var(--space-4, 1rem) var(--space-5, 1.25rem);
    }
  }

  /* ── Mobile: 768px ── */
  @media (max-width: 768px) {
    .admin-layout {
      grid-template-columns: 1fr;
      display: flex;
      flex-direction: column;
    }

    .admin-mobile-bar {
      display: flex;
    }

    .admin-sidebar-close {
      display: flex;
    }

    .admin-sidebar-backdrop {
      display: block;
      pointer-events: none;
    }

    .admin-sidebar-backdrop.visible {
      pointer-events: auto;
    }

    .admin-sidebar {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 280px;
      max-width: 85vw;
      height: 100vh;
      z-index: 999;
      transform: translateX(-100%);
      transition: transform 0.25s ease;
      border-right: 1px solid var(--border-default, #e2e8f0);
      box-shadow: none;
    }

    .admin-sidebar.open {
      transform: translateX(0);
      box-shadow: 4px 0 24px rgba(0, 0, 0, 0.12);
    }

    .admin-content {
      padding: var(--space-4, 1rem);
    }
  }

  /* ── Small mobile: 480px ── */
  @media (max-width: 480px) {
    .admin-content {
      padding: var(--space-3, 0.75rem);
    }

    .admin-mobile-bar {
      padding: var(--space-2, 0.5rem) var(--space-3, 0.75rem);
    }

    .admin-sidebar-title {
      font-size: 0.9375rem;
    }
  }
</style>

  " data-auto-scroll="false" data-pause-on-hover="true" data-snap-align="true" data-show-scrollbar="false" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="75:2"> <div class="slider-container" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="76:33"> <ul class="slider-list" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="77:29"> <li class="slider-item">Item 1</li> </ul> </div> <div class="slider-controls" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="83:34"> <button class="slider-button slider-button--prev" aria-label="Défiler vers la gauche" type="button" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="88:8"> <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="89:155"> <path d="M15 18L9 12L15 6" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="90:12"></path> </svg> </button> <button class="slider-button slider-button--next" aria-label="Défiler vers la droite" type="button" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="97:8"> <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="98:155"> <path d="M9 18L15 12L9 6" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="99:12"></path> </svg> </button> </div> <div class="slider-indicators" role="tablist" aria-label="Navigation du slider" data-astro-cid-j7nxpspe data-astro-source-file="C:/Users/Utilisateur/Documents/concordia/src/components/ui/Slider/Slider.astro" data-astro-source-loc="105:4"></div> </div>  <script>
  class SliderComponent {
    constructor(slider) {
      this.slider = slider;
      this.list = slider.querySelector('.slider-list');
      this.prevButton = slider.querySelector('.slider-button--prev');
      this.nextButton = slider.querySelector('.slider-button--next');
      this.indicators = slider.querySelector('.slider-indicators');
      
      this.scrollAmount = 0;
      this.autoScrollInterval = null;
      this.isAutoScrolling = false;
      
      this.init();
    }

    init() {
      this.calculateScrollAmount();
      this.bindEvents();
      this.updateButtons();
      this.createIndicators();
      this.setupAutoScroll();
      
      // Observe resize
      const resizeObserver = new ResizeObserver(() => {
        this.calculateScrollAmount();
        this.createIndicators();
      });
      resizeObserver.observe(this.list);
    }

    calculateScrollAmount() {
      const item = this.list.querySelector(':scope > *');
      if (item) {
        const gap = parseFloat(getComputedStyle(this.list).gap) || 0;
        this.scrollAmount = item.offsetWidth + gap;
      }
    }

    bindEvents() {
      // Button navigation
      this.prevButton?.addEventListener('click', () => this.scrollLeft());
      this.nextButton?.addEventListener('click', () => this.scrollRight());

      // Update button states on scroll
      this.list.addEventListener('scroll', () => {
        this.updateButtons();
        this.updateIndicators();
      });

      // Keyboard navigation
      this.slider.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          this.scrollLeft();
        }
        if (e.key === 'ArrowRight') {
          e.preventDefault();
          this.scrollRight();
        }
      });

      // Touch/swipe support
      let startX = 0;
      let scrollLeft = 0;
      let isDragging = false;

      this.list.addEventListener('touchstart', (e) => {
        startX = e.touches[0].pageX - this.list.offsetLeft;
        scrollLeft = this.list.scrollLeft;
        isDragging = true;
      }, { passive: true });

      this.list.addEventListener('touchmove', (e) => {
        if (!isDragging) return;
        const x = e.touches[0].pageX - this.list.offsetLeft;
        const walk = (x - startX) * 2;
        this.list.scrollLeft = scrollLeft - walk;
      }, { passive: true });

      this.list.addEventListener('touchend', () => {
        isDragging = false;
      });

      // Mouse drag support
      let isMouseDragging = false;
      this.list.addEventListener('mousedown', (e) => {
        isMouseDragging = true;
        startX = e.pageX - this.list.offsetLeft;
        scrollLeft = this.list.scrollLeft;
        this.list.style.cursor = 'grabbing';
        e.preventDefault();
      });

      this.list.addEventListener('mouseleave', () => {
        isMouseDragging = false;
        this.list.style.cursor = 'grab';
      });

      this.list.addEventListener('mouseup', () => {
        isMouseDragging = false;
        this.list.style.cursor = 'grab';
      });

      this.list.addEventListener('mousemove', (e) => {
        if (!isMouseDragging) return;
        e.preventDefault();
        const x = e.pageX - this.list.offsetLeft;
        const walk = (x - startX) * 2;
        this.list.scrollLeft = scrollLeft - walk;
      });

      // Pause auto-scroll on hover
      if (this.slider.dataset.pauseOnHover === 'true') {
        this.slider.addEventListener('mouseenter', () => this.pauseAutoScroll());
        this.slider.addEventListener('mouseleave', () => this.resumeAutoScroll());
      }
    }

    scrollLeft() {
      this.list.scrollBy({
        left: -this.scrollAmount,
        behavior: 'smooth'
      });
    }

    scrollRight() {
      this.list.scrollBy({
        left: this.scrollAmount,
        behavior: 'smooth'
      });
    }

    updateButtons() {
      if (!this.prevButton || !this.nextButton) return;

      const isAtStart = this.list.scrollLeft <= 1;
      const isAtEnd = this.list.scrollLeft >= this.list.scrollWidth - this.list.clientWidth - 1;

      this.prevButton.disabled = isAtStart;
      this.nextButton.disabled = isAtEnd;
    }

    createIndicators() {
      if (!this.indicators) return;

      const itemCount = this.list.children.length;
      const visibleCount = Math.floor(this.list.clientWidth / this.scrollAmount);
      const indicatorCount = Math.ceil(itemCount / visibleCount);

      if (indicatorCount <= 1) {
        this.indicators.innerHTML = '';
        return;
      }

      this.indicators.innerHTML = '';
      
      for (let i = 0; i < indicatorCount; i++) {
        const indicator = document.createElement('button');
        indicator.classList.add('indicator');
        indicator.setAttribute('role', 'tab');
        indicator.setAttribute('aria-label', \`Aller à la page \${i + 1}\`);
        indicator.addEventListener('click', () => {
          const scrollTo = i * this.scrollAmount * visibleCount;
          this.list.scrollTo({
            left: scrollTo,
            behavior: 'smooth'
          });
        });
        this.indicators.appendChild(indicator);
      }

      this.updateIndicators();
    }

    updateIndicators() {
      if (!this.indicators) return;

      const indicators = this.indicators.querySelectorAll('.indicator');
      if (indicators.length === 0) return;

      const visibleCount = Math.floor(this.list.clientWidth / this.scrollAmount);
      const currentIndex = Math.round(this.list.scrollLeft / (this.scrollAmount * visibleCount));

      indicators.forEach((indicator, index) => {
        indicator.classList.toggle('active', index === currentIndex);
        indicator.setAttribute('aria-selected', String(index === currentIndex));
      });
    }

    setupAutoScroll() {
      if (this.slider.dataset.autoScroll !== 'true') return;

      const scrollSpeed = parseFloat(this.slider.style.getPropertyValue('--slider-scroll-speed')) || 50;
      const scrollInterval = scrollSpeed * 1000 / this.list.children.length;

      this.autoScrollInterval = window.setInterval(() => {
        if (this.isAutoScrolling) return;

        const isAtEnd = this.list.scrollLeft >= this.list.scrollWidth - this.list.clientWidth - 1;
        
        if (isAtEnd) {
          this.list.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          this.scrollRight();
        }
      }, scrollInterval);
    }

    pauseAutoScroll() {
      this.isAutoScrolling = true;
    }

    resumeAutoScroll() {
      this.isAutoScrolling = false;
    }

    destroy() {
      if (this.autoScrollInterval) {
        clearInterval(this.autoScrollInterval);
      }
    }
  }

  // Initialize all sliders
  function initSliders() {
    const sliders = document.querySelectorAll('.slider-wrapper');
    sliders.forEach(slider => new SliderComponent(slider));
  }

  // Initialize on DOMContentLoaded
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSliders);
  } else {
    initSliders();
  }

  // Reinitialize on Astro page transitions
  document.addEventListener('astro:page-load', initSliders);
</script> "
`;
